{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Wilder1222/cineweave-studio/schemas/proposal-output.schema.json",
  "title": "CineWeave Director Proposal Set",
  "description": "Provider-neutral alternative direction set. Version 2.5 adds immutable identity, capability requirements and an explicit human selection gate while retaining the legacy 2.0 input shape.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "kind",
    "contractVersion",
    "skillReceipt",
    "proposals"
  ],
  "properties": {
    "kind": {
      "const": "cineweave_codex_director_proposals"
    },
    "contractVersion": {
      "enum": [
        "2.0.0",
        "2.5.0"
      ]
    },
    "proposalSetId": {
      "$ref": "common.schema.json#/$defs/identifier"
    },
    "version": {
      "type": "integer",
      "minimum": 1
    },
    "sourceRefs": {
      "type": "array",
      "maxItems": 16,
      "uniqueItems": true,
      "items": {
        "$ref": "common.schema.json#/$defs/contractRef"
      }
    },
    "sourceInput": {
      "type": "string",
      "minLength": 1,
      "maxLength": 1200
    },
    "skillReceipt": {
      "$ref": "common.schema.json#/$defs/skillReceipt"
    },
    "explorationAxes": {
      "type": "array",
      "minItems": 1,
      "maxItems": 5,
      "uniqueItems": true,
      "items": {
        "enum": [
          "blocking",
          "attention",
          "camera",
          "tempo",
          "coverage"
        ]
      }
    },
    "proposals": {
      "type": "array",
      "minItems": 2,
      "maxItems": 5,
      "items": {
        "$ref": "#/$defs/proposal"
      }
    },
    "humanSelection": {
      "$ref": "#/$defs/humanSelection"
    },
    "executionBoundary": {
      "$ref": "#/$defs/executionBoundary"
    },
    "validation": {
      "$ref": "#/$defs/validation"
    },
    "provenance": {
      "$ref": "common.schema.json#/$defs/provenance"
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "contractVersion": {
            "const": "2.0.0"
          }
        }
      },
      "then": {
        "properties": {
          "proposals": {
            "items": {
              "required": [
                "recommendedProvider"
              ]
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "contractVersion": {
            "const": "2.5.0"
          }
        }
      },
      "then": {
        "required": [
          "proposalSetId",
          "version",
          "explorationAxes",
          "humanSelection",
          "executionBoundary",
          "validation",
          "provenance"
        ],
        "properties": {
          "proposals": {
            "items": {
              "allOf": [
                {
                  "required": [
                    "proposalId",
                    "primaryDelta",
                    "capabilityRequirements",
                    "costClass",
                    "riskClass"
                  ]
                },
                {
                  "not": {
                    "required": [
                      "recommendedProvider"
                    ]
                  }
                }
              ]
            }
          }
        }
      }
    }
  ],
  "$defs": {
    "stylePriority": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "label",
        "importance"
      ],
      "properties": {
        "label": {
          "type": "string",
          "minLength": 1,
          "maxLength": 240
        },
        "importance": {
          "enum": [
            "required",
            "strong",
            "supporting"
          ]
        }
      }
    },
    "primaryDelta": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "axis",
        "direction",
        "hypothesis"
      ],
      "properties": {
        "axis": {
          "enum": [
            "blocking",
            "attention",
            "camera",
            "tempo",
            "coverage"
          ]
        },
        "direction": {
          "type": "string",
          "minLength": 1,
          "maxLength": 800
        },
        "hypothesis": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1600
        }
      }
    },
    "proposal": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "title",
        "summary",
        "narrativeIntent",
        "audienceFeeling",
        "composition",
        "camera",
        "performance",
        "visualTreatment",
        "soundEdit",
        "styleStack",
        "preserve",
        "allowedChanges",
        "cost",
        "risk"
      ],
      "properties": {
        "proposalId": {
          "$ref": "common.schema.json#/$defs/identifier"
        },
        "title": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4000
        },
        "summary": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4000
        },
        "narrativeIntent": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4000
        },
        "audienceFeeling": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4000
        },
        "primaryDelta": {
          "$ref": "#/$defs/primaryDelta"
        },
        "composition": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4000
        },
        "camera": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4000
        },
        "performance": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4000
        },
        "visualTreatment": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4000
        },
        "soundEdit": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4000
        },
        "styleStack": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/stylePriority"
          }
        },
        "preserve": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 500
          }
        },
        "allowedChanges": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 500
          }
        },
        "capabilityRequirements": {
          "type": "array",
          "minItems": 1,
          "maxItems": 12,
          "uniqueItems": true,
          "items": {
            "$ref": "common.schema.json#/$defs/identifier"
          }
        },
        "cost": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4000
        },
        "costClass": {
          "enum": [
            "low",
            "medium",
            "high",
            "unknown"
          ]
        },
        "risk": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4000
        },
        "riskClass": {
          "enum": [
            "low",
            "medium",
            "high",
            "unknown"
          ]
        },
        "recommendedProvider": {
          "enum": [
            "codex",
            "libtv"
          ],
          "deprecated": true,
          "description": "Legacy 2.0 provider recommendation. It is forbidden in provider-neutral 2.5 proposal sets."
        }
      }
    },
    "humanSelection": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "required",
        "status",
        "method"
      ],
      "properties": {
        "required": {
          "const": true
        },
        "status": {
          "const": "pending"
        },
        "method": {
          "enum": [
            "compare",
            "choose",
            "defer"
          ]
        },
        "selectionQuestion": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1600
        }
      }
    },
    "executionBoundary": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "providerNeutral",
        "generatesMedia",
        "approvesAssets",
        "humanApprovalRequired"
      ],
      "properties": {
        "providerNeutral": {
          "const": true
        },
        "generatesMedia": {
          "const": false
        },
        "approvesAssets": {
          "const": false
        },
        "humanApprovalRequired": {
          "const": true
        },
        "notes": {
          "type": "string",
          "maxLength": 1200
        }
      }
    },
    "validation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "proposalSetVersioned",
        "primaryDeltasDistinct",
        "providerNeutral",
        "capabilityRequirementsDeclared",
        "humanSelectionRequired"
      ],
      "properties": {
        "proposalSetVersioned": {
          "const": true
        },
        "primaryDeltasDistinct": {
          "const": true
        },
        "providerNeutral": {
          "const": true
        },
        "capabilityRequirementsDeclared": {
          "const": true
        },
        "humanSelectionRequired": {
          "const": true
        }
      }
    }
  }
}
