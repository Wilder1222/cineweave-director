{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Wilder1222/cineweave-studio/schemas/creative-brief.schema.json",
  "title": "CineWeave Creative Brief",
  "type": "object",
  "additionalProperties": false,
  "required": ["kind", "contractVersion", "briefId", "status", "inputMode", "purpose", "task", "intent", "styleSelection", "referenceBindings", "locks", "stagePlan", "missingHighImpact", "validation", "skillReceipt"],
  "properties": {
    "kind": { "const": "cineweave_codex_creative_brief" },
    "contractVersion": { "const": "2.0.0" },
    "worldId": { "type": "string", "minLength": 1, "maxLength": 160 },
    "briefId": { "type": "string", "pattern": "^[a-z0-9][a-z0-9._-]{2,159}$" },
    "status": { "enum": ["draft", "ready", "blocked", "approved", "archived"] },
    "inputMode": { "enum": ["zero_prompt", "quick", "guided", "professional", "studio"] },
    "purpose": { "type": "string", "minLength": 1, "maxLength": 2400 },
    "sourcePrompt": { "type": "string", "maxLength": 8000 },
    "task": { "$ref": "#/$defs/task" },
    "intent": { "$ref": "#/$defs/intent" },
    "styleSelection": { "$ref": "#/$defs/styleSelection" },
    "referenceBindings": { "type": "array", "maxItems": 24, "items": { "$ref": "#/$defs/referenceBinding" } },
    "locks": { "$ref": "#/$defs/locks" },
    "stagePlan": { "type": "array", "minItems": 1, "maxItems": 16, "items": { "$ref": "#/$defs/stage" } },
    "missingHighImpact": { "type": "array", "maxItems": 12, "items": { "$ref": "#/$defs/missingQuestion" } },
    "assumptions": { "type": "array", "maxItems": 24, "items": { "type": "string", "minLength": 1, "maxLength": 1200 } },
    "validation": { "type": "object", "additionalProperties": false, "required": ["intentParsed", "referencesRoleScoped", "questionsPrioritized", "styleDoesNotOwnIdentity", "noProviderClaim"], "properties": { "intentParsed": { "const": true }, "referencesRoleScoped": { "const": true }, "questionsPrioritized": { "const": true }, "styleDoesNotOwnIdentity": { "const": true }, "noProviderClaim": { "const": true } } },
    "skillReceipt": { "$ref": "#/$defs/skillReceipt" }
  },
  "$defs": {
    "stringList": { "type": "array", "minItems": 1, "maxItems": 32, "items": { "type": "string", "minLength": 1, "maxLength": 1200 } },
    "task": { "type": "object", "additionalProperties": false, "required": ["type", "output"], "properties": { "type": { "enum": ["character_exploration", "character_lock", "appearance", "expression", "motion", "scene", "shot", "storyboard", "style_exploration", "prompt_management", "aigc_studio"] }, "output": { "enum": ["image", "video", "prompt", "plan", "mixed"] }, "medium": { "enum": ["live_action", "hand_drawn_2d", "digital_2d", "three_d", "comic", "illustration", "mixed", "unknown"] }, "aspectRatio": { "type": "string", "maxLength": 32 } } },
    "intent": { "type": "object", "additionalProperties": false, "required": ["character", "scene", "performance", "output"], "properties": { "character": { "type": "string", "maxLength": 2400 }, "scene": { "type": "string", "maxLength": 2400 }, "performance": { "type": "string", "maxLength": 2400 }, "output": { "type": "string", "maxLength": 1600 } } },
    "styleSelection": { "type": "object", "additionalProperties": false, "required": ["medium", "representation", "styleAtoms", "temporalRequired"], "properties": { "medium": { "type": "string", "minLength": 1, "maxLength": 240 }, "representation": { "type": "string", "minLength": 1, "maxLength": 240 }, "stylePackageRef": { "$ref": "#/$defs/contractRef" }, "styleAtoms": { "$ref": "#/$defs/stringList" }, "temporalRequired": { "type": "boolean" }, "historicalTreatment": { "type": "string", "maxLength": 240 } } },
    "referenceBinding": { "type": "object", "additionalProperties": false, "required": ["referenceId", "role", "scope", "preserve", "ignore", "rightsStatus"], "properties": { "referenceId": { "type": "string", "minLength": 1, "maxLength": 160 }, "role": { "enum": ["identity", "appearance", "skin_material", "body", "pose", "style", "capture", "lighting", "composition", "scene", "camera_motion", "performance", "temporal", "material", "validation"] }, "scope": { "type": "string", "minLength": 1, "maxLength": 160 }, "preserve": { "$ref": "#/$defs/stringList" }, "ignore": { "$ref": "#/$defs/stringList" }, "rightsStatus": { "enum": ["confirmed", "unverified", "unknown", "restricted"] } } },
    "locks": { "type": "object", "additionalProperties": false, "required": ["hard", "soft", "free", "undefined"], "properties": { "hard": { "$ref": "#/$defs/stringList" }, "soft": { "$ref": "#/$defs/stringList" }, "free": { "$ref": "#/$defs/stringList" }, "undefined": { "$ref": "#/$defs/stringList" } } },
    "stage": { "type": "object", "additionalProperties": false, "required": ["stageId", "owner", "status", "purpose", "gate"], "properties": { "stageId": { "type": "string", "pattern": "^[a-z0-9][a-z0-9._-]{2,159}$" }, "owner": { "enum": ["cineweave-story", "cineweave-character", "cineweave-scene", "cineweave-style", "cineweave-reference", "cineweave-director", "cineweave-prompt", "cineweave-production"] }, "status": { "enum": ["pending", "in_progress", "blocked", "approved"] }, "purpose": { "type": "string", "minLength": 1, "maxLength": 800 }, "gate": { "type": "string", "minLength": 1, "maxLength": 800 }, "inputRefs": { "type": "array", "maxItems": 16, "items": { "type": "string", "minLength": 1, "maxLength": 160 } }, "outputContracts": { "$ref": "#/$defs/stringList" } } },
    "missingQuestion": { "type": "object", "additionalProperties": false, "required": ["path", "impact", "reason", "question"], "properties": { "path": { "type": "string", "minLength": 1, "maxLength": 240 }, "impact": { "enum": ["high", "medium"] }, "reason": { "type": "string", "minLength": 1, "maxLength": 800 }, "question": { "type": "string", "minLength": 1, "maxLength": 800 }, "safeDefault": { "type": "string", "maxLength": 600 } } },
    "contractRef": { "type": "object", "additionalProperties": false, "required": ["id", "version", "contentHash"], "properties": { "id": { "type": "string", "minLength": 1, "maxLength": 160 }, "version": { "type": "integer", "minimum": 1 }, "contentHash": { "type": "string", "pattern": "^sha256:[0-9a-fA-F]{64}$" } } },
    "skillReceipt": { "type": "object", "additionalProperties": false, "required": ["repository", "ref", "commit", "installedBy", "usedAt"], "properties": { "repository": { "type": "string", "format": "uri", "pattern": "^https://(www\\.)?github\\.com/[^/]+/[^/]+(?:\\.git)?/?$" }, "ref": { "type": "string", "minLength": 1, "maxLength": 240 }, "commit": { "type": "string", "pattern": "^[0-9a-fA-F]{7,64}$" }, "contentHash": { "type": "string", "pattern": "^sha256:[0-9a-fA-F]{64}$" }, "installedBy": { "const": "codex-environment" }, "environmentId": { "type": "string", "maxLength": 240 }, "usedAt": { "type": "string", "format": "date-time" } } }
  }
}
