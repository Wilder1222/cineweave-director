{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Wilder1222/cineweave-studio/schemas/content-credential-handoff.schema.json",
  "title": "CineWeave Production Content Credential Handoff",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "kind",
    "contractVersion",
    "contentCredentialHandoffId",
    "version",
    "referenceAssetRef",
    "contentCredentialInspectionRef",
    "skillReceipt",
    "handoffStatus",
    "inspectionRequirement",
    "provenancePlan",
    "executionBoundary",
    "validation",
    "provenance"
  ],
  "properties": {
    "kind": { "const": "cineweave_codex_content_credential_handoff" },
    "contractVersion": { "const": "2.5.0" },
    "contentCredentialHandoffId": { "$ref": "common.schema.json#/$defs/identifier" },
    "version": { "type": "integer", "minimum": 1 },
    "referenceAssetRef": { "$ref": "#/$defs/referenceAssetRef" },
    "contentCredentialInspectionRef": { "$ref": "#/$defs/contentCredentialInspectionRef" },
    "skillReceipt": { "$ref": "common.schema.json#/$defs/skillReceipt" },
    "handoffStatus": { "const": "planned" },
    "inspectionRequirement": { "$ref": "#/$defs/inspectionRequirement" },
    "provenancePlan": { "$ref": "#/$defs/provenancePlan" },
    "executionBoundary": { "$ref": "#/$defs/executionBoundary" },
    "validation": { "$ref": "#/$defs/validation" },
    "provenance": { "$ref": "common.schema.json#/$defs/provenance" }
  },
  "$defs": {
    "referenceAssetRef": {
      "allOf": [
        { "$ref": "common.schema.json#/$defs/contractRef" },
        { "properties": { "kind": { "const": "cineweave_codex_reference_asset" } } }
      ]
    },
    "contentCredentialInspectionRef": {
      "allOf": [
        { "$ref": "common.schema.json#/$defs/contractRef" },
        { "properties": { "kind": { "const": "cineweave_codex_content_credential_inspection" } } }
      ]
    },
    "inspectionRequirement": {
      "type": "object",
      "additionalProperties": false,
      "required": ["requiresRecordedInspectionBeforeExternalTransfer", "requiresDerivedOutputRevalidation", "credentialPresenceIsNotRightsEvidence", "credentialValidityIsNotTruthEvidence"],
      "properties": {
        "requiresRecordedInspectionBeforeExternalTransfer": { "const": true },
        "requiresDerivedOutputRevalidation": { "const": true },
        "credentialPresenceIsNotRightsEvidence": { "const": true },
        "credentialValidityIsNotTruthEvidence": { "const": true }
      }
    },
    "provenancePlan": {
      "type": "object",
      "additionalProperties": false,
      "required": ["sourceRelationship", "manifestAction", "rawManifestEmbedded", "manifestLocationStored"],
      "properties": {
        "sourceRelationship": { "const": "ingredient_planned" },
        "manifestAction": { "const": "not_performed" },
        "rawManifestEmbedded": { "const": false },
        "manifestLocationStored": { "const": false },
        "notes": { "type": "string", "minLength": 1, "maxLength": 1200 }
      }
    },
    "executionBoundary": {
      "type": "object",
      "additionalProperties": false,
      "required": ["providerNeutral", "invokesAdapter", "writesMedia", "writesManifest", "exportsAsset", "humanApprovalRequired"],
      "properties": {
        "providerNeutral": { "const": true },
        "invokesAdapter": { "const": false },
        "writesMedia": { "const": false },
        "writesManifest": { "const": false },
        "exportsAsset": { "const": false },
        "humanApprovalRequired": { "const": true },
        "notes": { "type": "string", "minLength": 1, "maxLength": 1200 }
      }
    },
    "validation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["sourceRefsExact", "inspectionRequired", "ingredientOnlyPlanned", "rightsSeparate", "truthSeparate", "providerNeutral"],
      "properties": {
        "sourceRefsExact": { "const": true },
        "inspectionRequired": { "const": true },
        "ingredientOnlyPlanned": { "const": true },
        "rightsSeparate": { "const": true },
        "truthSeparate": { "const": true },
        "providerNeutral": { "const": true }
      }
    }
  }
}
