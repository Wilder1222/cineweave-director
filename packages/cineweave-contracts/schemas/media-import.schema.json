{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Wilder1222/cineweave-studio/schemas/media-import.schema.json",
  "title": "CineWeave Codex Verified Draft Media Import",
  "type": "object",
  "additionalProperties": false,
  "required": ["kind", "contractVersion", "worldId", "renderPlanRef", "skillReceipt", "status", "media", "verification", "importContract"],
  "properties": {
    "kind": { "const": "cineweave_codex_media_import" },
    "contractVersion": { "const": "2.0.0" },
    "worldId": { "type": "string", "minLength": 1, "maxLength": 160 },
    "shotId": { "type": "string", "minLength": 1, "maxLength": 160 },
    "renderPlanRef": { "type": "string", "minLength": 1, "maxLength": 240 },
    "skillReceipt": { "$ref": "#/$defs/skillReceipt" },
    "status": { "const": "draft" },
    "media": {
      "type": "array",
      "minItems": 1,
      "maxItems": 12,
      "items": { "$ref": "#/$defs/media" }
    },
    "verification": {
      "type": "object",
      "additionalProperties": false,
      "required": ["fileExists", "contentHashPresent", "dimensionsDetected", "privateUrlAbsent", "status"],
      "properties": {
        "fileExists": { "const": true },
        "contentHashPresent": { "const": true },
        "dimensionsDetected": { "const": true },
        "privateUrlAbsent": { "const": true },
        "status": { "enum": ["verified", "blocked"] }
      }
    },
    "importContract": {
      "type": "object",
      "additionalProperties": false,
      "required": ["source", "statusOnCreation", "nextAction"],
      "properties": {
        "source": { "enum": ["codex_interactive", "user_upload", "external_adapter"] },
        "statusOnCreation": { "const": "draft" },
        "nextAction": { "type": "string", "minLength": 1, "maxLength": 1200 }
      }
    }
  },
  "$defs": {
    "skillReceipt": {
      "type": "object",
      "additionalProperties": false,
      "required": ["repository", "ref", "commit", "installedBy", "usedAt"],
      "properties": {
        "repository": { "type": "string", "format": "uri", "pattern": "^https://(www\\.)?github\\.com/[^/]+/[^/]+(?:\\.git)?/?$" },
        "ref": { "type": "string", "minLength": 1, "maxLength": 240 },
        "commit": { "type": "string", "pattern": "^[0-9a-fA-F]{7,64}$" },
        "contentHash": { "type": "string", "pattern": "^sha256:[0-9a-fA-F]{64}$" },
        "installedBy": { "const": "codex-environment" },
        "environmentId": { "type": "string", "maxLength": 240 },
        "usedAt": { "type": "string", "format": "date-time" }
      }
    },
    "media": {
      "type": "object",
      "additionalProperties": false,
      "required": ["mediaId", "mediaType", "fileName", "format", "byteSize", "contentHash", "width", "height", "source"],
      "properties": {
        "mediaId": { "type": "string", "minLength": 1, "maxLength": 160 },
        "mediaType": { "enum": ["still", "storyboard_frame", "keyframe_candidate", "video_candidate"] },
        "fileName": { "type": "string", "minLength": 1, "maxLength": 300, "pattern": "^[^/\\\\?%*:|\"<>]+$" },
        "format": { "enum": ["png", "jpeg", "webp", "mp4", "mov", "webm"] },
        "byteSize": { "type": "integer", "minimum": 1 },
        "contentHash": { "type": "string", "pattern": "^sha256:[0-9a-fA-F]{64}$" },
        "width": { "type": "integer", "minimum": 1 },
        "height": { "type": "integer", "minimum": 1 },
        "durationSeconds": { "type": "number", "exclusiveMinimum": 0, "maximum": 86400 },
        "frameRate": { "type": "number", "exclusiveMinimum": 0, "maximum": 480 },
        "source": { "enum": ["codex_interactive", "user_upload", "external_adapter"] }
      },
      "allOf": [
        {
          "if": { "properties": { "mediaType": { "const": "video_candidate" } } },
          "then": {
            "required": ["durationSeconds", "frameRate"],
            "properties": { "format": { "enum": ["mp4", "mov", "webm"] } }
          },
          "else": { "properties": { "format": { "enum": ["png", "jpeg", "webp"] } } }
        }
      ]
    }
  }
}
