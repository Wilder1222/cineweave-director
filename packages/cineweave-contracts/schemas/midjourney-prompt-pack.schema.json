{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Wilder1222/cineweave-studio/schemas/midjourney-prompt-pack.schema.json",
  "title": "CineWeave Midjourney Exploration Prompt Pack",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "kind",
    "contractVersion",
    "packId",
    "version",
    "status",
    "purpose",
    "explorationAxis",
    "target",
    "promptLanguage",
    "variants",
    "referenceSlots",
    "aestheticProfileBindings",
    "parameterPolicy",
    "handoff",
    "preserve",
    "allowedChanges",
    "forbidden",
    "validation",
    "provenance",
    "skillReceipt"
  ],
  "properties": {
    "kind": { "const": "cineweave_codex_midjourney_prompt_pack" },
    "contractVersion": { "const": "1.0.0" },
    "packId": { "$ref": "common.schema.json#/$defs/identifier" },
    "version": { "type": "integer", "minimum": 1 },
    "status": { "enum": ["draft", "ready", "selected", "archived"] },
    "worldId": { "type": "string", "minLength": 1, "maxLength": 160 },
    "corePromptRef": {
      "allOf": [
        { "$ref": "common.schema.json#/$defs/contractRef" },
        {
          "properties": {
            "kind": { "const": "cineweave_codex_prompt_record" }
          }
        }
      ]
    },
    "purpose": { "type": "string", "minLength": 1, "maxLength": 2000 },
    "explorationAxis": {
      "enum": ["concept", "identity", "appearance", "style", "composition", "lighting", "medium", "scene", "shot", "mixed"]
    },
    "target": {
      "type": "object",
      "additionalProperties": false,
      "required": ["subject", "scene", "outputUse"],
      "properties": {
        "subject": { "type": "string", "minLength": 1, "maxLength": 1000 },
        "scene": { "type": "string", "minLength": 1, "maxLength": 1000 },
        "outputUse": { "type": "string", "minLength": 1, "maxLength": 1000 },
        "audienceFeeling": { "type": "string", "maxLength": 800 },
        "narrativeCue": { "type": "string", "maxLength": 800 }
      }
    },
    "promptLanguage": { "enum": ["zh-CN", "en", "bilingual"] },
    "variants": {
      "type": "array",
      "minItems": 3,
      "maxItems": 8,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["variantId", "label", "hypothesis", "promptText", "copyablePrompt", "parameterTokens", "referenceOrder", "acceptance", "status"],
        "properties": {
          "variantId": { "$ref": "common.schema.json#/$defs/identifier" },
          "label": { "type": "string", "minLength": 1, "maxLength": 240 },
          "hypothesis": { "type": "string", "minLength": 1, "maxLength": 800 },
          "promptText": { "type": "string", "minLength": 1, "maxLength": 4000 },
          "copyablePrompt": { "type": "string", "minLength": 1, "maxLength": 5000 },
          "parameterTokens": {
            "type": "array",
            "minItems": 1,
            "maxItems": 16,
            "items": { "type": "string", "minLength": 1, "maxLength": 160 }
          },
          "referenceOrder": {
            "type": "array",
            "maxItems": 8,
            "uniqueItems": true,
            "items": { "type": "string", "pattern": "^[a-z0-9][a-z0-9_]{1,63}$" }
          },
          "acceptance": { "$ref": "common.schema.json#/$defs/stringList" },
          "status": { "enum": ["draft", "candidate", "selected", "rejected"] }
        }
      }
    },
    "referenceSlots": {
      "type": "array",
      "maxItems": 8,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["slotId", "role", "token", "required", "purpose", "preserve", "doNotTransfer"],
        "properties": {
          "slotId": { "type": "string", "pattern": "^[a-z0-9][a-z0-9_]{1,63}$" },
          "role": { "enum": ["image_prompt", "style_reference", "omni_reference", "moodboard", "starting_frame", "ending_frame"] },
          "token": { "type": "string", "pattern": "^\\{\\{[a-z0-9_]+\\}\\}$" },
          "required": { "type": "boolean" },
          "purpose": { "type": "string", "minLength": 1, "maxLength": 800 },
          "preserve": { "$ref": "common.schema.json#/$defs/stringList" },
          "doNotTransfer": { "$ref": "common.schema.json#/$defs/stringList" },
          "caseImage": {
            "type": "object",
            "additionalProperties": false,
            "required": ["caseRef", "resultId", "referenceAssetRef"],
            "properties": {
              "caseRef": {
                "allOf": [
                  { "$ref": "common.schema.json#/$defs/contractRef" },
                  { "properties": { "kind": { "const": "cineweave_codex_midjourney_exploration_case" } } }
                ]
              },
              "resultId": { "$ref": "common.schema.json#/$defs/identifier" },
              "referenceAssetRef": {
                "allOf": [
                  { "$ref": "common.schema.json#/$defs/contractRef" },
                  { "properties": { "kind": { "const": "cineweave_codex_reference_asset" } } }
                ]
              }
            }
          }
        }
      }
    },
    "explorationCaseRefs": {
      "type": "array",
      "maxItems": 12,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["caseRef", "role", "purpose", "preserve", "doNotTransfer"],
        "properties": {
          "caseRef": {
            "allOf": [
              { "$ref": "common.schema.json#/$defs/contractRef" },
              { "properties": { "kind": { "const": "cineweave_codex_midjourney_exploration_case" } } }
            ]
          },
          "role": { "enum": ["style_grammar", "prompt_pattern", "composition", "lighting", "material", "negative_example", "identity_policy"] },
          "purpose": { "type": "string", "minLength": 1, "maxLength": 800 },
          "preserve": { "$ref": "common.schema.json#/$defs/stringList" },
          "doNotTransfer": { "$ref": "common.schema.json#/$defs/stringList" }
        }
      }
    },
    "aestheticProfileBindings": {
      "type": "array",
      "maxItems": 8,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["bindingId", "profileRef", "profileType", "scope", "providerToken", "tokenKind", "knownCompatibleVersions", "reverifyBeforeUse", "purpose", "preserve", "doNotTransfer"],
        "properties": {
          "bindingId": { "$ref": "common.schema.json#/$defs/identifier" },
          "profileRef": {
            "allOf": [
              { "$ref": "common.schema.json#/$defs/contractRef" },
              { "properties": { "kind": { "const": "cineweave_codex_midjourney_aesthetic_profile" } } }
            ]
          },
          "profileType": { "enum": ["moodboard", "personalization_profile"] },
          "scope": { "enum": ["creator_baseline", "world_visual_bible", "project_domain", "shot_experiment"] },
          "providerToken": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{1,239}$" },
          "tokenKind": { "enum": ["profile_id_latest", "resolved_code_snapshot"] },
          "knownCompatibleVersions": {
            "type": "array",
            "minItems": 1,
            "maxItems": 12,
            "uniqueItems": true,
            "items": { "type": "string", "minLength": 1, "maxLength": 40 }
          },
          "reverifyBeforeUse": { "const": true },
          "purpose": { "type": "string", "minLength": 1, "maxLength": 800 },
          "preserve": { "$ref": "common.schema.json#/$defs/stringList" },
          "doNotTransfer": { "$ref": "common.schema.json#/$defs/stringList" }
        }
      }
    },
    "parameterPolicy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["modelVersion", "surface", "pinVersion", "verifyBeforeUse", "notes"],
      "properties": {
        "modelVersion": { "type": "string", "minLength": 1, "maxLength": 40 },
        "surface": { "enum": ["web", "discord", "both"] },
        "pinVersion": { "const": true },
        "verifyBeforeUse": { "const": true },
        "notes": { "$ref": "common.schema.json#/$defs/stringList" }
      }
    },
    "handoff": {
      "type": "object",
      "additionalProperties": false,
      "required": ["userAction", "selectionRule", "returnToCodex", "nextStage"],
      "properties": {
        "userAction": { "$ref": "common.schema.json#/$defs/stringList" },
        "selectionRule": { "$ref": "common.schema.json#/$defs/stringList" },
        "returnToCodex": { "type": "string", "minLength": 1, "maxLength": 1200 },
        "nextStage": { "enum": ["reference_ingest", "prompt_refine", "style_converge", "asset_planning"] },
        "requiredUploads": {
          "type": "array",
          "maxItems": 8,
          "items": { "type": "string", "minLength": 1, "maxLength": 240 }
        }
      }
    },
    "preserve": { "$ref": "common.schema.json#/$defs/stringList" },
    "allowedChanges": { "$ref": "common.schema.json#/$defs/stringList" },
    "forbidden": { "$ref": "common.schema.json#/$defs/stringList" },
    "validation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["providerProjectionOnly", "onePrimaryTarget", "oneAxisPerVariant", "referenceRolesSeparated", "referenceVersionCompatible", "aestheticLayersSeparated", "aestheticProfilesVersionCompatible", "profileTokensExplicit", "moodboardStyleReferenceParametersCompatible", "noPrivateLocators", "versionExplicit", "manualSelectionRequired"],
      "properties": {
        "providerProjectionOnly": { "const": true },
        "onePrimaryTarget": { "const": true },
        "oneAxisPerVariant": { "const": true },
        "referenceRolesSeparated": { "const": true },
        "referenceVersionCompatible": { "const": true },
        "aestheticLayersSeparated": { "const": true },
        "aestheticProfilesVersionCompatible": { "const": true },
        "profileTokensExplicit": { "const": true },
        "moodboardStyleReferenceParametersCompatible": { "const": true },
        "noPrivateLocators": { "const": true },
        "versionExplicit": { "const": true },
        "manualSelectionRequired": { "const": true }
      }
    },
    "provenance": { "$ref": "common.schema.json#/$defs/provenance" },
    "skillReceipt": { "$ref": "common.schema.json#/$defs/skillReceipt" }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "referenceSlots": {
            "contains": {
              "type": "object",
              "required": ["role"],
              "properties": { "role": { "const": "omni_reference" } }
            }
          }
        },
        "required": ["referenceSlots"]
      },
      "then": {
        "properties": {
          "parameterPolicy": {
            "properties": {
              "modelVersion": { "pattern": "^V7(?:\\.|$)" }
            }
          }
        }
      }
    },
    {
      "if": {
        "required": ["aestheticProfileBindings"],
        "properties": {
          "aestheticProfileBindings": { "minItems": 1 }
        }
      },
      "then": {
        "properties": {
          "variants": {
            "items": {
              "properties": {
                "parameterTokens": {
                  "contains": { "type": "string", "pattern": "^--p\\s+[A-Za-z0-9][A-Za-z0-9._-]{1,239}$" }
                }
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "required": ["aestheticProfileBindings"],
        "properties": {
          "aestheticProfileBindings": {
            "contains": {
              "type": "object",
              "required": ["profileType"],
              "properties": { "profileType": { "const": "moodboard" } }
            }
          }
        }
      },
      "then": {
        "properties": {
          "variants": {
            "not": {
              "contains": {
                "type": "object",
                "properties": {
                  "parameterTokens": {
                    "contains": { "type": "string", "pattern": "^--s(?:w|v)(?:\\s|$)" }
                  }
                }
              }
            }
          }
        }
      }
    }
  ]
}
