{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Wilder1222/cineweave-studio/schemas/director-repair.schema.json",
  "title": "CineWeave Director Single-variable Repair or Delegation",
  "description": "Provider-neutral repair plan for one Director-owned variable, or a non-mutating delegation to the correct owner.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "kind",
    "contractVersion",
    "repairId",
    "version",
    "disposition",
    "skillReceipt",
    "observedFailure",
    "preserve",
    "acceptanceChecks",
    "stopCondition",
    "executionGate",
    "executionBoundary",
    "validation",
    "provenance"
  ],
  "properties": {
    "kind": { "const": "cineweave_codex_director_repair" },
    "contractVersion": { "const": "2.5.0" },
    "repairId": { "$ref": "common.schema.json#/$defs/identifier" },
    "version": { "type": "integer", "minimum": 1 },
    "worldId": { "$ref": "common.schema.json#/$defs/identifier" },
    "disposition": { "enum": ["repair", "delegate"] },
    "sourceReviewRef": { "$ref": "#/$defs/controlBenchmarkReviewRef" },
    "skillReceipt": { "$ref": "common.schema.json#/$defs/skillReceipt" },
    "observedFailure": { "$ref": "#/$defs/observedFailure" },
    "preserve": { "$ref": "common.schema.json#/$defs/stringList" },
    "targetRef": { "$ref": "#/$defs/directorTargetRef" },
    "change": { "$ref": "#/$defs/change" },
    "delegation": { "$ref": "#/$defs/delegation" },
    "acceptanceChecks": {
      "type": "array",
      "minItems": 1,
      "maxItems": 12,
      "items": { "$ref": "#/$defs/acceptanceCheck" }
    },
    "stopCondition": { "type": "string", "minLength": 1, "maxLength": 1600 },
    "executionGate": { "$ref": "#/$defs/executionGate" },
    "executionBoundary": { "$ref": "#/$defs/executionBoundary" },
    "validation": { "$ref": "#/$defs/validation" },
    "provenance": { "$ref": "common.schema.json#/$defs/provenance" }
  },
  "allOf": [
    {
      "if": {
        "required": ["disposition"],
        "properties": { "disposition": { "const": "repair" } }
      },
      "then": {
        "required": ["targetRef", "change"],
        "properties": {
          "observedFailure": {
            "properties": { "owningDomain": { "const": "director" } }
          }
        },
        "not": { "required": ["delegation"] }
      }
    },
    {
      "if": {
        "required": ["disposition"],
        "properties": { "disposition": { "const": "delegate" } }
      },
      "then": {
        "required": ["delegation"],
        "not": {
          "anyOf": [
            { "required": ["targetRef"] },
            { "required": ["change"] }
          ]
        }
      }
    }
  ],
  "$defs": {
    "controlBenchmarkReviewRef": {
      "allOf": [
        { "$ref": "common.schema.json#/$defs/contractRef" },
        { "properties": { "kind": { "const": "cineweave_codex_control_benchmark_review" } } }
      ]
    },
    "directorTargetRef": {
      "oneOf": [
        {
          "allOf": [
            { "$ref": "common.schema.json#/$defs/contractRef" },
            { "properties": { "kind": { "const": "cineweave_codex_action_sequence_spec" } } }
          ]
        },
        {
          "allOf": [
            { "$ref": "common.schema.json#/$defs/contractRef" },
            { "properties": { "kind": { "const": "cineweave_codex_shot_spec" } } }
          ]
        },
        {
          "allOf": [
            { "$ref": "common.schema.json#/$defs/contractRef" },
            { "properties": { "kind": { "const": "cineweave_codex_shot_lighting_plan" } } }
          ]
        },
        {
          "allOf": [
            { "$ref": "common.schema.json#/$defs/contractRef" },
            { "properties": { "kind": { "const": "cineweave_codex_temporal_spec" } } }
          ]
        },
        {
          "allOf": [
            { "$ref": "common.schema.json#/$defs/contractRef" },
            { "properties": { "kind": { "const": "cineweave_codex_camera_previs_spec" } } }
          ]
        },
        {
          "allOf": [
            { "$ref": "common.schema.json#/$defs/contractRef" },
            { "properties": { "kind": { "const": "cineweave_codex_storyboard_sequence" } } }
          ]
        },
        {
          "allOf": [
            { "$ref": "common.schema.json#/$defs/contractRef" },
            { "properties": { "kind": { "const": "cineweave_codex_render_plan" } } }
          ]
        }
      ]
    },
    "observedFailure": {
      "type": "object",
      "additionalProperties": false,
      "required": ["owningDomain", "variable", "description", "evidenceObservationIds", "severity", "confidence"],
      "properties": {
        "owningDomain": { "enum": ["story", "character", "scene", "style", "reference", "director", "prompt", "production", "rights"] },
        "variable": { "type": "string", "minLength": 1, "maxLength": 320 },
        "description": { "type": "string", "minLength": 1, "maxLength": 2000 },
        "evidenceObservationIds": {
          "type": "array",
          "minItems": 1,
          "maxItems": 24,
          "uniqueItems": true,
          "items": { "$ref": "common.schema.json#/$defs/identifier" }
        },
        "severity": { "enum": ["advisory", "important", "blocking"] },
        "confidence": { "enum": ["high", "medium", "low", "unknown"] }
      }
    },
    "change": {
      "type": "object",
      "additionalProperties": false,
      "required": ["variable", "targetPath", "currentState", "targetState", "rationale"],
      "properties": {
        "variable": { "enum": ["dramatic_purpose", "action_blocking", "camera", "composition", "shot_light_use", "temporal_curve", "coverage", "render_intent"] },
        "targetPath": { "type": "string", "minLength": 1, "maxLength": 320 },
        "currentState": { "type": "string", "minLength": 1, "maxLength": 1600 },
        "targetState": { "type": "string", "minLength": 1, "maxLength": 1600 },
        "rationale": { "type": "string", "minLength": 1, "maxLength": 1600 }
      }
    },
    "delegation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["owner", "reason", "requiredInputKinds"],
      "properties": {
        "owner": { "enum": ["story", "character", "scene", "style", "reference", "prompt", "production", "rights"] },
        "reason": { "type": "string", "minLength": 1, "maxLength": 1600 },
        "targetRef": { "$ref": "common.schema.json#/$defs/contractRef" },
        "requiredInputKinds": {
          "type": "array",
          "minItems": 1,
          "maxItems": 16,
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 1, "maxLength": 160 }
        }
      }
    },
    "acceptanceCheck": {
      "type": "object",
      "additionalProperties": false,
      "required": ["checkId", "criterion", "expectedEvidence", "status"],
      "properties": {
        "checkId": { "$ref": "common.schema.json#/$defs/identifier" },
        "criterion": { "type": "string", "minLength": 1, "maxLength": 1600 },
        "expectedEvidence": { "type": "string", "minLength": 1, "maxLength": 1600 },
        "status": { "const": "pending" }
      }
    },
    "executionGate": {
      "type": "object",
      "additionalProperties": false,
      "required": ["requiresHumanApproval", "status"],
      "properties": {
        "requiresHumanApproval": { "const": true },
        "status": { "enum": ["planned", "blocked", "approved", "rejected"] },
        "approvedBy": { "type": "string", "minLength": 1, "maxLength": 240 },
        "approvedAt": { "type": "string", "format": "date-time" }
      },
      "allOf": [
        {
          "if": {
            "required": ["status"],
            "properties": { "status": { "const": "approved" } }
          },
          "then": { "required": ["approvedBy", "approvedAt"] }
        }
      ]
    },
    "executionBoundary": {
      "type": "object",
      "additionalProperties": false,
      "required": ["providerNeutral", "generatesMedia", "approvesAssets", "humanApprovalRequired"],
      "properties": {
        "providerNeutral": { "const": true },
        "generatesMedia": { "const": false },
        "approvesAssets": { "const": false },
        "humanApprovalRequired": { "const": true },
        "notes": { "type": "string", "maxLength": 1200 }
      }
    },
    "validation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["singleVariable", "parentImmutable", "evidenceBound", "ownershipResolved", "providerNeutral", "noSuccessClaim"],
      "properties": {
        "singleVariable": { "const": true },
        "parentImmutable": { "const": true },
        "evidenceBound": { "const": true },
        "ownershipResolved": { "const": true },
        "providerNeutral": { "const": true },
        "noSuccessClaim": { "const": true }
      }
    }
  }
}
