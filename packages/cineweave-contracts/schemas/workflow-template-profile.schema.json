{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Wilder1222/cineweave-studio/schemas/workflow-template-profile.schema.json",
  "title": "CineWeave Workflow Template Profile",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "kind",
    "contractVersion",
    "templateProfileId",
    "title",
    "version",
    "status",
    "adapterId",
    "operationId",
    "executionSurface",
    "templateIdentity",
    "inputSlots",
    "outputSlots",
    "dependencyLocks",
    "licenseProfileRefs",
    "knownLimits",
    "validation",
    "provenance",
    "skillReceipt"
  ],
  "properties": {
    "kind": { "const": "cineweave_codex_workflow_template_profile" },
    "contractVersion": { "const": "1.0.0" },
    "templateProfileId": { "$ref": "common.schema.json#/$defs/identifier" },
    "title": { "type": "string", "minLength": 1, "maxLength": 240 },
    "version": { "type": "integer", "minimum": 1 },
    "status": { "enum": ["draft", "active", "deprecated", "retired"] },
    "adapterId": { "$ref": "common.schema.json#/$defs/identifier" },
    "operationId": { "$ref": "common.schema.json#/$defs/identifier" },
    "executionSurface": { "enum": ["comfyui", "invokeai", "generic_graph", "provider_managed", "other"] },
    "templateIdentity": { "$ref": "#/$defs/templateIdentity" },
    "inputSlots": {
      "type": "array",
      "maxItems": 64,
      "items": { "$ref": "#/$defs/inputSlot" }
    },
    "outputSlots": {
      "type": "array",
      "minItems": 1,
      "maxItems": 16,
      "items": { "$ref": "#/$defs/outputSlot" }
    },
    "dependencyLocks": {
      "type": "array",
      "minItems": 1,
      "maxItems": 64,
      "items": { "$ref": "#/$defs/dependencyLock" }
    },
    "licenseProfileRefs": {
      "type": "array",
      "minItems": 1,
      "maxItems": 24,
      "uniqueItems": true,
      "items": {
        "allOf": [
          { "$ref": "common.schema.json#/$defs/contractRef" },
          { "properties": { "kind": { "const": "cineweave_codex_license_profile" } } }
        ]
      }
    },
    "knownLimits": { "$ref": "common.schema.json#/$defs/stringList" },
    "validation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "templateIdentityPinned",
        "inputSlotIdsUnique",
        "outputSlotIdsUnique",
        "dependenciesDeclared",
        "licensesLinked",
        "noEndpointOrCredentials"
      ],
      "properties": {
        "templateIdentityPinned": { "type": "boolean" },
        "inputSlotIdsUnique": { "const": true },
        "outputSlotIdsUnique": { "const": true },
        "dependenciesDeclared": { "const": true },
        "licensesLinked": { "const": true },
        "noEndpointOrCredentials": { "const": true }
      }
    },
    "provenance": { "$ref": "common.schema.json#/$defs/provenance" },
    "skillReceipt": { "$ref": "common.schema.json#/$defs/skillReceipt" }
  },
  "$defs": {
    "templateIdentity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["format", "templateId", "templateRevision", "contentHash", "nativeSchemaVersion", "serializable", "reverifyBeforeExecution"],
      "properties": {
        "format": { "enum": ["comfy_api_json", "comfy_workflow_json", "invoke_graph", "generic_json", "other_serialized", "provider_managed"] },
        "templateId": { "type": ["string", "null"], "pattern": "^[a-z0-9][a-z0-9._-]{1,159}$" },
        "templateRevision": { "type": ["string", "null"], "minLength": 1, "maxLength": 160 },
        "contentHash": { "type": ["string", "null"], "pattern": "^sha256:[0-9a-f]{64}$" },
        "nativeSchemaVersion": { "type": ["string", "null"], "minLength": 1, "maxLength": 240 },
        "serializable": { "type": "boolean" },
        "reverifyBeforeExecution": { "type": "boolean" }
      },
      "allOf": [
        {
          "if": {
            "required": ["serializable"],
            "properties": { "serializable": { "const": true } }
          },
          "then": {
            "properties": {
              "format": { "enum": ["comfy_api_json", "comfy_workflow_json", "invoke_graph", "generic_json", "other_serialized"] },
              "templateId": { "type": "string", "pattern": "^[a-z0-9][a-z0-9._-]{1,159}$" },
              "templateRevision": { "type": "string", "minLength": 1, "maxLength": 160 },
              "contentHash": { "$ref": "common.schema.json#/$defs/contentHash" },
              "nativeSchemaVersion": { "type": "string", "minLength": 1, "maxLength": 240 }
            }
          },
          "else": {
            "properties": {
              "format": { "const": "provider_managed" },
              "templateId": { "const": null },
              "templateRevision": { "const": null },
              "contentHash": { "const": null },
              "nativeSchemaVersion": { "const": null },
              "reverifyBeforeExecution": { "const": true }
            }
          }
        }
      ]
    },
    "inputSlot": {
      "type": "object",
      "additionalProperties": false,
      "required": ["slotId", "mediaKind", "required", "acceptedArtifactKinds", "purpose"],
      "properties": {
        "slotId": { "$ref": "common.schema.json#/$defs/identifier" },
        "mediaKind": { "enum": ["artifact", "image", "video", "mask", "prompt", "control", "other"] },
        "required": { "type": "boolean" },
        "acceptedArtifactKinds": {
          "type": "array",
          "minItems": 1,
          "maxItems": 24,
          "uniqueItems": true,
          "items": { "$ref": "common.schema.json#/$defs/identifier" }
        },
        "purpose": { "type": "string", "minLength": 1, "maxLength": 1200 }
      }
    },
    "outputSlot": {
      "type": "object",
      "additionalProperties": false,
      "required": ["slotId", "mediaKind", "acceptedMimeTypes", "purpose"],
      "properties": {
        "slotId": { "$ref": "common.schema.json#/$defs/identifier" },
        "mediaKind": { "enum": ["image", "video", "other"] },
        "acceptedMimeTypes": {
          "type": "array",
          "minItems": 1,
          "maxItems": 12,
          "uniqueItems": true,
          "items": { "type": "string", "pattern": "^[a-z0-9.+-]+/[a-z0-9.+-]+$" }
        },
        "purpose": { "type": "string", "minLength": 1, "maxLength": 1200 }
      }
    },
    "dependencyLock": {
      "type": "object",
      "additionalProperties": false,
      "required": ["dependencyId", "dependencyKind", "version", "contentHash", "status", "purpose"],
      "properties": {
        "dependencyId": { "$ref": "common.schema.json#/$defs/identifier" },
        "dependencyKind": { "enum": ["runtime", "model", "custom_node", "package", "workflow_component", "other"] },
        "version": { "type": ["string", "null"], "minLength": 1, "maxLength": 160 },
        "contentHash": { "type": ["string", "null"], "pattern": "^sha256:[0-9a-f]{64}$" },
        "status": { "enum": ["pinned", "declared", "unknown"] },
        "purpose": { "type": "string", "minLength": 1, "maxLength": 1200 }
      },
      "allOf": [
        {
          "if": {
            "required": ["status"],
            "properties": { "status": { "const": "pinned" } }
          },
          "then": {
            "properties": {
              "version": { "type": "string", "minLength": 1, "maxLength": 160 },
              "contentHash": { "$ref": "common.schema.json#/$defs/contentHash" }
            }
          }
        }
      ]
    }
  }
}
