{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cineweave.dev/contracts/workflow-plan.schema.json",
  "title": "CineWeave Workflow Plan",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "kind",
    "contractVersion",
    "workflowId",
    "status",
    "entry",
    "steps",
    "outputs",
    "executionBoundary",
    "skillReceipt"
  ],
  "properties": {
    "kind": { "const": "cineweave_codex_workflow_plan" },
    "contractVersion": { "const": "2.0.0" },
    "workflowId": { "type": "string", "minLength": 3 },
    "projectId": { "type": "string", "minLength": 1 },
    "status": { "enum": ["draft", "ready_for_specialists", "blocked", "complete"] },
    "entry": {
      "type": "object",
      "additionalProperties": false,
      "required": ["mode", "source"],
      "properties": {
        "mode": { "enum": ["zero_prompt", "quick", "guided", "professional", "studio"] },
        "source": { "enum": ["direct", "router"] },
        "creativeBriefRef": { "type": "string", "minLength": 1 }
      }
    },
    "steps": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["stepId", "skill", "route", "invocationMode", "requires", "produces"],
        "properties": {
          "stepId": { "type": "string", "minLength": 1 },
          "skill": {
            "enum": [
              "cineweave-story",
              "cineweave-character",
              "cineweave-scene",
              "cineweave-style",
              "cineweave-reference",
              "cineweave-director",
              "cineweave-prompt",
              "cineweave-production"
            ]
          },
          "route": { "type": "string", "minLength": 1 },
          "invocationMode": { "enum": ["standalone", "composed"] },
          "requires": {
            "type": "array",
            "items": { "type": "string", "minLength": 1 },
            "uniqueItems": true
          },
          "produces": {
            "type": "array",
            "minItems": 1,
            "items": { "type": "string", "minLength": 1 },
            "uniqueItems": true
          },
          "dependsOn": {
            "type": "array",
            "items": { "type": "string", "minLength": 1 },
            "uniqueItems": true
          },
          "humanGate": { "enum": ["none", "select", "approve"] }
        }
      }
    },
    "outputs": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["contractKind", "producer"],
        "properties": {
          "contractKind": { "type": "string", "minLength": 1 },
          "producer": { "type": "string", "minLength": 1 }
        }
      }
    },
    "questions": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 },
      "maxItems": 3
    },
    "warnings": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 }
    },
    "executionBoundary": {
      "type": "object",
      "additionalProperties": false,
      "required": ["generatesMedia", "requiresHumanApproval"],
      "properties": {
        "generatesMedia": { "const": false },
        "requiresHumanApproval": { "const": true }
      }
    },
    "skillReceipt": {
      "type": "object",
      "additionalProperties": false,
      "required": ["repository", "ref", "commit", "contentHash", "installedBy", "usedAt"],
      "properties": {
        "repository": { "type": "string", "format": "uri" },
        "ref": { "type": "string", "minLength": 1 },
        "commit": { "type": "string", "minLength": 1 },
        "contentHash": { "type": "string", "minLength": 1 },
        "installedBy": { "type": "string", "minLength": 1 },
        "usedAt": { "type": "string", "format": "date-time" }
      }
    }
  }
}
