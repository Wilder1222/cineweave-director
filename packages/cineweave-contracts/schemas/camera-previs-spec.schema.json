{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Wilder1222/cineweave-studio/schemas/camera-previs-spec.schema.json",
  "title": "CineWeave Director Camera Previsualization Specification",
  "description": "Optional provider-neutral camera geometry and optics handoff derived from an exact directed shot.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "kind",
    "contractVersion",
    "cameraPrevisSpecId",
    "version",
    "shotSpecRef",
    "sceneBindingRef",
    "skillReceipt",
    "coordinateSystem",
    "frameRate",
    "frameRange",
    "camera",
    "motion",
    "tracks",
    "endState",
    "executionBoundary",
    "validation",
    "provenance"
  ],
  "properties": {
    "kind": { "const": "cineweave_codex_camera_previs_spec" },
    "contractVersion": { "const": "2.5.0" },
    "cameraPrevisSpecId": { "$ref": "common.schema.json#/$defs/identifier" },
    "version": { "type": "integer", "minimum": 1 },
    "shotSpecRef": { "$ref": "#/$defs/shotSpecRef" },
    "sceneBindingRef": { "$ref": "#/$defs/sceneBindingRef" },
    "temporalSpecRef": { "$ref": "#/$defs/temporalSpecRef" },
    "skillReceipt": { "$ref": "common.schema.json#/$defs/skillReceipt" },
    "coordinateSystem": { "$ref": "#/$defs/coordinateSystem" },
    "frameRate": { "$ref": "#/$defs/frameRate" },
    "frameRange": { "$ref": "#/$defs/frameRange" },
    "camera": { "$ref": "#/$defs/camera" },
    "motion": { "$ref": "#/$defs/motion" },
    "tracks": { "$ref": "#/$defs/tracks" },
    "endState": { "type": "string", "minLength": 1, "maxLength": 1600 },
    "executionBoundary": { "$ref": "#/$defs/executionBoundary" },
    "validation": { "$ref": "#/$defs/validation" },
    "provenance": { "$ref": "common.schema.json#/$defs/provenance" }
  },
  "$defs": {
    "shotSpecRef": {
      "allOf": [
        { "$ref": "common.schema.json#/$defs/contractRef" },
        { "properties": { "kind": { "const": "cineweave_codex_shot_spec" } } }
      ]
    },
    "sceneBindingRef": {
      "allOf": [
        { "$ref": "common.schema.json#/$defs/contractRef" },
        { "properties": { "kind": { "const": "scene_binding" } } }
      ]
    },
    "temporalSpecRef": {
      "allOf": [
        { "$ref": "common.schema.json#/$defs/contractRef" },
        { "properties": { "kind": { "const": "cineweave_codex_temporal_spec" } } }
      ]
    },
    "coordinateSystem": {
      "type": "object",
      "additionalProperties": false,
      "required": ["space", "linearUnit", "upAxis", "handedness", "cameraForwardAxis", "origin"],
      "properties": {
        "space": { "const": "scene_binding_local" },
        "linearUnit": { "const": "meter" },
        "upAxis": { "enum": ["Y", "Z"] },
        "handedness": { "enum": ["right", "left"] },
        "cameraForwardAxis": { "enum": ["-Z", "+Z"] },
        "origin": { "type": "string", "minLength": 1, "maxLength": 800 }
      }
    },
    "frameRate": {
      "type": "object",
      "additionalProperties": false,
      "required": ["numerator", "denominator"],
      "properties": {
        "numerator": { "type": "integer", "minimum": 1, "maximum": 480 },
        "denominator": { "type": "integer", "minimum": 1, "maximum": 1001 }
      }
    },
    "frameRange": {
      "type": "object",
      "additionalProperties": false,
      "required": ["startFrame", "endFrame"],
      "properties": {
        "startFrame": { "type": "integer", "minimum": 0, "maximum": 1000000 },
        "endFrame": { "type": "integer", "minimum": 0, "maximum": 1000000 }
      }
    },
    "camera": {
      "type": "object",
      "additionalProperties": false,
      "required": ["projection", "filmback", "clippingRangeMeters", "shutter", "focusTarget"],
      "properties": {
        "projection": { "enum": ["perspective", "orthographic"] },
        "filmback": {
          "type": "object",
          "additionalProperties": false,
          "required": ["horizontalApertureMm", "verticalApertureMm"],
          "properties": {
            "horizontalApertureMm": { "type": "number", "exclusiveMinimum": 0, "maximum": 200 },
            "verticalApertureMm": { "type": "number", "exclusiveMinimum": 0, "maximum": 200 }
          }
        },
        "clippingRangeMeters": {
          "type": "object",
          "additionalProperties": false,
          "required": ["near", "far"],
          "properties": {
            "near": { "type": "number", "exclusiveMinimum": 0, "maximum": 100000 },
            "far": { "type": "number", "exclusiveMinimum": 0, "maximum": 100000 }
          }
        },
        "shutter": {
          "type": "object",
          "additionalProperties": false,
          "required": ["openFrameOffset", "closeFrameOffset"],
          "properties": {
            "openFrameOffset": { "type": "number", "minimum": -1, "maximum": 1 },
            "closeFrameOffset": { "type": "number", "minimum": -1, "maximum": 1 }
          }
        },
        "focusTarget": { "type": "string", "minLength": 1, "maxLength": 1000 }
      }
    },
    "motion": {
      "type": "object",
      "additionalProperties": false,
      "required": ["primaryBehavior", "components", "motivation", "framingChange"],
      "properties": {
        "primaryBehavior": {
          "enum": ["static", "dolly", "truck", "pan", "tilt", "arc", "crane", "handheld", "gimbal", "zoom", "compound"]
        },
        "components": {
          "type": "array",
          "minItems": 1,
          "maxItems": 5,
          "uniqueItems": true,
          "items": { "enum": ["translation", "rotation", "zoom", "focus_pull", "iris", "shake"] }
        },
        "motivation": { "type": "string", "minLength": 1, "maxLength": 1200 },
        "framingChange": { "type": "string", "minLength": 1, "maxLength": 1200 }
      }
    },
    "tracks": {
      "type": "object",
      "additionalProperties": false,
      "required": ["poseInterpolation", "intrinsicsInterpolation", "pose", "intrinsics"],
      "properties": {
        "poseInterpolation": { "enum": ["hold", "linear"] },
        "intrinsicsInterpolation": { "enum": ["hold", "linear"] },
        "pose": {
          "type": "array",
          "minItems": 2,
          "maxItems": 128,
          "items": { "$ref": "#/$defs/poseKeyframe" }
        },
        "intrinsics": {
          "type": "array",
          "minItems": 2,
          "maxItems": 128,
          "items": { "$ref": "#/$defs/intrinsicKeyframe" }
        }
      }
    },
    "poseKeyframe": {
      "type": "object",
      "additionalProperties": false,
      "required": ["frame", "positionMeters", "orientationQuaternion"],
      "properties": {
        "frame": { "type": "integer", "minimum": 0, "maximum": 1000000 },
        "positionMeters": { "$ref": "#/$defs/vector3" },
        "orientationQuaternion": { "$ref": "#/$defs/quaternion" }
      }
    },
    "intrinsicKeyframe": {
      "type": "object",
      "additionalProperties": false,
      "required": ["frame", "focalLengthMm", "focusDistanceMeters", "fStop"],
      "properties": {
        "frame": { "type": "integer", "minimum": 0, "maximum": 1000000 },
        "focalLengthMm": { "type": "number", "exclusiveMinimum": 0, "maximum": 2000 },
        "focusDistanceMeters": { "type": "number", "exclusiveMinimum": 0, "maximum": 100000 },
        "fStop": { "type": "number", "exclusiveMinimum": 0, "maximum": 256 }
      }
    },
    "vector3": {
      "type": "object",
      "additionalProperties": false,
      "required": ["x", "y", "z"],
      "properties": {
        "x": { "type": "number", "minimum": -100000, "maximum": 100000 },
        "y": { "type": "number", "minimum": -100000, "maximum": 100000 },
        "z": { "type": "number", "minimum": -100000, "maximum": 100000 }
      }
    },
    "quaternion": {
      "type": "object",
      "additionalProperties": false,
      "required": ["x", "y", "z", "w"],
      "properties": {
        "x": { "type": "number", "minimum": -1, "maximum": 1 },
        "y": { "type": "number", "minimum": -1, "maximum": 1 },
        "z": { "type": "number", "minimum": -1, "maximum": 1 },
        "w": { "type": "number", "minimum": -1, "maximum": 1 }
      }
    },
    "executionBoundary": {
      "type": "object",
      "additionalProperties": false,
      "required": ["providerNeutral", "generatesMedia", "executesAdapter"],
      "properties": {
        "providerNeutral": { "const": true },
        "generatesMedia": { "const": false },
        "executesAdapter": { "const": false }
      }
    },
    "validation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "exactDependencies",
        "coordinateSystemExplicit",
        "tracksSeparate",
        "keyframesOrdered",
        "motionComponentsExplicit",
        "providerNeutral",
        "noMediaGeneration"
      ],
      "properties": {
        "exactDependencies": { "const": true },
        "coordinateSystemExplicit": { "const": true },
        "tracksSeparate": { "const": true },
        "keyframesOrdered": { "const": true },
        "motionComponentsExplicit": { "const": true },
        "providerNeutral": { "const": true },
        "noMediaGeneration": { "const": true }
      }
    }
  }
}
