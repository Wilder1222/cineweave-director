{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Wilder1222/cineweave-studio/schemas/midjourney-exploration-case.schema.json",
  "title": "CineWeave Midjourney Exploration Case",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "kind",
    "contractVersion",
    "caseId",
    "version",
    "status",
    "title",
    "purpose",
    "styleProfile",
    "prompt",
    "resultImages",
    "reusePolicy",
    "rightsStatus",
    "usageBoundary",
    "validation",
    "provenance",
    "skillReceipt"
  ],
  "properties": {
    "kind": { "const": "cineweave_codex_midjourney_exploration_case" },
    "contractVersion": { "const": "1.0.0" },
    "caseId": { "$ref": "common.schema.json#/$defs/identifier" },
    "version": { "type": "integer", "minimum": 1 },
    "status": { "enum": ["draft", "reviewed", "selected", "archived"] },
    "title": { "type": "string", "minLength": 1, "maxLength": 240 },
    "purpose": { "type": "string", "minLength": 1, "maxLength": 2000 },
    "sourcePackRef": {
      "allOf": [
        { "$ref": "common.schema.json#/$defs/contractRef" },
        { "properties": { "kind": { "const": "cineweave_codex_midjourney_prompt_pack" } } }
      ]
    },
    "styleProfile": {
      "type": "object",
      "additionalProperties": false,
      "required": ["summary", "styleAtoms", "lighting", "composition", "colorMaterial"],
      "properties": {
        "summary": { "type": "string", "minLength": 1, "maxLength": 1600 },
        "styleAtoms": { "$ref": "common.schema.json#/$defs/stringList" },
        "lighting": { "$ref": "common.schema.json#/$defs/stringList" },
        "composition": { "$ref": "common.schema.json#/$defs/stringList" },
        "colorMaterial": { "$ref": "common.schema.json#/$defs/stringList" },
        "representation": { "type": "string", "maxLength": 240 }
      }
    },
    "prompt": {
      "type": "object",
      "additionalProperties": false,
      "required": ["originalText", "parameterTokens", "modelVersion", "surface"],
      "properties": {
        "originalText": { "type": "string", "minLength": 1, "maxLength": 6000 },
        "copyablePrompt": { "type": "string", "minLength": 1, "maxLength": 6000 },
        "parameterTokens": { "$ref": "common.schema.json#/$defs/stringList" },
        "modelVersion": { "type": "string", "minLength": 1, "maxLength": 40 },
        "surface": { "enum": ["web", "discord", "both", "unknown"] },
        "notes": { "$ref": "common.schema.json#/$defs/stringList" }
      }
    },
    "resultImages": {
      "type": "array",
      "minItems": 1,
      "maxItems": 8,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["resultId", "referenceAssetRef", "status", "roles", "observedStrengths", "observedRisks"],
        "properties": {
          "resultId": { "$ref": "common.schema.json#/$defs/identifier" },
          "referenceAssetRef": {
            "allOf": [
              { "$ref": "common.schema.json#/$defs/contractRef" },
              { "properties": { "kind": { "const": "cineweave_codex_reference_asset" } } }
            ]
          },
          "status": { "enum": ["candidate", "selected", "rejected"] },
          "roles": {
            "type": "array",
            "minItems": 1,
            "maxItems": 5,
            "uniqueItems": true,
            "items": { "enum": ["style_reference", "image_prompt", "omni_reference", "moodboard", "negative_example", "validation"] }
          },
          "observedStrengths": { "$ref": "common.schema.json#/$defs/stringList" },
          "observedRisks": { "$ref": "common.schema.json#/$defs/stringList" },
          "selectionNote": { "type": "string", "maxLength": 1200 }
        }
      }
    },
    "reusePolicy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["allowedRoles", "preserve", "doNotTransfer", "doNotUseFor", "requiresHumanReview"],
      "properties": {
        "allowedRoles": {
          "type": "array",
          "minItems": 1,
          "maxItems": 5,
          "uniqueItems": true,
          "items": { "enum": ["style_grammar", "prompt_pattern", "composition", "lighting", "material", "negative_example", "identity_policy"] }
        },
        "preserve": { "$ref": "common.schema.json#/$defs/stringList" },
        "doNotTransfer": { "$ref": "common.schema.json#/$defs/stringList" },
        "doNotUseFor": { "$ref": "common.schema.json#/$defs/stringList" },
        "requiresHumanReview": { "const": true }
      }
    },
    "rightsStatus": { "enum": ["confirmed", "unverified", "unknown", "restricted"] },
    "usageBoundary": { "enum": ["private_exploration_only", "internal_review", "commercial_pending", "commercial_cleared"] },
    "validation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["exactResultAssets", "sourcePromptRecorded", "resultsRoleScoped", "noImplicitCanon", "manualSelectionRecorded"],
      "properties": {
        "exactResultAssets": { "const": true },
        "sourcePromptRecorded": { "const": true },
        "resultsRoleScoped": { "const": true },
        "noImplicitCanon": { "const": true },
        "manualSelectionRecorded": { "const": true }
      }
    },
    "provenance": { "$ref": "common.schema.json#/$defs/provenance" },
    "skillReceipt": { "$ref": "common.schema.json#/$defs/skillReceipt" }
  }
}
