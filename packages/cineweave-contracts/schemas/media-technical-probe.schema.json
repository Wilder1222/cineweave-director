{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Wilder1222/cineweave-studio/schemas/media-technical-probe.schema.json",
  "title": "CineWeave Production Media Technical Probe",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "kind",
    "contractVersion",
    "mediaTechnicalProbeId",
    "version",
    "mediaImportRef",
    "mediaId",
    "mediaContentHash",
    "mediaByteSize",
    "skillReceipt",
    "probeStatus",
    "probeTool",
    "container",
    "streams",
    "executionBoundary",
    "validation",
    "provenance"
  ],
  "properties": {
    "kind": { "const": "cineweave_codex_media_technical_probe" },
    "contractVersion": { "const": "2.5.0" },
    "mediaTechnicalProbeId": { "$ref": "common.schema.json#/$defs/identifier" },
    "version": { "type": "integer", "minimum": 1 },
    "mediaImportRef": { "$ref": "#/$defs/mediaImportRef" },
    "mediaId": { "$ref": "common.schema.json#/$defs/identifier" },
    "mediaContentHash": { "$ref": "common.schema.json#/$defs/contentHash" },
    "mediaByteSize": { "type": "integer", "minimum": 1 },
    "skillReceipt": { "$ref": "common.schema.json#/$defs/skillReceipt" },
    "probeStatus": { "enum": ["planned", "recorded"] },
    "probeTool": { "$ref": "#/$defs/probeTool" },
    "container": { "$ref": "#/$defs/container" },
    "streams": { "$ref": "#/$defs/streams" },
    "executionBoundary": { "$ref": "#/$defs/executionBoundary" },
    "validation": { "$ref": "#/$defs/validation" },
    "provenance": { "$ref": "common.schema.json#/$defs/provenance" }
  },
  "$defs": {
    "mediaImportRef": {
      "allOf": [
        { "$ref": "common.schema.json#/$defs/contractRef" },
        { "properties": { "kind": { "const": "cineweave_codex_media_import" } } }
      ]
    },
    "probeTool": {
      "type": "object",
      "additionalProperties": false,
      "required": ["executionState"],
      "properties": {
        "executionState": { "enum": ["not_invoked", "ffprobe_recorded"] },
        "toolId": { "const": "ffprobe" },
        "toolVersion": { "type": "string", "minLength": 1, "maxLength": 200 },
        "commandProfile": { "const": "ffprobe_format_streams_json_v1" },
        "sanitizedReportHash": { "$ref": "common.schema.json#/$defs/contentHash" },
        "observedAt": { "type": "string", "format": "date-time" }
      },
      "allOf": [
        {
          "if": {
            "required": ["executionState"],
            "properties": { "executionState": { "const": "not_invoked" } }
          },
          "then": {
            "not": {
              "anyOf": [
                { "required": ["toolId"] },
                { "required": ["toolVersion"] },
                { "required": ["commandProfile"] },
                { "required": ["sanitizedReportHash"] },
                { "required": ["observedAt"] }
              ]
            }
          }
        },
        {
          "if": {
            "required": ["executionState"],
            "properties": { "executionState": { "const": "ffprobe_recorded" } }
          },
          "then": {
            "required": ["toolId", "toolVersion", "commandProfile", "sanitizedReportHash", "observedAt"]
          }
        }
      ]
    },
    "container": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "formatNames", "metadataExcluded"],
      "properties": {
        "status": { "enum": ["not_probed", "probed"] },
        "formatNames": {
          "type": "array",
          "maxItems": 32,
          "items": { "type": "string", "pattern": "^[A-Za-z0-9._+-]+$", "maxLength": 120 }
        },
        "startTimeSeconds": { "$ref": "#/$defs/numberMeasurement" },
        "durationSeconds": { "$ref": "#/$defs/numberMeasurement" },
        "bitRate": { "$ref": "#/$defs/integerMeasurement" },
        "reportedByteSize": { "$ref": "#/$defs/integerMeasurement" },
        "metadataExcluded": { "const": true }
      },
      "allOf": [
        {
          "if": {
            "required": ["status"],
            "properties": { "status": { "const": "not_probed" } }
          },
          "then": {
            "properties": { "formatNames": { "maxItems": 0 } },
            "not": {
              "anyOf": [
                { "required": ["startTimeSeconds"] },
                { "required": ["durationSeconds"] },
                { "required": ["bitRate"] },
                { "required": ["reportedByteSize"] }
              ]
            }
          }
        },
        {
          "if": {
            "required": ["status"],
            "properties": { "status": { "const": "probed" } }
          },
          "then": {
            "properties": { "formatNames": { "minItems": 1 } }
          }
        }
      ]
    },
    "streams": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "video", "audio", "otherStreamCount"],
      "properties": {
        "status": { "enum": ["not_probed", "probed"] },
        "video": {
          "type": "array",
          "maxItems": 32,
          "items": { "$ref": "#/$defs/videoStream" }
        },
        "audio": {
          "type": "array",
          "maxItems": 64,
          "items": { "$ref": "#/$defs/audioStream" }
        },
        "otherStreamCount": { "type": "integer", "minimum": 0, "maximum": 128 }
      },
      "allOf": [
        {
          "if": {
            "required": ["status"],
            "properties": { "status": { "const": "not_probed" } }
          },
          "then": {
            "properties": {
              "video": { "maxItems": 0 },
              "audio": { "maxItems": 0 },
              "otherStreamCount": { "const": 0 }
            }
          }
        }
      ]
    },
    "videoStream": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "streamIndex",
        "codecName",
        "codecProfile",
        "codecTag",
        "width",
        "height",
        "pixelFormat",
        "bitDepth",
        "fieldOrder",
        "sampleAspectRatio",
        "displayAspectRatio",
        "frameRate",
        "timeBase",
        "durationSeconds",
        "bitRate",
        "colorSignals"
      ],
      "properties": {
        "streamIndex": { "type": "integer", "minimum": 0 },
        "codecName": { "type": "string", "minLength": 1, "maxLength": 120 },
        "codecProfile": { "$ref": "#/$defs/stringMeasurement" },
        "codecTag": { "$ref": "#/$defs/stringMeasurement" },
        "width": { "type": "integer", "minimum": 1 },
        "height": { "type": "integer", "minimum": 1 },
        "pixelFormat": { "$ref": "#/$defs/stringMeasurement" },
        "bitDepth": { "$ref": "#/$defs/integerMeasurement" },
        "fieldOrder": { "$ref": "#/$defs/stringMeasurement" },
        "sampleAspectRatio": { "$ref": "#/$defs/rationalMeasurement" },
        "displayAspectRatio": { "$ref": "#/$defs/rationalMeasurement" },
        "frameRate": { "$ref": "#/$defs/rationalMeasurement" },
        "timeBase": { "$ref": "#/$defs/rationalMeasurement" },
        "durationSeconds": { "$ref": "#/$defs/numberMeasurement" },
        "bitRate": { "$ref": "#/$defs/integerMeasurement" },
        "colorSignals": { "$ref": "#/$defs/colorSignals" }
      }
    },
    "audioStream": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "streamIndex",
        "codecName",
        "codecProfile",
        "codecTag",
        "sampleRate",
        "channels",
        "channelLayout",
        "timeBase",
        "durationSeconds",
        "bitRate"
      ],
      "properties": {
        "streamIndex": { "type": "integer", "minimum": 0 },
        "codecName": { "type": "string", "minLength": 1, "maxLength": 120 },
        "codecProfile": { "$ref": "#/$defs/stringMeasurement" },
        "codecTag": { "$ref": "#/$defs/stringMeasurement" },
        "sampleRate": { "$ref": "#/$defs/integerMeasurement" },
        "channels": { "$ref": "#/$defs/integerMeasurement" },
        "channelLayout": { "$ref": "#/$defs/stringMeasurement" },
        "timeBase": { "$ref": "#/$defs/rationalMeasurement" },
        "durationSeconds": { "$ref": "#/$defs/numberMeasurement" },
        "bitRate": { "$ref": "#/$defs/integerMeasurement" }
      }
    },
    "stringMeasurement": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status"],
      "properties": {
        "status": { "enum": ["reported", "not_reported"] },
        "value": { "type": "string", "minLength": 1, "maxLength": 160 }
      },
      "allOf": [
        {
          "if": {
            "required": ["status"],
            "properties": { "status": { "const": "reported" } }
          },
          "then": { "required": ["value"] }
        },
        {
          "if": {
            "required": ["status"],
            "properties": { "status": { "const": "not_reported" } }
          },
          "then": { "not": { "required": ["value"] } }
        }
      ]
    },
    "integerMeasurement": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status"],
      "properties": {
        "status": { "enum": ["reported", "not_reported"] },
        "value": { "type": "integer", "minimum": 0 }
      },
      "allOf": [
        {
          "if": {
            "required": ["status"],
            "properties": { "status": { "const": "reported" } }
          },
          "then": { "required": ["value"] }
        },
        {
          "if": {
            "required": ["status"],
            "properties": { "status": { "const": "not_reported" } }
          },
          "then": { "not": { "required": ["value"] } }
        }
      ]
    },
    "numberMeasurement": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status"],
      "properties": {
        "status": { "enum": ["reported", "not_reported"] },
        "value": { "type": "number", "minimum": 0, "maximum": 86400 }
      },
      "allOf": [
        {
          "if": {
            "required": ["status"],
            "properties": { "status": { "const": "reported" } }
          },
          "then": { "required": ["value"] }
        },
        {
          "if": {
            "required": ["status"],
            "properties": { "status": { "const": "not_reported" } }
          },
          "then": { "not": { "required": ["value"] } }
        }
      ]
    },
    "rationalMeasurement": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status"],
      "properties": {
        "status": { "enum": ["reported", "not_reported"] },
        "numerator": { "type": "integer", "minimum": 0 },
        "denominator": { "type": "integer", "minimum": 1 },
        "source": { "enum": ["avg_frame_rate", "r_frame_rate", "time_base", "aspect_ratio", "not_reported"] }
      },
      "allOf": [
        {
          "if": {
            "required": ["status"],
            "properties": { "status": { "const": "reported" } }
          },
          "then": {
            "required": ["numerator", "denominator", "source"],
            "properties": { "source": { "not": { "const": "not_reported" } } }
          }
        },
        {
          "if": {
            "required": ["status"],
            "properties": { "status": { "const": "not_reported" } }
          },
          "then": {
            "required": ["source"],
            "properties": { "source": { "const": "not_reported" } },
            "not": {
              "anyOf": [
                { "required": ["numerator"] },
                { "required": ["denominator"] }
              ]
            }
          }
        }
      ]
    },
    "colorSignals": {
      "type": "object",
      "additionalProperties": false,
      "required": ["primaries", "transfer", "matrix", "range"],
      "properties": {
        "primaries": { "$ref": "#/$defs/stringMeasurement" },
        "transfer": { "$ref": "#/$defs/stringMeasurement" },
        "matrix": { "$ref": "#/$defs/stringMeasurement" },
        "range": { "$ref": "#/$defs/stringMeasurement" }
      }
    },
    "executionBoundary": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "usesLocalProbeTool",
        "callsNetwork",
        "writesSourceMedia",
        "writesDerivedMedia",
        "storesRawFilePath",
        "storesRawContainerTags",
        "humanReviewRequired"
      ],
      "properties": {
        "usesLocalProbeTool": { "const": true },
        "callsNetwork": { "const": false },
        "writesSourceMedia": { "const": false },
        "writesDerivedMedia": { "const": false },
        "storesRawFilePath": { "const": false },
        "storesRawContainerTags": { "const": false },
        "humanReviewRequired": { "const": true },
        "notes": { "type": "string", "minLength": 1, "maxLength": 1200 }
      }
    },
    "validation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "sourceBindingExact",
        "mediaHashExact",
        "probeStateConsistent",
        "missingFieldsExplicit",
        "sensitiveFieldsExcluded"
      ],
      "properties": {
        "sourceBindingExact": { "const": true },
        "mediaHashExact": { "const": true },
        "probeStateConsistent": { "const": true },
        "missingFieldsExplicit": { "const": true },
        "sensitiveFieldsExcluded": { "const": true }
      }
    }
  },
  "allOf": [
    {
      "if": {
        "required": ["probeStatus"],
        "properties": { "probeStatus": { "const": "planned" } }
      },
      "then": {
        "properties": {
          "probeTool": {
            "properties": { "executionState": { "const": "not_invoked" } }
          },
          "container": {
            "properties": { "status": { "const": "not_probed" } }
          },
          "streams": {
            "properties": { "status": { "const": "not_probed" } }
          }
        }
      }
    },
    {
      "if": {
        "required": ["probeStatus"],
        "properties": { "probeStatus": { "const": "recorded" } }
      },
      "then": {
        "properties": {
          "probeTool": {
            "properties": { "executionState": { "const": "ffprobe_recorded" } }
          },
          "container": {
            "properties": { "status": { "const": "probed" } }
          },
          "streams": {
            "properties": { "status": { "const": "probed" } }
          }
        }
      }
    }
  ]
}
