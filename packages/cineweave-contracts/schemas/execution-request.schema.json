{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Wilder1222/cineweave-studio/schemas/execution-request.schema.json",
  "title": "CineWeave Execution Request",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "kind",
    "contractVersion",
    "requestId",
    "version",
    "status",
    "createdAt",
    "skillReceipt",
    "adapterDescriptorRef",
    "capabilityProfileRef",
    "renderPlanRef",
    "promptRef",
    "operationId",
    "executionMode",
    "idempotencyKey",
    "inputArtifactRefs",
    "observationIds",
    "parameters",
    "outputRequest",
    "budget",
    "authorization",
    "preflight",
    "provenance"
  ],
  "properties": {
    "kind": { "const": "cineweave_execution_request" },
    "contractVersion": { "const": "2.3.0" },
    "requestId": { "$ref": "common.schema.json#/$defs/identifier" },
    "version": { "type": "integer", "minimum": 1 },
    "status": { "enum": ["draft", "ready", "blocked"] },
    "createdAt": { "type": "string", "format": "date-time" },
    "skillReceipt": { "$ref": "common.schema.json#/$defs/skillReceipt" },
    "adapterDescriptorRef": { "$ref": "common.schema.json#/$defs/contractRef" },
    "capabilityProfileRef": { "$ref": "common.schema.json#/$defs/contractRef" },
    "renderPlanRef": { "$ref": "common.schema.json#/$defs/contractRef" },
    "promptRef": { "$ref": "common.schema.json#/$defs/contractRef" },
    "operationId": { "$ref": "common.schema.json#/$defs/identifier" },
    "executionMode": { "enum": ["dry_run", "fixture", "external"] },
    "idempotencyKey": { "type": "string", "pattern": "^[a-z0-9][a-z0-9._:-]{7,239}$" },
    "inputArtifactRefs": {
      "type": "array",
      "maxItems": 64,
      "uniqueItems": true,
      "items": { "$ref": "common.schema.json#/$defs/contractRef" }
    },
    "workflowTemplateBinding": { "$ref": "#/$defs/workflowTemplateBinding" },
    "observationIds": {
      "type": "array",
      "maxItems": 64,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 160,
        "not": { "pattern": "(?:https?:|file:|[\\\\/?#])" }
      }
    },
    "parameters": {
      "type": "array",
      "maxItems": 48,
      "items": { "$ref": "#/$defs/parameter" }
    },
    "outputRequest": { "$ref": "#/$defs/outputRequest" },
    "budget": { "$ref": "#/$defs/budget" },
    "authorization": { "$ref": "#/$defs/authorization" },
    "preflight": { "$ref": "#/$defs/preflight" },
    "provenance": { "$ref": "common.schema.json#/$defs/provenance" }
  },
  "$defs": {
    "workflowTemplateBinding": {
      "type": "object",
      "additionalProperties": false,
      "required": ["templateProfileRef", "mode", "templateContentHash", "inputBindings", "outputSlotId"],
      "properties": {
        "templateProfileRef": {
          "allOf": [
            { "$ref": "common.schema.json#/$defs/contractRef" },
            { "properties": { "kind": { "const": "cineweave_codex_workflow_template_profile" } } }
          ]
        },
        "mode": { "enum": ["serialized", "provider_managed"] },
        "templateContentHash": { "type": ["string", "null"], "pattern": "^sha256:[0-9a-f]{64}$" },
        "inputBindings": {
          "type": "array",
          "maxItems": 64,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["slotId", "artifactRef"],
            "properties": {
              "slotId": { "$ref": "common.schema.json#/$defs/identifier" },
              "artifactRef": { "$ref": "common.schema.json#/$defs/contractRef" }
            }
          }
        },
        "outputSlotId": { "$ref": "common.schema.json#/$defs/identifier" }
      },
      "allOf": [
        {
          "if": {
            "required": ["mode"],
            "properties": { "mode": { "const": "serialized" } }
          },
          "then": {
            "properties": {
              "templateContentHash": { "$ref": "common.schema.json#/$defs/contentHash" }
            }
          },
          "else": {
            "properties": {
              "templateContentHash": { "const": null }
            }
          }
        }
      ]
    },
    "parameter": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "value", "sensitive"],
      "properties": {
        "name": { "$ref": "common.schema.json#/$defs/identifier" },
        "value": { "type": ["string", "number", "boolean", "null"], "maxLength": 1600 },
        "sensitive": { "const": false }
      }
    },
    "outputRequest": {
      "type": "object",
      "additionalProperties": false,
      "required": ["mediaKind", "acceptedMimeTypes", "variantCount", "destinationPolicy"],
      "properties": {
        "mediaKind": { "enum": ["image", "video"] },
        "acceptedMimeTypes": {
          "type": "array",
          "minItems": 1,
          "maxItems": 12,
          "uniqueItems": true,
          "items": { "type": "string", "pattern": "^[a-z0-9.+-]+/[a-z0-9.+-]+$" }
        },
        "variantCount": { "type": "integer", "minimum": 1, "maximum": 64 },
        "destinationPolicy": { "const": "project_execution_store" }
      }
    },
    "budget": {
      "type": "object",
      "additionalProperties": false,
      "required": ["currency", "maxAmount", "maxAttempts", "maxWallSeconds", "unknownCostAction"],
      "properties": {
        "currency": { "type": "string", "pattern": "^[A-Z]{3}$" },
        "maxAmount": { "type": "number", "minimum": 0 },
        "maxAttempts": { "type": "integer", "minimum": 1, "maximum": 8 },
        "maxWallSeconds": { "type": "integer", "minimum": 1, "maximum": 86400 },
        "unknownCostAction": { "const": "block" }
      }
    },
    "authorization": {
      "type": "object",
      "additionalProperties": false,
      "required": ["externalEffects", "approvalScope"],
      "properties": {
        "externalEffects": { "enum": ["denied", "exact_request_approval_required"] },
        "approvalScope": { "enum": ["none", "exact_execution_request"] }
      }
    },
    "preflight": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status",
        "exactRefsResolved",
        "operationSupported",
        "hardCapabilitiesSatisfied",
        "rightsResolved",
        "budgetResolved",
        "secretsAbsent"
      ],
      "properties": {
        "status": { "enum": ["ready", "blocked"] },
        "exactRefsResolved": { "type": "boolean" },
        "operationSupported": { "type": "boolean" },
        "hardCapabilitiesSatisfied": { "type": "boolean" },
        "rightsResolved": { "type": "boolean" },
        "budgetResolved": { "type": "boolean" },
        "secretsAbsent": { "type": "boolean" },
        "workflowTemplateResolved": { "type": "boolean" }
      }
    }
  },
  "allOf": [
    {
      "if": { "required": ["workflowTemplateBinding"] },
      "then": {
        "properties": {
          "preflight": {
            "properties": {
              "workflowTemplateResolved": { "const": true }
            }
          }
        }
      }
    }
  ]
}
