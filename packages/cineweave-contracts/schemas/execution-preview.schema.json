{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Wilder1222/cineweave-studio/schemas/execution-preview.schema.json",
  "title": "CineWeave Execution Preview",
  "description": "A human-readable, exact-request preview shown before any adapter spend or external effect. It records risks and budget visibility without approving or executing the request.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "kind",
    "contractVersion",
    "previewId",
    "version",
    "status",
    "executionRequestRef",
    "capabilityResolutionPlanRef",
    "adapterDescriptorRef",
    "capabilityProfileRef",
    "requestSummary",
    "requirementsSummary",
    "costEstimate",
    "riskSummary",
    "approval",
    "executionBoundary",
    "validation",
    "skillReceipt",
    "provenance"
  ],
  "properties": {
    "kind": { "const": "cineweave_codex_execution_preview" },
    "contractVersion": { "const": "2.5.0" },
    "previewId": { "$ref": "common.schema.json#/$defs/identifier" },
    "version": { "type": "integer", "minimum": 1 },
    "status": { "enum": ["ready", "needs_review", "blocked"] },
    "executionRequestRef": { "$ref": "#/$defs/executionRequestRef" },
    "capabilityResolutionPlanRef": { "$ref": "#/$defs/resolutionRef" },
    "adapterDescriptorRef": { "$ref": "#/$defs/adapterRef" },
    "capabilityProfileRef": { "$ref": "#/$defs/capabilityRef" },
    "requestSummary": { "$ref": "#/$defs/requestSummary" },
    "requirementsSummary": { "$ref": "#/$defs/requirementsSummary" },
    "costEstimate": { "$ref": "#/$defs/costEstimate" },
    "riskSummary": {
      "type": "array",
      "minItems": 1,
      "maxItems": 24,
      "items": { "$ref": "#/$defs/risk" }
    },
    "approval": { "$ref": "#/$defs/approval" },
    "executionBoundary": { "$ref": "#/$defs/executionBoundary" },
    "validation": { "$ref": "#/$defs/validation" },
    "skillReceipt": { "$ref": "common.schema.json#/$defs/skillReceipt" },
    "provenance": { "$ref": "common.schema.json#/$defs/provenance" }
  },
  "$defs": {
    "exactRef": { "$ref": "common.schema.json#/$defs/contractRef" },
    "executionRequestRef": {
      "allOf": [
        { "$ref": "#/$defs/exactRef" },
        { "properties": { "kind": { "const": "cineweave_execution_request" } } }
      ]
    },
    "resolutionRef": {
      "allOf": [
        { "$ref": "#/$defs/exactRef" },
        { "properties": { "kind": { "const": "cineweave_codex_capability_resolution_plan" } } }
      ]
    },
    "adapterRef": {
      "allOf": [
        { "$ref": "#/$defs/exactRef" },
        { "properties": { "kind": { "const": "cineweave_adapter_descriptor" } } }
      ]
    },
    "capabilityRef": {
      "allOf": [
        { "$ref": "#/$defs/exactRef" },
        { "properties": { "kind": { "const": "cineweave_codex_capability_profile" } } }
      ]
    },
    "requestSummary": {
      "type": "object",
      "additionalProperties": false,
      "required": ["operationId", "executionMode", "renderMode", "mediaKind", "variantCount", "inputCount", "currency", "maxAmount", "maxAttempts", "maxWallSeconds"],
      "properties": {
        "operationId": { "$ref": "common.schema.json#/$defs/identifier" },
        "executionMode": { "enum": ["dry_run", "fixture", "external"] },
        "renderMode": { "enum": ["generate", "edit", "inpaint", "multi_reference"] },
        "mediaKind": { "enum": ["image", "video"] },
        "variantCount": { "type": "integer", "minimum": 1, "maximum": 64 },
        "inputCount": { "type": "integer", "minimum": 0, "maximum": 64 },
        "currency": { "type": "string", "pattern": "^[A-Z]{3}$" },
        "maxAmount": { "type": "number", "minimum": 0 },
        "maxAttempts": { "type": "integer", "minimum": 1, "maximum": 8 },
        "maxWallSeconds": { "type": "integer", "minimum": 1, "maximum": 86400 }
      }
    },
    "requirementsSummary": {
      "type": "object",
      "additionalProperties": false,
      "required": ["hard", "soft", "advisory", "hardSatisfied"],
      "properties": {
        "hard": { "type": "integer", "minimum": 0, "maximum": 48 },
        "soft": { "type": "integer", "minimum": 0, "maximum": 48 },
        "advisory": { "type": "integer", "minimum": 0, "maximum": 48 },
        "hardSatisfied": { "type": "boolean" }
      }
    },
    "costEstimate": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "currency", "amount", "maximumAmount", "basis", "attemptsIncluded", "unknownCostAction"],
      "properties": {
        "status": { "enum": ["exact", "bounded", "unknown"] },
        "currency": { "type": "string", "pattern": "^[A-Z]{3}$" },
        "amount": { "type": ["number", "null"], "minimum": 0 },
        "maximumAmount": { "type": "number", "minimum": 0 },
        "basis": { "type": "string", "minLength": 1, "maxLength": 800 },
        "attemptsIncluded": { "type": "integer", "minimum": 1, "maximum": 8 },
        "unknownCostAction": { "const": "block" }
      }
    },
    "risk": {
      "type": "object",
      "additionalProperties": false,
      "required": ["riskId", "severity", "status", "message"],
      "properties": {
        "riskId": { "$ref": "common.schema.json#/$defs/identifier" },
        "severity": { "enum": ["hard", "soft", "advisory"] },
        "status": { "enum": ["pass", "review", "block", "info"] },
        "message": { "type": "string", "minLength": 1, "maxLength": 800 }
      }
    },
    "approval": {
      "type": "object",
      "additionalProperties": false,
      "required": ["required", "status", "scope", "action"],
      "properties": {
        "required": { "const": true },
        "status": { "const": "pending" },
        "scope": { "enum": ["exact_execution_request", "none"] },
        "action": { "const": "approve_exact_request" }
      }
    },
    "executionBoundary": {
      "type": "object",
      "additionalProperties": false,
      "required": ["providerNeutral", "generatesMedia", "executesAdapter", "mutatesCanon", "writesFiles", "humanApprovalRequired"],
      "properties": {
        "providerNeutral": { "const": true },
        "generatesMedia": { "const": false },
        "executesAdapter": { "const": false },
        "mutatesCanon": { "const": false },
        "writesFiles": { "const": false },
        "humanApprovalRequired": { "const": true },
        "notes": { "type": "string", "maxLength": 1600 }
      }
    },
    "validation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["exactRequestRef", "exactResolutionRef", "selectedAdapterMatches", "hardConstraintsVisible", "costVisible", "approvalPending", "noExecution"],
      "properties": {
        "exactRequestRef": { "const": true },
        "exactResolutionRef": { "const": true },
        "selectedAdapterMatches": { "const": true },
        "hardConstraintsVisible": { "const": true },
        "costVisible": { "const": true },
        "approvalPending": { "const": true },
        "noExecution": { "const": true }
      }
    }
  }
}
