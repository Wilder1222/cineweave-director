{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Wilder1222/cineweave-studio/schemas/temporal-spec.schema.json",
  "title": "CineWeave Director Temporal Specification",
  "type": "object",
  "additionalProperties": false,
  "required": ["kind", "contractVersion", "temporalSpecId", "version", "shotSpecRef", "durationSeconds", "skillReceipt", "cameraMotion", "focusTimeline", "actionTimeline", "secondaryMotion", "dynamicLighting", "edit", "videoSafeConstraints", "endState", "validation"],
  "properties": {
    "kind": { "const": "cineweave_codex_temporal_spec" },
    "contractVersion": { "const": "2.2.0" },
    "temporalSpecId": { "$ref": "common.schema.json#/$defs/identifier" },
    "version": { "type": "integer", "minimum": 1 },
    "shotSpecRef": { "$ref": "common.schema.json#/$defs/contractRef" },
    "heroFrameAnchorRef": {
      "allOf": [
        { "$ref": "common.schema.json#/$defs/contractRef" },
        { "properties": { "kind": { "const": "cineweave_codex_hero_frame_anchor" } } }
      ],
      "description": "Optional exact visual anchor for the first frame; it carries visual DNA into temporal direction without changing the shot dependency."
    },
    "durationSeconds": { "type": "number", "exclusiveMinimum": 0, "maximum": 300 },
    "skillReceipt": { "$ref": "common.schema.json#/$defs/skillReceipt" },
    "cameraMotion": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "motivation", "path", "start", "acceleration", "peak", "deceleration", "end", "framingChange"],
      "properties": {
        "type": { "enum": ["static", "dolly", "truck", "pan", "tilt", "arc", "crane", "handheld", "gimbal", "compound"] },
        "motivation": { "type": "string", "minLength": 1, "maxLength": 800 },
        "path": { "type": "string", "minLength": 1, "maxLength": 800 },
        "start": { "type": "string", "minLength": 1, "maxLength": 600 },
        "acceleration": { "type": "string", "minLength": 1, "maxLength": 600 },
        "peak": { "type": "string", "minLength": 1, "maxLength": 600 },
        "deceleration": { "type": "string", "minLength": 1, "maxLength": 600 },
        "end": { "type": "string", "minLength": 1, "maxLength": 600 },
        "framingChange": { "type": "string", "minLength": 1, "maxLength": 800 }
      }
    },
    "focusTimeline": {
      "type": "array",
      "minItems": 1,
      "maxItems": 16,
      "items": { "$ref": "#/$defs/timedEvent" }
    },
    "actionTimeline": {
      "type": "array",
      "minItems": 1,
      "maxItems": 32,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["eventId", "timeSeconds", "ownerRef", "trigger", "action", "resultingState"],
        "properties": {
          "eventId": { "$ref": "common.schema.json#/$defs/identifier" },
          "timeSeconds": { "type": "number", "minimum": 0 },
          "ownerRef": { "type": "string", "minLength": 1, "maxLength": 240 },
          "trigger": { "type": "string", "minLength": 1, "maxLength": 800 },
          "action": { "type": "string", "minLength": 1, "maxLength": 1200 },
          "resultingState": { "type": "string", "minLength": 1, "maxLength": 1000 }
        }
      }
    },
    "secondaryMotion": { "$ref": "common.schema.json#/$defs/stringList" },
    "dynamicLighting": {
      "type": "array",
      "maxItems": 16,
      "items": { "$ref": "#/$defs/timedEvent" }
    },
    "edit": {
      "type": "object",
      "additionalProperties": false,
      "required": ["entry", "exit", "preferredTransition", "soundBridge"],
      "properties": {
        "entry": { "type": "string", "minLength": 1, "maxLength": 800 },
        "exit": { "type": "string", "minLength": 1, "maxLength": 800 },
        "preferredTransition": { "type": "string", "minLength": 1, "maxLength": 500 },
        "soundBridge": { "type": "string", "minLength": 1, "maxLength": 800 }
      }
    },
    "videoSafeConstraints": { "$ref": "common.schema.json#/$defs/stringList" },
    "endState": { "type": "string", "minLength": 1, "maxLength": 1200 },
    "validation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["eventsOrdered", "withinDuration", "cameraMotivated", "actionCausal", "endStateStable", "visualTemporalSeparated"],
      "properties": {
        "eventsOrdered": { "const": true },
        "withinDuration": { "const": true },
        "cameraMotivated": { "const": true },
        "actionCausal": { "const": true },
        "endStateStable": { "const": true },
        "visualTemporalSeparated": { "const": true }
      }
    }
  },
  "$defs": {
    "timedEvent": {
      "type": "object",
      "additionalProperties": false,
      "required": ["eventId", "timeSeconds", "description"],
      "properties": {
        "eventId": { "$ref": "common.schema.json#/$defs/identifier" },
        "timeSeconds": { "type": "number", "minimum": 0 },
        "description": { "type": "string", "minLength": 1, "maxLength": 1000 }
      }
    }
  }
}
