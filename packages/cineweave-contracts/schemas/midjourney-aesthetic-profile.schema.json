{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Wilder1222/cineweave-studio/schemas/midjourney-aesthetic-profile.schema.json",
  "title": "CineWeave Midjourney Aesthetic Profile",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "kind",
    "contractVersion",
    "profileId",
    "version",
    "status",
    "title",
    "profileType",
    "scope",
    "curation",
    "providerProjection",
    "visualPolicy",
    "rightsStatus",
    "usageBoundary",
    "validation",
    "provenance",
    "skillReceipt"
  ],
  "properties": {
    "kind": { "const": "cineweave_codex_midjourney_aesthetic_profile" },
    "contractVersion": { "const": "1.0.0" },
    "profileId": { "$ref": "common.schema.json#/$defs/identifier" },
    "version": { "type": "integer", "minimum": 1 },
    "status": { "enum": ["draft", "active", "archived"] },
    "title": { "type": "string", "minLength": 1, "maxLength": 240 },
    "profileType": { "enum": ["moodboard", "personalization_profile"] },
    "scope": { "enum": ["creator_baseline", "world_visual_bible", "project_domain", "shot_experiment"] },
    "curation": { "$ref": "#/$defs/curation" },
    "providerProjection": { "$ref": "#/$defs/providerProjection" },
    "visualPolicy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["preserve", "doNotTransfer", "doesNotDefineIdentity", "doesNotReplaceVisualBible"],
      "properties": {
        "preserve": { "$ref": "common.schema.json#/$defs/stringList" },
        "doNotTransfer": { "$ref": "common.schema.json#/$defs/stringList" },
        "doesNotDefineIdentity": { "const": true },
        "doesNotReplaceVisualBible": { "const": true }
      }
    },
    "rightsStatus": { "enum": ["confirmed", "unverified", "unknown", "restricted"] },
    "usageBoundary": { "enum": ["private_exploration_only", "internal_review", "commercial_pending", "commercial_cleared"] },
    "validation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["curationInputsRecorded", "profileSnapshotPolicyExplicit", "layersSeparated", "noImplicitDefaultActivation", "noPrivateLocators", "humanReviewRequired"],
      "properties": {
        "curationInputsRecorded": { "const": true },
        "profileSnapshotPolicyExplicit": { "const": true },
        "layersSeparated": { "const": true },
        "noImplicitDefaultActivation": { "const": true },
        "noPrivateLocators": { "const": true },
        "humanReviewRequired": { "const": true }
      }
    },
    "provenance": { "$ref": "common.schema.json#/$defs/provenance" },
    "skillReceipt": { "$ref": "common.schema.json#/$defs/skillReceipt" }
  },
  "$defs": {
    "providerToken": {
      "type": ["string", "null"],
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{1,239}$"
    },
    "curation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["method", "referenceAssetRefs", "explorationCaseRefs", "selectionCriteria", "exclude", "humanReviewRequired"],
      "properties": {
        "method": { "enum": ["curated_images", "selection_history"] },
        "referenceAssetRefs": {
          "type": "array",
          "maxItems": 64,
          "uniqueItems": true,
          "items": {
            "allOf": [
              { "$ref": "common.schema.json#/$defs/contractRef" },
              { "properties": { "kind": { "const": "cineweave_codex_reference_asset" } } }
            ]
          }
        },
        "explorationCaseRefs": {
          "type": "array",
          "maxItems": 32,
          "uniqueItems": true,
          "items": {
            "allOf": [
              { "$ref": "common.schema.json#/$defs/contractRef" },
              { "properties": { "kind": { "const": "cineweave_codex_midjourney_exploration_case" } } }
            ]
          }
        },
        "selectionCriteria": { "$ref": "common.schema.json#/$defs/stringList" },
        "exclude": { "$ref": "common.schema.json#/$defs/stringList" },
        "humanReviewRequired": { "const": true }
      }
    },
    "providerProjection": {
      "type": "object",
      "additionalProperties": false,
      "required": ["providerProfileId", "latestKnownCode", "recordResolvedCodeAfterRun", "requiresExplicitPromptToken", "modelCompatibility", "stylizeGuidance"],
      "properties": {
        "providerProfileId": { "$ref": "#/$defs/providerToken" },
        "latestKnownCode": { "$ref": "#/$defs/providerToken" },
        "recordResolvedCodeAfterRun": { "const": true },
        "requiresExplicitPromptToken": { "const": true },
        "modelCompatibility": {
          "type": "object",
          "additionalProperties": false,
          "required": ["knownCompatibleVersions", "reverifyBeforeUse"],
          "properties": {
            "knownCompatibleVersions": {
              "type": "array",
              "minItems": 1,
              "maxItems": 12,
              "uniqueItems": true,
              "items": { "type": "string", "minLength": 1, "maxLength": 40 }
            },
            "reverifyBeforeUse": { "const": true }
          }
        },
        "stylizeGuidance": {
          "type": "object",
          "additionalProperties": false,
          "required": ["minimum", "maximum", "defaultValue", "recommendedValues"],
          "properties": {
            "minimum": { "const": 0 },
            "maximum": { "const": 1000 },
            "defaultValue": { "type": "integer", "minimum": 0, "maximum": 1000 },
            "recommendedValues": {
              "type": "array",
              "minItems": 1,
              "maxItems": 8,
              "uniqueItems": true,
              "items": { "type": "integer", "minimum": 0, "maximum": 1000 }
            }
          }
        }
      }
    }
  },
  "allOf": [
    {
      "if": {
        "required": ["profileType"],
        "properties": { "profileType": { "const": "moodboard" } }
      },
      "then": {
        "properties": {
          "curation": {
            "properties": {
              "method": { "const": "curated_images" },
              "referenceAssetRefs": { "minItems": 1 }
            }
          }
        }
      },
      "else": {
        "properties": {
          "curation": {
            "properties": {
              "method": { "const": "selection_history" }
            }
          }
        }
      }
    },
    {
      "if": {
        "required": ["status"],
        "properties": { "status": { "const": "active" } }
      },
      "then": {
        "properties": {
          "providerProjection": {
            "anyOf": [
              { "properties": { "providerProfileId": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{1,239}$" } } },
              { "properties": { "latestKnownCode": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{1,239}$" } } }
            ]
          }
        }
      }
    }
  ]
}
