{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Wilder1222/cineweave-studio/schemas/content-credential-inspection.schema.json",
  "title": "CineWeave Reference Content Credential Inspection",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "kind",
    "contractVersion",
    "contentCredentialInspectionId",
    "version",
    "referenceAssetRef",
    "assetByteHash",
    "skillReceipt",
    "inspectionStatus",
    "validator",
    "manifestStore",
    "result",
    "executionBoundary",
    "validation",
    "provenance"
  ],
  "properties": {
    "kind": { "const": "cineweave_codex_content_credential_inspection" },
    "contractVersion": { "const": "2.5.0" },
    "contentCredentialInspectionId": { "$ref": "common.schema.json#/$defs/identifier" },
    "version": { "type": "integer", "minimum": 1 },
    "referenceAssetRef": { "$ref": "#/$defs/referenceAssetRef" },
    "assetByteHash": { "$ref": "common.schema.json#/$defs/contentHash" },
    "skillReceipt": { "$ref": "common.schema.json#/$defs/skillReceipt" },
    "inspectionStatus": { "enum": ["planned", "recorded"] },
    "validator": { "$ref": "#/$defs/validator" },
    "manifestStore": { "$ref": "#/$defs/manifestStore" },
    "result": { "$ref": "#/$defs/result" },
    "executionBoundary": { "$ref": "#/$defs/executionBoundary" },
    "validation": { "$ref": "#/$defs/validation" },
    "provenance": { "$ref": "common.schema.json#/$defs/provenance" }
  },
  "$defs": {
    "referenceAssetRef": {
      "allOf": [
        { "$ref": "common.schema.json#/$defs/contractRef" },
        { "properties": { "kind": { "const": "cineweave_codex_reference_asset" } } }
      ]
    },
    "validator": {
      "type": "object",
      "additionalProperties": false,
      "required": ["executionState"],
      "properties": {
        "executionState": { "enum": ["not_invoked", "external_report_recorded"] },
        "validatorId": { "$ref": "common.schema.json#/$defs/identifier" },
        "validatorVersion": { "type": "string", "minLength": 1, "maxLength": 120 },
        "reportHash": { "$ref": "common.schema.json#/$defs/contentHash" },
        "recordedAt": { "type": "string", "format": "date-time" }
      },
      "allOf": [
        {
          "if": {
            "required": ["executionState"],
            "properties": { "executionState": { "const": "not_invoked" } }
          },
          "then": {
            "not": {
              "anyOf": [
                { "required": ["validatorId"] },
                { "required": ["validatorVersion"] },
                { "required": ["reportHash"] },
                { "required": ["recordedAt"] }
              ]
            }
          }
        },
        {
          "if": {
            "required": ["executionState"],
            "properties": { "executionState": { "const": "external_report_recorded" } }
          },
          "then": {
            "required": ["validatorId", "validatorVersion", "reportHash", "recordedAt"]
          }
        }
      ]
    },
    "manifestStore": {
      "type": "object",
      "additionalProperties": false,
      "required": ["inspectionState"],
      "properties": {
        "inspectionState": { "enum": ["not_inspected", "absent", "present"] },
        "manifestCount": { "type": "integer", "minimum": 0, "maximum": 1024 },
        "activeManifestLabel": { "type": "string", "minLength": 1, "maxLength": 500 },
        "activeManifestHash": { "$ref": "common.schema.json#/$defs/contentHash" },
        "specVersion": { "type": "string", "minLength": 1, "maxLength": 80 }
      },
      "allOf": [
        {
          "if": {
            "required": ["inspectionState"],
            "properties": { "inspectionState": { "const": "not_inspected" } }
          },
          "then": {
            "not": {
              "anyOf": [
                { "required": ["manifestCount"] },
                { "required": ["activeManifestLabel"] },
                { "required": ["activeManifestHash"] },
                { "required": ["specVersion"] }
              ]
            }
          }
        },
        {
          "if": {
            "required": ["inspectionState"],
            "properties": { "inspectionState": { "const": "absent" } }
          },
          "then": {
            "required": ["manifestCount"],
            "properties": { "manifestCount": { "const": 0 } },
            "not": {
              "anyOf": [
                { "required": ["activeManifestLabel"] },
                { "required": ["activeManifestHash"] },
                { "required": ["specVersion"] }
              ]
            }
          }
        },
        {
          "if": {
            "required": ["inspectionState"],
            "properties": { "inspectionState": { "const": "present" } }
          },
          "then": {
            "required": ["manifestCount", "activeManifestLabel", "activeManifestHash", "specVersion"],
            "properties": { "manifestCount": { "minimum": 1 } }
          }
        }
      ]
    },
    "checkState": {
      "enum": ["not_checked", "not_applicable", "pass", "fail", "indeterminate"]
    },
    "result": {
      "type": "object",
      "additionalProperties": false,
      "required": ["validationState", "signerTrust", "checks", "successCodes", "failureCodes", "rightsConclusion", "truthConclusion"],
      "properties": {
        "validationState": { "enum": ["not_checked", "absent", "well_formed", "valid", "trusted", "invalid", "indeterminate"] },
        "signerTrust": { "enum": ["not_checked", "unknown", "untrusted", "valid_untrusted_signer", "trusted"] },
        "checks": {
          "type": "object",
          "additionalProperties": false,
          "required": ["assertions", "claimSignature", "hardBinding", "ingredients", "timestamp", "credentialRevocation", "assetContent"],
          "properties": {
            "assertions": { "$ref": "#/$defs/checkState" },
            "claimSignature": { "$ref": "#/$defs/checkState" },
            "hardBinding": { "$ref": "#/$defs/checkState" },
            "ingredients": { "$ref": "#/$defs/checkState" },
            "timestamp": { "$ref": "#/$defs/checkState" },
            "credentialRevocation": { "$ref": "#/$defs/checkState" },
            "assetContent": { "$ref": "#/$defs/checkState" }
          }
        },
        "successCodes": {
          "type": "array",
          "maxItems": 256,
          "items": { "type": "string", "pattern": "^[A-Za-z][A-Za-z0-9_-]*(?:\\.[A-Za-z][A-Za-z0-9_-]*)+$", "maxLength": 240 }
        },
        "failureCodes": {
          "type": "array",
          "maxItems": 256,
          "items": { "type": "string", "pattern": "^[A-Za-z][A-Za-z0-9_-]*(?:\\.[A-Za-z][A-Za-z0-9_-]*)+$", "maxLength": 240 }
        },
        "rightsConclusion": { "const": "not_determined" },
        "truthConclusion": { "const": "not_determined" }
      }
    },
    "executionBoundary": {
      "type": "object",
      "additionalProperties": false,
      "required": ["providerNeutral", "runsValidator", "writesMedia", "writesManifest", "humanReviewRequired"],
      "properties": {
        "providerNeutral": { "const": true },
        "runsValidator": { "const": false },
        "writesMedia": { "const": false },
        "writesManifest": { "const": false },
        "humanReviewRequired": { "const": true },
        "notes": { "type": "string", "minLength": 1, "maxLength": 1200 }
      }
    },
    "validation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["assetByteBindingExact", "statusConsistent", "c2paScopeOnly", "rightsSeparate", "truthSeparate", "noValidatorExecutionClaim"],
      "properties": {
        "assetByteBindingExact": { "const": true },
        "statusConsistent": { "const": true },
        "c2paScopeOnly": { "const": true },
        "rightsSeparate": { "const": true },
        "truthSeparate": { "const": true },
        "noValidatorExecutionClaim": { "const": true }
      }
    }
  }
}
