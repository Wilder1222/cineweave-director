{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Wilder1222/cineweave-studio/schemas/skill-evaluation-run.schema.json",
  "title": "CineWeave Skill Evaluation Run",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "kind",
    "contractVersion",
    "runId",
    "runnerVersion",
    "suiteVersion",
    "mode",
    "startedAt",
    "finishedAt",
    "dataset",
    "environment",
    "results",
    "summary",
    "privacy",
    "reproducibility"
  ],
  "properties": {
    "kind": { "const": "cineweave_skill_evaluation_run" },
    "contractVersion": { "const": "2.3.0" },
    "runId": { "$ref": "common.schema.json#/$defs/identifier" },
    "runnerVersion": { "enum": ["1.0.0", "1.1.0"] },
    "suiteVersion": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$" },
    "mode": { "enum": ["fixture_replay", "live_codex"] },
    "startedAt": { "type": "string", "format": "date-time" },
    "finishedAt": { "type": "string", "format": "date-time" },
    "dataset": { "$ref": "#/$defs/dataset" },
    "environment": { "$ref": "#/$defs/environment" },
    "results": {
      "type": "array",
      "minItems": 1,
      "maxItems": 128,
      "items": { "$ref": "#/$defs/caseResult" }
    },
    "summary": { "$ref": "#/$defs/summary" },
    "privacy": { "$ref": "#/$defs/privacy" },
    "reproducibility": { "$ref": "#/$defs/reproducibility" }
  },
  "$defs": {
    "dataset": {
      "type": "object",
      "additionalProperties": false,
      "required": ["datasetId", "contentHash", "caseIds"],
      "properties": {
        "datasetId": { "$ref": "common.schema.json#/$defs/identifier" },
        "contentHash": { "$ref": "common.schema.json#/$defs/contentHash" },
        "caseIds": {
          "type": "array",
          "minItems": 1,
          "maxItems": 128,
          "uniqueItems": true,
          "items": { "$ref": "common.schema.json#/$defs/identifier" }
        }
      }
    },
    "environment": {
      "type": "object",
      "additionalProperties": false,
      "required": ["platform", "nodeVersion", "codexVersion", "model", "pluginVersion", "pluginSourceRef", "gitCommit", "sandbox"],
      "properties": {
        "platform": { "enum": ["win32", "linux", "darwin", "other"] },
        "nodeVersion": { "type": "string", "minLength": 1, "maxLength": 80 },
        "codexVersion": { "type": ["string", "null"], "maxLength": 120 },
        "model": { "type": ["string", "null"], "maxLength": 120 },
        "pluginVersion": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$" },
        "pluginSourceRef": { "type": ["string", "null"], "maxLength": 120 },
        "gitCommit": { "type": "string", "pattern": "^[0-9a-f]{7,64}$" },
        "sandbox": { "enum": ["read-only", "fixture-replay"] }
      }
    },
    "checkResult": {
      "type": "object",
      "additionalProperties": false,
      "required": ["checkId", "scope", "status", "message"],
      "properties": {
        "checkId": { "$ref": "common.schema.json#/$defs/identifier" },
        "scope": { "enum": ["activation", "output", "safety"] },
        "status": { "enum": ["pass", "fail"] },
        "message": { "type": "string", "minLength": 1, "maxLength": 800 }
      }
    },
    "caseResult": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "caseId",
        "status",
        "selectedSkill",
        "route",
        "responseHash",
        "transcriptRef",
        "checks",
        "errors"
      ],
      "properties": {
        "caseId": { "$ref": "common.schema.json#/$defs/identifier" },
        "status": { "enum": ["pass", "fail", "error"] },
        "selectedSkill": { "type": ["string", "null"], "maxLength": 160 },
        "route": { "type": ["string", "null"], "maxLength": 160 },
        "responseHash": {
          "type": ["string", "null"],
          "pattern": "^sha256:[0-9a-f]{64}$"
        },
        "transcriptRef": {
          "type": ["string", "null"],
          "pattern": "^[a-z0-9][a-z0-9._-]{1,159}\\.(?:events\\.jsonl|stderr\\.txt)$"
        },
        "checks": {
          "type": "array",
          "maxItems": 32,
          "items": { "$ref": "#/$defs/checkResult" }
        },
        "errors": {
          "type": "array",
          "maxItems": 16,
          "items": { "type": "string", "minLength": 1, "maxLength": 1200 }
        }
      }
    },
    "summary": {
      "type": "object",
      "additionalProperties": false,
      "required": ["total", "passed", "failed", "errors", "activationPassRate", "outputPassRate", "releaseGatePassed"],
      "properties": {
        "total": { "type": "integer", "minimum": 1 },
        "passed": { "type": "integer", "minimum": 0 },
        "failed": { "type": "integer", "minimum": 0 },
        "errors": { "type": "integer", "minimum": 0 },
        "activationPassRate": { "type": "number", "minimum": 0, "maximum": 1 },
        "outputPassRate": { "type": "number", "minimum": 0, "maximum": 1 },
        "releaseGatePassed": { "type": "boolean" }
      }
    },
    "privacy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["syntheticInputsOnly", "userAssetsIncluded", "secretsScanned", "rawResponsePolicy"],
      "properties": {
        "syntheticInputsOnly": { "const": true },
        "userAssetsIncluded": { "const": false },
        "secretsScanned": { "const": true },
        "rawResponsePolicy": { "enum": ["local_uncommitted", "discarded"] }
      }
    },
    "reproducibility": {
      "type": "object",
      "additionalProperties": false,
      "required": ["command", "caseOrderStable", "graderDeterministic"],
      "properties": {
        "command": { "type": "string", "minLength": 1, "maxLength": 800 },
        "caseOrderStable": { "const": true },
        "graderDeterministic": { "const": true }
      }
    }
  }
}
