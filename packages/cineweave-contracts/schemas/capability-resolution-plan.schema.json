{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Wilder1222/cineweave-studio/schemas/capability-resolution-plan.schema.json",
  "title": "CineWeave Explainable Capability Resolution Plan",
  "description": "A deterministic, provider-neutral comparison of exact CapabilityProfile and AdapterDescriptor candidates. It may recommend an adapter surface but never executes it or grants approval.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "kind",
    "contractVersion",
    "resolutionPlanId",
    "version",
    "status",
    "request",
    "candidates",
    "selection",
    "explanation",
    "executionBoundary",
    "validation",
    "skillReceipt",
    "provenance"
  ],
  "properties": {
    "kind": { "const": "cineweave_codex_capability_resolution_plan" },
    "contractVersion": { "const": "2.5.0" },
    "resolutionPlanId": { "$ref": "common.schema.json#/$defs/identifier" },
    "version": { "type": "integer", "minimum": 1 },
    "status": { "enum": ["selected", "needs_review", "blocked"] },
    "request": { "$ref": "#/$defs/request" },
    "candidates": {
      "type": "array",
      "minItems": 1,
      "maxItems": 32,
      "items": { "$ref": "#/$defs/candidate" }
    },
    "selection": { "$ref": "#/$defs/selection" },
    "explanation": { "$ref": "#/$defs/explanation" },
    "executionBoundary": { "$ref": "#/$defs/executionBoundary" },
    "validation": { "$ref": "#/$defs/validation" },
    "skillReceipt": { "$ref": "common.schema.json#/$defs/skillReceipt" },
    "provenance": { "$ref": "common.schema.json#/$defs/provenance" }
  },
  "$defs": {
    "exactCapabilityRef": {
      "allOf": [
        { "$ref": "common.schema.json#/$defs/contractRef" },
        { "properties": { "kind": { "const": "cineweave_codex_capability_profile" } } }
      ]
    },
    "exactAdapterRef": {
      "allOf": [
        { "$ref": "common.schema.json#/$defs/contractRef" },
        { "properties": { "kind": { "const": "cineweave_adapter_descriptor" } } }
      ]
    },
    "request": {
      "type": "object",
      "additionalProperties": false,
      "required": ["operationId", "renderMode", "executionMode", "mediaKind", "inputCount", "outputCount", "acceptedMimeTypes", "requirements"],
      "properties": {
        "operationId": { "$ref": "common.schema.json#/$defs/identifier" },
        "renderMode": { "enum": ["generate", "edit", "inpaint", "multi_reference"] },
        "executionMode": { "enum": ["dry_run", "fixture", "external"] },
        "mediaKind": { "enum": ["image", "video"] },
        "inputCount": { "type": "integer", "minimum": 0, "maximum": 64 },
        "outputCount": { "type": "integer", "minimum": 1, "maximum": 64 },
        "acceptedMimeTypes": {
          "type": "array",
          "minItems": 1,
          "maxItems": 12,
          "uniqueItems": true,
          "items": { "type": "string", "pattern": "^[a-z0-9.+-]+/[a-z0-9.+-]+$" }
        },
        "requirements": {
          "type": "array",
          "minItems": 1,
          "maxItems": 32,
          "items": { "$ref": "#/$defs/requirement" }
        }
      }
    },
    "requirement": {
      "type": "object",
      "additionalProperties": false,
      "required": ["requirementId", "capabilityId", "level", "reason"],
      "properties": {
        "requirementId": { "$ref": "common.schema.json#/$defs/identifier" },
        "capabilityId": { "$ref": "common.schema.json#/$defs/identifier" },
        "level": { "enum": ["hard", "soft", "advisory"] },
        "scope": { "type": "string", "minLength": 1, "maxLength": 160 },
        "reason": { "type": "string", "minLength": 1, "maxLength": 800 }
      }
    },
    "operationSupport": {
      "type": "object",
      "additionalProperties": false,
      "required": ["operationId", "status", "executionMode", "renderMode", "mediaKind", "inputCapacity", "outputCapacity", "mimeTypes"],
      "properties": {
        "operationId": { "$ref": "common.schema.json#/$defs/identifier" },
        "status": { "enum": ["pass", "fail"] },
        "executionMode": { "type": "boolean" },
        "renderMode": { "type": "boolean" },
        "mediaKind": { "type": "boolean" },
        "inputCapacity": { "type": "boolean" },
        "outputCapacity": { "type": "boolean" },
        "mimeTypes": { "type": "boolean" },
        "reason": { "type": "string", "minLength": 1, "maxLength": 800 }
      }
    },
    "capabilityResult": {
      "type": "object",
      "additionalProperties": false,
      "required": ["requirementId", "capabilityId", "level", "support", "status", "score", "reason"],
      "properties": {
        "requirementId": { "$ref": "common.schema.json#/$defs/identifier" },
        "capabilityId": { "$ref": "common.schema.json#/$defs/identifier" },
        "level": { "enum": ["hard", "soft", "advisory"] },
        "support": { "enum": ["strong", "partial", "experimental", "unsupported", "unknown"] },
        "status": { "enum": ["pass", "review", "warn", "fail"] },
        "score": { "type": "number", "minimum": 0, "maximum": 1 },
        "reason": { "type": "string", "minLength": 1, "maxLength": 800 }
      }
    },
    "candidate": {
      "type": "object",
      "additionalProperties": false,
      "required": ["candidateId", "capabilityProfileRef", "adapterDescriptorRef", "adapterId", "operationSupport", "capabilityResults", "score", "status", "hardFailures", "warnings", "rationale"],
      "properties": {
        "candidateId": { "$ref": "common.schema.json#/$defs/identifier" },
        "capabilityProfileRef": { "$ref": "#/$defs/exactCapabilityRef" },
        "adapterDescriptorRef": { "$ref": "#/$defs/exactAdapterRef" },
        "adapterId": { "$ref": "common.schema.json#/$defs/identifier" },
        "operationSupport": { "$ref": "#/$defs/operationSupport" },
        "capabilityResults": {
          "type": "array",
          "minItems": 1,
          "maxItems": 48,
          "items": { "$ref": "#/$defs/capabilityResult" }
        },
        "score": { "type": "number", "minimum": 0, "maximum": 100 },
        "status": { "enum": ["eligible", "selected", "needs_review", "blocked"] },
        "hardFailures": { "type": "array", "maxItems": 32, "uniqueItems": true, "items": { "type": "string", "minLength": 1, "maxLength": 240 } },
        "warnings": { "type": "array", "maxItems": 48, "uniqueItems": true, "items": { "type": "string", "minLength": 1, "maxLength": 240 } },
        "rationale": { "type": "string", "minLength": 1, "maxLength": 1200 }
      }
    },
    "selection": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "selectedCandidateId", "selectedCapabilityProfileRef", "selectedAdapterDescriptorRef", "rationale", "humanApprovalRequired"],
      "properties": {
        "status": { "enum": ["selected", "needs_review", "blocked"] },
        "selectedCandidateId": { "type": ["string", "null"], "pattern": "^[a-z0-9][a-z0-9._-]{1,159}$" },
        "selectedCapabilityProfileRef": {
          "anyOf": [
            { "type": "null" },
            { "$ref": "#/$defs/exactCapabilityRef" }
          ]
        },
        "selectedAdapterDescriptorRef": {
          "anyOf": [
            { "type": "null" },
            { "$ref": "#/$defs/exactAdapterRef" }
          ]
        },
        "rationale": { "type": "string", "minLength": 1, "maxLength": 1600 },
        "humanApprovalRequired": { "const": true }
      }
    },
    "explanation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["primaryDecision", "rankingPolicy", "hardConstraints", "tradeoffs", "fallbackCandidateIds"],
      "properties": {
        "primaryDecision": { "type": "string", "minLength": 1, "maxLength": 1600 },
        "rankingPolicy": { "type": "string", "minLength": 1, "maxLength": 1200 },
        "hardConstraints": { "type": "array", "maxItems": 32, "items": { "type": "string", "minLength": 1, "maxLength": 400 } },
        "tradeoffs": { "type": "array", "maxItems": 32, "items": { "type": "string", "minLength": 1, "maxLength": 600 } },
        "fallbackCandidateIds": { "type": "array", "maxItems": 16, "uniqueItems": true, "items": { "$ref": "common.schema.json#/$defs/identifier" } }
      }
    },
    "executionBoundary": {
      "type": "object",
      "additionalProperties": false,
      "required": ["providerNeutral", "generatesMedia", "executesAdapter", "mutatesCanon", "writesFiles", "humanApprovalRequired"],
      "properties": {
        "providerNeutral": { "const": true },
        "generatesMedia": { "const": false },
        "executesAdapter": { "const": false },
        "mutatesCanon": { "const": false },
        "writesFiles": { "const": false },
        "humanApprovalRequired": { "const": true },
        "notes": { "type": "string", "maxLength": 1600 }
      }
    },
    "validation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["candidateRefsExact", "descriptorBindingsExact", "hardRequirementsBlock", "rankingDeterministic", "explanationPresent", "noProviderSelection", "noExecution"],
      "properties": {
        "candidateRefsExact": { "const": true },
        "descriptorBindingsExact": { "const": true },
        "hardRequirementsBlock": { "const": true },
        "rankingDeterministic": { "const": true },
        "explanationPresent": { "const": true },
        "noProviderSelection": { "const": true },
        "noExecution": { "const": true }
      }
    }
  }
}
