 });
+
+test('MOMENTUM native presentation inherits canonical tokens through the production color adapter',()=>{
+  const momentum=theme.slice(theme.indexOf('/* MOMENTUM production presentation.'),theme.indexOf('/* End MOMENTUM production presentation. */'));
+  assert.ok(momentum.startsWith('/* MOMENTUM production presentation.'));
+  for(const token of ['background','card','foreground','muted-foreground','border','ring','primary','primary-foreground','danger'])
+    assert.ok(momentum.includes(`var(--${token})`),token);
+  assert.doesNotMatch(momentum,/#[\da-f]{3,8}\b|(?:rgb|hsl)a?\(/i,'no second palette survives outside the canonical tokens');
+  const built=materialsCss(legacy,theme);
+  assert.ok(built.includes(applySemanticTheme(momentum)),'actual production conversion retains the presentation');
+  assert.match(momentum,/\.material-focused \.gallery-grid\s*\{[^}]*repeat\(4/);
+  assert.match(momentum,/@media \(max-width:760px\)[\s\S]*?\.material-focused \.gallery-grid\s*\{[^}]*repeat\(2/);
+  assert.match(momentum,/@media \(hover:hover\) and \(pointer:fine\)/);
+  assert.match(momentum,/:focus-within/,'keyboard navigation reveals the contextual actions');
+  assert.match(momentum,/\.material-focused \.asset-actions :is\(button,a\)\s*\{\s*min-height: 44px/,'touch controls remain reachable');
+  assert.doesNotMatch(theme,/button\[id\*=["']undo["']\][^}]*display\s*:\s*none/,'business hidden state controls undo availability');
+});
+
+test('large native preview keeps modal lifecycle, exact original rendering and semantic loading state',()=>{
+  const body=previewBody('<dialog id="preview-dialog"><img id="preview-image" alt=""></dialog>');
+  assert.match(body,/width:min\(1480px/);
+  assert.match(body,/height:min\(68dvh,760px\)/);
+  assert.match(body,/object-fit:contain;filter:none/);
+  assert.match(body,/background:var\(--card\)/);
+  assert.match(body,/color:var\(--muted-foreground\)/);
+  assert.match(body,/@media\(max-width:760px\)/);
+  assert.match(body,/<dialog id="preview-dialog"/);
+  assert.match(body,/id="material-preview-status" role="status" aria-live="polite" hidden/);
+  assert.doesNotMatch(body,/#(?:[\da-f]{3,8})\b/i,'embedded preview style follows the same theme');
+});
