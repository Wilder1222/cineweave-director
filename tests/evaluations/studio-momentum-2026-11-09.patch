+'use client';
+
+import {useEffect, useMemo, useRef, useState} from 'react';
+import {ArrowDown, ArrowRight, ArrowUpRight, ChevronLeft, ChevronRight, Pause, Play} from 'lucide-react';
+import AnimatedContent from '@/components/react-bits/AnimatedContent';
+import {Button} from '@/components/ui/button';
+import {Atmosphere} from './creative-effects';
+import {directoryPage, directoryKindLabel, directoryPhase, directoryTitle} from './project-directory.mjs';
+import {projectReferenceBindings, projectReferenceAsset} from './home-project-media.mjs';
+import type {Project} from './model';
+import './momentum-home.css';
+
+type ProjectReference = {id:string;src:string;title:string};
+type Binding = {frame_asset_id:string};
+const destinations = [
+  {view:'screenplay',label:'故事'}, {view:'episodes',label:'剧集'},
+  {view:'storyboard',label:'分镜'}, {view:'prompts',label:'提示词'},
+] as const;
+interface Props {
+  projects:Project[];
+  loaded:boolean;
+  loadError:boolean;
+  onOpen(projectId:string,view:string):void;
+  onDirectory():void;
+}
+
+/** An optional exact project reference never gates the independent dashboard read. */
+function useProjectReference(projectId:string) {
+  const [reference,setReference]=useState<{projectId:string;asset:ProjectReference|null}>({projectId:'',asset:null});
+  const generation=useRef(0);
+  useEffect(()=>{
+    const token=++generation.current,controller=new AbortController();
+    setReference({projectId,asset:null});
+    if(projectId)void (async()=>{
+      const response=await fetch('/api/studio/bindings?'+new URLSearchParams({target_type:'project',target_id:projectId}),{credentials:'same-origin',cache:'no-store',signal:controller.signal,headers:{Accept:'application/json'}});
+      if(!response.ok)throw Error('项目参考暂不可用');
+      const result=await response.json() as {data?:unknown};
+      const bindings=projectReferenceBindings(result.data,projectId) as Binding[];
+      for(const binding of bindings){
+        const assetResponse=await fetch('/api/assets/'+encodeURIComponent(binding.frame_asset_id),{credentials:'same-origin',cache:'no-store',signal:controller.signal,headers:{Accept:'application/json'}});
+        if(!assetResponse.ok)continue;
+        const asset=projectReferenceAsset(await assetResponse.json(),binding.frame_asset_id) as ProjectReference|null;
+        if(token!==generation.current||controller.signal.aborted)return;
+        if(asset){setReference({projectId,asset});return;}
+      }
+    })().catch(()=>{/* Optional reference failures keep the real project and aggregate usable. */});
+    return()=>{generation.current++;controller.abort();};
+  },[projectId]);
+  return reference.projectId===projectId?reference.asset:null;
+}
+
+export default function MomentumProjectBoard({projects,loaded,loadError,onOpen,onDirectory}:Props){
+  const recent=useMemo(()=>directoryPage(projects,{sort:'updated',pageSize:12}).rows.slice(0,6) as Project[],[projects]);
+  const [featuredId,setFeaturedId]=useState(''),[paused,setPaused]=useState(false),[failedImage,setFailedImage]=useState('');
+  const featured=recent.find(project=>project.id===featuredId)||recent[0];
+  const featuredIndex=featured?recent.findIndex(project=>project.id===featured.id):-1;
+  const reference=useProjectReference(featured?.id||'');
+  const chapters=useRef<HTMLElement>(null),chapterHeading=useRef<HTMLHeadingElement>(null);
+  const nextFeature=(direction:-1|1)=>{if(recent.length>1)setFeaturedId(recent[(featuredIndex+direction+recent.length)%recent.length].id);};
+  const showChapters=()=>{chapters.current?.scrollIntoView({block:'start',behavior:window.matchMedia('(prefers-reduced-motion: reduce)').matches?'auto':'smooth'});chapterHeading.current?.focus({preventScroll:true});};
+  const title=featured?directoryTitle(featured):loadError?'项目暂未读取':loaded?'新建项目':'正在读取项目';
+  return <div className="cw-momentum-board">
+    <section className="cw-momentum-feature" aria-label="继续创作" aria-busy={!loaded&&!loadError}>
+      {reference&&failedImage!==reference.src&&<div className="cw-momentum-feature-media"><img src={reference.src} alt={reference.title} onError={()=>setFailedImage(reference.src)}/><span>项目参考</span></div>}
+      <Atmosphere kind="fibers" paused={paused}/>
+      <div className="cw-momentum-feature-copy">
+        <h1>{title}</h1>
+        {featured?<><p className="cw-momentum-feature-meta"><span>{directoryKindLabel(featured.kind)}</span><span>{directoryPhase(featured.phase).label}</span></p><Button className="cw-momentum-continue" onClick={()=>onOpen(featured.id,'screenplay')} aria-label={`继续创作${directoryTitle(featured)}`}><ArrowRight size={18}/>继续创作</Button></>:<><Button className="cw-momentum-continue" variant="outline" onClick={onDirectory}>打开项目目录<ArrowUpRight size={17}/></Button></>}
+      </div>
+      {recent.length>0&&<Button variant="ghost" className="cw-momentum-explore" onClick={showChapters}><span>项目</span><span aria-hidden="true"/><ArrowDown size={18}/></Button>}
+      <div className="cw-momentum-feature-footer">
