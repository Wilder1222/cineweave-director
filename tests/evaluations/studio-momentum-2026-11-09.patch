diff --git a/components/workspace/home-project-media.mjs b/components/workspace/home-project-media.mjs
new file mode 100644
index 0000000..09b4f04
--- /dev/null
+++ b/components/workspace/home-project-media.mjs
@@ -0,0 +1,14 @@
+/** Only explicit bindings belonging to this exact project may decorate its home feature. */
+export function projectReferenceBindings(value, projectId) {
+  if (!Array.isArray(value)) throw Error('项目参考未能完整读取');
+  return value.filter(binding => binding && binding.target_type === 'project' && binding.target_id === projectId &&
+    ['reference', 'scene'].includes(binding.usage) && typeof binding.frame_asset_id === 'string' && binding.frame_asset_id.length > 0)
+    .sort((a, b) => Number(b.usage === 'reference') - Number(a.usage === 'reference')).slice(0, 6);
+}
+
+export function projectReferenceAsset(value, assetId) {
+  const asset = value?.asset;
+  if (!asset || asset.id !== assetId || typeof asset.thumbnail_url !== 'string' ||
+    !/^\/media\/[A-Za-z0-9_./-]+$/.test(asset.thumbnail_url) || asset.thumbnail_url.split('/').includes('..')) return null;
+  return { id: assetId, src: asset.thumbnail_url, title: typeof asset.title === 'string' && asset.title.trim() ? asset.title : '已关联项目参考' };
+}
