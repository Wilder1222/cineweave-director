+import test from 'node:test';import assert from 'node:assert/strict';import fs from 'node:fs';
+import {materialsBody,materialsModule} from '../src/materials-bundle.mjs';
+const read=p=>fs.readFileSync(new URL('../../'+p,import.meta.url),'utf8');
+const home=JSON.parse(read('lib/home.ts').replace(/^export const home = /,'').trim().replace(/;$/,''));
+const app=read('public/app.js');
+const source=materialsModule({html:home,kind:'images',app}),body=materialsBody(home,'images');
+test('preview preparation can only reset controls present in the current composed FRAME template',()=>{const ids=new Set([...body.matchAll(/\bid="([^"]+)"/g)].map(match=>match[1]));const prepare=source.slice(source.indexOf('function prepareMaterialPreview('),source.indexOf('function materialPreviewFailure('));const used=[...prepare.matchAll(/\$\('([^']+)'\)/g)].map(match=>match[1]);for(const group of prepare.matchAll(/for\(const key of \[([^\]]+)\]\)/g))used.push(...[...group[1].matchAll(/'([^']+)'/g)].map(match=>match[1]));assert.ok(used.length>15);for(const id of used)assert.ok(ids.has(id),'missing reset target: '+id);});
+test('current preview opens without the retired technical renderer while keeping source and original actions',()=>{const open=source.slice(source.indexOf('async function openPreview('),source.indexOf('async function openPreview(')+3200);assert.doesNotMatch(open,/preview-technical|technicalDetails/);for(const required of ['metadataFor(asset)','renderPromptDetails(asset)','renderDescriptionDetails(asset)','loadMaterialPreviewImage(image,asset,serial)',"showDialog('preview-dialog')","$('original-link')"])assert.ok(open.includes(required),required);});
