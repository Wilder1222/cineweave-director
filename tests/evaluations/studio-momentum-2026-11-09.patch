+// Wardrobe cards are projections of saved looks and verified FRAME references.
+// A selected card never changes identity or represents an equipped/generated look.
+export const wardrobeSlots = {
+  unassigned: '未指定', top: '上装', bottom: '下装', dress: '连衣裙 / 连体装',
+  outfit_set: '整套服装', outerwear: '外套', shoes: '鞋', socks: '袜', bag: '包',
+  jewelry: '首饰', accessory: '其他配饰', hair_reference: '发型参考',
+  expression_reference: '表情 / 表演参考', makeup_reference: '妆容参考',
+  pose_reference: '体态参考', background_reference: '背景参考',
+};
+
+export function wardrobeTab(value) {
+  return value === 'references' ? 'looks' : ['profile', 'identity', 'looks', 'credits'].includes(value) ? value : 'profile';
+}
+
+export function wardrobeCover(look) {
+  const items = look?.spec?.items || [];
+  return items.find(item => ['outfit_set', 'dress', 'outerwear', 'top', 'bottom'].includes(item.slot)) || items[0] || null;
+}
+
+export function filterWardrobe(looks, query = '', slot = 'all', assets = {}) {
+  const terms = query.trim().toLocaleLowerCase().split(/\s+/).filter(Boolean);
+  return looks.filter(look => {
+    if (!look.spec || !Array.isArray(look.spec.items)) return false;
+    const items = look.spec.items;
+    if (slot !== 'all' && !items.some(item => item.slot === slot)) return false;
+    const text = [look.title, ...items.flatMap(item => [wardrobeSlots[item.slot] || '', item.note || '', assets[item.asset_id]?.identity?.display_name || assets[item.asset_id]?.title || ''])].join(' ').toLocaleLowerCase();
+    return terms.every(term => text.includes(term));
+  });
+}
+
+function checkActive(signal) {
+  if (signal?.aborted) throw new DOMException('读取已取消', 'AbortError');
+}
+
+// Read complete immutable specs in bounded parallel batches. Results are published
+// only after the whole page matches its list revisions; summaries are never empty looks.
+export async function readWardrobeLooks({ readPage, readLook, signal, onPage, pageSize = 40, concurrency = 4 }) {
+  const all = [], seen = new Set();
+  for (let offset = 0; ; offset += pageSize) {
+    checkActive(signal);
+    const rows = await readPage({ limit: pageSize, offset, signal });
+    checkActive(signal);
+    if (!Array.isArray(rows) || rows.length > pageSize) throw Error('衣橱列表未能完整读取，请重新读取。');
+    const page = new Array(rows.length);
+    let cursor = 0;
+    await Promise.all(Array.from({ length: Math.min(concurrency, rows.length) }, async () => {
+      while (cursor < rows.length) {
+        checkActive(signal);
+        const index = cursor++, row = rows[index];
+        if (!row?.id || seen.has(row.id)) throw Error('衣橱列表已有变化，请重新读取。');
+        seen.add(row.id);
+        const detail = await readLook(row.id, signal);
+        checkActive(signal);
+        if (detail?.id !== row.id || detail.revision !== row.revision) throw Error('造型版本已有变化，请重新读取衣橱。');
+        if (!detail.spec || !Array.isArray(detail.spec.items)) throw Error('造型完整内容未能读取，请重新读取衣橱。');
+        page[index] = detail;
+      }
+    }));
+    checkActive(signal);
+    all.push(...page);
+    onPage?.([...all]);
+    if (rows.length < pageSize) return all;
+  }
+}
+
+export async function wardrobeRead(path, signal) {
+  if (!path.startsWith('/api/') || path.startsWith('//')) throw Error('衣橱读取地址无效');
+  const response = await fetch(path, { credentials: 'same-origin', cache: 'no-store', headers: { Accept: 'application/json' }, signal });
+  let value;
+  try { value = await response.json(); } catch { throw Error('衣橱响应未能读取，请重试。'); }
+  checkActive(signal);
+  if (!response.ok) throw Error(response.status === 401 ? '登录已过期，请重新登录后再试。' : response.status === 403 ? '当前账户无法读取此衣橱。' : response.status === 404 ? '此造型已不可用，请重新读取。' : '衣橱暂时无法读取，请重试。');
+  if (!value || typeof value !== 'object') throw Error('衣橱响应未能读取，请重试。');
+  return Object.hasOwn(value, 'data') ? value.data : value;
+}
