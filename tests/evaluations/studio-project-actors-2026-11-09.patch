+'use client';
+import {useEffect,useRef,useState} from 'react';
+import {Button} from '@/components/ui/button';
+import type {Project} from './model';
+import './project-content.css';
+
+interface SoundController {getState():{dirty:boolean;busy:boolean;unsettled?:boolean};dispose?():void}
+interface SoundModule {mountMaterials(host:HTMLElement,options?:Record<string,unknown>):SoundController}
+interface Props {project:Project;onDirty(value:boolean):void;onBusy(value:boolean):void}
+
+/** Reuse the native account sound library in this project's workspace, without inventing project bindings. */
+export default function ProjectSound({project,onDirty,onBusy}:Props){
+ const host=useRef<HTMLDivElement>(null),callbacks=useRef({onDirty,onBusy});callbacks.current={onDirty,onBusy};
+ const [loading,setLoading]=useState(true),[error,setError]=useState(''),[attempt,setAttempt]=useState(0),[unsettled,setUnsettled]=useState(false);
+ useEffect(()=>{
+  const target=host.current;if(!target)return;let alive=true,controller:SoundController|undefined,observer:MutationObserver|undefined,root:ShadowRoot|null=null,last='';
+  const report=()=>{if(!alive||!controller)return;const status=controller.getState(),signature=JSON.stringify(status);if(signature===last)return;last=signature;setUnsettled(status.unsettled===true);callbacks.current.onDirty(status.dirty);callbacks.current.onBusy(status.busy);};
+  const unload=(event:BeforeUnloadEvent)=>{const status=controller?.getState();if(status?.dirty||status?.busy){event.preventDefault();event.returnValue='';}};
+  const eventReport=()=>{report();queueMicrotask(report);};
+  setLoading(true);setError('');
+  const modulePath='/studio/materials-sound.mjs'+(attempt?'?retry='+attempt:'');
+  import(/* @vite-ignore */ modulePath).then((module:SoundModule)=>{
+   if(!alive)return;controller=module.mountMaterials(target);root=target.shadowRoot;
+   if(!root||typeof controller?.getState!=='function')throw Error('声音面板未能完整载入');
+   const frame=root.querySelector('.frame-body');frame?.classList.add('project-sound-panel');
+   observer=new MutationObserver(report);observer.observe(root,{subtree:true,childList:true,attributes:true,characterData:true});
+   for(const name of ['input','change','click','submit','reset','close'])root.addEventListener(name,eventReport,true);
+   window.addEventListener('beforeunload',unload);report();setLoading(false);
+  }).catch(()=>{if(alive){setLoading(false);setError('声音未能载入');}});
+  return()=>{alive=false;observer?.disconnect();if(root)for(const name of ['input','change','click','submit','reset','close'])root.removeEventListener(name,eventReport,true);window.removeEventListener('beforeunload',unload);controller?.dispose?.();callbacks.current.onDirty(false);callbacks.current.onBusy(false);};
+ },[project.id,attempt]);
+ return <section className="cw-project-sound" aria-label="声音"><header className="cw-project-section-heading"><h2>声音</h2><span className="cw-small-copy">账号声音库</span></header>{loading&&<p role="status">正在读取声音…</p>}{unsettled&&<p role="status" className="cw-warning">上次操作结果待核对，请返回原保存或撤销操作重试。</p>}{error&&<div role="alert"><p>{error}</p><Button type="button" variant="outline" onClick={()=>setAttempt(value=>value+1)}>重新载入</Button></div>}<div key={attempt} ref={host} className="cw-project-sound-native"/></section>;
+}
