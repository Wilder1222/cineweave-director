diff --git a/tests/actor-profile-labels.test.mjs b/tests/actor-profile-labels.test.mjs
new file mode 100644
index 0000000..c9fbb26
--- /dev/null
+++ b/tests/actor-profile-labels.test.mjs
@@ -0,0 +1,70 @@
+import test,{after} from 'node:test';
+import assert from 'node:assert/strict';
+import {mkdtemp,rm} from 'node:fs/promises';
+import {fileURLToPath,pathToFileURL} from 'node:url';
+import path from 'node:path';
+import {build} from 'esbuild';
+import {maskActorText,restoreActorText} from '../studio-core/web/review-readable.mjs';
+
+const site=fileURLToPath(new URL('..',import.meta.url));
+const temp=await mkdtemp(path.join(site,'node_modules','.actor-label-test-'));
+after(()=>rm(temp,{recursive:true,force:true}));
+const entry=path.join(temp,'render.mjs');
+await build({stdin:{contents:`import React from 'react';
+ import {renderToStaticMarkup} from 'react-dom/server';
+ import MarkdownContent from './components/workspace/markdown-content.tsx';
+ export const render=(content,actorLabels=true)=>renderToStaticMarkup(React.createElement(MarkdownContent,{content,actorLabels}));
+ export const defaults=content=>renderToStaticMarkup(React.createElement(MarkdownContent,{content}));`,resolveDir:site,loader:'js'},bundle:true,packages:'external',platform:'node',format:'esm',outfile:entry,jsx:'automatic',logLevel:'silent'});
+const {render,defaults}=await import(pathToFileURL(entry).href);
+const labels=html=>[...html.matchAll(/<span class="cw-actor-label" data-tone="([0-3])">([^<]*)<\/span>/g)].map(match=>({tone:match[1],text:match[2]}));
+
+test('actor mode renders literal inline labels with stable colors and complete surrounding prose',()=>{
+ const content='【慢热】她会先观察。\n【坚定】答应的事会做完。再次【慢热】。';
+ const html=render(content),found=labels(html);
+ assert.deepEqual(found.map(label=>label.text),['慢热','坚定','慢热']);
+ assert.equal(found[0].tone,found[2].tone);
+ assert.equal(found[0].tone,labels(render('调整前文，再次【慢热】。'))[0].tone);
+ assert.match(html,/她会先观察。<br\/>/);assert.match(html,/答应的事会做完。/);
+ assert.doesNotMatch(html,/<button|tabindex|role="button"/);
+ assert.equal(content,'【慢热】她会先观察。\n【坚定】答应的事会做完。再次【慢热】。');
+});
+
+test('default Markdown rendering keeps brackets and existing Chinese emphasis unchanged',()=>{
+ const content='**性格：**【慢热】\n【坚定】';
+ const standard=defaults(content);
+ assert.equal(standard,render(content,false));assert.doesNotMatch(standard,/cw-actor-label/);
+ assert.match(standard,/<strong>性格：<\/strong>【慢热】/);
+ const actor=render(content);assert.match(actor,/<strong>性格：<\/strong>/);assert.deepEqual(labels(actor).map(label=>label.text),['慢热','坚定']);
+});
+
+test('links, images, inline code, fenced code and HTML remain opaque to label styling',()=>{
+ const content='[【链接】](https://example.com) ![【图片】](https://example.com/pixel.png) `【代码】` 【可见】\n\n```txt\n【围栏】\n```\n\n<span>【原始 HTML】</span>';
+ const html=render(content);
+ assert.deepEqual(labels(html).map(label=>label.text),['可见']);
+ assert.match(html,/>【链接】<\/a>/);assert.match(html,/<span>【图片】<\/span>/);assert.match(html,/<code>【代码】<\/code>/);
+ assert.match(html,/&lt;span&gt;【原始 HTML】&lt;\/span&gt;/);assert.doesNotMatch(html,/<img\b|\ssrc=/);
+ const danglingCode=render('`【` 【独立标签】');assert.deepEqual(labels(danglingCode).map(label=>label.text),['独立标签']);
+});
+
+test('nested, multiline, empty and long bracket prose never becomes a partial label',()=>{
+ const content='【外【内】层】 【外 **层【内】** 尾】 【跨\n行】 【】 【   】 【'+ '长'.repeat(49)+'】 【普通】';
+ const html=render(content);
+ assert.deepEqual(labels(html).map(label=>label.text),['普通']);
+ assert.match(html,/【外【内】层】/);assert.match(html,/【外 <strong>层【内】<\/strong> 尾】/);
+ assert.match(html,/【跨<br\/>\n行】/);
+});
+
+test('protected material markers and exact saved references survive display unchanged',()=>{
+ const source='【冷静】以 file_portrait_123 为素材。〔既有备注〕 【〔素材引用 8〕】';
+ const projection=maskActorText(source),before=JSON.stringify(projection),html=render(projection.text);
+ assert.deepEqual(labels(html).map(label=>label.text),['冷静']);
+ assert.match(html,/〔素材引用 1〕/);assert.match(html,/〔既有备注〕/);assert.match(html,/【〔素材引用 8〕】/);
+ assert.equal(JSON.stringify(projection),before);assert.equal(restoreActorText(projection.text,projection),source);
+});
+
+test('label contents cannot inject HTML or bypass the existing safe-link policy',()=>{
+ const html=render('【&lt;script&gt;alert(1)&lt;/script&gt;】 [【危险】](javascript:alert%281%29)\n\n<script>【注入】</script>');
+ assert.doesNotMatch(html,/<script\b|href="javascript:|dangerouslySetInnerHTML/i);
+ assert.match(html,/&lt;script&gt;/);assert.match(html,/<span>【危险】<\/span>/);
+ assert.deepEqual(labels(html).map(label=>label.text),['&lt;script&gt;alert(1)&lt;/script&gt;']);
+});
diff --git a/tests/dashboard-recent-ui.test.mjs b/tests/dashboard-recent-ui.test.mjs
new file mode 100644
index 0000000..389142c
--- /dev/null
+++ b/tests/dashboard-recent-ui.test.mjs
@@ -0,0 +1,49 @@
+import test from 'node:test';
+import assert from 'node:assert/strict';
+import {readFileSync} from 'node:fs';
+import {createRequire} from 'node:module';
+import ts from 'typescript';
+import * as dashboardData from '../components/workspace/dashboard-data.mjs';
+
+const require=createRequire(import.meta.url);
+const source=readFileSync(new URL('../components/workspace/dashboard.tsx',import.meta.url),'utf8');
+const output=ts.transpileModule(source,{compilerOptions:{module:ts.ModuleKind.CommonJS,jsx:ts.JsxEmit.ReactJSX,target:ts.ScriptTarget.ES2022}}).outputText;
+const walk=node=>!node||typeof node!=='object'?[]:[node,...[node.props?.children].flat(Infinity).flatMap(walk)];
+const text=node=>typeof node==='string'||typeof node==='number'?String(node):node&&typeof node==='object'?[node.props?.children].flat(Infinity).map(text).join(''):'';
+const section=(items=[],extra={})=>({items,has_more:false,partial:false,error:null,...extra});
+const row=(kind,id=kind)=>({kind,id,key:kind+':'+id,title:'记录-'+id,project_id:'project',project_title:'项目',label:'已保存',updated_at:null,target:kind==='story'?{view:'canvas',item:id}:kind==='document'?{view:'screenplay',document:id}:{view:'tasks',task:id}});
+function render(recent,extra={}){
+ const state={data:{sections:{pending:section([row('collaboration')]),running:section([row('task')]),recent}},loading:false,activeSection:null,error:'',moreErrors:{},...extra};
+ const calls=[],controller={more:name=>calls.push(['more',name]),refresh:()=>calls.push(['refresh'])};
+ const react={useState:()=>[state,()=>{}],useRef:value=>({current:value===null?controller:value}),useEffect(){}};
+ const exports={};
+ new Function('require','exports','location',output)(name=>name==='react'?react:name==='react/jsx-runtime'?require(name):name==='./dashboard-data.mjs'?dashboardData:name==='@/components/ui/button'?{Button:'Button'}:name==='lucide-react'?{ArrowUpRight:'ArrowUpRight',RefreshCw:'RefreshCw'}:{},exports,{assign:href=>calls.push(['assign',href])});
+ const tree=exports.default({onOpen:(...args)=>calls.push(['open',...args]),onNavigate:view=>calls.push(['navigate',view]),onAttempt:fn=>{calls.push(['attempt']);fn();},onReady(){}});
+ return{tree,calls,all:walk(tree),text:text(tree)};
+}
+
+test('home presents only recent story and document rows without changing dashboard data',()=>{
