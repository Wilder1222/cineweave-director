new file mode 100644
index 0000000..71ff706
--- /dev/null
+++ b/components/workspace/remark-actor-labels.mjs
@@ -0,0 +1,76 @@
+const scopes = new Set(['paragraph', 'heading', 'tableCell']);
+const inlineContainers = new Set(['emphasis', 'strong', 'delete']);
+
+// Stable presentation only: the same authored label keeps its color after edits.
+function tone(value) {
+  let hash = 2166136261;
+  for (const character of value) hash = Math.imul(hash ^ character.codePointAt(0), 16777619);
+  return (hash >>> 0) % 4;
+}
+
+/** Display short, literal Chinese bracket labels without rewriting the source.
+ * Markdown links/code/images remain opaque; protected 〔素材引用〕 markers stay text.
+ * A label must fit within one text node, so markup and nested brackets cannot
+ * accidentally turn into an interactive or partially formatted label.
+ */
+export default function remarkActorLabels() {
+  return tree => {
+    function transform(scope) {
+      const pieces = []; let value = '', containsHtml = false;
+      function collect(node) {
+        if (node.type === 'html') { containsHtml = true; return; }
+        if (node.type === 'text') {
+          const start = value.length;
+          value += node.value;
+          pieces.push({node, start, end: value.length});
+        } else if (node === scope || inlineContainers.has(node.type)) {
+          for (const child of node.children || []) collect(child);
+        } else value += node.type === 'break' ? '\n' : '\0';
+      }
+      collect(scope);
+      // Inline raw HTML has no mdast subtree. Keep the complete mixed scope
+      // literal instead of styling content between an opening/closing HTML tag.
+      if (containsHtml) return;
+      const replacements = new Map();
+      let depth = 0, start = -1, nested = false;
+      for (let index = 0; index < value.length; index++) {
+        if (value[index] === '【') {
+          if (!depth) { start = index; nested = false; } else nested = true;
+          depth++;
+        } else if (value[index] === '】' && depth) {
+          depth--;
+          if (depth || nested) continue;
+          const label = value.slice(start + 1, index).trim();
+          if (!label || label.length > 48 || /[\r\n\0〔〕]/.test(label)) continue;
+          const piece = pieces.find(part => start >= part.start && index < part.end);
+          if (!piece) continue;
+          const ranges = replacements.get(piece.node) || [];
+          ranges.push({start: start - piece.start, end: index + 1 - piece.start, label});
+          replacements.set(piece.node, ranges);
+        }
+      }
+      function replace(parent) {
+        if (!Array.isArray(parent.children)) return;
+        parent.children = parent.children.flatMap(node => {
+          const ranges = replacements.get(node);
+          if (!ranges) { if (inlineContainers.has(node.type)) replace(node); return [node]; }
+          const out = []; let cursor = 0;
+          for (const range of ranges) {
+            if (range.start > cursor) out.push({type:'text', value:node.value.slice(cursor, range.start)});
+            out.push({type:'emphasis', data:{hName:'span', hProperties:{className:['cw-actor-label'], 'data-tone':String(tone(range.label))}}, children:[{type:'text', value:range.label}]});
+            cursor = range.end;
+          }
+          if (cursor < node.value.length) out.push({type:'text', value:node.value.slice(cursor)});
+          return out;
+        });
+      }
+      replace(scope);
+    }
+    function visit(node) {
+      if (scopes.has(node.type)) { transform(node); return; }
+      // Traverse structural blocks only. Opaque inline nodes are handled above.
+      for (const child of node.children || []) visit(child);
+    }
+    visit(tree);
+  };
+}
