+.project-sound-panel>.topbar,.project-sound-panel .intro,.project-sound-panel .workspace-note,.project-sound-panel footer{display:none}
+.project-sound-panel main{max-width:none;padding:0;margin:0}
+.project-sound-panel .tabs{gap:28px;margin:0}
+.project-sound-panel .tabs button{font-size:15px;min-height:48px}
+.project-sound-panel .toolbar{padding:24px 0 14px;gap:20px}
+.project-sound-panel .toolbar h2{font-size:18px}
+.project-sound-panel .toolbar #list-help{display:none}
+.project-sound-panel .tools{flex-wrap:wrap}
+.project-sound-panel button{min-height:44px;max-width:100%;height:auto;overflow:visible;white-space:normal;overflow-wrap:anywhere}
+.project-sound-panel .sound-row{padding:22px 4px;grid-template-columns:40px minmax(0,1fr) minmax(130px,200px) auto}
+.project-sound-panel .row-index{font:400 15px var(--sans);font-variant-numeric:tabular-nums}
+.project-sound-panel .row-main h3{font-size:16px;font-weight:500}
+.project-sound-panel dialog{border-radius:12px;max-height:90dvh}
+.project-sound-panel .empty-state strong{font:500 28px var(--sans)}
+@media(max-width:760px){.project-sound-panel .toolbar{align-items:stretch}.project-sound-panel .sound-row{grid-template-columns:minmax(0,1fr) auto;gap:12px}.project-sound-panel .row-index{display:none}.project-sound-panel .row-meta{grid-column:1;grid-row:2}.project-sound-panel .row-action{grid-column:2;grid-row:1 / span 2}.project-sound-panel .search-label{flex-basis:100%}}
