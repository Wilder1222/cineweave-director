+ const stages=spec.stages??[];
+ if(!Array.isArray(stages)||stages.length>developmentStages.length)error('INVALID_DEVELOPMENT_STAGES',422,'创作规划最多记录 G0–G7 八个阶段');
+ const seen=new Set(),normalized=[];
+ for(const entry of stages){
+  keys(entry,['stage','plan']);
+  if(!developmentStages.includes(entry.stage)||seen.has(entry.stage))error('INVALID_DEVELOPMENT_STAGES',422,'阶段需要不重复的 G0–G7 标识');
+  seen.add(entry.stage);normalized.push({stage:entry.stage,plan:requiredText(entry.plan,'阶段规划',12000)});
+ }
+ normalized.sort((a,b)=>developmentStages.indexOf(a.stage)-developmentStages.indexOf(b.stage));
+ return {topic_id,intent,...Object.fromEntries(textFields.map(field=>[field,optionalText(spec[field],field,field==='logline'?4000:12000)])),basis,basis_date,stages:normalized};
+}
