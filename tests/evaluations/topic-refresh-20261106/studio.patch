+import {normalizeDevelopmentPlanSpec,developmentStages,developmentStageLabels as stageNames} from '../../studio-core/src/development-plan-spec.mjs';
+import {requiredText,optionalText,stableId,positiveRevision,idempotencyKey} from '../../studio-core/src/validation.mjs';
+
+export const developmentStageLabels=Object.fromEntries(developmentStages.map(stage=>[stage,stage+' · '+stageNames[stage]]));
+export const developmentImportFormat='cineweave-development-plans/v1';
+export const developmentImportLimit=2*1024*1024;
+export const developmentImportStorage='cw-development-plan-import:v1';
+const object=value=>value&&typeof value==='object'&&!Array.isArray(value);
+const fail=message=>{throw Error(message);};
+const keys=(value,allowed)=>{if(!object(value))fail('导入内容必须是对象');for(const key of Object.keys(value))if(!allowed.includes(key))fail('导入包含不支持字段：'+key);};
+const list=(value,max)=>{if(!Array.isArray(value)||value.length>max)fail('导入列表超出允许范围');return value;};
+const integer=value=>{if(value==null)return null;if(!Number.isSafeInteger(value)||Math.abs(value)>100000000)fail('顺序与时点必须为有效整数');return value;};
+const digest=value=>typeof value==='string'&&/^[a-f0-9]{64}$/.test(value);
+const same=(a,b)=>JSON.stringify(canonical(a))===JSON.stringify(canonical(b));
+function canonical(value){if(Array.isArray(value))return value.map(canonical);if(object(value))return Object.fromEntries(Object.keys(value).sort().map(key=>[key,canonical(value[key])]));return value;}
+const fields=['character_id','age','location','motivation','goal','behavior','speech','author_secret','unresolved','participants','event_layer','time_label','time_precision','from_id','to_id','layer','relationship_type','direction','subjective','knower_id','knowledge_type','channel','adaptation_note'];
+function normalizeSources(value=[]){
+ return list(value,100).map(source=>{
+  keys(source,['kind','item_id','version','paragraph','text','origin','url','quote','sha256']);
+  if(source.kind==='note'){
+   const origin=source.origin??'user',url=optionalText(source.url,'来源链接',2000);
+   if(!['user','adopted_text','assistant','inference','external'].includes(origin)||url&&!/^https:\/\//.test(url))fail('来源性质或链接无效');
+   return {kind:'note',text:requiredText(source.text,'依据摘要',5000),origin,url};
+  }
+  if(!['item','story','document'].includes(source.kind))fail('导入来源类型无效');
+  stableId(source.item_id);positiveRevision(source.version);
+  if(source.kind==='item'){
+   if(source.sha256!==undefined&&!digest(source.sha256))fail('准确来源哈希无效');
+   return {kind:'item',item_id:source.item_id,version:source.version,...(source.sha256?{sha256:source.sha256}:{})};
+  }
+  positiveRevision(source.paragraph);
+  if(source.quote!==undefined&&typeof source.quote!=='string')fail('引用原文必须是文本');
+  return {kind:source.kind,item_id:source.item_id,version:source.version,paragraph:source.paragraph,...(source.quote!==undefined?{quote:source.quote}:{})};
+ });
+}
+
+/** Same common content defaults as the story service; no source is fetched or upgraded. */
+export function normalizeDevelopmentImportContent(input){
+ keys(input,['title','body','aliases','fields','sources','audience','known_by','known_from','reader_from','story_order','narrative_order','valid_from','valid_to','spec']);
+ const source=normalizeSources(input.sources),f=input.fields??{};keys(f,fields);
+ const normalizedFields=Object.fromEntries(Object.entries(f).map(([key,value])=>[key,key==='participants'?[...new Set(list(value,100).map(stableId))]:optionalText(value,key,8000)]));
+ for(const key of ['character_id','from_id','to_id','knower_id'])if(normalizedFields[key])stableId(normalizedFields[key]);
+ const aliases=[...new Set(list(input.aliases??[],30).map(value=>requiredText(value,'别名',120)))];
+ const known_by=[...new Set(list(input.known_by??[],100).map(stableId))];
+ if((input.audience??'author')!=='author'||input.reader_from!=null)fail('创作规划仅供作者使用，不能作为读者事实');
+ const result={title:requiredText(input.title,'规划标题'),body:optionalText(input.body,'完整评析',70000),aliases,fields:normalizedFields,sources:source,audience:'author',known_by,known_from:integer(input.known_from),reader_from:null,story_order:integer(input.story_order),valid_from:integer(input.valid_from),valid_to:integer(input.valid_to),spec:normalizeDevelopmentPlanSpec(input.spec,{sources:source})};
+ if(input.narrative_order!==undefined)result.narrative_order=integer(input.narrative_order);
+ if(result.valid_from!==null&&result.valid_to!==null&&result.valid_from>result.valid_to)fail('结束时点早于开始时点');
+ return result;
+}
+
+export function parseDevelopmentPlanPackage(text,projects,newKey=()=>crypto.randomUUID(),byteLimit=developmentImportLimit){
+ if(typeof text!=='string'||new TextEncoder().encode(text).length>byteLimit)fail('候选包不能超过 2 MB');
+ let value;try{value=JSON.parse(text);}catch{fail('候选包格式无法读取，请选择有效的规划候选文件');}
+ keys(value,['format','metadata','coverage','entries']);
+ if(value.format!==developmentImportFormat)fail('不是受支持的创作规划候选包');
+ for(const key of ['metadata','coverage'])if(value[key]!==undefined&&!object(value[key]))fail('候选包说明字段必须是对象');
+ const projectMap=new Map(projects.map(project=>[project.id,project])),seenProjects=new Set(),seenTopics=new Set();
+ const entries=list(value.entries,200).map(entry=>{
+  keys(entry,['project_id','topic_id','content']);stableId(entry.project_id);
+  if(!projectMap.has(entry.project_id))fail('候选包包含当前项目目录未确认的作品；未写入任何候选');
+  const content=normalizeDevelopmentImportContent(entry.content),topic_id=entry.topic_id==null||entry.topic_id===''?null:requiredText(entry.topic_id,'题号',200);
+  if(topic_id!==content.spec.topic_id)fail('候选包题号与规划内题号不一致');
+  if(seenProjects.has(entry.project_id)||topic_id&&seenTopics.has(topic_id))fail('候选包包含重复项目或题号');
+  seenProjects.add(entry.project_id);if(topic_id)seenTopics.add(topic_id);
+  const key=newKey();idempotencyKey(key);
+  return {project_id:entry.project_id,topic_id,content,key,status:'ready',error:''};
+ });
+ if(!entries.length)fail('候选包中没有规划条目');
+ return {format:developmentImportFormat,entries};
+}
+
+export function developmentImportCounts(job){
+ const rows=job?.entries??[];
+ return {complete:rows.filter(entry=>entry.status==='complete').length,failed:rows.filter(entry=>entry.status==='failed').length,unknown:rows.filter(entry=>['pending','unknown'].includes(entry.status)).length,remaining:rows.filter(entry=>entry.status==='ready').length};
+}
+export function developmentStageCoverage(spec={}){
+ const entries=Array.isArray(spec.stages)?spec.stages.filter(value=>developmentStages.includes(value?.stage)&&typeof value.plan==='string'&&value.plan.trim()):[];
+ return {entries:[...entries].sort((a,b)=>developmentStages.indexOf(a.stage)-developmentStages.indexOf(b.stage)),missing:developmentStages.filter(stage=>!entries.some(entry=>entry.stage===stage))};
+}
+export function sameDevelopmentPackage(a,b){return same(a.entries.map(({project_id,topic_id,content})=>({project_id,topic_id,content})),b.entries.map(({project_id,topic_id,content})=>({project_id,topic_id,content})));}
+export function developmentImportRequest(entry){
+ if(!Number.isSafeInteger(entry.canon_revision)||entry.canon_revision<0)fail('当前作品基线尚未确认');
+ return {kind:'development_plan',branch:'main',timeline:'main',content:entry.content,expected_canon_revision:entry.canon_revision};
+}
+
+/** Persist the exact key/content/canon before writing. Quota failures stop the write. */
+export function persistDevelopmentImport(storage,job){
+ const serialized=JSON.stringify(job);storage.setItem(developmentImportStorage,serialized);
+ if(storage.getItem(developmentImportStorage)!==serialized)fail('恢复记录未准确保存，尚未开始写入');
+ return job;
+}
+export function recoverDevelopmentImport(storage,projects){
+ const raw=storage.getItem(developmentImportStorage);if(!raw)return null;
+ let saved;try{saved=JSON.parse(raw);}catch{fail('上次导入恢复记录无法读取，请保留本页并核对');}
+ keys(saved,['format','entries']);
+ if(saved.format!==developmentImportFormat)fail('上次导入恢复记录版本不支持');
+ const sanitized=parseDevelopmentPlanPackage(JSON.stringify({format:saved.format,entries:list(saved.entries,200).map(entry=>({project_id:entry.project_id,topic_id:entry.topic_id,content:entry.content}))}),projects,()=>crypto.randomUUID(),developmentImportLimit*3);
+ sanitized.entries=sanitized.entries.map((entry,index)=>{
+  const old=saved.entries[index];keys(old,['project_id','topic_id','content','key','status','error','canon_revision','receipt','known_rejection','attempts']);
+  if(!same(entry.content,old.content))fail('上次提交内容已变动，不能重建另一份请求');
+  if(old.known_rejection!==undefined&&typeof old.known_rejection!=='boolean')fail('上次导入拒绝状态无效');
+  if(!['ready','pending','unknown','failed','complete'].includes(old.status))fail('上次导入状态无效');idempotencyKey(old.key);
+  if(old.canon_revision!==undefined&&(!Number.isSafeInteger(old.canon_revision)||old.canon_revision<0))fail('上次导入基线无效');
+  if(['pending','unknown','complete'].includes(old.status)&&old.canon_revision===undefined)fail('上次提交缺少准确基线，不能重试写入');
+  if(old.receipt){keys(old.receipt,['id','version','revision','canonical_unchanged']);if(!digest(old.receipt.id))fail('上次候选身份无效');positiveRevision(old.receipt.version);if(old.receipt.revision!==undefined)positiveRevision(old.receipt.revision);if(old.receipt.canonical_unchanged!==true)fail('上次操作不是保存候选');}
+  if(old.status==='complete'&&!old.receipt)fail('已完成条目缺少回读身份');
+  const attempts=old.attempts===undefined?undefined:list(old.attempts,50).map(attempt=>{keys(attempt,['key','canon_revision','error','known_rejection']);idempotencyKey(attempt.key);if(!Number.isSafeInteger(attempt.canon_revision)||attempt.canon_revision<0||attempt.known_rejection!==true||typeof attempt.error!=='string')fail('原失败请求记录无效');return attempt;});
+  return {...entry,key:old.key,status:old.status==='pending'?'unknown':old.status,error:typeof old.error==='string'?old.error:'',...(old.canon_revision!==undefined?{canon_revision:old.canon_revision}:{}),...(old.receipt?{receipt:old.receipt}:{}),...(typeof old.known_rejection==='boolean'?{known_rejection:old.known_rejection}:{}),...(attempts?{attempts}:{})};
+ });
+ return sanitized;
+}
+
+export function developmentImportReadback(history,entry,receipt){
+ if(history?.item?.id!==receipt.id||history.item.project_id!==entry.project_id||history.item.kind!=='development_plan'||history.item.branch!=='main'||history.item.timeline!=='main'||history.item.archived||history.item.accepted_version===receipt.version||!Number.isSafeInteger(history.item.head_version)||history.item.head_version<receipt.version||!Number.isSafeInteger(history.item.revision)||history.item.revision<(receipt.revision??1))fail('候选身份、范围或审阅状态尚未准确核对');
+ const version=history.versions?.find(value=>value.version===receipt.version);
+ if(!version||version.actor_kind!=='human'||version.project_id!==entry.project_id||version.item_id!==receipt.id||version.base_canon_revision!==entry.canon_revision)fail('完整候选版本尚未回读');
+ const actual=version.content,expected=entry.content;
+ const normalized=normalizeDevelopmentImportContent(actual);
+ if(!same(actual,normalized))fail('回读内容包含未核对字段或默认值');
+ if(!Array.isArray(actual.sources)||actual.sources.length!==expected.sources.length)fail('候选来源数量不匹配');
+ const sources=actual.sources.map((source,index)=>{
+  const original=expected.sources[index];
+  if(source.kind==='item'&&original.kind==='item'){
+   if(!digest(source.sha256)||original.sha256&&source.sha256!==original.sha256)fail('候选准确来源未匹配');
+   const {sha256,...rest}=source;return original.sha256?source:rest;
+  }
+  if(['story','document'].includes(source.kind)&&original.kind===source.kind){
+   if(typeof source.quote!=='string'||!source.quote.trim())fail('候选引用原文尚未展开');
+   const {quote,...rest}=source;return original.quote!==undefined?source:rest;
+  }
+  return source;
+ });
+ if(!same({...actual,sources},expected))fail('回读的完整候选与原提交内容不一致');
+ return true;
+}
+
+/** Sequential single-entry transaction; unknown outcomes retain the same request. */
+export async function runDevelopmentImportEntry(api,job,index,persist){
+ let current=job,entry=current.entries[index];if(!entry||entry.status==='complete'||entry.status==='failed')return current;
+ const update=patch=>{const next={...current,entries:current.entries.map((row,i)=>i===index?{...row,...patch}:row)};try{persist(next);}catch{throw Object.assign(Error('恢复记录无法保存，已停止继续写入；请保留本页并核对上次结果'),{persistence:true});}current=next;entry=current.entries[index];};
+ let wrote=false;
+ try{
+  if(entry.canon_revision===undefined){
+   const graph=await api.story(entry.project_id,'graph?perspective=author&branch=main&timeline=main&candidates=false');
+   if(graph?.project_id!==entry.project_id||graph.perspective!=='author'||!Number.isSafeInteger(graph.canon_revision)||graph.canon_revision<0)fail('当前作品的正式基线尚未确认');
