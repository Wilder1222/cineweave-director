+ * this pure normalizer neither opens locators nor claims design/media readiness. */
+export function normalizeDevelopmentPlanSpec(input,{sources=[]}={}){
+ const spec=input??{};
+ keys(spec,['topic_id','intent',...textFields,'basis','basis_date','stages']);
+ const topic_id=spec.topic_id===undefined||spec.topic_id===null||spec.topic_id===''?null:spec.topic_id;
+ if(topic_id!==null&&(typeof topic_id!=='string'||!/^[A-Za-z0-9][A-Za-z0-9._-]{0,79}$/.test(topic_id)))error('INVALID_DEVELOPMENT_TOPIC',422,'选题号需要 1–80 位字母、数字、点、横线或下划线');
