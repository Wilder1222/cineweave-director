+import type {StoryContent,Project,ItemHistory} from './model';
+import type {WorkspaceApi} from './api';
+export const developmentStageLabels:Record<string,string>;
+export const developmentImportFormat:string;
+export const developmentImportLimit:number;
+export const developmentImportStorage:string;
+export interface DevelopmentImportReceipt {id:string;version:number;revision?:number;canonical_unchanged:true}
+export interface DevelopmentImportEntry {project_id:string;topic_id:string|null;content:StoryContent;key:string;status:'ready'|'pending'|'unknown'|'failed'|'complete';error:string;canon_revision?:number;receipt?:DevelopmentImportReceipt;known_rejection?:boolean;attempts?:{key:string;canon_revision:number;error:string;known_rejection:true}[]}
+export interface DevelopmentImportJob {format:string;entries:DevelopmentImportEntry[]}
+export function normalizeDevelopmentImportContent(input:unknown):StoryContent;
+export function parseDevelopmentPlanPackage(text:string,projects:Project[],newKey?:()=>string):DevelopmentImportJob;
+export function developmentImportCounts(job:DevelopmentImportJob|null):{complete:number;failed:number;unknown:number;remaining:number};
+export function developmentStageCoverage(spec?:Record<string,unknown>):{entries:{stage:string;plan:string}[];missing:string[]};
+export function sameDevelopmentPackage(a:DevelopmentImportJob,b:DevelopmentImportJob):boolean;
+export function developmentImportRequest(entry:DevelopmentImportEntry):Record<string,unknown>;
+export function persistDevelopmentImport(storage:Storage,job:DevelopmentImportJob):DevelopmentImportJob;
+export function recoverDevelopmentImport(storage:Storage,projects:Project[]):DevelopmentImportJob|null;
+export function developmentImportReadback(history:ItemHistory,entry:DevelopmentImportEntry,receipt:DevelopmentImportReceipt):true;
+export function runDevelopmentImportEntry(api:WorkspaceApi,job:DevelopmentImportJob,index:number,persist:(value:DevelopmentImportJob)=>void):Promise<DevelopmentImportJob>;
+export function retryFailedDevelopmentEntry(api:WorkspaceApi,job:DevelopmentImportJob,index:number,persist:(value:DevelopmentImportJob)=>void):Promise<DevelopmentImportJob>;
