+ const basis_date=requiredText(spec.basis_date,'依据日期',10);
+ if(!/^\d{4}-\d{2}-\d{2}$/.test(basis_date)||basis_date.startsWith('0000-')||!Number.isFinite(Date.parse(basis_date+'T00:00:00.000Z'))||new Date(basis_date+'T00:00:00.000Z').toISOString().slice(0,10)!==basis_date)error('INVALID_DEVELOPMENT_DATE',422,'依据日期需要真实的 YYYY-MM-DD 日期');
+ if(!Array.isArray(sources))error('INVALID_INPUT',422,'规划来源需要列表');
+ if(basis==='pinned_sources'&&!sources.some(source=>source&&['item','story','document'].includes(source.kind)&&typeof source.item_id==='string'&&Number.isSafeInteger(source.version)&&source.version>0))error('DEVELOPMENT_PIN_REQUIRED',422,'准确来源规划需要真正的版本化卡片或正文来源');
