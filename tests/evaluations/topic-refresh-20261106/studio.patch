+  if(lock.current||disabled||!projectsLoaded||recoveryBlocked||!job)return;lock.current=true;setBusy(true);onBusy(true);setError('');let current=job;
+  try{
+   const indices=current.entries.map((entry,index)=>({entry,index})).filter(({entry})=>failedOnly?entry.status==='failed':['ready','pending','unknown'].includes(entry.status)).slice(0,10).map(({index})=>index);
