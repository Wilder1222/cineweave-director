+  try{if(file.size>developmentImportLimit)throw Error('候选包不能超过 2 MB');const value=parseDevelopmentPlanPackage(await file.text(),projects,()=>api.newIdempotencyKey());if(job&&sameDevelopmentPackage(job,value)){onNotice('已保留此候选包原有提交与核对记录。');return;}remember(value);onNotice('候选包已读取。核对项目后，保存为待审候选。');}
