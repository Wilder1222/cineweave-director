+import type {WorkspaceApi} from './api';
+import type {FeedbackHandler,Project} from './model';
+import {errorMessage} from './advanced-api';
+import {developmentImportLimit,developmentImportStorage,parseDevelopmentPlanPackage,persistDevelopmentImport,recoverDevelopmentImport,developmentImportCounts,runDevelopmentImportEntry,retryFailedDevelopmentEntry,sameDevelopmentPackage,type DevelopmentImportJob} from './development-plan-import.mjs';
+
+interface Props {api:WorkspaceApi;projects:Project[];projectsLoaded:boolean;disabled?:boolean;onAttempt(action:()=>void):void;onDirty(value:boolean):void;onBusy(value:boolean):void;onError(message:string):void;onNotice:FeedbackHandler;onOpen(projectId:string,itemId:string):void}
+const stateNames={ready:'未处理',pending:'结果待核对',unknown:'结果待核对',failed:'失败',complete:'已保存并回读'};
+const basisNames:Record<string,string>={historical_snapshot:'历史快照 · 待当前回读',author_brief:'作者创作简报',pinned_sources:'准确版本来源'};
+/** A user-selected package stays in this browser session; only candidate records are written. */
+export default function DevelopmentPlanImport({api,projects,projectsLoaded,disabled=false,onAttempt,onDirty,onBusy,onError,onNotice,onOpen}:Props){
+ const [job,setJob]=useState<DevelopmentImportJob|null>(null),[busy,setBusy]=useState(false),[error,setError]=useState(''),[recoveryBlocked,setRecoveryBlocked]=useState(false);
+ const lock=useRef(false),restored=useRef(false),mounted=useRef(true);
+ const counts=developmentImportCounts(job),projectNames=new Map(projects.map(project=>[project.id,project.title]));
+ const dirty=(value:DevelopmentImportJob|null)=>{const n=developmentImportCounts(value);onDirty(n.remaining+n.unknown+n.failed>0);};
+ function remember(value:DevelopmentImportJob){persistDevelopmentImport(sessionStorage,value);if(mounted.current){setJob(value);dirty(value);}}
+ useEffect(()=>{mounted.current=true;if(projectsLoaded&&!restored.current){restored.current=true;try{const old=recoverDevelopmentImport(sessionStorage,projects);setJob(old);dirty(old);}catch(e){setError(errorMessage(e));setRecoveryBlocked(true);onDirty(true);}}return()=>{mounted.current=false;};},[projectsLoaded,projects]);
+ async function choose(file:File){
