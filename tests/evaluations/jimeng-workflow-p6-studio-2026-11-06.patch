+import test from 'node:test';
+import assert from 'node:assert/strict';
+import {episodeShotPlan,moveStoryReference,resetPlanningPins,sourceParagraphs} from '../../components/workspace/episode-shot-ux.mjs';
+
+const item=(id,kind,spec={},extra={})=>({id,kind,version:1,status:'accepted',content:{title:id,body:'',fields:{},sources:[],spec},...extra});
+test('declared episode membership retains scene order and sorts equal shot numbers stably',()=>{
+ const result=episodeShotPlan([item('scene-a','scene'),item('scene-b','scene'),item('chapter','chapter'),item('e2','episode',{number:2,scene_ids:[]}),item('e1','episode',{number:1,scene_ids:['scene-b','scene-a','missing']}),item('s-b','shot',{episode_id:'e1',scene_id:'scene-b',number:2}),item('s-a','shot',{episode_id:'e1',scene_id:'scene-b',number:2})]);
+ assert.deepEqual(result.groups.map(group=>group.episode.id),['e1','e2']);
+ assert.deepEqual(result.groups[0].scenes.map(entry=>entry.id),['scene-b','scene-a','missing']);
+ assert.deepEqual(result.groups[0].scenes[0].shots.map(shot=>shot.id),['s-a','s-b']);
+ assert.equal(result.groups[0].scenes[2].scene,null);assert.deepEqual(result.scenes,[]);assert.deepEqual(result.shots,[]);
+});
+test('candidate status and unexpanded parents remain truthful without guessing membership from titles',()=>{
+ const orphan=item('orphan','shot',{episode_id:'unloaded',scene_id:'scene',number:1},{status:'draft'});
+ const result=episodeShotPlan([item('scene','scene'),item('e','episode',{number:1,scene_ids:[]},{archived:true}),orphan,item('e 1 scene 1 shot 1','chapter')]);
+ assert.deepEqual(result.groups,[]);assert.deepEqual(result.scenes.map(value=>value.id),['scene']);assert.equal(result.shots[0].status,'draft');
+});
+test('scene reordering copies input and preserves IDs at boundaries',()=>{
+ const original=['a','b','c'];assert.deepEqual(moveStoryReference(original,1,-1),['b','a','c']);assert.deepEqual(original,['a','b','c']);assert.deepEqual(moveStoryReference(original,0,-1),original);assert.deepEqual(moveStoryReference(original,2,1),original);
+});
+test('explicit re-pin removes only original/current structural pins and scene paragraph pins',()=>{
+ const sources=[{kind:'item',item_id:'old-episode',version:1},{kind:'item',item_id:'episode',version:1},{kind:'item',item_id:'old-scene',version:1},{kind:'item',item_id:'scene',version:1},{kind:'item',item_id:'cast',version:1},{kind:'item',item_id:'research',version:1},{kind:'story',item_id:'scene',version:1,paragraph:1},{kind:'story',item_id:'old-scene',version:1,paragraph:2},{kind:'story',item_id:'research',version:1,paragraph:1},{kind:'document',item_id:'scene',version:1},{kind:'note',text:'手工依据'}];
+ const content={title:'镜头',body:'',fields:{},sources,spec:{episode_id:'episode',scene_id:'scene',cast:['cast']}};
+ const result=resetPlanningPins('shot',content,{spec:{episode_id:'old-episode',scene_id:'old-scene'}});
+ assert.deepEqual(result.sources,sources.slice(5,6).concat(sources.slice(8)));assert.equal(content.sources.length,11);assert.equal(result.spec,content.spec);
+});
+test('episode re-pin preserves unrelated paragraphs, notes and unsupported kinds',()=>{
+ const content={title:'集',body:'',fields:{},spec:{previous_episode_id:'e0',scene_ids:['scene']},sources:[{kind:'item',item_id:'scene'},{kind:'item',item_id:'old-scene'},{kind:'item',item_id:'e0'},{kind:'story',item_id:'scene',paragraph:1},{kind:'note',text:'依据'}]};
+ assert.deepEqual(resetPlanningPins('episode',content,{spec:{scene_ids:['old-scene']}}).sources,content.sources.slice(3));
+ assert.deepEqual(resetPlanningPins('chapter',content).sources,content.sources);
