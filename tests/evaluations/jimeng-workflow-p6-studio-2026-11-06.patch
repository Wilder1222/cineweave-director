+'use client';
+import {Button} from '@/components/ui/button';
+import {episodeShotPlan} from './episode-shot-ux.mjs';
+import {statusLabels,type StoryItem} from './model';
+
+interface Props {items:StoryItem[];candidates:boolean;onCandidates():void;onSelect(id:string):void}
+/** Text planning records use the existing guarded inspector, never a media timeline. */
+export default function EpisodeShotPlan({items,candidates,onCandidates,onSelect}:Props){
+ const plan=episodeShotPlan(items);
+ const open=(item:StoryItem,prefix:string)=><Button type="button" variant="record" size="record" className="cw-document-open" onClick={()=>onSelect(item.id)}><span>{prefix}{item.content.title}<small>{statusLabels[item.status]||'状态未记录'} · v{item.version}{item.needs_review?.length?' · 来源待复核':''}</small></span></Button>;
+ const shot=(item:StoryItem)=>open(item,`镜 ${String(item.content.spec?.number??'未编号')} · `);
+ return <section aria-label="分集场次与镜头计划"><header className="cw-module-toolbar"><h2>分集与镜头</h2><Button type="button" variant="ghost" aria-pressed={candidates} onClick={onCandidates}>{candidates?'隐藏未采纳候选':'显示未采纳候选'}</Button></header>
+ {!plan.groups.length&&!plan.scenes.length&&!plan.shots.length&&<p>尚无结构记录。可先保存场次，再编排分集与镜头计划。</p>}
+ {plan.groups.map(group=><section className="cw-inspector-section" key={group.episode.id}>{open(group.episode,`第 ${String(group.episode.content.spec?.number??'未编号')} 集 · `)}{group.scenes.length?<ol>{group.scenes.map((entry,index)=><li key={entry.id}>{entry.scene?open(entry.scene,`场 ${index+1} · `):<p>场 {index+1} · 原关联未在当前快照展开</p>}{entry.shots.length?<ul>{entry.shots.map(item=><li key={item.id}>{shot(item)}</li>)}</ul>:<p className="cw-small-copy">尚无此场次的镜头计划。</p>}</li>)}</ol>:<p className="cw-small-copy">尚未编排场次。</p>}</section>)}
+ {plan.scenes.length>0&&<section className="cw-inspector-section"><h3>未编入已显示分集的场次</h3>{plan.scenes.map(item=><div key={item.id}>{open(item,'场次 · ')}</div>)}</section>}
+ {plan.shots.length>0&&<section className="cw-inspector-section"><h3>所属结构未在当前快照展开的镜头</h3>{plan.shots.map(item=><div key={item.id}>{shot(item)}</div>)}</section>}
+ </section>;
+}
