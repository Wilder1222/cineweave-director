+import type {StoryContent,StoryItem} from './model';
+export interface EpisodeGroup {episode:StoryItem;scenes:{id:string;scene:StoryItem|null;shots:StoryItem[]}[]}
+export function episodeShotPlan(items:StoryItem[]):{groups:EpisodeGroup[];scenes:StoryItem[];shots:StoryItem[]};
+export function moveStoryReference(value:unknown,index:number,direction:number):string[];
+export function sourceParagraphs(body:unknown):string[];
+export function resetPlanningPins(kind:string,content:StoryContent,original?:Partial<StoryContent>):StoryContent;
diff --git a/components/workspace/episode-shot-ux.mjs b/components/workspace/episode-shot-ux.mjs
new file mode 100644
index 0000000..3e6b921
--- /dev/null
+++ b/components/workspace/episode-shot-ux.mjs
@@ -0,0 +1,37 @@
+const ids = value => Array.isArray(value) ? value.filter(id => typeof id === 'string' && id) : [];
+const order = (a, b) => (a.content?.spec?.number ?? Infinity) - (b.content?.spec?.number ?? Infinity) || a.id.localeCompare(b.id);
+
+/** Reading order is explicit metadata; no text parsing or membership inference. */
+export function episodeShotPlan(items) {
+  const active = items.filter(item => !item.archived);
+  const byId = new Map(active.map(item => [item.id, item]));
+  const episodes = active.filter(item => item.kind === 'episode').sort(order);
+  const shots = active.filter(item => item.kind === 'shot').sort(order);
+  const placedScenes = new Set(), placedShots = new Set();
+  const groups = episodes.map(episode => ({ episode, scenes: ids(episode.content.spec?.scene_ids).map(id => {
+    const item = byId.get(id), scene = item?.kind === 'scene' ? item : null;
+    if (scene) placedScenes.add(id);
+    const children = shots.filter(shot => shot.content.spec?.episode_id === episode.id && shot.content.spec?.scene_id === id);
+    children.forEach(shot => placedShots.add(shot.id));
+    return { id, scene, shots: children };
+  }) }));
+  return { groups, scenes: active.filter(item => item.kind === 'scene' && !placedScenes.has(item.id)).sort((a, b) => (a.content.narrative_order ?? a.content.story_order ?? Infinity) - (b.content.narrative_order ?? b.content.story_order ?? Infinity) || a.id.localeCompare(b.id)), shots: shots.filter(shot => !placedShots.has(shot.id)) };
+}
+
+export function moveStoryReference(value, index, direction) {
+  const result = ids(value), next = index + direction;
+  if (!Number.isInteger(index) || ![-1, 1].includes(direction) || index < 0 || index >= result.length || next < 0 || next >= result.length) return result;
+  [result[index], result[next]] = [result[next], result[index]];
+  return result;
+}
+
+/** Matches the story service's blank-line paragraph numbering. */
+export const sourceParagraphs = body => String(body || '').split(/\n\s*\n/).map(part => part.trim()).filter(Boolean);
+
+/** Explicit re-pin only: leave notes, documents and unrelated manual evidence intact. */
+export function resetPlanningPins(kind, content, original = {}) {
+  const specs = [content.spec || {}, original.spec || {}];
+  const structural = new Set(specs.flatMap(spec => kind === 'episode' ? [...ids(spec.scene_ids), spec.previous_episode_id].filter(Boolean) : kind === 'shot' ? [spec.episode_id, spec.scene_id, ...ids(spec.cast)].filter(Boolean) : []));
+  const scenes = new Set(kind === 'shot' ? specs.map(spec => spec.scene_id).filter(Boolean) : []);
+  return { ...content, sources: (content.sources || []).filter(source => !(source.kind === 'item' && structural.has(source.item_id)) && !(source.kind === 'story' && scenes.has(source.item_id))) };
+}
