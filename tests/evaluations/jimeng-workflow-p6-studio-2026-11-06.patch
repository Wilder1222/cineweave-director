diff --git a/studio-core/src/story-structure.mjs b/studio-core/src/story-structure.mjs
new file mode 100644
index 0000000..eeaa93a
--- /dev/null
+++ b/studio-core/src/story-structure.mjs
@@ -0,0 +1,45 @@
+import {error,objectInput,optionalText,stableId} from './validation.mjs';
+
+export const structureKinds=['episode','shot'];
+const keys=(value,allowed)=>{objectInput(value);for(const key of Object.keys(value))if(!allowed.includes(key))error('INVALID_SPEC_FIELD',422,'不支持的创作文稿字段：'+key);};
+const list=(value=[],label,max=100)=>{if(!Array.isArray(value)||value.length>max)error('INVALID_STRUCTURE_LIST',422,label+'最多 '+max+' 项');return value;};
+const unique=(value,label,normalize)=>{const result=list(value,label).map(normalize);if(new Set(result).size!==result.length)error('DUPLICATE_STRUCTURE_REFERENCE',422,label+'不能重复');return result;};
+const number=(value,label)=>{if(!Number.isSafeInteger(value)||value<1)error('INVALID_STRUCTURE_NUMBER',422,label+'必须为正整数');return value;};
+const text=(value,label)=>optionalText(value,label,8000);
+
+/** Author-supplied plans only. Dependencies use immutable story versions; reverse
+ * membership is a reading projection, never another versioned parent pointer. */
+export async function normalizeStoryStructure(kind,input,ctx){
+ const s=input??{};
+ if(kind==='episode'){
+  keys(s,['number','goal','entry_state','exit_state','previous_episode_id','scene_ids']);
+  const result={number:number(s.number,'集号'),goal:text(s.goal,'本集目标'),entry_state:text(s.entry_state,'入集状态'),exit_state:text(s.exit_state,'离集状态'),scene_ids:unique(s.scene_ids,'分集场次',stableId)};
+  if(s.previous_episode_id){
+   const previousId=stableId(s.previous_episode_id),seen=new Set(ctx.itemId?[ctx.itemId]:[]);
+   if(seen.has(previousId))error('EPISODE_DEPENDENCY_CYCLE',422,'前集关联不能返回当前分集或形成循环');
+   let previous=await ctx.dep(previousId,['episode']);if(previous.content.spec.number>=result.number)error('PREVIOUS_EPISODE_ORDER',422,'前集的编号必须小于本集');result.previous_episode_id=previous.id;
+   while(previous){
+    if(seen.has(previous.id))error('EPISODE_DEPENDENCY_CYCLE',422,'前集关联不能返回当前分集或形成循环');seen.add(previous.id);
+    const ancestorId=previous.content.spec.previous_episode_id;if(!ancestorId)break;
+    if(seen.has(ancestorId))error('EPISODE_DEPENDENCY_CYCLE',422,'前集关联不能返回当前分集或形成循环');
+    const pin=previous.content.sources.find(source=>source.kind==='item'&&source.item_id===ancestorId);if(!pin)error('EPISODE_PREVIOUS_PIN_REQUIRED',422,'前集链缺少准确版本来源');
+    previous=await ctx.readDependency(ancestorId,['episode'],pin.version);if(previous.sha256!==pin.sha256)error('SOURCE_HASH_MISMATCH',422,'前集链的固定哈希不一致');
+   }
+  }
+  for(const id of result.scene_ids)await ctx.dep(id,['scene']);
+  return result;
+ }
+ keys(s,['episode_id','scene_id','number','duration_ms','cast','framing','camera','action','dialogue','source_paragraphs']);
+ const episode=await ctx.dep(stableId(s.episode_id),['episode']),sceneId=stableId(s.scene_id);
+ if(!episode.content.spec.scene_ids.includes(sceneId))error('SHOT_SCENE_SCOPE',422,'镜头场次不属于所选分集的准确版本');
+ const scenePin=episode.content.sources.find(source=>source.kind==='item'&&source.item_id===sceneId);
+ if(!scenePin)error('EPISODE_SCENE_PIN_REQUIRED',422,'分集场次缺少准确版本来源');
+ const scene=await ctx.dep(sceneId,['scene'],true,scenePin.version);
+ if(scene.sha256!==scenePin.sha256)error('SOURCE_HASH_MISMATCH',422,'镜头场次与分集固定的来源哈希不同');
+ const cast=unique(s.cast,'镜头人物',stableId),allowed=new Set(scene.content.spec?.cast??[]);
+ for(const id of cast){if(!allowed.has(id))error('SHOT_CAST_SCOPE',422,'镜头人物不在该场次的出场状态中');await ctx.dep(id,['instance']);}
+ const source_paragraphs=unique(s.source_paragraphs,'正文段落',value=>number(value,'正文段落'));
+ for(const source of ctx.sources.filter(source=>source.kind==='story'))if(source.item_id!==scene.id||source.version!==scene.version||!source_paragraphs.includes(source.paragraph))error('SHOT_PARAGRAPH_SCOPE',422,'镜头正文来源必须属于所选场次的准确版本和明确段落');
+ for(const index of source_paragraphs)await ctx.paragraph(scene.id,scene.version,index,'scene');
+ return {episode_id:episode.id,scene_id:scene.id,number:number(s.number,'镜号'),duration_ms:s.duration_ms==null?null:number(s.duration_ms,'计划时长（毫秒）'),cast,framing:text(s.framing,'景别与构图'),camera:text(s.camera,'机位与运动'),action:text(s.action,'镜头动作'),dialogue:text(s.dialogue,'准确台词'),source_paragraphs};
+}
