+test('production composition cannot reintroduce duplicate project keys that retain stale relation DOM',async()=>{
+ // The former ProjectRelations key={pid} and DocumentEditor key={project.id}
+ // were sibling aliases of the same key. Async loading inserts caused React to
+ // retain old relation DOM. Inspect actual JSX sibling groups, not string count.
+ const file=await readFile(path.join(site,'components/workspace/production-workspace.tsx'),'utf8');
+ const tree=ts.createSourceFile('production-workspace.tsx',file,ts.ScriptTarget.Latest,true,ts.ScriptKind.TSX);
+ function keyOf(node){
+  if(ts.isJsxExpression(node)&&node.expression)return keyOf(node.expression);
+  if(ts.isBinaryExpression(node)&&node.operatorToken.kind===ts.SyntaxKind.AmpersandAmpersandToken)return keyOf(node.right);
+  const opening=ts.isJsxElement(node)?node.openingElement:ts.isJsxSelfClosingElement(node)?node:null;
+  if(!opening)return null;
+  const key=opening.attributes.properties.find(attr=>ts.isJsxAttribute(attr)&&attr.name.text==='key');
+  if(!key?.initializer)return null;
+  const value=ts.isJsxExpression(key.initializer)?key.initializer.expression?.getText(tree):key.initializer.getText(tree);
+  return value==='pid'||value==='project.id'?'project-identity':value;
+ }
+ function visit(node){
+  if(ts.isJsxElement(node)||ts.isJsxFragment(node)){
+   const keys=node.children.map(keyOf).filter(Boolean);
+   assert.equal(new Set(keys).size,keys.length,'Duplicate sibling keys at '+tree.getLineAndCharacterOfPosition(node.pos).line+': '+keys.join(', '));
+  }
+  ts.forEachChild(node,visit);
+ }
+ visit(tree);
+});
