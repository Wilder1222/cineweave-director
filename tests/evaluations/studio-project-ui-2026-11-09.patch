+++ b/components/workspace/project-navigation.tsx
@@ -0,0 +1,38 @@
+'use client';
+import {useMemo,useRef,useState,type PointerEvent} from 'react';
+import {ArrowLeft,ArrowRight,ArrowUpRight,BookOpen,Check,Clapperboard,FolderOpen,Grid2X2,Layers3,ListChecks,Network,NotebookPen,Search,Send,UsersRound,Workflow,X} from 'lucide-react';
+import {Button} from '@/components/ui/button';
+import {Input} from '@/components/ui/input';
+import {Dialog,DialogContent,DialogTitle,DialogDescription,DialogTrigger} from '@/components/ui/dialog';
+import {directoryPage,directoryTitle,directoryKindLabel,DIRECTORY_KINDS,formatDirectoryDate} from './project-directory.mjs';
+import {workflowStages} from './workflow-navigation.mjs';
+import type {Project} from './model';
+import './project-navigation.css';
+
+const icons:Record<string,typeof BookOpen>={screenplay:Clapperboard,episodes:Layers3,storyboard:Grid2X2,prompts:NotebookPen,canvas:UsersRound,relations:Network,novel:BookOpen,planning:FolderOpen,review:Check,tasks:ListChecks,production:Workflow,delivery:Send};
+
+/** Routing stays with the workspace, including its dirty/save guard. */
+export function ProjectNavigation({view,onNavigate}:{view:string;onNavigate(view:string):void}){
+ return <nav className="cw-project-navigation" aria-label="项目功能">{workflowStages.map(stage=>{const Icon=icons[stage.value]||FolderOpen;return <Button type="button" key={stage.value} variant="ghost" aria-current={view===stage.value?'page':undefined} onClick={()=>onNavigate(stage.value)}><Icon size={17} strokeWidth={1.6}/><span>{stage.label}</span></Button>;})}</nav>;
+}
+
+export function ProjectSwitcher({projects,project,loaded,loadError=false,onReload,onChoose}:{projects:Project[];project:Project|null;loaded:boolean;loadError?:boolean;onReload?():void;onChoose(project:Project):void}){
+ const [open,setOpen]=useState(false),[query,setQuery]=useState(''),[kind,setKind]=useState('all'),[page,setPage]=useState(1);
+ const search=useRef<HTMLInputElement>(null);
+ const result=useMemo(()=>directoryPage(projects,{query,kind,page,pageSize:12}),[projects,query,kind,page]);
+ const spotlight=(event:PointerEvent<HTMLButtonElement>)=>{if(event.pointerType!=='mouse'||window.matchMedia('(prefers-reduced-motion: reduce)').matches)return;const rect=event.currentTarget.getBoundingClientRect();event.currentTarget.style.setProperty('--pointer-x',`${event.clientX-rect.left}px`);event.currentTarget.style.setProperty('--pointer-y',`${event.clientY-rect.top}px`);};
+ return <Dialog open={open} onOpenChange={value=>{setOpen(value);if(value){setQuery('');setKind('all');setPage(1);}}}>
+  <DialogTrigger asChild><Button type="button" variant="ghost" className="cw-project-switch-trigger" aria-label="切换项目"><Grid2X2 size={17}/><span>切换项目</span></Button></DialogTrigger>
+  <DialogContent className="cw-theme cw-project-switcher" showCloseButton={false} onOpenAutoFocus={event=>{event.preventDefault();search.current?.focus();}}>
+   <header><div><DialogTitle>切换项目</DialogTitle><DialogDescription className="sr-only">搜索并打开项目，保留当前功能入口。</DialogDescription></div><Button type="button" variant="ghost" size="icon" aria-label="关闭项目切换" onClick={()=>setOpen(false)}><X size={20}/></Button></header>
+   <label className="cw-project-switch-search"><Search size={19}/><Input ref={search} type="search" aria-label="搜索切换项目" placeholder="搜索项目" value={query} onChange={event=>{setQuery(event.target.value);setPage(1);}}/></label>
+   <div className="cw-project-switch-filters" role="group" aria-label="项目形式">{['all',...DIRECTORY_KINDS].map(value=><Button key={value} type="button" variant="ghost" aria-pressed={kind===value} onClick={()=>{setKind(value);setPage(1);}}>{value==='all'?'全部':directoryKindLabel(value)}</Button>)}<span aria-live="polite">{loaded?`${result.total} 个项目`:loadError?'读取失败':'正在读取'}</span></div>
+   <div className="cw-project-switch-results" aria-label="可切换项目" aria-busy={!loaded&&!loadError}>
+    {result.rows.map(row=><Button type="button" variant="record" size="record" key={row.id} className="cw-project-switch-card" aria-label={`切换到项目：${directoryTitle(row)}`} aria-current={row.id===project?.id?'true':undefined} onPointerMove={spotlight} onClick={()=>{setOpen(false);if(row.id!==project?.id)onChoose(row);}}><span className="cw-project-switch-card-top"><span>{directoryKindLabel(row.kind)}</span>{row.id===project?.id?<span><Check size={14}/>当前</span>:<ArrowUpRight size={16}/>}</span><strong>{directoryTitle(row)}</strong><span className="cw-project-switch-card-date">{formatDirectoryDate(row.updated_at)||'未记录日期'}</span></Button>)}
+    {loadError&&!loaded&&<div className="cw-project-switch-empty" role="alert"><p>项目暂未读取</p><Button variant="outline" onClick={onReload}>重新读取</Button></div>}
+    {loaded&&!result.total&&<div className="cw-project-switch-empty"><FolderOpen size={30}/><p>{projects.length?'没有匹配的项目':'暂无项目'}</p>{projects.length>0&&<Button variant="outline" onClick={()=>{setQuery('');setKind('all');setPage(1);}}>清除筛选</Button>}</div>}
+   </div>
+   <footer><span>{result.total?`${result.start}–${result.end} / ${result.total}`:'0'}</span><div><Button type="button" variant="ghost" size="icon" aria-label="上一页项目" disabled={result.page<=1} onClick={()=>setPage(result.page-1)}><ArrowLeft size={18}/></Button><Button type="button" variant="ghost" size="icon" aria-label="下一页项目" disabled={result.page>=result.pages} onClick={()=>setPage(result.page+1)}><ArrowRight size={18}/></Button></div></footer>
+  </DialogContent>
+ </Dialog>;
+}
