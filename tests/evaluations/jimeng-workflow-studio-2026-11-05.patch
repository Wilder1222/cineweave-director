+export interface RelationRecord {id:string;kind:string;title:string;version:number;status:string;needsReview:boolean;age:string;time:string;validFrom:string|number|null;validTo:string|number|null}
+export interface RelationEdge {from:string;to:string;label:string;state:string;version:number|null;sha256:string}
+export interface ExternalRelation {owner:string;kind:'actor'|'look'|'document';id:string;label:string;revision:number|null;profileVersion?:string;actorId?:string;lookbookId?:string;lookbookRevision?:number|null}
+export interface RelationAsset {id:string;uses:{usage:string;targetId:string}[]}
+export interface RelationProjection {available:boolean;reason?:string;canonRevision?:number|null;records:RelationRecord[];edges:RelationEdge[];external:ExternalRelation[];assets:RelationAsset[];assetScope:string;notices:string[];gaps:string[]}
+export function projectRelations(projectId:string,graph:unknown,handoff?:unknown):RelationProjection;
diff --git a/components/workspace/project-relations.mjs b/components/workspace/project-relations.mjs
new file mode 100644
index 0000000..c29de2d
--- /dev/null
+++ b/components/workspace/project-relations.mjs
@@ -0,0 +1,76 @@
+const object = value => value && typeof value === 'object' && !Array.isArray(value) ? value : {};
+const text = value => typeof value === 'string' ? value : '';
+const list = value => Array.isArray(value) ? value : [];
+const kinds = new Set(['character', 'instance', 'scene', 'casting', 'appearance', 'chapter', 'adaptation', 'outline', 'event', 'relation', 'simulation', 'knowledge', 'review', 'review_policy']);
+const hash = value => typeof value === 'string' && /^[a-f0-9]{64}$/.test(value);
+
+/** A reading projection of an already-authorized main/main author graph. No I/O,
+ * content parsing, adoption, rebase, guessed episodes or inferred asset ownership. */
+export function projectRelations(projectId, graph, handoff = null) {
+  const empty = { available: false, records: [], edges: [], external: [], assets: [], assetScope: 'not_loaded', notices: [], gaps: ['分集关系尚未结构化', '逐镜关系尚未结构化'] };
+  if (!projectId || graph?.project_id !== projectId || graph?.perspective !== 'author' || !Array.isArray(graph?.nodes)) {
+    return { ...empty, reason: '当前作品的作者快照尚未确认，请重新读取工作区。' };
+  }
+  const eligible = graph.nodes.filter(node => node && text(node.id) && kinds.has(node.kind) && !node.archived && node.project_id === projectId && node.branch === 'main' && node.timeline === 'main' && Number.isSafeInteger(node.version) && node.version > 0 && node.content && typeof node.content === 'object');
+  const duplicates = new Set(eligible.filter((node, index) => eligible.findIndex(other => other.id === node.id) !== index).map(node => node.id));
+  const nodes = eligible.filter(node => !duplicates.has(node.id));
+  const byId = new Map(nodes.map(node => [node.id, node]));
+  const records = nodes.map(node => ({ id: node.id, kind: node.kind, title: text(node.content.title) || '未命名记录', version: node.version, status: text(node.status), needsReview: list(node.needs_review).length > 0,
+    age: text(node.content.fields?.age), time: text(node.content.fields?.time_label), validFrom: node.content.valid_from ?? null, validTo: node.content.valid_to ?? null }));
+  const edges = [], external = [], seen = new Set();
+  function add(node, targetId, label, allowed = null, pin = null) {
+    if (!text(targetId)) return;
+    const target = byId.get(targetId), key = JSON.stringify([node.id, targetId, label, pin?.version, pin?.sha256]);
+    if (seen.has(key)) return; seen.add(key);
+    let state = !target ? 'not_loaded' : allowed && !allowed.includes(target.kind) ? 'kind_mismatch' : 'loaded';
+    if (state === 'loaded' && pin) {
+      if (!Number.isSafeInteger(pin.version) || pin.version < 1 || pin.kind === 'item' && !hash(pin.sha256)) state = 'pin_missing';
+      else if (target.version !== pin.version) state = 'version_mismatch';
+      else if (pin.sha256 && (!hash(pin.sha256) || target.sha256 !== pin.sha256)) state = 'hash_mismatch';
+    }
+    edges.push({ from: node.id, to: targetId, label, state, version: pin?.version ?? null, sha256: text(pin?.sha256) });
+  }
+  for (const node of nodes) {
+    const fields = object(node.content.fields), spec = object(node.content.spec);
+    if (node.kind === 'instance') add(node, fields.character_id, '所属角色', ['character']);
+    if (node.kind === 'scene') {
+      for (const id of list(spec.cast)) add(node, id, '出场状态', ['instance']);
+      add(node, spec.adaptation_id, '改编方案', ['adaptation']);
+    }
+    if (node.kind === 'casting') {
+      add(node, spec.character_id, '选角角色', ['character']);
+      if (text(spec.ip_id)) external.push({ owner: node.id, kind: 'actor', id: spec.ip_id, label: '演员 IP', revision: spec.identity_revision ?? null, profileVersion: text(spec.profile_version) });
+    }
+    if (node.kind === 'appearance') {
+      add(node, spec.casting_id, '使用选角', ['casting']);
+      add(node, spec.target_id, '适用状态／场次', ['instance', 'event', 'scene']);
+      if (text(spec.look_id)) external.push({ owner: node.id, kind: 'look', id: spec.look_id, actorId: text(spec.ip_id), label: '造型', revision: spec.look_revision ?? null, lookbookId: text(spec.lookbook_id), lookbookRevision: spec.lookbook_revision ?? null });
+    }
+    if (node.kind === 'chapter') { add(node, spec.outline_id, '章节大纲', ['outline']); add(node, spec.simulation_id, '角色推演', ['simulation']); }
+    if (node.kind === 'adaptation') add(node, spec.chapter_id, '改编来源章节', ['chapter']);
+    if (node.kind === 'event') for (const id of list(fields.participants)) add(node, id, '参与状态', ['instance']);
+    if (node.kind === 'relation') { add(node, fields.from_id, '关系起点'); add(node, fields.to_id, '关系终点'); }
+    for (const source of list(node.content.sources)) {
+      if (['item', 'story'].includes(source?.kind)) add(node, source.item_id, '来源版本', null, source);
+      if (source?.kind === 'document' && text(source.item_id)) external.push({ owner: node.id, kind: 'document', id: source.item_id, label: '来源文稿', revision: source.version ?? null });
+    }
+  }
+  const notices = [];
+  if (eligible.length !== graph.nodes.length) notices.push('部分记录不属于当前项目／分支、已归档或字段不完整，未展开。');
+  if (duplicates.size) notices.push('发现重复记录 ID，未选择其中任何版本。');
+  let assetScope = 'not_loaded', assets = [];
+  if (handoff) {
+    if (handoff.project_id !== projectId || handoff.manifest?.project?.id !== projectId) {
+      notices.push('已读取交接与当前作品不匹配，未展开其资产。'); assetScope = 'scope_mismatch';
+    } else if (handoff.manifest.production && (handoff.manifest.production.branch !== 'main' || handoff.manifest.production.timeline !== 'main')) {
+      notices.push('场次交接的分支／时间线不同或尚未确认，未与当前主线快照合并。'); assetScope = 'scope_mismatch';
+    } else {
+      assetScope = handoff.stale === true ? 'stale' : 'frozen';
+      const declared = [...list(handoff.manifest.assets).map(asset => ({ id: asset?.frame_asset_id, usage: text(asset?.usage), targetId: text(asset?.target_id) })), ...list(handoff.manifest.production?.assets).map(id => ({ id, usage: '场次冻结引用', targetId: '' }))];
+      const valid = declared.filter(asset => hash(asset.id));
+      if (valid.length !== declared.length) notices.push('部分交接资产引用格式不完整，未展开。');
+      assets = [...new Set(valid.map(asset => asset.id))].map(id => ({ id, uses: valid.filter(asset => asset.id === id).map(asset => ({ usage: asset.usage, targetId: asset.targetId })) }));
+    }
+  }
+  return { ...empty, available: true, reason: '', canonRevision: graph.canon_revision ?? null, records, edges, external, assets, assetScope, notices };
+}
