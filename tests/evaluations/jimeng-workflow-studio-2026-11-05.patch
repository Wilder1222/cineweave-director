+'use client';
+import {useMemo,useState} from 'react';
+import {Button} from '@/components/ui/button';
+import {NativeSelect} from '@/components/ui/native-select';
+import {kindLabels,statusLabels,type GraphData,type ItemKind} from './model';
+import {projectRelations} from './project-relations.mjs';
+import './project-relations.css';
+
+interface Props {projectId:string;graph:GraphData|null;handoff?:unknown;onSelect(id:string):void;onAttempt(action:()=>void):void;onProduction?():void}
+const relationState:Record<string,string>={not_loaded:'未在当前快照展开',kind_mismatch:'引用类型需核对',pin_missing:'来源版本未记录',version_mismatch:'与当前显示版本不同',hash_mismatch:'来源内容需核对'};
+const label=(kind:string)=>kindLabels[kind as ItemKind]||kind;
+/** Ordinary record navigation over the existing graph. No writes or media controls. */
+export default function ProjectRelations({projectId,graph,handoff,onSelect,onAttempt,onProduction}:Props){
+ const [kind,setKind]=useState('all'),[chosen,setChosen]=useState('');
+ const data=useMemo(()=>projectRelations(projectId,graph,handoff),[projectId,graph,handoff]);
+ const records=data.records.filter(record=>kind==='all'||record.kind===kind);
+ const focus=records.find(record=>record.id===chosen)||records.find(record=>record.kind==='scene')||records[0];
+ const byId=new Map(data.records.map(record=>[record.id,record]));
+ const direct=focus?data.edges.filter(edge=>edge.from===focus.id||edge.to===focus.id):[];
+ const outside=focus?data.external.filter(source=>source.owner===focus.id):[];
+ const open=(href:string)=>onAttempt(()=>window.location.assign(href));
+ return <details className="cw-project-relations"><summary>项目关系查阅</summary><section aria-label="当前作品的已声明关系">
+ {!data.available?<p role="status">{data.reason}</p>:<>
+ <p className="cw-small-copy">{data.gaps.join('；')}。以下按已读取记录查阅，章节不等于集，场次不等于镜头。</p>
+ {data.notices.map(notice=><p key={notice} className="cw-warning">{notice}</p>)}
+ <div className="cw-project-relations-tools"><label>记录类型<NativeSelect value={kind} onChange={event=>{setKind(event.target.value);setChosen('');}}><option value="all">全部记录</option>{[...new Set(data.records.map(record=>record.kind))].map(value=><option key={value} value={value}>{label(value)}</option>)}</NativeSelect></label><label>选择原记录<NativeSelect value={focus?.id||''} disabled={!records.length} onChange={event=>setChosen(event.target.value)}>{!records.length&&<option value="">没有此类记录</option>}{records.map(record=><option key={record.id} value={record.id}>{label(record.kind)} · {record.title} · v{record.version} · {record.id.slice(0,8)}</option>)}</NativeSelect></label></div>
+ {focus?<article className="cw-project-relations-record"><header><div><h3>{focus.title}</h3><p>{label(focus.kind)} · v{focus.version} · {statusLabels[focus.status]||'状态未记录'}{focus.needsReview?' · 依赖需核对':''}</p></div><Button type="button" variant="outline" onClick={()=>onSelect(focus.id)}>打开原记录</Button></header>
+ {focus.kind==='instance'&&<p>年龄：{focus.age||'未记录'}；时期：{focus.time||'未记录'}；生效时点：{focus.validFrom??'未定'} 至 {focus.validTo??'未定'}。</p>}
+ <h4>直接关联</h4>{!direct.length&&!outside.length?<p>当前快照没有声明此记录的直接关联。</p>:<ul className="cw-project-relations-list">{direct.map((edge,index)=>{const incoming=edge.to===focus.id,other=byId.get(incoming?edge.from:edge.to);return <li key={JSON.stringify([edge.from,edge.to,edge.label,index])}><div><span>{incoming?'被引用为：':'引用：'}{edge.label}</span>{other?<Button type="button" variant="ghost" onClick={()=>{setKind('all');setChosen(other.id);onSelect(other.id);}}>{other.title} · {label(other.kind)} · v{other.version}</Button>:<code>{incoming?edge.from:edge.to}</code>}</div><p className="cw-small-copy">{edge.version!==null?`来源固定 v${edge.version}；`:''}{edge.state==='loaded'?'记录已展开；准确来源和全文见原记录。':relationState[edge.state]||'待核对'}</p></li>;})}{outside.map((source,index)=><li key={source.kind+':'+source.id+':'+index}><div><span>{source.label} · {source.revision!==null?`v${source.revision}`:'版本未记录'}</span><code>{source.id}</code></div>{source.kind==='actor'&&<Button type="button" variant="ghost" onClick={()=>open('/workspace?view=ip&actor='+encodeURIComponent(source.id))}>到演员资料核对</Button>}{source.kind==='look'&&source.actorId&&<Button type="button" variant="ghost" onClick={()=>open('/workspace?view=ip&actor='+encodeURIComponent(source.actorId||'')+'&actorTab=looks')}>到演员造型核对</Button>}{source.kind==='document'&&<Button type="button" variant="ghost" onClick={()=>open('/studio?project='+encodeURIComponent(projectId)+'&document='+encodeURIComponent(source.id)+'#scripts')}>打开来源文稿</Button>}<p className="cw-small-copy">此处仅展示引用；外部记录与准确历史版本尚未展开。</p></li>)}</ul>}
+ </article>:<p>当前快照没有可展开的故事记录。已有文稿仍可从上方文稿入口读取。</p>}
+ <div className="cw-project-relations-assets"><h4>冻结交接的资产引用</h4>{data.assetScope==='not_loaded'?<p>尚未选择并读取交接包；资产依赖未展开。</p>:data.assetScope==='scope_mismatch'?<p>交接范围与当前快照不同或尚未确认，请重新选择。</p>:<><p>{data.assetScope==='stale'?'交接来源已有变化，保留原冻结引用。':'当前选择交接中的冻结引用。'} 原图可访问性与媒体质量需另行核对。</p>{data.assets.length?<ul>{data.assets.map(asset=><li key={asset.id}><code>{asset.id}</code><p className="cw-small-copy">{[...new Set(asset.uses.map(use=>use.usage||'用途未记录'))].join('；')}</p></li>)}</ul>:<p>此交接没有可展开的资产引用。</p>}</>}{onProduction&&<Button type="button" variant="ghost" onClick={onProduction}>到制作查阅交接包</Button>}</div>
+ </>}
+ </section></details>;
+}
