+import test from 'node:test';
+import assert from 'node:assert/strict';
+import {projectRelations} from '../../components/workspace/project-relations.mjs';
+
+const digest='a'.repeat(64),asset='b'.repeat(64);
+const record=(id,kind,fields={},spec={},extra={})=>({id,project_id:'p',branch:'main',timeline:'main',kind,version:1,sha256:digest,status:'accepted',content:{title:id,body:'',fields,spec,sources:[]},...extra});
+const graph=nodes=>({project_id:'p',perspective:'author',canon_revision:4,nodes});
+const fixture=()=>[
+ record('role','character'),record('young','instance',{character_id:'role',age:'少年',time_label:'离乡前'}),record('adult','instance',{character_id:'role',age:'成年'}),
+ record('scene','scene',{}, {cast:['young']}),record('casting','casting',{}, {character_id:'role',ip_id:'actor',identity_revision:3,profile_version:digest}),
+ record('appearance','appearance',{}, {casting_id:'casting',target_id:'young',ip_id:'actor',look_id:'look',look_revision:2,lookbook_id:'book',lookbook_revision:5})
+];
+
+test('real spec links preserve identity, role state and appearance scope independently',()=>{
+ const result=projectRelations('p',graph(fixture()));
+ assert.equal(result.available,true);
+ assert.ok(result.edges.some(edge=>edge.from==='scene'&&edge.to==='young'&&edge.label==='出场状态'));
+ assert.ok(result.edges.some(edge=>edge.from==='young'&&edge.to==='role'&&edge.label==='所属角色'));
+ assert.ok(result.edges.some(edge=>edge.from==='appearance'&&edge.to==='young'));
+ assert.ok(!result.edges.some(edge=>edge.from==='appearance'&&edge.to==='adult'));
+ assert.equal(result.records.find(item=>item.id==='young').age,'少年');
+ assert.deepEqual(result.external.find(item=>item.kind==='look'),{owner:'appearance',kind:'look',id:'look',actorId:'actor',label:'造型',revision:2,lookbookId:'book',lookbookRevision:5});
+});
+test('wrong, unidentified and non-author snapshots return no records or handoff assets',()=>{
+ for(const value of [null,{}, {...graph(fixture()),project_id:'other'}, {...graph(fixture()),perspective:'reader'}, {...graph(fixture()),perspective:'character'}]){
+  const result=projectRelations('p',value,{project_id:'p',manifest:{project:{id:'p'},assets:[{frame_asset_id:asset}]}});
+  assert.equal(result.available,false);assert.deepEqual(result.records,[]);assert.deepEqual(result.assets,[]);
+ }
+});
+test('individual project/branch/timeline scope, archived and duplicate records fail closed',()=>{
+ const base=fixture(),foreign=record('foreign','character',{}, {},{project_id:'other'}),branch=record('branch','character',{}, {},{branch:'alternate'}),timeline=record('timeline','character',{}, {},{timeline:'past'}),archived=record('archived','character',{}, {},{archived:true});
+ const result=projectRelations('p',graph([...base,foreign,branch,timeline,archived,{...base[0],version:2},record('unscoped','character',{}, {},{project_id:undefined})]));
+ assert.ok(result.records.every(item=>!['foreign','branch','timeline','archived','role','unscoped'].includes(item.id)));
+ assert.equal(result.edges.find(edge=>edge.from==='young').state,'not_loaded');
+ assert.equal(result.notices.length,2);
+});
+test('same title and body episode/shot words create no implicit relation or total',()=>{
+ const a=record('a','character'),b=record('b','scene');a.content.title=b.content.title='第12集 少年 8镜';b.content.body='18岁，采用服装look，角色a出场';
+ const result=projectRelations('p',graph([a,b]));
+ assert.deepEqual(result.edges,[]);assert.deepEqual(result.assets,[]);assert.equal(result.records[0].age,'');
+ assert.deepEqual(result.gaps,['分集关系尚未结构化','逐镜关系尚未结构化']);assert.ok(!Object.hasOwn(result,'episodeCount'));assert.ok(!Object.hasOwn(result,'shotCount'));
+});
+test('source pins report unavailable, changed version, missing revision and hash mismatch without rebasing',()=>{
+ const nodes=fixture(),scene=nodes.find(node=>node.id==='scene');
+ scene.content.sources=[{kind:'item',item_id:'role',version:2,sha256:digest},{kind:'item',item_id:'young',version:1,sha256:asset},{kind:'story',item_id:'missing',version:9},{kind:'item',item_id:'adult'},{kind:'item',item_id:'adult',version:1}];
+ const edges=projectRelations('p',graph(nodes)).edges.filter(edge=>edge.label==='来源版本');
+ assert.deepEqual(edges.map(edge=>edge.state),['version_mismatch','hash_mismatch','not_loaded','pin_missing','pin_missing']);assert.equal(edges[0].version,2);assert.equal(nodes[0].version,1);
+});
+test('malformed fields and wrong target kinds remain unknown rather than crash or adopt',()=>{
+ const bad=record('bad','instance');bad.content={title:'unknown'};
+ const scene=record('scene','scene',{}, {cast:['role',null,7]});const result=projectRelations('p',graph([record('role','character'),bad,scene]));
+ assert.equal(result.records.find(item=>item.id==='bad').age,'');assert.equal(result.edges[0].state,'kind_mismatch');assert.equal(result.edges.length,1);
+});
+test('chapter/adaptation/scene provenance uses exact explicit links and valid source hashes',()=>{
+ const chapter=record('chapter','chapter'),plan=record('plan','adaptation',{}, {chapter_id:'chapter'}),scene=record('scene','scene',{}, {adaptation_id:'plan'});
+ scene.content.sources=[{kind:'item',item_id:'chapter',version:1,sha256:digest}];
+ const result=projectRelations('p',graph([chapter,plan,scene]));
+ assert.ok(result.edges.some(edge=>edge.from==='plan'&&edge.to==='chapter'&&edge.label==='改编来源章节'));
+ assert.ok(result.edges.some(edge=>edge.from==='scene'&&edge.to==='plan'&&edge.label==='改编方案'));
+ assert.equal(result.edges.find(edge=>edge.label==='来源版本').state,'loaded');
+});
+test('candidate and review flags survive unchanged and never claim adoption or production readiness',()=>{
+ const candidate=record('look-candidate','appearance',{}, {casting_id:'casting',target_id:'scene'}, {status:'pending',accepted_version:null,needs_review:[{reason:'stale'}]});
+ const result=projectRelations('p',graph([candidate]));assert.equal(result.records[0].status,'pending');assert.equal(result.records[0].needsReview,true);
+ assert.ok(!Object.hasOwn(result,'adopted'));assert.ok(!Object.hasOwn(result,'production_ready'));assert.ok(!Object.hasOwn(result,'media_verified'));
+});
+test('only the exact selected same-project handoff contributes frozen asset IDs',()=>{
+ const h={project_id:'p',stale:false,manifest:{project:{id:'p'},assets:[{frame_asset_id:asset,usage:'服装',target_id:'actor'}],production:{branch:'main',timeline:'main',assets:[asset,digest]}}};
+ const result=projectRelations('p',graph(fixture()),h);assert.equal(result.assetScope,'frozen');assert.deepEqual(result.assets.map(a=>a.id),[asset,digest]);assert.equal(result.assets[0].uses.length,2);
+ assert.equal(projectRelations('p',graph(fixture()),{...h,stale:true}).assetScope,'stale');
+ for(const invalid of [{...h,project_id:'other'},{...h,manifest:{...h.manifest,project:{id:'other'}}}]){const value=projectRelations('p',graph(fixture()),invalid);assert.equal(value.assetScope,'scope_mismatch');assert.deepEqual(value.assets,[]);}
+ assert.equal(projectRelations('p',graph(fixture())).assetScope,'not_loaded');
+});
+test('production handoff branch and timeline must match main/main; material-only handoffs need no invented story scope',()=>{
+ const production={branch:'main',timeline:'main',assets:[asset]},h={project_id:'p',stale:false,manifest:{project:{id:'p'},production,assets:[{frame_asset_id:digest}]}};
+ for(const invalid of [{...production,branch:'alternate'},{...production,timeline:'past'},{assets:[asset]},{...production,branch:undefined}]){
+  const result=projectRelations('p',graph(fixture()),{...h,manifest:{...h.manifest,production:invalid}});
+  assert.equal(result.assetScope,'scope_mismatch');assert.deepEqual(result.assets,[]);assert.match(result.notices[0],/分支／时间线/);
+ }
+ const material={project_id:'p',stale:false,manifest:{project:{id:'p'},assets:[{frame_asset_id:digest}]}};
+ const result=projectRelations('p',graph(fixture()),material);assert.equal(result.assetScope,'frozen');assert.deepEqual(result.assets.map(item=>item.id),[digest]);
+});
+test('malformed handoff IDs are disclosed, and source documents retain exact revisions',()=>{
+ const scene=record('s','scene');scene.content.sources=[{kind:'document',item_id:'doc',version:7,paragraph:2}];
+ const h={project_id:'p',manifest:{project:{id:'p'},assets:[{frame_asset_id:'look'},null]}};
+ const result=projectRelations('p',graph([scene]),h);assert.deepEqual(result.assets,[]);assert.match(result.notices[0],/格式不完整/);assert.equal(result.external[0].revision,7);
+});
+test('all projections are pure and leave caller records and immutable handoff byte-identical',()=>{
+ const g=graph(fixture()),h={project_id:'p',manifest:{project:{id:'p'},assets:[{frame_asset_id:asset}]}};const before=JSON.stringify([g,h]);
+ projectRelations('p',g,h);assert.equal(JSON.stringify([g,h]),before);
+});
