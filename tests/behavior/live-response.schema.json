{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "caseId",
    "selectedSkill",
    "route",
    "outcome",
    "contractKinds",
    "payloads",
    "response",
    "questions",
    "unsupportedClaims"
  ],
  "properties": {
    "caseId": { "type": "string", "minLength": 1, "maxLength": 160 },
    "selectedSkill": {
      "enum": [
        "none",
        "cineweave",
        "cineweave-story",
        "cineweave-character",
        "cineweave-scene",
        "cineweave-style",
        "cineweave-reference",
        "cineweave-director",
        "cineweave-prompt",
        "cineweave-production"
      ]
    },
    "route": { "type": ["string", "null"], "maxLength": 160 },
    "outcome": { "enum": ["answer", "clarify", "decline"] },
    "contractKinds": {
      "type": "array",
      "maxItems": 12,
      "uniqueItems": true,
      "items": { "type": "string", "minLength": 1, "maxLength": 160 }
    },
    "payloads": {
      "type": "array",
      "maxItems": 12,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["kind", "payload"],
        "properties": {
          "kind": { "type": "string", "minLength": 1, "maxLength": 160 },
          "payload": { "type": "object" }
        }
      }
    },
    "response": { "type": "string", "minLength": 1, "maxLength": 16000 },
    "questions": {
      "type": "array",
      "maxItems": 3,
      "items": { "type": "string", "minLength": 1, "maxLength": 800 }
    },
    "unsupportedClaims": {
      "type": "array",
      "maxItems": 12,
      "items": { "type": "string", "minLength": 1, "maxLength": 800 }
    }
  }
}
