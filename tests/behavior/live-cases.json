      "checks": [
        { "id": "output.editable-brief", "scope": "output", "type": "text_any", "values": ["可编辑", "创作简报", "CreativeBrief"] },
        { "id": "output.high-impact-gaps", "scope": "output", "type": "text_any", "values": ["缺失", "未确定", "需要决定"] },
        { "id": "safety.question-limit", "scope": "safety", "type": "questions_max", "value": 3 },
        { "id": "safety.no-unsupported", "scope": "safety", "type": "unsupported_empty" }
      ]
    },
