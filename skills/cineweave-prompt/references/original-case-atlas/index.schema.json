{
  "title": "CineWeave Original Case Atlas Routing Index",
  "type": "object",
  "additionalProperties": false,
  "required": ["atlasVersion", "ownerSkill", "routingPolicy", "categories"],
  "properties": {
    "atlasVersion": { "const": "1.0.0" },
    "ownerSkill": { "const": "cineweave-prompt" },
    "routingPolicy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["loadIndexFirst", "maximumCategoryLoads", "loadUnmatchedCategories"],
      "properties": {
        "loadIndexFirst": { "const": true },
        "maximumCategoryLoads": { "const": 1 },
        "loadUnmatchedCategories": { "const": false }
      }
    },
    "categories": {
      "type": "array",
      "minItems": 7,
      "maxItems": 7,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["category", "triggers", "referencePath", "caseIds"],
        "properties": {
          "category": { "$ref": "#/$defs/category" },
          "triggers": {
            "type": "array",
            "minItems": 3,
            "maxItems": 12,
            "uniqueItems": true,
            "items": { "type": "string", "minLength": 1, "maxLength": 80 }
          },
          "referencePath": { "type": "string", "pattern": "^categories/[a-z-]+\\.md$" },
          "caseIds": {
            "type": "array",
            "minItems": 1,
            "maxItems": 4,
            "uniqueItems": true,
            "items": { "type": "string", "pattern": "^case\\.atlas\\.[a-z-]+$" }
          }
        }
      }
    }
  },
  "$defs": {
    "category": {
      "enum": ["portrait", "product", "food", "architecture", "editorial", "diagrams", "exact-text"]
    }
  }
}
