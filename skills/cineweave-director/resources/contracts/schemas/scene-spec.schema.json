{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cineweave.dev/contracts/scene-spec.schema.json",
  "title": "CineWeave Scene Specification",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "kind",
    "contractVersion",
    "worldId",
    "sceneId",
    "name",
    "version",
    "status",
    "skillReceipt",
    "narrativeFunction",
    "geography",
    "architecture",
    "materialSystem",
    "propLayout",
    "cameraTopology",
    "stateModel",
    "referencePolicy",
    "rights",
    "validation",
    "provenance"
  ],
  "properties": {
    "kind": {
      "const": "cineweave_codex_scene_spec"
    },
    "contractVersion": {
      "const": "2.0.0"
    },
    "worldId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 160
    },
    "sceneId": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9._-]{2,159}$"
    },
    "name": {
      "type": "string",
      "minLength": 1,
      "maxLength": 240
    },
    "version": {
      "type": "integer",
      "minimum": 1
    },
    "status": {
      "enum": [
        "draft",
        "active",
        "locked",
        "archived",
        "retired"
      ]
    },
    "collection": {
      "type": "string",
      "minLength": 1,
      "maxLength": 160
    },
    "tags": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 120
      },
      "maxItems": 24,
      "uniqueItems": true
    },
    "skillReceipt": {
      "$ref": "#/$defs/skillReceipt"
    },
    "narrativeFunction": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "role": {
          "type": "string",
          "minLength": 1,
          "maxLength": 500
        },
        "oneLineConcept": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1200
        },
        "dramaticPressure": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1200
        },
        "audienceExperience": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1200
        }
      },
      "required": [
        "role",
        "oneLineConcept",
        "dramaticPressure",
        "audienceExperience"
      ]
    },
    "geography": {
      "$ref": "#/$defs/geography"
    },
    "architecture": {
      "$ref": "#/$defs/architecture"
    },
    "materialSystem": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/material"
      },
      "minItems": 1,
      "maxItems": 24
    },
    "propLayout": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/prop"
      },
      "minItems": 1,
      "maxItems": 32
    },
    "cameraTopology": {
      "$ref": "#/$defs/cameraTopology"
    },
    "stateModel": {
      "$ref": "#/$defs/stateModel"
    },
    "referencePolicy": {
      "$ref": "#/$defs/referencePolicy"
    },
    "rights": {
      "$ref": "#/$defs/rights"
    },
    "validation": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "geographyCoherent": {
          "$ref": "#/$defs/testStatus"
        },
        "scaleReadable": {
          "$ref": "#/$defs/testStatus"
        },
        "axisDefined": {
          "$ref": "#/$defs/testStatus"
        },
        "materialLogic": {
          "$ref": "#/$defs/testStatus"
        },
        "propContinuity": {
          "$ref": "#/$defs/testStatus"
        },
        "notes": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2000
        }
      },
      "required": [
        "geographyCoherent",
        "scaleReadable",
        "axisDefined",
        "materialLogic",
        "propContinuity"
      ]
    },
    "provenance": {
      "$ref": "#/$defs/provenance"
    }
  },
  "$defs": {
    "skillReceipt": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "repository": {
          "type": "string",
          "format": "uri",
          "pattern": "^https://(www\\.)?github\\.com/[^/]+/[^/]+(?:\\.git)?/?$"
        },
        "ref": {
          "type": "string",
          "minLength": 1,
          "maxLength": 240
        },
        "commit": {
          "type": "string",
          "pattern": "^[0-9a-fA-F]{7,64}$"
        },
        "contentHash": {
          "type": "string",
          "pattern": "^sha256:[0-9a-fA-F]{64}$"
        },
        "installedBy": {
          "const": "codex-environment"
        },
        "environmentId": {
          "type": "string",
          "maxLength": 240
        },
        "usedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": [
        "repository",
        "ref",
        "commit",
        "installedBy",
        "usedAt"
      ]
    },
    "stableId": {
      "type": "string",
      "pattern": "^[a-zA-Z][a-zA-Z0-9._-]{1,159}$"
    },
    "lowerId": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9._-]{2,159}$"
    },
    "observationId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 160,
      "not": {
        "pattern": "(?:https?:|file:|[\\\\/?#])"
      }
    },
    "contentHash": {
      "type": "string",
      "pattern": "^sha256:[0-9a-fA-F]{64}$"
    },
    "stringList": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 1200
      },
      "minItems": 1,
      "maxItems": 24
    },
    "optionalStringList": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 1200
      },
      "maxItems": 24
    },
    "characterSpecRef": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "characterId": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9._-]{2,159}$"
        },
        "version": {
          "type": "integer",
          "minimum": 1
        },
        "contentHash": {
          "type": "string",
          "pattern": "^sha256:[0-9a-fA-F]{64}$"
        }
      },
      "required": [
        "characterId",
        "version",
        "contentHash"
      ]
    },
    "appearanceStateRef": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "appearanceStateId": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9._-]{2,159}$"
        },
        "version": {
          "type": "integer",
          "minimum": 1
        },
        "contentHash": {
          "type": "string",
          "pattern": "^sha256:[0-9a-fA-F]{64}$"
        }
      },
      "required": [
        "appearanceStateId",
        "version",
        "contentHash"
      ]
    },
    "sceneSpecRef": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "sceneId": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9._-]{2,159}$"
        },
        "version": {
          "type": "integer",
          "minimum": 1
        },
        "contentHash": {
          "type": "string",
          "pattern": "^sha256:[0-9a-fA-F]{64}$"
        }
      },
      "required": [
        "sceneId",
        "version",
        "contentHash"
      ]
    },
    "sceneStateRef": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "sceneStateId": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9._-]{2,159}$"
        },
        "version": {
          "type": "integer",
          "minimum": 1
        },
        "contentHash": {
          "type": "string",
          "pattern": "^sha256:[0-9a-fA-F]{64}$"
        }
      },
      "required": [
        "sceneStateId",
        "version",
        "contentHash"
      ]
    },
    "approvalGate": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "requiresHumanApproval": {
          "const": true
        },
        "status": {
          "enum": [
            "planned",
            "approved",
            "blocked",
            "rejected"
          ]
        },
        "approvedBy": {
          "type": "string",
          "minLength": 1,
          "maxLength": 240
        },
        "approvedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": [
        "requiresHumanApproval",
        "status"
      ]
    },
    "provenance": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "source": {
          "enum": [
            "user_authored",
            "codex_authored",
            "adapted",
            "imported",
            "migrated"
          ]
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        },
        "parentId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 160
        },
        "changeLog": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 1200
          },
          "minItems": 1,
          "maxItems": 24
        }
      },
      "required": [
        "source",
        "createdAt",
        "updatedAt",
        "changeLog"
      ]
    },
    "sceneAnchor": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "anchorId": {
          "$ref": "#/$defs/stableId"
        },
        "type": {
          "enum": [
            "geography",
            "architecture",
            "scale",
            "landmark",
            "occlusion",
            "path",
            "prop",
            "material",
            "light"
          ]
        },
        "description": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1200
        },
        "priority": {
          "enum": [
            "critical",
            "high",
            "supporting"
          ]
        },
        "zoneId": {
          "$ref": "#/$defs/stableId"
        },
        "evidenceObservationIds": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/observationId"
          },
          "maxItems": 8,
          "uniqueItems": true
        }
      },
      "required": [
        "anchorId",
        "type",
        "description",
        "priority"
      ]
    },
    "zone": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "zoneId": {
          "$ref": "#/$defs/stableId"
        },
        "label": {
          "type": "string",
          "minLength": 1,
          "maxLength": 240
        },
        "function": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1200
        },
        "elevation": {
          "type": "string",
          "minLength": 1,
          "maxLength": 500
        },
        "capacity": {
          "type": "string",
          "minLength": 1,
          "maxLength": 500
        },
        "visibility": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1200
        }
      },
      "required": [
        "zoneId",
        "label",
        "function",
        "elevation",
        "capacity",
        "visibility"
      ]
    },
    "connection": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "fromZone": {
          "$ref": "#/$defs/stableId"
        },
        "toZone": {
          "$ref": "#/$defs/stableId"
        },
        "type": {
          "enum": [
            "path",
            "stairs",
            "bridge",
            "door",
            "portal",
            "vertical",
            "open"
          ]
        },
        "direction": {
          "type": "string",
          "minLength": 1,
          "maxLength": 500
        },
        "traversal": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1200
        }
      },
      "required": [
        "fromZone",
        "toZone",
        "type",
        "direction",
        "traversal"
      ]
    },
    "entranceExit": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "anchorId": {
          "$ref": "#/$defs/stableId"
        },
        "kind": {
          "enum": [
            "entrance",
            "exit",
            "both"
          ]
        },
        "zoneId": {
          "$ref": "#/$defs/stableId"
        },
        "orientation": {
          "type": "string",
          "minLength": 1,
          "maxLength": 500
        }
      },
      "required": [
        "anchorId",
        "kind",
        "zoneId",
        "orientation"
      ]
    },
    "scaleAnchor": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "anchorId": {
          "$ref": "#/$defs/stableId"
        },
        "description": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1200
        },
        "realWorldRelation": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1200
        }
      },
      "required": [
        "anchorId",
        "description",
        "realWorldRelation"
      ]
    },
    "geography": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "orientation": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1200
        },
        "immutableAnchors": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/sceneAnchor"
          },
          "minItems": 3,
          "maxItems": 24
        },
        "zones": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/zone"
          },
          "minItems": 1,
          "maxItems": 24
        },
        "connections": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/connection"
          },
          "minItems": 1,
          "maxItems": 48
        },
        "entrancesExits": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/entranceExit"
          },
          "minItems": 1,
          "maxItems": 24
        },
        "scaleAnchors": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/scaleAnchor"
          },
          "minItems": 1,
          "maxItems": 16
        },
        "forbiddenGeographyChanges": {
          "$ref": "#/$defs/stringList"
        }
      },
      "required": [
        "orientation",
        "immutableAnchors",
        "zones",
        "connections",
        "entrancesExits",
        "scaleAnchors",
        "forbiddenGeographyChanges"
      ]
    },
    "structure": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "structureId": {
          "$ref": "#/$defs/stableId"
        },
        "label": {
          "type": "string",
          "minLength": 1,
          "maxLength": 240
        },
        "zoneId": {
          "$ref": "#/$defs/stableId"
        },
        "function": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1200
        },
        "silhouette": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1200
        },
        "placement": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1200
        },
        "construction": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1600
        },
        "continuityPriority": {
          "enum": [
            "critical",
            "high",
            "supporting"
          ]
        }
      },
      "required": [
        "structureId",
        "label",
        "zoneId",
        "function",
        "silhouette",
        "placement",
        "construction",
        "continuityPriority"
      ]
    },
    "architecture": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "styleGrammar": {
          "$ref": "#/$defs/stringList"
        },
        "structures": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/structure"
          },
          "minItems": 1,
          "maxItems": 32
        },
        "constructionRules": {
          "$ref": "#/$defs/stringList"
        },
        "forbiddenChanges": {
          "$ref": "#/$defs/stringList"
        }
      },
      "required": [
        "styleGrammar",
        "structures",
        "constructionRules",
        "forbiddenChanges"
      ]
    },
    "material": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "materialId": {
          "$ref": "#/$defs/stableId"
        },
        "surface": {
          "type": "string",
          "minLength": 1,
          "maxLength": 800
        },
        "construction": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1200
        },
        "ageState": {
          "type": "string",
          "minLength": 1,
          "maxLength": 800
        },
        "weathering": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1200
        },
        "lightResponse": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1200
        }
      },
      "required": [
        "materialId",
        "surface",
        "construction",
        "ageState",
        "weathering",
        "lightResponse"
      ]
    },
    "prop": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "propId": {
          "$ref": "#/$defs/stableId"
        },
        "label": {
          "type": "string",
          "minLength": 1,
          "maxLength": 240
        },
        "function": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1200
        },
        "zoneId": {
          "$ref": "#/$defs/stableId"
        },
        "placement": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1200
        },
        "mobility": {
          "enum": [
            "fixed",
            "movable",
            "consumable"
          ]
        },
        "continuityPriority": {
          "enum": [
            "critical",
            "high",
            "supporting"
          ]
        }
      },
      "required": [
        "propId",
        "label",
        "function",
        "zoneId",
        "placement",
        "mobility",
        "continuityPriority"
      ]
    },
    "axis": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "axisId": {
          "$ref": "#/$defs/stableId"
        },
        "description": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1200
        },
        "sideA": {
          "type": "string",
          "minLength": 1,
          "maxLength": 500
        },
        "sideB": {
          "type": "string",
          "minLength": 1,
          "maxLength": 500
        }
      },
      "required": [
        "axisId",
        "description",
        "sideA",
        "sideB"
      ]
    },
    "cameraAnchor": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "cameraAnchorId": {
          "$ref": "#/$defs/stableId"
        },
        "zoneId": {
          "$ref": "#/$defs/stableId"
        },
        "height": {
          "type": "string",
          "minLength": 1,
          "maxLength": 500
        },
        "orientation": {
          "type": "string",
          "minLength": 1,
          "maxLength": 500
        },
        "purpose": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1200
        },
        "allowedMovements": {
          "$ref": "#/$defs/stringList"
        }
      },
      "required": [
        "cameraAnchorId",
        "zoneId",
        "height",
        "orientation",
        "purpose",
        "allowedMovements"
      ]
    },
    "cameraTopology": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "safeAxes": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/axis"
          },
          "minItems": 1,
          "maxItems": 12
        },
        "cameraAnchors": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/cameraAnchor"
          },
          "minItems": 1,
          "maxItems": 24
        },
        "occlusionAnchors": {
          "$ref": "#/$defs/stringList"
        },
        "forbiddenPositions": {
          "$ref": "#/$defs/stringList"
        }
      },
      "required": [
        "safeAxes",
        "cameraAnchors",
        "occlusionAnchors",
        "forbiddenPositions"
      ]
    },
    "sceneVariable": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "variableId": {
          "$ref": "#/$defs/stableId"
        },
        "type": {
          "enum": [
            "time",
            "weather",
            "season",
            "occupancy",
            "damage",
            "light",
            "atmosphere",
            "crowd"
          ]
        },
        "allowedValues": {
          "$ref": "#/$defs/stringList"
        },
        "defaultValue": {
          "type": "string",
          "minLength": 1,
          "maxLength": 800
        },
        "constraints": {
          "$ref": "#/$defs/stringList"
        }
      },
      "required": [
        "variableId",
        "type",
        "allowedValues",
        "defaultValue",
        "constraints"
      ]
    },
    "stateModel": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "defaultStateId": {
          "$ref": "#/$defs/stableId"
        },
        "controllableVariables": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/sceneVariable"
          },
          "minItems": 1,
          "maxItems": 24
        }
      },
      "required": [
        "defaultStateId",
        "controllableVariables"
      ]
    },
    "referencePolicy": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "requiredViews": {
          "$ref": "#/$defs/stringList"
        },
        "geographyObservationIds": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/observationId"
          },
          "maxItems": 16,
          "uniqueItems": true
        },
        "materialObservationIds": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/observationId"
          },
          "maxItems": 16,
          "uniqueItems": true
        },
        "referenceLock": {
          "enum": [
            "draft",
            "partial",
            "locked"
          ]
        },
        "notes": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2000
        }
      },
      "required": [
        "requiredViews",
        "geographyObservationIds",
        "materialObservationIds",
        "referenceLock",
        "notes"
      ]
    },
    "rights": {
      "type": "object",
