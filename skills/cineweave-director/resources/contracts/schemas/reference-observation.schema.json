{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cineweave.dev/contracts/reference-observation.schema.json",
  "title": "CineWeave Role-scoped Reference Observation",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "kind",
    "contractVersion",
    "observationId",
    "version",
    "status",
    "skillReceipt",
    "assetRef",
    "selector",
    "role",
    "scope",
    "evidence",
    "transfer",
    "authority",
    "rightsGate",
    "validation"
  ],
  "properties": {
    "kind": {
      "const": "cineweave_codex_reference_observation"
    },
    "contractVersion": {
      "const": "2.4.0"
    },
    "observationId": {
      "$ref": "common.schema.json#/$defs/identifier"
    },
    "version": {
      "type": "integer",
      "minimum": 1
    },
    "status": {
      "enum": [
        "draft",
        "reviewed",
        "approved",
        "retired"
      ]
    },
    "skillReceipt": {
      "$ref": "common.schema.json#/$defs/skillReceipt"
    },
    "assetRef": {
      "allOf": [
        {
          "$ref": "common.schema.json#/$defs/contractRef"
        },
        {
          "properties": {
            "kind": {
              "const": "cineweave_codex_reference_asset"
            }
          }
        }
      ]
    },
    "selector": {
      "$ref": "#/$defs/selector"
    },
    "role": {
      "$ref": "#/$defs/role"
    },
    "scope": {
      "$ref": "#/$defs/scope"
    },
    "evidence": {
      "$ref": "#/$defs/evidence"
    },
    "transfer": {
      "$ref": "#/$defs/transfer"
    },
    "authority": {
      "$ref": "#/$defs/authority"
    },
    "rightsGate": {
      "$ref": "#/$defs/rightsGate"
    },
    "validation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "assetExact",
        "selectorChecked",
        "onePrimaryRole",
        "extractIgnoreDisjoint",
        "noPrivateLocator",
        "rightsReviewed"
      ],
      "properties": {
        "assetExact": {
          "const": true
        },
        "selectorChecked": {
          "const": true
        },
        "onePrimaryRole": {
          "const": true
        },
        "extractIgnoreDisjoint": {
          "const": true
        },
        "noPrivateLocator": {
          "const": true
        },
        "rightsReviewed": {
          "const": true
        }
      }
    }
  },
  "$defs": {
    "role": {
      "enum": [
        "identity",
        "face_identity",
        "body_identity",
        "face_morphology",
        "body_morphology",
        "appearance",
        "skin_material",
        "skin_surface",
        "eye_surface",
        "makeup",
        "hair",
        "hair_material",
        "costume",
        "prop",
        "expression",
        "pose",
        "motion",
        "capture",
        "composition",
        "lighting",
        "palette",
        "material",
        "style",
        "representation_geometry",
        "shape_language",
        "linework",
        "surface_style",
        "shading",
        "color_system",
        "depth_language",
        "effects",
        "panel_layout",
        "typography",
        "motion_style",
        "environment",
        "geography",
        "architecture",
        "prop_layout",
        "atmosphere",
        "camera_motion",
        "performance",
        "temporal_atmosphere",
        "mask",
        "validation_boundary",
        "reference"
      ]
    },
    "scope": {
      "enum": [
        "full_asset",
        "full_character",
        "face",
        "face_morphology",
        "eyes",
        "skin",
        "body",
        "body_morphology",
        "hair",
        "costume",
        "prop",
        "expression",
        "pose",
        "motion",
        "capture",
        "environment",
        "architecture",
        "geography",
        "scale",
        "prop_layout",
        "lighting",
        "material",
        "weather",
        "atmosphere",
        "crowd",
        "damage",
        "camera_axis",
        "composition",
        "style",
        "representation",
        "linework",
        "shading",
        "depth",
        "effects",
        "panel_layout",
        "typography",
        "palette",
        "mask",
        "generic"
      ]
    },
    "selector": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "type"
      ],
      "properties": {
        "type": {
          "enum": [
            "full_asset",
            "spatial_rect",
            "temporal_range",
            "spatiotemporal_rect",
            "mask_asset"
          ]
        },
        "normalizedRect": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "x",
            "y",
            "width",
            "height"
          ],
          "properties": {
            "x": {
              "type": "number",
              "minimum": 0,
              "maximum": 1
            },
            "y": {
              "type": "number",
              "minimum": 0,
              "maximum": 1
            },
            "width": {
              "type": "number",
              "exclusiveMinimum": 0,
              "maximum": 1
            },
            "height": {
              "type": "number",
              "exclusiveMinimum": 0,
              "maximum": 1
            }
          }
        },
        "temporalRange": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "startMs",
            "endMs"
          ],
          "properties": {
            "startMs": {
              "type": "integer",
              "minimum": 0
            },
            "endMs": {
              "type": "integer",
              "minimum": 1
            }
          }
        },
        "maskAssetRef": {
          "allOf": [
            {
              "$ref": "common.schema.json#/$defs/contractRef"
            },
            {
              "properties": {
                "kind": {
                  "const": "cineweave_codex_reference_asset"
                }
              }
            }
          ]
        }
      },
      "oneOf": [
        {
          "properties": {
            "type": {
              "const": "full_asset"
            }
          },
          "required": [
            "type"
          ],
          "not": {
            "anyOf": [
              {
                "required": [
                  "normalizedRect"
                ]
              },
              {
                "required": [
                  "temporalRange"
                ]
              },
              {
                "required": [
                  "maskAssetRef"
                ]
              }
            ]
          }
        },
        {
          "properties": {
            "type": {
              "const": "spatial_rect"
            }
          },
          "required": [
            "type",
            "normalizedRect"
          ],
          "not": {
            "anyOf": [
              {
                "required": [
                  "temporalRange"
                ]
              },
              {
                "required": [
                  "maskAssetRef"
                ]
              }
            ]
          }
        },
        {
          "properties": {
            "type": {
              "const": "temporal_range"
            }
          },
          "required": [
            "type",
            "temporalRange"
          ],
          "not": {
            "anyOf": [
              {
                "required": [
                  "normalizedRect"
                ]
              },
              {
                "required": [
                  "maskAssetRef"
                ]
              }
            ]
          }
        },
        {
          "properties": {
            "type": {
              "const": "spatiotemporal_rect"
            }
          },
          "required": [
            "type",
            "normalizedRect",
            "temporalRange"
          ],
          "not": {
            "required": [
              "maskAssetRef"
            ]
          }
        },
        {
          "properties": {
            "type": {
              "const": "mask_asset"
            }
          },
          "required": [
            "type",
            "maskAssetRef"
          ],
          "not": {
            "anyOf": [
              {
                "required": [
                  "normalizedRect"
                ]
              },
              {
                "required": [
                  "temporalRange"
                ]
              }
            ]
          }
        }
      ]
    },
    "evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "basis",
        "confidence",
        "observations"
      ],
      "properties": {
        "basis": {
          "enum": [
            "visible",
            "declared",
            "inferred",
            "unknown"
          ]
        },
        "confidence": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "observations": {
          "$ref": "common.schema.json#/$defs/stringList"
        }
      }
    },
    "transfer": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "extract",
        "ignore",
        "allowedTransforms",
        "forbiddenUses"
      ],
      "properties": {
        "extract": {
          "$ref": "common.schema.json#/$defs/stringList"
        },
        "ignore": {
          "$ref": "common.schema.json#/$defs/stringList"
        },
        "allowedTransforms": {
          "$ref": "common.schema.json#/$defs/stringList"
        },
        "forbiddenUses": {
          "$ref": "common.schema.json#/$defs/stringList"
        }
      }
    },
    "authority": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "identity",
        "appearance",
        "performance",
        "capture",
        "style",
        "environment"
      ],
      "properties": {
        "identity": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "appearance": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "performance": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "capture": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "style": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "environment": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        }
      }
    },
    "rightsGate": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status",
        "allowedForExploration",
        "allowedForProduction",
        "allowedForRedistribution",
        "unresolvedBlocksPromotion"
      ],
      "properties": {
        "status": {
          "enum": [
            "unknown",
            "verified",
            "restricted",
            "blocked"
          ]
        },
        "allowedForExploration": {
          "type": "boolean"
        },
        "allowedForProduction": {
          "type": "boolean"
        },
        "allowedForRedistribution": {
          "type": "boolean"
        },
        "unresolvedBlocksPromotion": {
          "const": true
        },
        "licenseProfileRef": {
          "allOf": [
            {
              "$ref": "common.schema.json#/$defs/contractRef"
            },
            {
              "properties": {
                "kind": {
                  "const": "cineweave_codex_license_profile"
                }
              }
            }
          ]
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "status": {
                "const": "verified"
              }
            },
            "required": [
              "status"
            ]
          },
          "then": {
            "required": [
              "licenseProfileRef"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "status": {
                "enum": [
                  "unknown",
                  "restricted",
                  "blocked"
                ]
              }
            },
            "required": [
              "status"
            ]
          },
          "then": {
            "properties": {
              "allowedForProduction": {
                "const": false
              },
              "allowedForRedistribution": {
                "const": false
              }
            }
          }
        }
      ]
    }
  }
}
