{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cineweave.dev/contracts/scene-state.schema.json",
  "title": "CineWeave Scene Environmental State",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "kind",
    "contractVersion",
    "worldId",
    "sceneStateId",
    "sceneSpecRef",
    "label",
    "version",
    "status",
    "skillReceipt",
    "purpose",
    "assignments",
    "lighting",
    "atmosphere",
    "occupancy",
    "damageState",
    "preserve",
    "allowedChanges",
    "forbiddenChanges",
    "validation",
    "provenance"
  ],
  "properties": {
    "kind": {
      "const": "cineweave_codex_scene_state"
    },
    "contractVersion": {
      "const": "2.0.0"
    },
    "worldId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 160
    },
    "sceneStateId": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9._-]{2,159}$"
    },
    "sceneSpecRef": {
      "$ref": "#/$defs/sceneSpecRef"
    },
    "label": {
      "type": "string",
      "minLength": 1,
      "maxLength": 240
    },
    "version": {
      "type": "integer",
      "minimum": 1
    },
    "status": {
      "enum": [
        "draft",
        "active",
        "locked",
        "archived",
        "retired"
      ]
    },
    "skillReceipt": {
      "$ref": "#/$defs/skillReceipt"
    },
    "purpose": {
      "type": "string",
      "minLength": 1,
      "maxLength": 2000
    },
    "assignments": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/assignment"
      },
      "minItems": 1,
      "maxItems": 24
    },
    "lighting": {
      "$ref": "#/$defs/lighting"
    },
    "atmosphere": {
      "$ref": "#/$defs/atmosphere"
    },
    "occupancy": {
      "$ref": "#/$defs/occupancy"
    },
    "damageState": {
      "$ref": "#/$defs/damageState"
    },
    "referenceObservationIds": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/observationId"
      },
      "maxItems": 16,
      "uniqueItems": true
    },
    "preserve": {
      "$ref": "#/$defs/stringList"
    },
    "allowedChanges": {
      "$ref": "#/$defs/stringList"
    },
    "forbiddenChanges": {
      "$ref": "#/$defs/stringList"
    },
    "validation": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "geographyPreserved": {
          "const": true
        },
        "variablesDeclared": {
          "const": true
        },
        "physicalLight": {
          "const": true
        },
        "providerNeutral": {
          "const": true
        }
      },
      "required": [
        "geographyPreserved",
        "variablesDeclared",
        "physicalLight",
        "providerNeutral"
      ]
    },
    "provenance": {
      "$ref": "#/$defs/provenance"
    },
    "temporalContext": {
      "$ref": "#/$defs/temporalContext"
    },
    "backgroundState": {
      "$ref": "#/$defs/backgroundState"
    }
  },
  "$defs": {
    "skillReceipt": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "repository": {
          "type": "string",
          "format": "uri",
          "pattern": "^https://(www\\.)?github\\.com/[^/]+/[^/]+(?:\\.git)?/?$"
        },
        "ref": {
          "type": "string",
          "minLength": 1,
          "maxLength": 240
        },
        "commit": {
          "type": "string",
          "pattern": "^[0-9a-fA-F]{7,64}$"
        },
        "contentHash": {
          "type": "string",
          "pattern": "^sha256:[0-9a-fA-F]{64}$"
        },
        "installedBy": {
          "const": "codex-environment"
        },
        "environmentId": {
          "type": "string",
          "maxLength": 240
        },
        "usedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": [
        "repository",
        "ref",
        "commit",
        "installedBy",
        "usedAt"
      ]
    },
    "stableId": {
      "type": "string",
      "pattern": "^[a-zA-Z][a-zA-Z0-9._-]{1,159}$"
    },
    "lowerId": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9._-]{2,159}$"
    },
    "observationId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 160,
      "not": {
        "pattern": "(?:https?:|file:|[\\\\/?#])"
      }
    },
    "contentHash": {
      "type": "string",
      "pattern": "^sha256:[0-9a-fA-F]{64}$"
    },
    "stringList": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 1200
      },
      "minItems": 1,
      "maxItems": 24
    },
    "optionalStringList": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 1200
      },
      "maxItems": 24
    },
    "characterSpecRef": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "characterId": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9._-]{2,159}$"
        },
        "version": {
          "type": "integer",
          "minimum": 1
        },
        "contentHash": {
          "type": "string",
          "pattern": "^sha256:[0-9a-fA-F]{64}$"
        }
      },
      "required": [
        "characterId",
        "version",
        "contentHash"
      ]
    },
    "appearanceStateRef": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "appearanceStateId": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9._-]{2,159}$"
        },
        "version": {
          "type": "integer",
          "minimum": 1
        },
        "contentHash": {
          "type": "string",
          "pattern": "^sha256:[0-9a-fA-F]{64}$"
        }
      },
      "required": [
        "appearanceStateId",
        "version",
        "contentHash"
      ]
    },
    "sceneSpecRef": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "sceneId": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9._-]{2,159}$"
        },
        "version": {
          "type": "integer",
          "minimum": 1
        },
        "contentHash": {
          "type": "string",
          "pattern": "^sha256:[0-9a-fA-F]{64}$"
        }
      },
      "required": [
        "sceneId",
        "version",
        "contentHash"
      ]
    },
    "sceneStateRef": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "sceneStateId": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9._-]{2,159}$"
        },
        "version": {
          "type": "integer",
          "minimum": 1
        },
        "contentHash": {
          "type": "string",
          "pattern": "^sha256:[0-9a-fA-F]{64}$"
        }
      },
      "required": [
        "sceneStateId",
        "version",
        "contentHash"
      ]
    },
    "approvalGate": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "requiresHumanApproval": {
          "const": true
        },
        "status": {
          "enum": [
            "planned",
            "approved",
            "blocked",
            "rejected"
          ]
        },
        "approvedBy": {
          "type": "string",
          "minLength": 1,
          "maxLength": 240
        },
        "approvedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": [
        "requiresHumanApproval",
        "status"
      ]
    },
    "provenance": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "source": {
          "enum": [
            "user_authored",
            "codex_authored",
            "adapted",
            "imported",
            "migrated"
          ]
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        },
        "parentId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 160
        },
        "changeLog": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 1200
          },
          "minItems": 1,
          "maxItems": 24
        }
      },
      "required": [
        "source",
        "createdAt",
        "updatedAt",
        "changeLog"
      ]
    },
    "assignment": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "variableId": {
          "$ref": "#/$defs/stableId"
        },
        "value": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1200
        },
        "rationale": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1200
        }
      },
      "required": [
        "variableId",
        "value",
        "rationale"
      ]
    },
    "lighting": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "source": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1200
        },
        "direction": {
          "type": "string",
          "minLength": 1,
          "maxLength": 800
        },
        "colorRelationship": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1200
        },
        "exposure": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1200
        },
        "shadowBehavior": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1200
        },
        "hardness": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "falloff": {
          "type": "string",
          "minLength": 1,
          "maxLength": 800
        },
        "subjectExposure": {
          "type": "string",
          "minLength": 1,
          "maxLength": 800
        },
        "backgroundExposure": {
          "type": "string",
          "minLength": 1,
          "maxLength": 800
        },
        "rim": {
          "type": "string",
          "minLength": 1,
          "maxLength": 800
        },
        "environmentBounce": {
          "type": "string",
          "minLength": 1,
          "maxLength": 800
        },
        "contactShadow": {
          "type": "string",
          "minLength": 1,
          "maxLength": 800
        }
      },
      "required": [
        "source",
        "direction",
        "colorRelationship",
        "exposure",
        "shadowBehavior"
      ]
    },
    "atmosphere": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "weather": {
          "type": "string",
          "minLength": 1,
          "maxLength": 800
        },
        "density": {
          "type": "string",
          "minLength": 1,
          "maxLength": 800
        },
        "visibility": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1200
        },
        "particleBehavior": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1200
        }
      },
      "required": [
        "weather",
        "density",
        "visibility",
        "particleBehavior"
      ]
    },
    "occupancy": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "crowdLevel": {
          "type": "string",
          "minLength": 1,
          "maxLength": 800
        },
        "activeZoneIds": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/stableId"
          },
          "minItems": 1,
          "maxItems": 24,
          "uniqueItems": true
        },
        "movementPattern": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1200
        }
      },
      "required": [
        "crowdLevel",
        "activeZoneIds",
        "movementPattern"
      ]
    },
    "damageState": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "summary": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1200
        },
        "changedAnchorIds": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/stableId"
          },
          "maxItems": 24,
          "uniqueItems": true
        }
      },
      "required": [
        "summary",
        "changedAnchorIds"
      ]
    },
    "temporalContext": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "timeOfDay",
        "season",
        "storyTime",
        "continuityWindow"
      ],
      "properties": {
        "timeOfDay": {
          "type": "string",
          "minLength": 1,
          "maxLength": 240
        },
        "season": {
          "type": "string",
          "minLength": 1,
          "maxLength": 240
        },
        "storyTime": {
          "type": "string",
          "minLength": 1,
          "maxLength": 500
        },
        "continuityWindow": {
          "type": "string",
          "minLength": 1,
          "maxLength": 500
        }
      }
    },
    "backgroundState": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "foreground",
        "midground",
        "background",
        "dynamicElements",
        "subjectSeparation"
      ],
      "properties": {
        "foreground": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1000
        },
        "midground": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1000
        },
        "background": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1000
        },
        "dynamicElements": {
          "$ref": "#/$defs/optionalStringList"
        },
        "subjectSeparation": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1000
        }
      }
    }
  }
}
