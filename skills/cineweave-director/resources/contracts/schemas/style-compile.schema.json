{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cineweave.dev/contracts/style-compile.schema.json",
  "title": "CineWeave Compiled Style Directives",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "kind",
    "contractVersion",
    "compileId",
    "stylePackageRef",
    "target",
    "blocks",
    "preserve",
    "allowedVariation",
    "forbidden",
    "referenceInputs",
    "validation",
    "planningBoundary",
    "skillReceipt"
  ],
  "properties": {
    "kind": {
      "const": "cineweave_codex_style_compile"
    },
    "contractVersion": {
      "const": "2.0.0"
    },
    "compileId": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9._-]{2,159}$"
    },
    "stylePackageRef": {
      "$ref": "#/$defs/contractRef"
    },
    "representationBindingRef": {
      "$ref": "#/$defs/contractRef"
    },
    "representationVariant": {
      "$ref": "#/$defs/representationVariant"
    },
    "target": {
      "$ref": "#/$defs/target"
    },
    "blocks": {
      "type": "array",
      "minItems": 1,
      "maxItems": 24,
      "items": {
        "$ref": "#/$defs/block"
      }
    },
    "preserve": {
      "$ref": "#/$defs/stringList"
    },
    "allowedVariation": {
      "$ref": "#/$defs/stringList"
    },
    "forbidden": {
      "$ref": "#/$defs/stringList"
    },
    "referenceInputs": {
      "type": "array",
      "maxItems": 24,
      "items": {
        "$ref": "#/$defs/referenceInput"
      }
    },
    "realismProfile": {
      "$ref": "#/$defs/realismProfile"
    },
    "unresolvedConflicts": {
      "type": "array",
      "maxItems": 16,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 1200
      }
    },
    "validation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "packageResolved",
        "identityNotOverwritten",
        "sceneNotOverwritten",
        "temporalSeparated",
        "providerNeutral"
      ],
      "properties": {
        "packageResolved": {
          "const": true
        },
        "identityNotOverwritten": {
          "const": true
        },
        "sceneNotOverwritten": {
          "const": true
        },
        "temporalSeparated": {
          "const": true
        },
        "providerNeutral": {
          "const": true
        }
      }
    },
    "planningBoundary": {
      "$ref": "#/$defs/planningBoundary"
    },
    "skillReceipt": {
      "$ref": "#/$defs/skillReceipt"
    }
  },
  "$defs": {
    "contractRef": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "version",
        "contentHash"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 160
        },
        "version": {
          "type": "integer",
          "minimum": 1
        },
        "contentHash": {
          "type": "string",
          "pattern": "^sha256:[0-9a-fA-F]{64}$"
        }
      }
    },
    "stringList": {
      "type": "array",
      "minItems": 1,
      "maxItems": 32,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 1200
      }
    },
    "target": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "medium",
        "output",
        "stage"
      ],
      "properties": {
        "medium": {
          "enum": [
            "image",
            "video"
          ]
        },
        "output": {
          "enum": [
            "prompt",
            "shot",
            "storyboard",
            "render_plan",
            "style_test"
          ]
        },
        "stage": {
          "enum": [
            "exploration",
            "identity",
            "appearance",
            "shot",
            "motion",
            "validation"
          ]
        },
        "aspectRatio": {
          "type": "string",
          "maxLength": 32
        }
      }
    },
    "semanticEmphasis": {
      "enum": [
        "required",
        "strong",
        "supporting"
      ]
    },
    "block": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "channel",
        "importance",
        "directives"
      ],
      "properties": {
        "channel": {
          "enum": [
            "medium",
            "representation",
            "geometry",
            "shape_language",
            "linework",
            "surface",
            "shading",
            "depth",
            "effects",
            "panel_layout",
            "typography",
            "character",
            "costume",
            "scene",
            "composition",
            "camera",
            "lighting",
            "palette",
            "material",
            "performance",
            "motion",
            "temporal",
            "postprocess"
          ]
        },
        "importance": {
          "$ref": "#/$defs/semanticEmphasis"
        },
        "directives": {
          "$ref": "#/$defs/stringList"
        },
        "negativeDirectives": {
          "type": "array",
          "maxItems": 24,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 1200
          }
        }
      }
    },
    "representationVariant": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "variantId",
        "family",
        "separateCompileArtifact",
        "identityTranslationBound",
        "protectedDomains"
      ],
      "properties": {
        "variantId": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9._-]{2,159}$"
        },
        "family": {
          "enum": [
            "photoreal",
            "anime",
            "manga",
            "illustration",
            "stylized_3d",
            "hybrid"
          ]
        },
        "separateCompileArtifact": {
          "const": true
        },
        "identityTranslationBound": {
          "const": true
        },
        "protectedDomains": {
          "type": "array",
          "minItems": 4,
          "maxItems": 8,
          "uniqueItems": true,
          "items": {
            "enum": [
              "character_identity",
              "character_appearance",
              "scene_geography",
              "physical_light",
              "camera",
              "interaction"
            ]
          }
        }
      }
    },
    "referenceInput": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "referenceId",
        "role",
        "required",
        "preserve",
        "ignore"
      ],
      "properties": {
        "referenceId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 160
        },
        "role": {
          "type": "string",
          "minLength": 1,
          "maxLength": 160
        },
        "required": {
          "type": "boolean"
        },
        "preserve": {
          "$ref": "#/$defs/stringList"
        },
        "ignore": {
          "$ref": "#/$defs/stringList"
        }
      }
    },
    "intentScale": {
      "type": "number",
      "minimum": 0,
      "maximum": 1
    },
    "realismProfile": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "representationalRealism",
        "anatomyFidelity",
        "surfaceMicrodetailVisibility",
        "materialDifferentiation",
        "naturalAsymmetryRetention",
        "opticalImperfection",
        "idealization",
        "beautyRetouch",
        "calibration"
      ],
      "properties": {
        "representationalRealism": {
          "$ref": "#/$defs/intentScale"
        },
        "anatomyFidelity": {
          "$ref": "#/$defs/intentScale"
        },
        "surfaceMicrodetailVisibility": {
          "$ref": "#/$defs/intentScale"
        },
        "materialDifferentiation": {
          "$ref": "#/$defs/intentScale"
        },
        "naturalAsymmetryRetention": {
          "$ref": "#/$defs/intentScale"
        },
        "opticalImperfection": {
          "$ref": "#/$defs/intentScale"
        },
        "idealization": {
          "$ref": "#/$defs/intentScale"
        },
        "beautyRetouch": {
          "$ref": "#/$defs/intentScale"
        },
        "calibration": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "scale",
            "providerNeutral",
            "notQualityScore",
            "identityProtected",
            "materialStateProtected",
            "doesNotPromiseOutput"
          ],
          "properties": {
            "scale": {
              "const": "normalized_creative_intent"
            },
            "providerNeutral": {
              "const": true
            },
            "notQualityScore": {
              "const": true
            },
            "identityProtected": {
              "const": true
            },
            "materialStateProtected": {
              "const": true
            },
            "doesNotPromiseOutput": {
              "const": true
            }
          }
        }
      }
    },
    "planningBoundary": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "providerNeutral",
        "generatesMedia",
        "humanApprovalRequired"
      ],
      "properties": {
        "providerNeutral": {
          "const": true
        },
        "generatesMedia": {
          "const": false
        },
        "humanApprovalRequired": {
          "const": true
        },
        "notes": {
          "type": "string",
          "maxLength": 1200
        }
      }
    },
    "skillReceipt": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "repository",
        "ref",
        "commit",
        "installedBy",
        "usedAt"
      ],
      "properties": {
        "repository": {
          "type": "string",
          "format": "uri",
          "pattern": "^https://(www\\.)?github\\.com/[^/]+/[^/]+(?:\\.git)?/?$"
        },
        "ref": {
          "type": "string",
          "minLength": 1,
          "maxLength": 240
        },
        "commit": {
          "type": "string",
          "pattern": "^[0-9a-fA-F]{7,64}$"
        },
        "contentHash": {
          "type": "string",
          "pattern": "^sha256:[0-9a-fA-F]{64}$"
        },
        "installedBy": {
          "const": "codex-environment"
        },
        "environmentId": {
          "type": "string",
          "maxLength": 240
        },
        "usedAt": {
          "type": "string",
          "format": "date-time"
        }
      }
    }
  }
}
