{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cineweave.dev/contracts/reference-transform.schema.json",
  "title": "CineWeave Reference-to-Target Transform",
  "description": "An explicit, provider-neutral delta between observed reference evidence and a requested target image.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "transformId",
    "sourceObservationRefs",
    "targetDeltas",
    "acceptanceCriteria",
    "validation"
  ],
  "properties": {
    "transformId": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9._-]{2,159}$"
    },
    "sourceObservationRefs": {
      "type": "array",
      "minItems": 1,
      "maxItems": 8,
      "items": {
        "$ref": "#/$defs/referenceObservationRef"
      }
    },
    "targetDeltas": {
      "type": "array",
      "minItems": 1,
      "maxItems": 16,
      "items": {
        "$ref": "#/$defs/targetDelta"
      }
    },
    "unknowns": {
      "type": "array",
      "minItems": 1,
      "maxItems": 16,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 1200
      }
    },
    "acceptanceCriteria": {
      "type": "array",
      "minItems": 1,
      "maxItems": 16,
      "items": {
        "$ref": "#/$defs/acceptanceCriterion"
      }
    },
    "validation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "sourceObservationsBound",
        "targetDeltasExplicit",
        "changedDimensionsBounded",
        "unknownsFlagged"
      ],
      "properties": {
        "sourceObservationsBound": {
          "const": true
        },
        "targetDeltasExplicit": {
          "const": true
        },
        "changedDimensionsBounded": {
          "const": true
        },
        "unknownsFlagged": {
          "const": true
        }
      }
    }
  },
  "$defs": {
    "referenceObservationRef": {
      "allOf": [
        {
          "$ref": "common.schema.json#/$defs/contractRef"
        },
        {
          "properties": {
            "kind": {
              "const": "cineweave_codex_reference_observation"
            }
          }
        }
      ]
    },
    "targetDelta": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "dimension",
        "sourceTreatment",
        "directive",
        "evidenceBasis",
        "acceptanceCheck"
      ],
      "properties": {
        "dimension": {
          "enum": [
            "canvas",
            "framing",
            "viewpoint",
            "identity",
            "appearance",
            "subject_state",
            "pose",
            "performance",
            "wardrobe",
            "environment",
            "composition",
            "lighting",
            "representation",
            "material",
            "palette",
            "typography",
            "other"
          ]
        },
        "sourceTreatment": {
          "enum": [
            "preserve",
            "replace",
            "exclude",
            "unresolved"
          ]
        },
        "directive": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1600
        },
        "evidenceBasis": {
          "enum": [
            "user_declared",
            "target_contract",
            "source_visible",
            "source_inferred",
            "safe_default"
          ]
        },
        "acceptanceCheck": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1200
        }
      }
    },
    "acceptanceCriterion": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "criterionId",
        "check",
        "status"
      ],
      "properties": {
        "criterionId": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9._-]{2,159}$"
        },
        "check": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1200
        },
        "status": {
          "enum": [
            "pending",
            "pass",
            "fail"
          ]
        }
      }
    }
  }
}
