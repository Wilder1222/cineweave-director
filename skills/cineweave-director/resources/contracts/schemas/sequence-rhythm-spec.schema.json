{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cineweave.dev/contracts/sequence-rhythm-spec.schema.json",
  "title": "CineWeave Director Sequence Rhythm Specification",
  "description": "A provider-neutral, sequence-level rhythm plan that allocates exact integer-frame windows and explicit transition grammar without becoming an editorial conform or media executor.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "kind",
    "contractVersion",
    "sequenceRhythmSpecId",
    "version",
    "storyboardRef",
    "skillReceipt",
    "rhythmIntent",
    "timebase",
    "shotDurationPolicy",
    "tempoPhases",
    "shotWindows",
    "breathingPoints",
    "transitions",
    "continuity",
    "planningBoundary",
    "validation",
    "provenance"
  ],
  "properties": {
    "kind": {
      "const": "cineweave_codex_sequence_rhythm_spec"
    },
    "contractVersion": {
      "const": "2.5.0"
    },
    "sequenceRhythmSpecId": {
      "$ref": "common.schema.json#/$defs/identifier"
    },
    "version": {
      "type": "integer",
      "minimum": 1
    },
    "storyboardRef": {
      "$ref": "#/$defs/storyboardRef"
    },
    "skillReceipt": {
      "$ref": "common.schema.json#/$defs/skillReceipt"
    },
    "rhythmIntent": {
      "type": "string",
      "minLength": 1,
      "maxLength": 1200
    },
    "timebase": {
      "$ref": "#/$defs/timebase"
    },
    "shotDurationPolicy": {
      "$ref": "#/$defs/shotDurationPolicy"
    },
    "tempoPhases": {
      "type": "array",
      "minItems": 1,
      "maxItems": 16,
      "items": {
        "$ref": "#/$defs/tempoPhase"
      }
    },
    "shotWindows": {
      "type": "array",
      "minItems": 1,
      "maxItems": 64,
      "items": {
        "$ref": "#/$defs/shotWindow"
      }
    },
    "breathingPoints": {
      "type": "array",
      "maxItems": 64,
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/breathingPoint"
      }
    },
    "transitions": {
      "type": "array",
      "maxItems": 64,
      "items": {
        "$ref": "#/$defs/transition"
      }
    },
    "continuity": {
      "$ref": "#/$defs/continuity"
    },
    "planningBoundary": {
      "$ref": "#/$defs/planningBoundary"
    },
    "validation": {
      "$ref": "#/$defs/validation"
    },
    "provenance": {
      "$ref": "common.schema.json#/$defs/provenance"
    }
  },
  "$defs": {
    "storyboardRef": {
      "allOf": [
        {
          "$ref": "common.schema.json#/$defs/contractRef"
        },
        {
          "properties": {
            "kind": {
              "const": "cineweave_codex_storyboard_sequence"
            }
          }
        }
      ]
    },
    "timebase": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "numerator",
        "denominator",
        "unit",
        "frameIndexOrigin"
      ],
      "properties": {
        "numerator": {
          "type": "integer",
          "minimum": 1,
          "maximum": 480000
        },
        "denominator": {
          "type": "integer",
          "minimum": 1,
          "maximum": 1001
        },
        "unit": {
          "const": "frames"
        },
        "frameIndexOrigin": {
          "const": 0
        },
        "notes": {
          "type": "string",
          "maxLength": 600
        }
      }
    },
    "shotDurationPolicy": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "minimumFrames",
        "preferredFrames",
        "maximumFrames"
      ],
      "properties": {
        "minimumFrames": {
          "type": "integer",
          "minimum": 1,
          "maximum": 100000000
        },
        "preferredFrames": {
          "type": "integer",
          "minimum": 1,
          "maximum": 100000000
        },
        "maximumFrames": {
          "type": "integer",
          "minimum": 1,
          "maximum": 100000000
        },
        "rationale": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1200
        }
      }
    },
    "tempoPhase": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "phaseId",
        "order",
        "tempo",
        "cutDensity",
        "shotIds",
        "purpose"
      ],
      "properties": {
        "phaseId": {
          "$ref": "common.schema.json#/$defs/identifier"
        },
        "order": {
          "type": "integer",
          "minimum": 1,
          "maximum": 16
        },
        "tempo": {
          "enum": [
            "still",
            "calm",
            "controlled",
            "dynamic",
            "chaotic"
          ]
        },
        "cutDensity": {
          "enum": [
            "low",
            "medium",
            "high"
          ]
        },
        "shotIds": {
          "type": "array",
          "minItems": 1,
          "maxItems": 64,
          "uniqueItems": true,
          "items": {
            "$ref": "common.schema.json#/$defs/identifier"
          }
        },
        "purpose": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1200
        }
      }
    },
    "shotWindow": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "shotId",
        "order",
        "startFrame",
        "endFrame",
        "purpose"
      ],
      "properties": {
        "shotId": {
          "$ref": "common.schema.json#/$defs/identifier"
        },
        "order": {
          "type": "integer",
          "minimum": 1,
          "maximum": 64
        },
        "startFrame": {
          "type": "integer",
          "minimum": 0,
          "maximum": 100000000
        },
        "endFrame": {
          "type": "integer",
          "minimum": 0,
          "maximum": 100000000
        },
        "purpose": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1200
        },
        "breathing": {
          "type": "boolean"
        }
      }
    },
    "breathingPoint": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "shotId",
        "frame",
        "rationale"
      ],
      "properties": {
        "shotId": {
          "$ref": "common.schema.json#/$defs/identifier"
        },
        "frame": {
          "type": "integer",
          "minimum": 0,
          "maximum": 100000000
        },
        "rationale": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1000
        }
      }
    },
    "transition": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "fromShotId",
        "toShotId",
        "grammar",
        "rationale"
      ],
      "properties": {
        "fromShotId": {
          "$ref": "common.schema.json#/$defs/identifier"
        },
        "toShotId": {
          "$ref": "common.schema.json#/$defs/identifier"
        },
        "grammar": {
          "enum": [
            "hard_cut",
            "action_match",
            "gaze_match",
            "match_cut",
            "whip_pan",
            "dissolve",
            "sound_bridge",
            "hold"
          ]
        },
        "rationale": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1200
        }
      }
    },
    "continuity": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "preserveScreenDirection",
        "axisPolicy",
        "stableEndStates",
        "shotOrderLocked"
      ],
      "properties": {
        "preserveScreenDirection": {
          "const": true
        },
        "axisPolicy": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1000
        },
        "stableEndStates": {
          "const": true
        },
        "shotOrderLocked": {
          "const": true
        },
        "notes": {
          "type": "string",
          "maxLength": 1000
        }
      }
    },
    "planningBoundary": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "providerNeutral",
        "generatesMedia",
        "invokesExternalTool",
        "editsMedia",
        "humanApprovalRequired"
      ],
      "properties": {
        "providerNeutral": {
          "const": true
        },
        "generatesMedia": {
          "const": false
        },
        "invokesExternalTool": {
          "const": false
        },
        "editsMedia": {
          "const": false
        },
        "humanApprovalRequired": {
          "const": true
        },
        "notes": {
          "type": "string",
          "maxLength": 1200
        }
      }
    },
    "validation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "exactStoryboardRef",
        "rationalTimebase",
        "shotWindowsOrdered",
        "storyboardShotsCovered",
        "phaseCoverageClosed",
        "transitionsAdjacent",
        "continuityExplicit",
        "providerNeutral",
        "noMediaGeneration"
      ],
      "properties": {
        "exactStoryboardRef": {
          "const": true
        },
        "rationalTimebase": {
          "const": true
        },
        "shotWindowsOrdered": {
          "const": true
        },
        "storyboardShotsCovered": {
          "const": true
        },
        "phaseCoverageClosed": {
          "const": true
        },
        "transitionsAdjacent": {
          "const": true
        },
        "continuityExplicit": {
          "const": true
        },
        "providerNeutral": {
          "const": true
        },
        "noMediaGeneration": {
          "const": true
        }
      }
    }
  }
}
