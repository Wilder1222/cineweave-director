{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cineweave.dev/contracts/evidence-bundle.schema.json",
  "title": "CineWeave Production Evidence Bundle",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "kind",
    "contractVersion",
    "worldId",
    "bundleId",
    "title",
    "version",
    "status",
    "skillReceipt",
    "purpose",
    "evidence",
    "requirements",
    "rightsResolution",
    "validation",
    "provenance"
  ],
  "properties": {
    "kind": {
      "const": "cineweave_codex_evidence_bundle"
    },
    "contractVersion": {
      "const": "2.0.0"
    },
    "worldId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 160
    },
    "bundleId": {
      "$ref": "#/$defs/lowerId"
    },
    "title": {
      "type": "string",
      "minLength": 1,
      "maxLength": 240
    },
    "version": {
      "type": "integer",
      "minimum": 1
    },
    "status": {
      "enum": [
        "draft",
        "active",
        "locked",
        "archived"
      ]
    },
    "skillReceipt": {
      "$ref": "#/$defs/skillReceipt"
    },
    "purpose": {
      "type": "string",
      "minLength": 1,
      "maxLength": 2000
    },
    "evidence": {
      "type": "array",
      "minItems": 1,
      "maxItems": 64,
      "items": {
        "$ref": "#/$defs/evidence"
      }
    },
    "requirements": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "requiredRoles",
        "minimumConfidence",
        "missingEvidencePolicy"
      ],
      "properties": {
        "requiredRoles": {
          "type": "array",
          "minItems": 1,
          "maxItems": 32,
          "uniqueItems": true,
          "items": {
            "enum": [
              "face_identity",
              "body_identity",
              "full_character",
              "makeup",
              "hair",
              "costume",
              "material",
              "expression",
              "pose",
              "motion",
              "depth",
              "segmentation",
              "mask",
              "composition",
              "lighting",
              "background",
              "scene_geography",
              "scene_architecture",
              "prop_layout",
              "atmosphere",
              "camera_axis",
              "style",
              "generic"
            ]
          }
        },
        "minimumConfidence": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "missingEvidencePolicy": {
          "enum": [
            "block",
            "warn",
            "degrade"
          ]
        }
      }
    },
    "rightsResolution": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "allProfilesResolved",
        "unresolved"
      ],
      "properties": {
        "allProfilesResolved": {
          "type": "boolean"
        },
        "unresolved": {
          "type": "array",
          "maxItems": 32,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 1000
          }
        }
      }
    },
    "validation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "observationIdsScoped",
        "rolesDistinct",
        "rightsProfilesLinked",
        "noPrivatePaths"
      ],
      "properties": {
        "observationIdsScoped": {
          "const": true
        },
        "rolesDistinct": {
          "const": true
        },
        "rightsProfilesLinked": {
          "const": true
        },
        "noPrivatePaths": {
          "const": true
        }
      }
    },
    "provenance": {
      "$ref": "#/$defs/provenance"
    }
  },
  "$defs": {
    "skillReceipt": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "repository",
        "ref",
        "commit",
        "installedBy",
        "usedAt"
      ],
      "properties": {
        "repository": {
          "type": "string",
          "format": "uri",
          "pattern": "^https://(www\\.)?github\\.com/[^/]+/[^/]+(?:\\.git)?/?$"
        },
        "ref": {
          "type": "string",
          "minLength": 1,
          "maxLength": 240
        },
        "commit": {
          "type": "string",
          "pattern": "^[0-9a-fA-F]{7,64}$"
        },
        "contentHash": {
          "type": "string",
          "pattern": "^sha256:[0-9a-fA-F]{64}$"
        },
        "installedBy": {
          "const": "codex-environment"
        },
        "environmentId": {
          "type": "string",
          "maxLength": 240
        },
        "usedAt": {
          "type": "string",
          "format": "date-time"
        }
      }
    },
    "stableId": {
      "type": "string",
      "pattern": "^[a-zA-Z][a-zA-Z0-9._-]{1,159}$"
    },
    "lowerId": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9._-]{2,159}$"
    },
    "observationId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 160,
      "not": {
        "pattern": "(?:https?:|file:|[\\\\/?#])"
      }
    },
    "contentHash": {
      "type": "string",
      "pattern": "^sha256:[0-9a-fA-F]{64}$"
    },
    "stringList": {
      "type": "array",
      "minItems": 1,
      "maxItems": 32,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 1600
      }
    },
    "optionalStringList": {
      "type": "array",
      "maxItems": 32,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 1600
      }
    },
    "primitive": {
      "type": [
        "string",
        "number",
        "boolean",
        "null"
      ]
    },
    "provenance": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "source",
        "createdAt",
        "updatedAt",
        "changeLog"
      ],
      "properties": {
        "source": {
          "enum": [
            "user_authored",
            "codex_authored",
            "adapted",
            "imported",
            "suite_builtin"
          ]
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        },
        "parentId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 160
        },
        "changeLog": {
          "$ref": "#/$defs/stringList"
        }
      }
    },
    "versionedRef": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "id"
      ],
      "properties": {
        "kind": {
          "type": "string",
          "minLength": 1,
          "maxLength": 160
        },
        "id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 160
        },
        "version": {
          "type": "integer",
          "minimum": 1
        },
        "contentHash": {
          "$ref": "#/$defs/contentHash"
        },
        "observationIds": {
          "type": "array",
          "maxItems": 24,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/observationId"
          }
        }
      }
    },
    "contractRef": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "contentHash"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 160
        },
        "version": {
          "type": "integer",
          "minimum": 1
        },
        "contentHash": {
          "$ref": "#/$defs/contentHash"
        }
      }
    },
    "canvas": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "aspectRatio",
        "sizeClass"
      ],
      "properties": {
        "aspectRatio": {
          "type": "string",
          "pattern": "^[1-9][0-9]*:[1-9][0-9]*$"
        },
        "sizeClass": {
          "enum": [
            "square",
            "portrait",
            "landscape",
            "wide",
            "tall",
            "custom",
            "unspecified"
          ]
        },
        "pixelDimensions": {
          "type": "string",
          "pattern": "^[1-9][0-9]*x[1-9][0-9]*$"
        },
        "background": {
          "type": "string",
          "minLength": 1,
          "maxLength": 500
        }
      }
    },
    "quality": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "confidence",
        "coverage",
        "resolutionStatus"
      ],
      "properties": {
        "confidence": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "coverage": {
          "enum": [
            "partial",
            "sufficient",
            "complete"
          ]
        },
        "resolutionStatus": {
          "enum": [
            "unknown",
            "draft",
            "reviewable",
            "production"
          ]
        },
        "view": {
          "type": "string",
          "minLength": 1,
          "maxLength": 500
        },
        "framing": {
          "type": "string",
          "minLength": 1,
          "maxLength": 500
        },
        "notes": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1000
        }
      }
    },
    "evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "evidenceId",
        "observationId",
        "role",
        "scope",
        "sourceType",
        "targetRefs",
        "preserve",
        "allowedUses",
        "excludedUses",
        "quality",
        "licenseProfileRef"
      ],
      "properties": {
        "evidenceId": {
          "$ref": "#/$defs/stableId"
        },
        "observationId": {
          "$ref": "#/$defs/observationId"
        },
        "role": {
          "enum": [
            "face_identity",
            "body_identity",
            "face_morphology",
            "body_morphology",
            "full_character",
            "skin_material",
            "skin_surface",
            "eye_surface",
            "makeup",
            "hair",
            "hair_material",
            "costume",
            "material",
            "expression",
            "pose",
            "motion",
            "depth",
            "segmentation",
            "mask",
            "capture",
            "composition",
            "lighting",
            "background",
            "scene_geography",
            "scene_architecture",
            "prop_layout",
            "atmosphere",
            "camera_axis",
            "style",
            "representation_geometry",
            "shape_language",
            "linework",
            "surface_style",
            "shading",
            "color_system",
            "depth_language",
            "effects",
            "panel_layout",
            "typography",
            "motion_style",
            "generic"
          ]
        },
        "scope": {
          "enum": [
            "face",
            "face_morphology",
            "eyes",
            "skin",
            "body",
            "body_morphology",
            "hair",
            "full_character",
            "costume",
            "prop",
            "expression",
            "pose",
            "motion",
            "capture",
            "environment",
            "lighting",
            "material",
            "composition",
            "style",
            "representation",
            "linework",
            "shading",
            "depth",
            "effects",
            "panel_layout",
            "typography",
            "mask",
            "architecture",
            "geography",
            "prop_layout",
            "weather",
            "atmosphere",
            "camera_axis",
            "scale",
            "generic"
          ]
        },
        "sourceType": {
          "enum": [
            "world_observation",
            "user_upload",
            "candidate_media",
            "derived_control",
            "suite_fixture"
          ]
        },
        "contentHash": {
          "$ref": "#/$defs/contentHash"
        },
        "targetRefs": {
          "type": "array",
          "minItems": 1,
          "maxItems": 12,
          "items": {
            "$ref": "#/$defs/versionedRef"
          }
        },
        "preserve": {
          "$ref": "#/$defs/stringList"
        },
        "allowedUses": {
          "$ref": "#/$defs/stringList"
        },
        "excludedUses": {
          "$ref": "#/$defs/stringList"
        },
        "quality": {
          "$ref": "#/$defs/quality"
        },
        "licenseProfileRef": {
          "$ref": "#/$defs/contractRef"
        }
      }
    }
  }
}
