{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cineweave.dev/contracts/story-brief.schema.json",
  "title": "CineWeave Story Brief",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "kind",
    "contractVersion",
    "storyId",
    "title",
    "version",
    "status",
    "skillReceipt",
    "premise",
    "dramaticQuestion",
    "theme",
    "genre",
    "tone",
    "audience",
    "protagonist",
    "stakes",
    "endingDirection",
    "locks",
    "unknowns",
    "validation"
  ],
  "properties": {
    "kind": {
      "const": "cineweave_codex_story_brief"
    },
    "contractVersion": {
      "const": "2.2.0"
    },
    "storyId": {
      "$ref": "common.schema.json#/$defs/identifier"
    },
    "title": {
      "type": "string",
      "minLength": 1,
      "maxLength": 240
    },
    "version": {
      "type": "integer",
      "minimum": 1
    },
    "status": {
      "enum": [
        "draft",
        "approved",
        "archived"
      ]
    },
    "skillReceipt": {
      "$ref": "common.schema.json#/$defs/skillReceipt"
    },
    "premise": {
      "type": "string",
      "minLength": 1,
      "maxLength": 2400
    },
    "dramaticQuestion": {
      "type": "string",
      "minLength": 1,
      "maxLength": 1000
    },
    "theme": {
      "$ref": "common.schema.json#/$defs/stringList"
    },
    "genre": {
      "$ref": "common.schema.json#/$defs/stringList"
    },
    "tone": {
      "$ref": "common.schema.json#/$defs/stringList"
    },
    "audience": {
      "type": "string",
      "minLength": 1,
      "maxLength": 800
    },
    "worldContext": {
      "type": "string",
      "maxLength": 2400
    },
    "protagonist": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "role",
        "want",
        "need",
        "fear",
        "contradiction"
      ],
      "properties": {
        "characterRef": {
          "$ref": "common.schema.json#/$defs/contractRef"
        },
        "role": {
          "type": "string",
          "minLength": 1,
          "maxLength": 800
        },
        "want": {
          "type": "string",
          "minLength": 1,
          "maxLength": 800
        },
        "need": {
          "type": "string",
          "minLength": 1,
          "maxLength": 800
        },
        "fear": {
          "type": "string",
          "minLength": 1,
          "maxLength": 800
        },
        "contradiction": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1000
        }
      }
    },
    "stakes": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "personal",
        "relational",
        "external"
      ],
      "properties": {
        "personal": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1000
        },
        "relational": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1000
        },
        "external": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1000
        }
      }
    },
    "endingDirection": {
      "type": "string",
      "minLength": 1,
      "maxLength": 1600
    },
    "locks": {
      "type": "array",
      "items": {
        "$ref": "common.schema.json#/$defs/lock"
      },
      "maxItems": 32
    },
    "unknowns": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 800
      },
      "maxItems": 24
    },
    "validation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "oneDramaticQuestion",
        "protagonistCausality",
        "stakesEscalate",
        "noShotDecisions"
      ],
      "properties": {
        "oneDramaticQuestion": {
          "const": true
        },
        "protagonistCausality": {
          "const": true
        },
        "stakesEscalate": {
          "const": true
        },
        "noShotDecisions": {
          "const": true
        }
      }
    }
  }
}
