{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cineweave.dev/contracts/character-spec.schema.json",
  "title": "CineWeave Codex Character Specification",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "kind",
    "worldId",
    "characterId",
    "name",
    "version",
    "status",
    "skillReceipt",
    "narrativeCore",
    "identityCore",
    "appearanceLayers",
    "motionFingerprint",
    "behaviorModel",
    "referencePolicy",
    "rights",
    "validation",
    "provenance"
  ],
  "properties": {
    "contractVersion": {
      "const": "2.0.0"
    },
    "kind": {
      "const": "cineweave_codex_character_spec"
    },
    "worldId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 160
    },
    "characterId": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9._-]{2,159}$"
    },
    "name": {
      "type": "string",
      "minLength": 1,
      "maxLength": 240
    },
    "version": {
      "type": "integer",
      "minimum": 1
    },
    "status": {
      "enum": [
        "draft",
        "active",
        "locked",
        "archived",
        "retired"
      ]
    },
    "morphologySpecRef": {
      "$ref": "#/$defs/morphologySpecRef"
    },
    "collection": {
      "type": "string",
      "minLength": 1,
      "maxLength": 160
    },
    "tags": {
      "type": "array",
      "maxItems": 24,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 120
      }
    },
    "skillReceipt": {
      "$ref": "#/$defs/skillReceipt"
    },
    "narrativeCore": {
      "$ref": "#/$defs/narrativeCore"
    },
    "identityCore": {
      "$ref": "#/$defs/identityCore"
    },
    "appearanceLayers": {
      "$ref": "#/$defs/appearanceLayers"
    },
    "motionFingerprint": {
      "$ref": "#/$defs/motionFingerprint"
    },
    "behaviorModel": {
      "$ref": "#/$defs/behaviorModel"
    },
    "referencePolicy": {
      "$ref": "#/$defs/referencePolicy"
    },
    "rights": {
      "$ref": "#/$defs/rights"
    },
    "validation": {
      "$ref": "#/$defs/validation"
    },
    "provenance": {
      "$ref": "#/$defs/provenance"
    },
    "referencePlanIds": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/stableId"
      },
      "maxItems": 16,
      "uniqueItems": true
    },
    "appearanceStateIds": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/stableId"
      },
      "maxItems": 24,
      "uniqueItems": true
    }
  },
  "$defs": {
    "skillReceipt": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "repository",
        "ref",
        "commit",
        "installedBy",
        "usedAt"
      ],
      "properties": {
        "repository": {
          "type": "string",
          "format": "uri",
          "pattern": "^https://(www\\.)?github\\.com/[^/]+/[^/]+(?:\\.git)?/?$"
        },
        "ref": {
          "type": "string",
          "minLength": 1,
          "maxLength": 240
        },
        "commit": {
          "type": "string",
          "pattern": "^[0-9a-fA-F]{7,64}$"
        },
        "contentHash": {
          "type": "string",
          "pattern": "^sha256:[0-9a-fA-F]{64}$"
        },
        "installedBy": {
          "const": "codex-environment"
        },
        "environmentId": {
          "type": "string",
          "maxLength": 240
        },
        "usedAt": {
          "type": "string",
          "format": "date-time"
        }
      }
    },
    "stableId": {
      "type": "string",
      "pattern": "^[a-zA-Z][a-zA-Z0-9._-]{1,159}$"
    },
    "morphologySpecRef": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "id",
        "version",
        "contentHash"
      ],
      "properties": {
        "kind": {
          "const": "cineweave_codex_character_morphology_spec"
        },
        "id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 160
        },
        "version": {
          "type": "integer",
          "minimum": 1
        },
        "contentHash": {
          "type": "string",
          "pattern": "^sha256:[0-9a-fA-F]{64}$"
        }
      }
    },
    "observationId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 160,
      "not": {
        "pattern": "(?:https?:|file:|[\\\\/?#])"
      }
    },
    "stringList": {
      "type": "array",
      "minItems": 1,
      "maxItems": 24,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 1200
      }
    },
    "optionalStringList": {
      "type": "array",
      "maxItems": 24,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 1200
      }
    },
    "narrativeCore": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "role",
        "oneLineConcept",
        "coreDesire",
        "coreFear",
        "publicMask",
        "privateContradiction"
      ],
      "properties": {
        "role": {
          "type": "string",
          "minLength": 1,
          "maxLength": 500
        },
        "oneLineConcept": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1200
        },
        "coreDesire": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1200
        },
        "coreFear": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1200
        },
        "publicMask": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1200
        },
        "privateContradiction": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1200
        },
        "backstorySignals": {
          "$ref": "#/$defs/optionalStringList"
        },
        "behavioralPrinciples": {
          "$ref": "#/$defs/optionalStringList"
        }
      }
    },
    "identityAnchor": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "anchorId",
        "type",
        "description",
        "priority",
        "visibleAt"
      ],
      "properties": {
        "anchorId": {
          "$ref": "#/$defs/stableId"
        },
        "type": {
          "enum": [
            "face",
            "body",
            "silhouette",
            "surface",
            "marking",
            "movement",
            "prop"
          ]
        },
        "description": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1200
        },
        "priority": {
          "enum": [
            "critical",
            "high",
            "supporting"
          ]
        },
        "visibleAt": {
          "type": "array",
          "minItems": 1,
          "maxItems": 5,
          "uniqueItems": true,
          "items": {
            "enum": [
              "closeup",
              "medium",
              "fullbody",
              "wide",
              "silhouette"
            ]
          }
        },
        "evidenceObservationIds": {
          "type": "array",
          "maxItems": 8,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/observationId"
          }
        }
      }
    },
    "faceIdentity": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "geometry",
        "features",
        "surface",
        "asymmetry"
      ],
      "properties": {
        "geometry": {
          "$ref": "#/$defs/stringList"
        },
        "features": {
          "$ref": "#/$defs/stringList"
        },
        "surface": {
          "$ref": "#/$defs/stringList"
        },
        "asymmetry": {
          "$ref": "#/$defs/stringList"
        }
      }
    },
    "surfaceProfile": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "baselineComplexion",
        "regionalVariation",
        "microTexture",
        "eyes",
        "lips",
        "forbidden",
        "calibration"
      ],
      "properties": {
        "baselineComplexion": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "toneRange",
            "undertone"
          ],
          "properties": {
            "toneRange": {
              "type": "string",
              "minLength": 1,
              "maxLength": 500
            },
            "undertone": {
              "type": "string",
              "minLength": 1,
              "maxLength": 500
            }
          }
        },
        "regionalVariation": {
          "type": "array",
          "minItems": 2,
          "maxItems": 16,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "region",
              "behavior"
            ],
            "properties": {
              "region": {
                "enum": [
                  "forehead",
                  "eyelids",
                  "under_eye",
                  "nose",
                  "cheeks",
                  "mouth_area",
                  "jaw",
                  "neck",
                  "ears",
                  "hands",
                  "body"
                ]
              },
              "behavior": {
                "type": "string",
                "minLength": 1,
                "maxLength": 800
              }
            }
          }
        },
        "microTexture": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "poreVisibility",
            "peachFuzz",
            "underEyeTexture",
            "fineLines"
          ],
          "properties": {
            "poreVisibility": {
              "enum": [
                "none",
                "subtle",
                "moderate",
                "pronounced"
              ]
            },
            "peachFuzz": {
              "enum": [
                "none",
                "subtle",
                "natural",
                "pronounced"
              ]
            },
            "underEyeTexture": {
              "enum": [
                "smoothed",
                "restrained",
                "preserved",
                "pronounced"
              ]
            },
            "fineLines": {
              "enum": [
                "minimal",
                "age_appropriate",
                "visible",
                "pronounced"
              ]
            }
          }
        },
        "eyes": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "scleraTone",
            "tearLineMoisture"
          ],
          "properties": {
            "scleraTone": {
              "type": "string",
              "minLength": 1,
              "maxLength": 500
            },
            "tearLineMoisture": {
              "enum": [
                "restrained",
                "natural",
                "pronounced"
              ]
            }
          }
        },
        "lips": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "naturalLines",
            "edgeCharacter"
          ],
          "properties": {
            "naturalLines": {
              "type": "boolean"
            },
            "edgeCharacter": {
              "type": "string",
              "minLength": 1,
              "maxLength": 500
            }
          }
        },
        "persistentMarks": {
          "$ref": "#/$defs/optionalStringList"
        },
        "forbidden": {
          "$ref": "#/$defs/stringList"
        },
        "calibration": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "providerNeutral",
            "notBiometric",
            "excludesMakeup",
            "excludesLighting"
          ],
          "properties": {
            "providerNeutral": {
              "const": true
            },
            "notBiometric": {
              "const": true
            },
            "excludesMakeup": {
              "const": true
            },
            "excludesLighting": {
              "const": true
            }
          }
        }
      }
    },
    "bodyIdentity": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "headToBodyRatio",
        "silhouette",
        "proportions",
        "centerOfGravity",
        "dominantSide"
      ],
      "properties": {
        "headToBodyRatio": {
          "type": "number",
          "minimum": 4,
          "maximum": 12
        },
        "silhouette": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1200
        },
        "proportions": {
          "$ref": "#/$defs/stringList"
        },
        "centerOfGravity": {
          "type": "string",
          "minLength": 1,
          "maxLength": 800
        },
        "dominantSide": {
          "enum": [
            "left",
            "right",
            "ambidextrous",
            "unknown"
          ]
        },
        "muscleAndFatDistribution": {
          "$ref": "#/$defs/optionalStringList"
        },
        "occupationalTraces": {
          "$ref": "#/$defs/optionalStringList"
        }
      }
    },
    "identityCore": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "apparentAge",
        "immutableAnchors",
        "face",
        "body",
        "forbiddenChanges"
      ],
      "properties": {
        "apparentAge": {
          "type": "string",
          "minLength": 1,
          "maxLength": 240
        },
        "immutableAnchors": {
          "type": "array",
          "minItems": 3,
          "maxItems": 16,
          "items": {
            "$ref": "#/$defs/identityAnchor"
          }
        },
        "face": {
          "$ref": "#/$defs/faceIdentity"
        },
        "body": {
          "$ref": "#/$defs/bodyIdentity"
        },
        "surfaceProfile": {
          "$ref": "#/$defs/surfaceProfile"
        },
        "forbiddenChanges": {
          "$ref": "#/$defs/stringList"
        }
      }
    },
    "appearanceVariable": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "variableId",
        "type",
        "label",
        "defaultState",
        "allowedValues",
        "constraints"
      ],
      "properties": {
        "variableId": {
          "$ref": "#/$defs/stableId"
        },
        "type": {
          "enum": [
            "hair",
            "wardrobe",
            "makeup",
            "injury",
            "age_state",
            "weather_response",
            "accessory",
            "skin_state"
          ]
        },
        "label": {
          "type": "string",
          "minLength": 1,
          "maxLength": 240
        },
        "defaultState": {
          "type": "string",
          "minLength": 1,
          "maxLength": 800
        },
        "allowedValues": {
          "$ref": "#/$defs/stringList"
        },
        "constraints": {
          "$ref": "#/$defs/stringList"
        }
      }
    },
    "appearanceLayers": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "locked",
        "controlledVariables"
      ],
      "properties": {
        "locked": {
          "$ref": "#/$defs/stringList"
        },
        "controlledVariables": {
          "type": "array",
          "minItems": 1,
          "maxItems": 16,
          "items": {
            "$ref": "#/$defs/appearanceVariable"
          }
        }
      }
    },
    "motionFingerprint": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "baselinePosture",
        "gazeSequence",
        "walk",
        "turn",
        "signatureGestures",
        "tempo",
        "amplitude",
        "weightQuality",
        "forbiddenMotions"
      ],
      "properties": {
        "baselinePosture": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1200
        },
        "gazeSequence": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1200
        },
        "walk": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1200
        },
        "turn": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1200
        },
        "signatureGestures": {
          "$ref": "#/$defs/stringList"
        },
        "tempo": {
          "enum": [
            "measured",
            "abrupt",
            "flowing",
            "irregular",
            "still"
          ]
        },
        "amplitude": {
          "enum": [
            "restrained",
            "moderate",
            "expansive"
          ]
        },
        "weightQuality": {
          "enum": [
            "grounded",
            "light",
            "precise",
            "heavy",
            "elastic"
          ]
        },
        "forbiddenMotions": {
          "$ref": "#/$defs/stringList"
        }
      }
    },
    "intensityRange": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "min",
        "max"
      ],
      "properties": {
        "min": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "max": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        }
      }
    },
    "emotionalLeakage": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "emotionId",
        "emotion",
        "observableCues",
        "intensityRange",
        "concealmentBehavior"
      ],
      "properties": {
        "emotionId": {
          "$ref": "#/$defs/stableId"
        },
        "emotion": {
          "type": "string",
          "minLength": 1,
          "maxLength": 240
        },
        "observableCues": {
          "$ref": "#/$defs/stringList"
        },
        "intensityRange": {
          "$ref": "#/$defs/intensityRange"
        },
        "concealmentBehavior": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1200
        }
      }
    },
    "observableCues": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "posture",
        "gaze",
        "face",
        "hands",
        "breath"
      ],
      "properties": {
        "posture": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1200
        },
        "gaze": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1200
        },
        "face": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1200
        },
        "hands": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1200
        },
        "breath": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1200
        },
        "voice": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1200
        }
      }
    },
    "behaviorState": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "stateId",
        "label",
        "triggers",
        "objectivePattern",
        "observableCues",
        "forbiddenResponses",
        "exitConditions"
      ],
      "properties": {
        "stateId": {
          "$ref": "#/$defs/stableId"
        },
        "label": {
          "type": "string",
          "minLength": 1,
          "maxLength": 240
        },
        "triggers": {
          "$ref": "#/$defs/stringList"
        },
        "objectivePattern": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1200
        },
        "observableCues": {
          "$ref": "#/$defs/observableCues"
        },
        "forbiddenResponses": {
          "$ref": "#/$defs/stringList"
        },
        "exitConditions": {
          "$ref": "#/$defs/stringList"
        }
      }
    },
    "behaviorModel": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "baselineState",
        "emotionalLeakage",
        "states"
      ],
      "properties": {
        "baselineState": {
          "$ref": "#/$defs/stableId"
        },
        "emotionalLeakage": {
          "type": "array",
          "minItems": 1,
          "maxItems": 12,
          "items": {
            "$ref": "#/$defs/emotionalLeakage"
          }
        },
        "states": {
          "type": "array",
          "minItems": 1,
          "maxItems": 16,
          "items": {
            "$ref": "#/$defs/behaviorState"
          }
        }
      }
    },
    "referencePolicy": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "requiredViews",
        "identityObservationIds",
        "referenceLock"
      ],
      "properties": {
        "requiredViews": {
          "type": "array",
          "minItems": 4,
          "maxItems": 16,
          "uniqueItems": true,
          "items": {
            "enum": [
              "neutral_front",
              "three_quarter_left",
              "three_quarter_right",
              "profile_left",
              "profile_right",
              "full_body_front",
              "full_body_side",
              "full_body_back",
              "neutral_stance",
              "walk_midframe",
              "signature_pose",
              "expression_sheet",
              "motion_sheet"
            ]
          }
        },
        "identityObservationIds": {
          "type": "array",
          "maxItems": 16,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/observationId"
          }
        },
        "referenceLock": {
          "enum": [
            "draft",
            "provisional",
            "locked"
          ]
        },
        "notes": {
          "type": "string",
          "maxLength": 2000
        }
      }
    },
    "rights": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "sourceClass",
        "likenessConsent",
        "redistribution"
      ],
      "properties": {
        "sourceClass": {
          "enum": [
            "fictional_original",
            "adapted",
            "user_likeness",
            "licensed_character",
            "public_domain"
          ]
        },
        "likenessConsent": {
          "enum": [
            "not_applicable",
            "confirmed",
            "unverified",
            "restricted"
          ]
        },
        "redistribution": {
          "enum": [
            "allowed",
            "restricted",
            "unverified"
          ]
        },
        "notes": {
          "type": "string",
          "maxLength": 2000
        }
      }
    },
    "testStatus": {
      "enum": [
        "pending",
        "pass",
        "fail"
      ]
    },
    "validation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "recognizableWithoutWardrobe",
        "silhouetteDistinct",
        "crossExpressionStable",
        "crossShotStable",
        "dominantSideStable",
        "anchorCoverage"
      ],
      "properties": {
        "recognizableWithoutWardrobe": {
          "$ref": "#/$defs/testStatus"
        },
        "silhouetteDistinct": {
          "$ref": "#/$defs/testStatus"
        },
        "crossExpressionStable": {
          "$ref": "#/$defs/testStatus"
        },
        "crossShotStable": {
          "$ref": "#/$defs/testStatus"
        },
        "dominantSideStable": {
          "$ref": "#/$defs/testStatus"
        },
        "anchorCoverage": {
          "$ref": "#/$defs/testStatus"
        },
        "notes": {
          "type": "string",
          "maxLength": 2000
        }
      }
    },
    "provenance": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "source",
        "createdAt",
        "updatedAt",
        "changeLog"
      ],
