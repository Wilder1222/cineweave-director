{
  "$id": "https://cineweave.dev/contracts/workflow-plan.schema.json",
  "title": "CineWeave Route Workflow Plan",
  "description": "Acyclic route plan for the single CineWeave Director skill; it never executes tools or generates media.",
  "type": "object",
  "additionalProperties": false,
  "required": ["kind", "contractVersion", "workflowId", "version", "status", "creativeBriefRef", "steps", "deliverables", "currentGate", "planningBoundary", "validation", "skillReceipt", "provenance"],
  "properties": {
    "kind": { "const": "cineweave_codex_workflow_plan" },
    "contractVersion": { "const": "3.0.0" },
    "workflowId": { "$ref": "common.schema.json#/$defs/identifier" },
    "version": { "type": "integer", "minimum": 1 },
    "status": { "enum": ["draft", "ready", "blocked", "complete", "archived"] },
    "creativeBriefRef": { "allOf": [{ "$ref": "common.schema.json#/$defs/contractRef" }, { "properties": { "kind": { "const": "cineweave_codex_creative_brief" } } }] },
    "steps": { "type": "array", "minItems": 1, "maxItems": 32, "items": { "$ref": "#/$defs/step" } },
    "deliverables": { "type": "array", "minItems": 1, "maxItems": 32, "items": { "$ref": "#/$defs/deliverable" } },
    "currentGate": { "$ref": "#/$defs/currentGate" },
    "questions": { "type": "array", "maxItems": 3, "items": { "type": "string", "minLength": 1, "maxLength": 1000 } },
    "warnings": { "type": "array", "maxItems": 24, "items": { "type": "string", "minLength": 1, "maxLength": 1200 } },
    "planningBoundary": { "$ref": "#/$defs/planningBoundary" },
    "validation": { "$ref": "#/$defs/validation" },
    "skillReceipt": { "$ref": "common.schema.json#/$defs/skillReceipt" },
    "provenance": { "$ref": "common.schema.json#/$defs/provenance" }
  },
  "$defs": {
    "route": { "enum": ["brief_world", "story", "character", "scene", "style", "reference_evidence", "action", "shot_direction", "storyboard_rhythm", "image_prompt", "production_plan", "review_repair"] },
    "step": {
      "type": "object",
      "additionalProperties": false,
      "required": ["stepId", "route", "status", "purpose", "inputKinds", "outputKinds", "dependsOn", "humanGate"],
      "properties": {
        "stepId": { "$ref": "common.schema.json#/$defs/identifier" },
        "route": { "$ref": "#/$defs/route" },
        "status": { "enum": ["pending", "in_progress", "blocked", "ready", "complete", "skipped"] },
        "purpose": { "type": "string", "minLength": 1, "maxLength": 1200 },
        "inputKinds": { "type": "array", "maxItems": 32, "uniqueItems": true, "items": { "$ref": "common.schema.json#/$defs/identifier" } },
        "outputKinds": { "type": "array", "minItems": 1, "maxItems": 32, "uniqueItems": true, "items": { "$ref": "common.schema.json#/$defs/identifier" } },
        "dependsOn": { "type": "array", "maxItems": 24, "uniqueItems": true, "items": { "$ref": "common.schema.json#/$defs/identifier" } },
        "humanGate": { "enum": ["none", "select", "approve"] },
        "blockReason": { "type": "string", "maxLength": 1200 }
      }
    },
    "deliverable": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "route", "required"],
      "properties": {
        "kind": { "$ref": "common.schema.json#/$defs/identifier" },
        "route": { "$ref": "#/$defs/route" },
        "required": { "type": "boolean" },
        "artifactRef": { "$ref": "common.schema.json#/$defs/contractRef" }
      }
    },
    "currentGate": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "status", "nextAction"],
      "properties": {
        "type": { "enum": ["none", "missing_input", "selection", "approval", "evidence_review", "rights_review"] },
        "status": { "enum": ["open", "satisfied", "blocked"] },
        "nextAction": { "type": "string", "minLength": 1, "maxLength": 1200 }
      }
    },
    "planningBoundary": {
      "type": "object",
      "additionalProperties": false,
      "required": ["singleSkill", "providerNeutral", "generatesMedia", "invokesExternalTool", "mutatesSourceArtifacts"],
      "properties": {
        "singleSkill": { "const": true },
        "providerNeutral": { "const": true },
        "generatesMedia": { "const": false },
        "invokesExternalTool": { "const": false },
        "mutatesSourceArtifacts": { "const": false }
      }
    },
    "validation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["stepsUnique", "dependenciesAcyclic", "routesKnown", "outputsOwned", "gatesExplicit", "noExecutionClaim"],
      "properties": {
        "stepsUnique": { "const": true },
        "dependenciesAcyclic": { "const": true },
        "routesKnown": { "const": true },
        "outputsOwned": { "const": true },
        "gatesExplicit": { "const": true },
        "noExecutionClaim": { "const": true }
      }
    }
  }
}
