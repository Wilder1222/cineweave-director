        "mode": {
          "enum": [
            "general_action",
            "fight_specific"
          ]
        },
        "orderedBlocks": {
          "type": "array",
          "minItems": 4,
          "maxItems": 10,
          "uniqueItems": true,
          "items": {
            "enum": [
              "dramatic_purpose",
              "spatial_geography",
              "weapon_profile",
              "technique",
              "trajectory",
              "exchange",
              "contact_result",
              "continuity",
              "camera_read"
            ]
          }
        },
        "selectedBeatRule": {
          "$ref": "#/$defs/boundedString"
        },
        "mustInclude": {
          "$ref": "common.schema.json#/$defs/stringList"
        },
        "mustAvoid": {
          "$ref": "#/$defs/optionalStrings"
        }
      }
    },
    "handoff": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "shotBreakdownReady",
        "requiredDownstreamContracts",
        "mustPreserve",
        "mayVary",
        "blockers",
        "unresolved"
      ],
      "properties": {
        "shotBreakdownReady": {
          "type": "boolean"
        },
        "requiredDownstreamContracts": {
          "type": "array",
          "minItems": 1,
          "maxItems": 8,
          "uniqueItems": true,
          "items": {
            "enum": [
              "InteractionConstraintSet",
              "PerformanceTimeline",
              "ShotSpec",
              "TemporalSpec",
              "Storyboard",
              "ProductionReview"
            ]
          }
        },
        "mustPreserve": {
          "$ref": "common.schema.json#/$defs/stringList"
        },
        "mayVary": {
          "$ref": "#/$defs/optionalStrings"
        },
        "blockers": {
          "$ref": "#/$defs/optionalStrings"
        },
        "unresolved": {
          "$ref": "#/$defs/optionalStrings"
        }
      }
    },
    "planningBoundary": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "generatesMedia",
        "providerNeutral",
        "constitutesStuntSafetyApproval",
        "qualifiedReviewRequired"
      ],
      "properties": {
        "generatesMedia": {
          "const": false
        },
        "providerNeutral": {
          "const": true
        },
        "constitutesStuntSafetyApproval": {
          "const": false
        },
        "qualifiedReviewRequired": {
          "type": "boolean"
        }
      }
    },
    "validation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "exactBindings",
        "beatsOrdered",
        "participantRefsResolved",
        "sceneZonesResolved",
        "constraintRefsScoped",
        "continuityClosed",
        "coverageLinked",
        "cameraDetailsDeferred",
        "performanceNotRewritten",
        "storyCausalityNotInvented",
        "riskVisibilityExplicit",
        "providerNeutral"
      ],
      "properties": {
        "exactBindings": {
          "const": true
        },
        "beatsOrdered": {
          "const": true
        },
        "participantRefsResolved": {
          "const": true
        },
        "sceneZonesResolved": {
          "const": true
        },
        "constraintRefsScoped": {
          "const": true
        },
        "continuityClosed": {
          "const": true
        },
        "coverageLinked": {
          "const": true
        },
        "cameraDetailsDeferred": {
          "const": true
        },
        "performanceNotRewritten": {
          "const": true
        },
        "storyCausalityNotInvented": {
          "const": true
        },
        "riskVisibilityExplicit": {
          "const": true
        },
        "providerNeutral": {
          "const": true
        }
      }
    }
  }
