        "status": {
          "enum": [
            "flagged",
            "requires_review",
            "not_applicable"
          ]
        }
      }
    },
    "actionPromptHandoff": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "mode",
        "orderedBlocks",
        "selectedBeatRule",
        "mustInclude",
        "mustAvoid"
      ],
