{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cineweave.dev/contracts/reference-binding-set.schema.json",
  "title": "CineWeave Exact Reference Binding Set",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "kind",
    "contractVersion",
    "bindingSetId",
    "version",
    "status",
    "skillReceipt",
    "purpose",
    "targetRefs",
    "bindings",
    "resolutionOrder",
    "conflictPolicy",
    "rightsPolicy",
    "validation"
  ],
  "properties": {
    "kind": {
      "const": "cineweave_codex_reference_binding_set"
    },
    "contractVersion": {
      "const": "2.4.0"
    },
    "bindingSetId": {
      "$ref": "common.schema.json#/$defs/identifier"
    },
    "version": {
      "type": "integer",
      "minimum": 1
    },
    "status": {
      "enum": [
        "draft",
        "active",
        "locked",
        "archived"
      ]
    },
    "skillReceipt": {
      "$ref": "common.schema.json#/$defs/skillReceipt"
    },
    "purpose": {
      "type": "string",
      "minLength": 1,
      "maxLength": 2000
    },
    "targetRefs": {
      "type": "array",
      "minItems": 1,
      "maxItems": 24,
      "items": {
        "$ref": "common.schema.json#/$defs/contractRef"
      }
    },
    "bindings": {
      "type": "array",
      "minItems": 1,
      "maxItems": 32,
      "items": {
        "$ref": "#/$defs/binding"
      }
    },
    "resolutionOrder": {
      "type": "array",
      "minItems": 1,
      "maxItems": 28,
      "uniqueItems": true,
      "items": {
        "$ref": "reference-observation.schema.json#/$defs/role"
      }
    },
    "conflictPolicy": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "identityCannotBeOverridden",
        "geographyCannotBeOverridden",
        "overlappingSelectors",
        "sameRoleConflict"
      ],
      "properties": {
        "identityCannotBeOverridden": {
          "const": true
        },
        "geographyCannotBeOverridden": {
          "const": true
        },
        "overlappingSelectors": {
          "enum": [
            "reject",
            "explicit_priority"
          ]
        },
        "sameRoleConflict": {
          "enum": [
            "reject",
            "explicit_priority"
          ]
        }
      }
    },
    "rightsPolicy": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "allProfilesResolved",
        "unresolvedBehavior",
        "redistributionAllowed",
        "unresolvedObservationIds"
      ],
      "properties": {
        "allProfilesResolved": {
          "type": "boolean"
        },
        "unresolvedBehavior": {
          "enum": [
            "block_production",
            "block_all",
            "warn_exploration"
          ]
        },
        "redistributionAllowed": {
          "type": "boolean"
        },
        "unresolvedObservationIds": {
          "type": "array",
          "maxItems": 32,
          "uniqueItems": true,
          "items": {
            "$ref": "common.schema.json#/$defs/identifier"
          }
        }
      }
    },
    "validation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "exactObservationRefs",
        "uniqueObservationRefs",
        "oneRolePerObservation",
        "selectorConflictsChecked",
        "rightsChecked",
        "noPrivateLocators"
      ],
      "properties": {
        "exactObservationRefs": {
          "const": true
        },
        "uniqueObservationRefs": {
          "const": true
        },
        "oneRolePerObservation": {
          "const": true
        },
        "selectorConflictsChecked": {
          "const": true
        },
        "rightsChecked": {
          "const": true
        },
        "noPrivateLocators": {
          "const": true
        }
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "status": {
            "enum": [
              "active",
              "locked"
            ]
          }
        },
        "required": [
          "status"
        ]
      },
      "then": {
        "properties": {
          "rightsPolicy": {
            "properties": {
              "allProfilesResolved": {
                "const": true
              },
              "unresolvedObservationIds": {
                "maxItems": 0
              },
              "unresolvedBehavior": {
                "enum": [
                  "block_production",
                  "block_all"
                ]
              }
            }
          }
        }
      }
    }
  ],
  "$defs": {
    "binding": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "observationRef",
        "role",
        "priority",
        "required"
      ],
      "properties": {
        "observationRef": {
          "allOf": [
            {
              "$ref": "common.schema.json#/$defs/contractRef"
            },
            {
              "properties": {
                "kind": {
                  "const": "cineweave_codex_reference_observation"
                }
              }
            }
          ]
        },
        "role": {
          "$ref": "reference-observation.schema.json#/$defs/role"
        },
        "priority": {
          "type": "integer",
          "minimum": 1,
          "maximum": 100
        },
        "required": {
          "type": "boolean"
        },
        "notes": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1200
        }
      }
    }
  }
}
