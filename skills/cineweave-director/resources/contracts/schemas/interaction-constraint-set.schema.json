{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cineweave.dev/contracts/interaction-constraint-set.schema.json",
  "title": "CineWeave Shot Interaction Constraint Set",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "kind",
    "contractVersion",
    "worldId",
    "interactionSetId",
    "shotId",
    "skillReceipt",
    "characterBindingRefs",
    "sceneBindingRef",
    "constraints",
    "preserve",
    "allowedDeviations",
    "forbiddenChanges",
    "validation",
    "provenance"
  ],
  "properties": {
    "kind": {
      "const": "cineweave_codex_interaction_constraint_set"
    },
    "contractVersion": {
      "const": "2.0.0"
    },
    "worldId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 160
    },
    "interactionSetId": {
      "$ref": "#/$defs/lowerId"
    },
    "shotId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 160
    },
    "skillReceipt": {
      "$ref": "#/$defs/skillReceipt"
    },
    "characterBindingRefs": {
      "type": "array",
      "minItems": 1,
      "maxItems": 16,
      "items": {
        "$ref": "#/$defs/bindingRef"
      }
    },
    "sceneBindingRef": {
      "$ref": "#/$defs/bindingRef"
    },
    "constraints": {
      "$ref": "#/$defs/interactionConstraints"
    },
    "preserve": {
      "$ref": "#/$defs/stringList"
    },
    "allowedDeviations": {
      "$ref": "#/$defs/stringList"
    },
    "forbiddenChanges": {
      "$ref": "#/$defs/stringList"
    },
    "validation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "bindingRefsResolved",
        "contactsGrounded",
        "occlusionAcyclic",
        "lightingMotivated",
        "propContinuityExplicit"
      ],
      "properties": {
        "bindingRefsResolved": {
          "const": true
        },
        "contactsGrounded": {
          "const": true
        },
        "occlusionAcyclic": {
          "const": true
        },
        "lightingMotivated": {
          "const": true
        },
        "propContinuityExplicit": {
          "const": true
        }
      }
    },
    "provenance": {
      "$ref": "#/$defs/provenance"
    }
  },
  "$defs": {
    "skillReceipt": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "repository",
        "ref",
        "commit",
        "installedBy",
        "usedAt"
      ],
      "properties": {
        "repository": {
          "type": "string",
          "format": "uri",
          "pattern": "^https://(www\\.)?github\\.com/[^/]+/[^/]+(?:\\.git)?/?$"
        },
        "ref": {
          "type": "string",
          "minLength": 1,
          "maxLength": 240
        },
        "commit": {
          "type": "string",
          "pattern": "^[0-9a-fA-F]{7,64}$"
        },
        "contentHash": {
          "type": "string",
          "pattern": "^sha256:[0-9a-fA-F]{64}$"
        },
        "installedBy": {
          "const": "codex-environment"
        },
        "environmentId": {
          "type": "string",
          "maxLength": 240
        },
        "usedAt": {
          "type": "string",
          "format": "date-time"
        }
      }
    },
    "stableId": {
      "type": "string",
      "pattern": "^[a-zA-Z][a-zA-Z0-9._-]{1,159}$"
    },
    "lowerId": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9._-]{2,159}$"
    },
    "observationId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 160,
      "not": {
        "pattern": "(?:https?:|file:|[\\\\/?#])"
      }
    },
    "contentHash": {
      "type": "string",
      "pattern": "^sha256:[0-9a-fA-F]{64}$"
    },
    "stringList": {
      "type": "array",
      "minItems": 1,
      "maxItems": 32,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 1600
      }
    },
    "optionalStringList": {
      "type": "array",
      "maxItems": 32,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 1600
      }
    },
    "primitive": {
      "type": [
        "string",
        "number",
        "boolean",
        "null"
      ]
    },
    "provenance": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "source",
        "createdAt",
        "updatedAt",
        "changeLog"
      ],
      "properties": {
        "source": {
          "enum": [
            "user_authored",
            "codex_authored",
            "adapted",
            "imported",
            "suite_builtin"
          ]
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        },
        "parentId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 160
        },
        "changeLog": {
          "$ref": "#/$defs/stringList"
        }
      }
    },
    "versionedRef": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "id"
      ],
      "properties": {
        "kind": {
          "type": "string",
          "minLength": 1,
          "maxLength": 160
        },
        "id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 160
        },
        "version": {
          "type": "integer",
          "minimum": 1
        },
        "contentHash": {
          "$ref": "#/$defs/contentHash"
        },
        "observationIds": {
          "type": "array",
          "maxItems": 24,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/observationId"
          }
        }
      }
    },
    "contractRef": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "contentHash"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 160
        },
        "version": {
          "type": "integer",
          "minimum": 1
        },
        "contentHash": {
          "$ref": "#/$defs/contentHash"
        }
      }
    },
    "canvas": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "aspectRatio",
        "sizeClass"
      ],
      "properties": {
        "aspectRatio": {
          "type": "string",
          "pattern": "^[1-9][0-9]*:[1-9][0-9]*$"
        },
        "sizeClass": {
          "enum": [
            "square",
            "portrait",
            "landscape",
            "wide",
            "tall",
            "custom",
            "unspecified"
          ]
        },
        "pixelDimensions": {
          "type": "string",
          "pattern": "^[1-9][0-9]*x[1-9][0-9]*$"
        },
        "background": {
          "type": "string",
          "minLength": 1,
          "maxLength": 500
        }
      }
    },
    "bindingRef": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "bindingId"
      ],
      "properties": {
        "bindingId": {
          "$ref": "#/$defs/stableId"
        },
        "contentHash": {
          "$ref": "#/$defs/contentHash"
        }
      }
    },
    "contact": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "contactId",
        "subjectBindingId",
        "subjectPart",
        "targetType",
        "targetRef",
        "relation",
        "required"
      ],
      "properties": {
        "contactId": {
          "$ref": "#/$defs/stableId"
        },
        "subjectBindingId": {
          "$ref": "#/$defs/stableId"
        },
        "subjectPart": {
          "type": "string",
          "minLength": 1,
          "maxLength": 160
        },
        "targetType": {
          "enum": [
            "scene_anchor",
            "prop",
            "character",
            "ground",
            "water",
            "surface"
          ]
        },
        "targetRef": {
          "type": "string",
          "minLength": 1,
          "maxLength": 240
        },
        "relation": {
          "enum": [
            "standing_on",
            "sitting_on",
            "leaning_on",
            "resting_on",
            "gripping",
            "touching",
            "pushing",
            "pulling",
            "passing_through",
            "shielding",
            "carrying"
          ]
        },
        "pressure": {
          "enum": [
            "none",
            "light",
            "moderate",
            "strong"
          ]
        },
        "duration": {
          "enum": [
            "instant",
            "beat",
            "shot",
            "sequence"
          ]
        },
        "required": {
          "type": "boolean"
        }
      }
    },
    "support": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "subjectBindingId",
        "supportTargetRef",
        "supportedParts",
        "weightDistribution",
        "centerOfGravity"
      ],
      "properties": {
        "subjectBindingId": {
          "$ref": "#/$defs/stableId"
        },
        "supportTargetRef": {
          "type": "string",
          "minLength": 1,
          "maxLength": 240
        },
        "supportedParts": {
          "$ref": "#/$defs/stringList"
        },
        "weightDistribution": {
          "type": "string",
          "minLength": 1,
          "maxLength": 800
        },
        "centerOfGravity": {
          "type": "string",
          "minLength": 1,
          "maxLength": 800
        }
      }
    },
    "occlusion": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "frontRef",
        "backRef",
        "region",
        "ordering"
      ],
      "properties": {
        "frontRef": {
          "type": "string",
          "minLength": 1,
          "maxLength": 240
        },
        "backRef": {
          "type": "string",
          "minLength": 1,
          "maxLength": 240
        },
        "region": {
          "type": "string",
          "minLength": 1,
          "maxLength": 500
        },
        "ordering": {
          "const": "front_before_back"
        }
      }
    },
    "lightingResponse": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "subjectBindingId",
        "keySourceRef",
        "castShadowOn",
        "contactShadow",
        "exposureRelation"
      ],
      "properties": {
        "subjectBindingId": {
          "$ref": "#/$defs/stableId"
        },
        "keySourceRef": {
          "type": "string",
          "minLength": 1,
          "maxLength": 240
        },
        "castShadowOn": {
          "type": "string",
          "minLength": 1,
          "maxLength": 240
        },
        "contactShadow": {
          "type": "string",
          "minLength": 1,
          "maxLength": 800
        },
        "bounceSource": {
          "type": "string",
          "minLength": 1,
          "maxLength": 240
        },
        "exposureRelation": {
          "type": "string",
          "minLength": 1,
          "maxLength": 800
        }
      }
    },
    "environmentResponse": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "subjectBindingId",
        "driver",
        "direction",
        "intensity",
        "hairEffect",
        "garmentEffect",
        "skinEffect"
      ],
      "properties": {
        "subjectBindingId": {
          "$ref": "#/$defs/stableId"
        },
        "driver": {
          "enum": [
            "wind",
            "rain",
            "snow",
            "dust",
            "heat",
            "water",
            "smoke",
            "none"
          ]
        },
        "direction": {
          "type": "string",
          "minLength": 1,
          "maxLength": 500
        },
        "intensity": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "hairEffect": {
          "type": "string",
          "minLength": 1,
          "maxLength": 800
        },
        "garmentEffect": {
          "type": "string",
          "minLength": 1,
          "maxLength": 800
        },
        "skinEffect": {
          "type": "string",
          "minLength": 1,
          "maxLength": 800
        }
      }
    },
    "propInteraction": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "interactionId",
        "subjectBindingId",
        "propRef",
        "handOrBodyPart",
        "action",
        "continuityState"
      ],
      "properties": {
        "interactionId": {
          "$ref": "#/$defs/stableId"
        },
        "subjectBindingId": {
          "$ref": "#/$defs/stableId"
        },
        "propRef": {
          "type": "string",
          "minLength": 1,
          "maxLength": 240
        },
        "handOrBodyPart": {
          "type": "string",
          "minLength": 1,
          "maxLength": 160
        },
        "grip": {
          "type": "string",
          "minLength": 1,
          "maxLength": 500
        },
        "action": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1000
        },
        "continuityState": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1000
        }
      }
    },
    "interactionConstraints": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "contacts",
        "supports",
        "occlusions",
        "lightingResponse",
        "environmentResponse",
        "propInteractions"
      ],
      "properties": {
        "contacts": {
          "type": "array",
          "maxItems": 32,
          "items": {
            "$ref": "#/$defs/contact"
          }
        },
        "supports": {
          "type": "array",
          "maxItems": 16,
          "items": {
            "$ref": "#/$defs/support"
          }
        },
        "occlusions": {
          "type": "array",
          "maxItems": 32,
          "items": {
            "$ref": "#/$defs/occlusion"
          }
        },
        "lightingResponse": {
          "type": "array",
          "maxItems": 16,
          "items": {
            "$ref": "#/$defs/lightingResponse"
          }
        },
        "environmentResponse": {
          "type": "array",
          "maxItems": 16,
          "items": {
            "$ref": "#/$defs/environmentResponse"
          }
        },
        "propInteractions": {
          "type": "array",
          "maxItems": 32,
          "items": {
            "$ref": "#/$defs/propInteraction"
          }
        }
      }
    }
  }
}
