{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cineweave.dev/contracts/storyboard-output.schema.json",
  "title": "CineWeave Codex Storyboard Sequence",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "kind",
    "contractVersion",
    "storyboardId",
    "version",
    "skillReceipt",
    "sequenceTitle",
    "scenePurpose",
    "shots",
    "coverageLedger",
    "planningBoundary",
    "validation",
    "provenance"
  ],
  "properties": {
    "contractVersion": {
      "const": "2.5.0"
    },
    "kind": {
      "const": "cineweave_codex_storyboard_sequence"
    },
    "storyboardId": {
      "$ref": "common.schema.json#/$defs/identifier"
    },
    "version": {
      "type": "integer",
      "minimum": 1
    },
    "worldId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 160
    },
    "skillReceipt": {
      "$ref": "#/$defs/skillReceipt"
    },
    "sequenceId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 160,
      "deprecated": true,
      "description": "Legacy sequence identifier. New artifacts use storyboardId."
    },
    "sequenceTitle": {
      "type": "string",
      "minLength": 1,
      "maxLength": 500
    },
    "scenePurpose": {
      "type": "string",
      "minLength": 1,
      "maxLength": 2000
    },
    "actionSequenceRef": {
      "$ref": "#/$defs/actionSequenceRef"
    },
    "actionBeatIds": {
      "type": "array",
      "minItems": 1,
      "maxItems": 32,
      "uniqueItems": true,
      "items": {
        "$ref": "common.schema.json#/$defs/identifier"
      }
    },
    "shots": {
      "type": "array",
      "minItems": 1,
      "maxItems": 24,
      "items": {
        "$ref": "#/$defs/shot"
      }
    },
    "coverageLedger": {
      "type": "array",
      "minItems": 1,
      "maxItems": 64,
      "items": {
        "$ref": "#/$defs/coverageLedgerEntry"
      }
    },
    "productionBindings": {
      "$ref": "#/$defs/storyboardProductionBindings"
    },
    "planningBoundary": {
      "$ref": "#/$defs/planningBoundary"
    },
    "validation": {
      "$ref": "#/$defs/validation"
    },
    "provenance": {
      "$ref": "common.schema.json#/$defs/provenance"
    }
  },
  "$defs": {
    "skillReceipt": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "repository",
        "ref",
        "commit",
        "installedBy",
        "usedAt"
      ],
      "properties": {
        "repository": {
          "type": "string",
          "format": "uri",
          "pattern": "^https://(www\\.)?github\\.com/[^/]+/[^/]+(?:\\.git)?/?$"
        },
        "ref": {
          "type": "string",
          "minLength": 1,
          "maxLength": 240
        },
        "commit": {
          "type": "string",
          "pattern": "^[0-9a-fA-F]{7,64}$"
        },
        "contentHash": {
          "type": "string",
          "pattern": "^sha256:[0-9a-fA-F]{64}$"
        },
        "installedBy": {
          "const": "codex-environment"
        },
        "environmentId": {
          "type": "string",
          "maxLength": 240
        },
        "usedAt": {
          "type": "string",
          "format": "date-time"
        }
      }
    },
    "actionSequenceRef": {
      "allOf": [
        {
          "$ref": "common.schema.json#/$defs/contractRef"
        },
        {
          "properties": {
            "kind": {
              "const": "cineweave_codex_action_sequence_spec"
            }
          }
        }
      ]
    },
    "shotSpecRef": {
      "allOf": [
        {
          "$ref": "common.schema.json#/$defs/contractRef"
        },
        {
          "properties": {
            "kind": {
              "const": "cineweave_codex_shot_spec"
            }
          }
        }
      ]
    },
    "boardAssemblyPlanRef": {
      "allOf": [
        {
          "$ref": "common.schema.json#/$defs/contractRef"
        },
        {
          "properties": {
            "kind": {
              "const": "cineweave_codex_board_assembly_plan"
            }
          }
        }
      ]
    },
    "promptRecordRef": {
      "allOf": [
        {
          "$ref": "common.schema.json#/$defs/contractRef"
        },
        {
          "properties": {
            "kind": {
              "const": "cineweave_codex_prompt_record"
            }
          }
        }
      ]
    },
    "imagePromptRef": {
      "allOf": [
        {
          "$ref": "common.schema.json#/$defs/contractRef"
        },
        {
          "properties": {
            "kind": {
              "const": "cineweave_codex_image_prompt"
            }
          }
        }
      ]
    },
    "evidenceBundleRef": {
      "allOf": [
        {
          "$ref": "common.schema.json#/$defs/contractRef"
        },
        {
          "properties": {
            "kind": {
              "const": "cineweave_codex_evidence_bundle"
            }
          }
        }
      ]
    },
    "coverageLedgerEntry": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "coverageId",
        "beatIds",
        "shotIds",
        "coverageTypes",
        "purpose",
        "continuityDependencies"
      ],
      "properties": {
        "coverageId": {
          "$ref": "common.schema.json#/$defs/identifier"
        },
        "beatIds": {
          "type": "array",
          "minItems": 1,
          "maxItems": 32,
          "uniqueItems": true,
          "items": {
            "$ref": "common.schema.json#/$defs/identifier"
          }
        },
        "shotIds": {
          "type": "array",
          "minItems": 1,
          "maxItems": 24,
          "uniqueItems": true,
          "items": {
            "$ref": "common.schema.json#/$defs/identifier"
          }
        },
        "coverageTypes": {
          "type": "array",
          "minItems": 1,
          "maxItems": 7,
          "uniqueItems": true,
          "items": {
            "enum": [
              "establish",
              "orientation",
              "preparation",
              "action",
              "reaction",
              "consequence",
              "transition"
            ]
          }
        },
        "purpose": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1600
        },
        "continuityDependencies": {
          "$ref": "common.schema.json#/$defs/stringList"
        },
        "editorialDisposition": {
          "enum": [
            "visible",
            "offscreen_approved"
          ]
        }
      }
    },
    "panelBinding": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "shotId",
        "panelId",
        "recipeRunId",
        "taskId",
        "regionId",
        "tileId",
        "status"
      ],
      "properties": {
        "shotId": {
          "$ref": "common.schema.json#/$defs/identifier"
        },
        "panelId": {
          "$ref": "common.schema.json#/$defs/identifier"
        },
        "recipeRunId": {
          "$ref": "common.schema.json#/$defs/identifier"
        },
        "taskId": {
          "$ref": "common.schema.json#/$defs/identifier"
        },
        "regionId": {
          "$ref": "common.schema.json#/$defs/identifier"
        },
        "tileId": {
          "$ref": "common.schema.json#/$defs/identifier"
        },
        "status": {
          "enum": [
            "planned",
            "rendered",
            "accepted",
            "failed"
          ]
        },
        "promptRecordRef": {
          "$ref": "#/$defs/promptRecordRef"
        },
        "imagePromptRef": {
          "$ref": "#/$defs/imagePromptRef"
        },
        "evidenceBundleRef": {
          "$ref": "#/$defs/evidenceBundleRef"
        }
      }
    },
    "storyboardProductionBindings": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "boardAssemblyPlanRef",
        "panels"
      ],
      "properties": {
        "boardAssemblyPlanRef": {
          "$ref": "#/$defs/boardAssemblyPlanRef"
        },
        "panels": {
          "type": "array",
          "minItems": 1,
          "maxItems": 24,
          "items": {
            "$ref": "#/$defs/panelBinding"
          }
        }
      }
    },
    "planningBoundary": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "providerNeutral",
        "generatesMedia",
        "humanApprovalRequired"
      ],
      "properties": {
        "providerNeutral": {
          "const": true
        },
        "generatesMedia": {
          "const": false
        },
        "humanApprovalRequired": {
          "const": true
        },
        "notes": {
          "type": "string",
          "maxLength": 1200
        }
      }
    },
    "validation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "ordersContiguous",
        "shotSpecsExact",
        "coverageLedgerClosed",
        "actionCoverageComplete",
        "productionBindingsExact",
        "providerNeutral"
      ],
      "properties": {
        "ordersContiguous": {
          "const": true
        },
        "shotSpecsExact": {
          "const": true
        },
        "coverageLedgerClosed": {
          "const": true
        },
        "actionCoverageComplete": {
          "type": "boolean"
        },
        "productionBindingsExact": {
          "type": "boolean"
        },
        "providerNeutral": {
          "const": true
        }
      }
    },
    "lens": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "focalLengthMm",
        "character"
      ],
      "properties": {
        "focalLengthMm": {
          "type": "number",
          "minimum": 12,
          "maximum": 400
        },
        "character": {
          "type": "string",
          "minLength": 1,
          "maxLength": 500
        }
      }
    },
    "movement": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "type",
        "direction",
        "speedCurve",
        "startState",
        "peakState",
        "endState"
      ],
      "properties": {
        "type": {
          "enum": [
            "static",
            "dolly",
            "truck",
            "pan",
            "tilt",
            "arc",
            "crane",
            "handheld",
            "gimbal",
            "rack-focus"
          ]
        },
        "direction": {
          "type": "string",
          "minLength": 1,
          "maxLength": 300
        },
        "speedCurve": {
          "type": "string",
          "minLength": 1,
          "maxLength": 500
        },
        "startState": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1000
        },
        "peakState": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1000
        },
        "endState": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1000
        }
      }
    },
    "continuity": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "screenDirection",
        "eyeline",
        "axis",
        "preserve"
      ],
      "properties": {
        "screenDirection": {
          "type": "string",
          "minLength": 1,
          "maxLength": 500
        },
        "eyeline": {
          "type": "string",
          "minLength": 1,
          "maxLength": 500
        },
        "axis": {
          "type": "string",
          "minLength": 1,
          "maxLength": 500
        },
        "preserve": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 800
          }
        },
        "characterState": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1000
        },
        "sceneState": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1000
        },
        "geographyAnchors": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 800
          },
          "maxItems": 24,
          "uniqueItems": true
        },
        "materialState": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1000
        },
        "emotionalState": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1000
        },
        "interactionState": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1000
        },
        "propState": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1000
        }
      }
    },
    "shot": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "shotId",
        "shotSpecRef",
        "order",
        "durationSeconds",
        "purpose",
        "shotScale",
        "cameraAngle",
        "lens",
        "cameraHeight",
        "movement",
        "composition",
        "actionBeat",
        "performance",
        "lighting",
        "soundEdit",
        "transition",
        "continuity",
        "coverageLedgerIds",
        "framePrompt"
      ],
      "properties": {
        "shotId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 160
        },
        "shotSpecRef": {
          "$ref": "#/$defs/shotSpecRef"
        },
        "actionBeatIds": {
          "type": "array",
          "minItems": 1,
          "maxItems": 16,
          "uniqueItems": true,
          "items": {
            "$ref": "common.schema.json#/$defs/identifier"
          }
        },
        "order": {
          "type": "integer",
          "minimum": 1,
          "maximum": 99
        },
        "durationSeconds": {
          "type": "number",
          "minimum": 0.5,
          "maximum": 120
        },
        "purpose": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1500
        },
        "shotScale": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        },
        "cameraAngle": {
          "type": "string",
          "minLength": 1,
          "maxLength": 300
        },
        "lens": {
          "$ref": "#/$defs/lens"
        },
        "cameraHeight": {
          "type": "string",
          "minLength": 1,
          "maxLength": 300
        },
        "movement": {
          "$ref": "#/$defs/movement"
        },
        "composition": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2000
        },
        "actionBeat": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1500
        },
        "performance": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1500
        },
        "characterBindings": {
          "type": "array",
          "maxItems": 12,
          "items": {
            "$ref": "character-binding.schema.json"
          }
        },
        "lighting": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1500
        },
        "soundEdit": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1500
        },
        "transition": {
          "enum": [
            "cut",
            "dissolve",
            "match-cut",
            "smash-cut",
            "fade",
            "hold",
            "j-cut",
            "l-cut"
          ]
        },
        "continuity": {
          "$ref": "#/$defs/continuity"
        },
        "coverageLedgerIds": {
          "type": "array",
          "minItems": 1,
          "maxItems": 16,
          "uniqueItems": true,
          "items": {
            "$ref": "common.schema.json#/$defs/identifier"
          }
        },
        "imagePromptId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 160
        },
        "framePrompt": {
          "type": "string",
          "minLength": 1,
          "maxLength": 12000
        },
        "sceneBinding": {
          "$ref": "scene-binding.schema.json"
        },
        "interactionConstraints": {
          "$ref": "interaction-constraint-set.schema.json#/$defs/interactionConstraints"
        },
        "productionContext": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "assetRecipeRef": {
              "type": "string",
              "minLength": 1,
              "maxLength": 240
            },
            "controlSetRef": {
              "type": "string",
              "minLength": 1,
              "maxLength": 240
            },
            "evidenceBundleRef": {
              "type": "string",
              "minLength": 1,
              "maxLength": 240
            }
          }
        }
      }
    }
  },
  "dependentRequired": {
    "actionSequenceRef": [
      "actionBeatIds"
    ],
    "actionBeatIds": [
      "actionSequenceRef"
    ]
  }
}
