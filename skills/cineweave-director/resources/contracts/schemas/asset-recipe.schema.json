{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cineweave.dev/contracts/asset-recipe.schema.json",
  "title": "CineWeave Production Asset Recipe",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "kind",
    "contractVersion",
    "worldId",
    "recipeId",
    "title",
    "version",
    "status",
    "ownerRoute",
    "category",
    "outputType",
    "purpose",
    "recipeMode",
    "parameters",
    "inputSlots",
    "layout",
    "sharedInvariants",
    "tasks",
    "assembly",
    "retryPolicy",
    "evaluation",
    "planningBoundary",
    "skillReceipt",
    "validation",
    "provenance"
  ],
  "properties": {
    "kind": {
      "const": "cineweave_codex_asset_recipe"
    },
    "contractVersion": {
      "const": "2.0.0"
    },
    "worldId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 160
    },
    "recipeId": {
      "$ref": "#/$defs/lowerId"
    },
    "title": {
      "type": "string",
      "minLength": 1,
      "maxLength": 240
    },
    "version": {
      "type": "integer",
      "minimum": 1
    },
    "status": {
      "enum": [
        "draft",
        "active",
        "archived",
        "retired"
      ]
    },
    "ownerRoute": {
      "enum": [
        "character",
        "scene",
        "style",
        "shot_direction",
        "production_plan"
      ]
    },
    "category": {
      "enum": [
        "character",
        "scene",
        "storyboard",
        "promotional",
        "technical",
        "mixed"
      ]
    },
    "outputType": {
      "enum": [
        "identity_reference",
        "morphology_turnaround",
        "human_realism_fixture",
        "representation_fixture",
        "style_exploration",
        "cross_representation_sheet",
        "expression_sheet",
        "turnaround",
        "action_sheet",
        "appearance_sheet",
        "establishing_frame",
        "scene_state_sheet",
        "storyboard_board",
        "keyframe_board",
        "poster",
        "custom"
      ]
    },
    "purpose": {
      "type": "string",
      "minLength": 1,
      "maxLength": 2000
    },
    "recipeMode": {
      "enum": [
        "template",
        "instance"
      ]
    },
    "parameters": {
      "type": "array",
      "maxItems": 32,
      "items": {
        "$ref": "#/$defs/parameter"
      }
    },
    "inputSlots": {
      "type": "array",
      "minItems": 1,
      "maxItems": 24,
      "items": {
        "$ref": "#/$defs/inputSlot"
      }
    },
    "bindings": {
      "type": "array",
      "maxItems": 24,
      "items": {
        "$ref": "#/$defs/binding"
      }
    },
    "layout": {
      "$ref": "#/$defs/layout"
    },
    "sharedInvariants": {
      "$ref": "#/$defs/stringList"
    },
    "tasks": {
      "type": "array",
      "minItems": 1,
      "maxItems": 64,
      "items": {
        "$ref": "#/$defs/task"
      }
    },
    "assembly": {
      "$ref": "#/$defs/assembly"
    },
    "retryPolicy": {
      "$ref": "#/$defs/retryPolicy"
    },
    "evaluation": {
      "$ref": "#/$defs/evaluation"
    },
    "planningBoundary": {
      "$ref": "#/$defs/planningBoundary"
    },
    "skillReceipt": {
      "$ref": "#/$defs/skillReceipt"
    },
    "validation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "parametersBound",
        "onePrimaryDeltaPerTask",
        "deterministicAssembly",
        "providerNeutral",
        "rightsProfilesRequired"
      ],
      "properties": {
        "parametersBound": {
          "type": "boolean"
        },
        "onePrimaryDeltaPerTask": {
          "const": true
        },
        "deterministicAssembly": {
          "const": true
        },
        "providerNeutral": {
          "const": true
        },
        "rightsProfilesRequired": {
          "const": true
        }
      }
    },
    "provenance": {
      "$ref": "#/$defs/provenance"
    }
  },
  "$defs": {
    "skillReceipt": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "repository",
        "ref",
        "commit",
        "installedBy",
        "usedAt"
      ],
      "properties": {
        "repository": {
          "type": "string",
          "format": "uri",
          "pattern": "^https://(www\\.)?github\\.com/[^/]+/[^/]+(?:\\.git)?/?$"
        },
        "ref": {
          "type": "string",
          "minLength": 1,
          "maxLength": 240
        },
        "commit": {
          "type": "string",
          "pattern": "^[0-9a-fA-F]{7,64}$"
        },
        "contentHash": {
          "type": "string",
          "pattern": "^sha256:[0-9a-fA-F]{64}$"
        },
        "installedBy": {
          "const": "codex-environment"
        },
        "environmentId": {
          "type": "string",
          "maxLength": 240
        },
        "usedAt": {
          "type": "string",
          "format": "date-time"
        }
      }
    },
    "stableId": {
      "type": "string",
      "pattern": "^[a-zA-Z][a-zA-Z0-9._-]{1,159}$"
    },
    "lowerId": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9._-]{2,159}$"
    },
    "observationId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 160,
      "not": {
        "pattern": "(?:https?:|file:|[\\\\/?#])"
      }
    },
    "contentHash": {
      "type": "string",
      "pattern": "^sha256:[0-9a-fA-F]{64}$"
    },
    "stringList": {
      "type": "array",
      "minItems": 1,
      "maxItems": 32,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 1600
      }
    },
    "optionalStringList": {
      "type": "array",
      "maxItems": 32,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 1600
      }
    },
    "primitive": {
      "type": [
        "string",
        "number",
        "boolean",
        "null"
      ]
    },
    "provenance": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "source",
        "createdAt",
        "updatedAt",
        "changeLog"
      ],
      "properties": {
        "source": {
          "enum": [
            "user_authored",
            "codex_authored",
            "adapted",
            "imported",
            "suite_builtin"
          ]
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        },
        "parentId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 160
        },
        "changeLog": {
          "$ref": "#/$defs/stringList"
        }
      }
    },
    "versionedRef": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "id"
      ],
      "properties": {
        "kind": {
          "type": "string",
          "minLength": 1,
          "maxLength": 160
        },
        "id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 160
        },
        "version": {
          "type": "integer",
          "minimum": 1
        },
        "contentHash": {
          "$ref": "#/$defs/contentHash"
        },
        "observationIds": {
          "type": "array",
          "maxItems": 24,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/observationId"
          }
        }
      }
    },
    "contractRef": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "contentHash"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 160
        },
        "version": {
          "type": "integer",
          "minimum": 1
        },
        "contentHash": {
          "$ref": "#/$defs/contentHash"
        }
      }
    },
    "canvas": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "aspectRatio",
        "sizeClass"
      ],
      "properties": {
        "aspectRatio": {
          "type": "string",
          "pattern": "^[1-9][0-9]*:[1-9][0-9]*$"
        },
        "sizeClass": {
          "enum": [
            "square",
            "portrait",
            "landscape",
            "wide",
            "tall",
            "custom",
            "unspecified"
          ]
        },
        "pixelDimensions": {
          "type": "string",
          "pattern": "^[1-9][0-9]*x[1-9][0-9]*$"
        },
        "background": {
          "type": "string",
          "minLength": 1,
          "maxLength": 500
        }
      }
    },
    "parameter": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "type",
        "description",
        "required"
      ],
      "properties": {
        "name": {
          "type": "string",
          "pattern": "^[a-zA-Z][a-zA-Z0-9_]{0,63}$"
        },
        "type": {
          "enum": [
            "string",
            "number",
            "boolean",
            "enum",
            "reference"
          ]
        },
        "description": {
          "type": "string",
          "minLength": 1,
          "maxLength": 800
        },
        "required": {
          "type": "boolean"
        },
        "default": {
          "$ref": "#/$defs/primitive"
        },
        "values": {
          "type": "array",
          "minItems": 1,
          "maxItems": 32,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 400
          }
        }
      }
    },
    "inputSlot": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "slotName",
        "role",
        "acceptedKinds",
        "required",
        "cardinality",
        "description"
      ],
      "properties": {
        "slotName": {
          "type": "string",
          "pattern": "^[a-zA-Z][a-zA-Z0-9_]{0,63}$"
        },
        "role": {
          "enum": [
            "identity",
            "morphology",
            "representation",
            "appearance",
            "performance",
            "scene",
            "scene_state",
            "shot",
            "composition",
            "lighting",
            "material",
            "style",
            "evidence",
            "control",
            "rights",
            "generic"
          ]
        },
        "acceptedKinds": {
          "type": "array",
          "minItems": 1,
          "maxItems": 12,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 160
          }
        },
        "required": {
          "type": "boolean"
        },
        "cardinality": {
          "enum": [
            "one",
            "zero_or_one",
            "one_or_more",
            "zero_or_more"
          ]
        },
        "description": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1000
        }
      }
    },
    "binding": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "slotName",
        "ref"
      ],
      "properties": {
        "slotName": {
          "type": "string",
          "pattern": "^[a-zA-Z][a-zA-Z0-9_]{0,63}$"
        },
        "ref": {
          "$ref": "#/$defs/versionedRef"
        }
      }
    },
    "delta": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "fieldPath",
        "operation",
        "value"
      ],
      "properties": {
        "fieldPath": {
          "type": "string",
          "minLength": 1,
          "maxLength": 320
        },
        "operation": {
          "enum": [
            "set",
            "replace",
            "select",
            "scale",
            "increment"
          ]
        },
        "value": {
          "$ref": "#/$defs/primitive"
        },
        "rationale": {
          "type": "string",
          "minLength": 1,
          "maxLength": 800
        }
      }
    },
    "task": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "taskId",
        "label",
        "outputSlot",
        "delta",
        "controlChannelIds",
        "evaluationCriteria"
      ],
      "properties": {
        "taskId": {
          "$ref": "#/$defs/stableId"
        },
        "label": {
          "type": "string",
          "minLength": 1,
          "maxLength": 240
        },
        "outputSlot": {
          "type": "string",
          "minLength": 1,
          "maxLength": 120
        },
        "delta": {
          "type": "array",
          "minItems": 1,
          "maxItems": 8,
          "items": {
            "$ref": "#/$defs/delta"
          }
        },
        "parameterOverrides": {
          "type": "object",
          "additionalProperties": {
            "$ref": "#/$defs/primitive"
          }
        },
        "controlChannelIds": {
          "type": "array",
          "minItems": 1,
          "maxItems": 32,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/stableId"
          }
        },
        "evaluationCriteria": {
          "$ref": "#/$defs/stringList"
        },
        "dependsOn": {
          "type": "array",
          "maxItems": 16,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/stableId"
          }
        },
        "promptIntent": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1600
        }
      }
    },
    "layout": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "type",
        "canvas",
        "cameraConsistency",
        "backgroundPolicy",
        "lightingPolicy"
      ],
      "properties": {
        "type": {
          "enum": [
            "single",
            "grid",
            "strip",
            "sequence",
            "turnaround",
            "contact_sheet",
            "pitch_board"
          ]
        },
        "rows": {
          "type": "integer",
          "minimum": 1,
          "maximum": 12
        },
        "cols": {
          "type": "integer",
          "minimum": 1,
          "maximum": 12
        },
        "canvas": {
          "$ref": "#/$defs/canvas"
        },
        "tileAspectRatio": {
          "type": "string",
          "pattern": "^[1-9][0-9]*:[1-9][0-9]*$"
        },
        "margin": {
          "type": "number",
          "minimum": 0,
          "maximum": 0.25
        },
        "gutter": {
          "type": "number",
          "minimum": 0,
          "maximum": 0.25
        },
        "labelPolicy": {
          "enum": [
            "none",
            "outside_tile",
            "inside_tile",
            "metadata_only"
          ]
        },
        "cameraConsistency": {
          "type": "boolean"
        },
        "backgroundPolicy": {
          "enum": [
            "locked",
            "controlled",
            "variable",
            "not_applicable"
          ]
        },
        "lightingPolicy": {
          "enum": [
            "locked",
            "controlled",
            "variable",
            "not_applicable"
          ]
        }
      }
    },
    "assembly": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "mode",
        "ordering",
        "preserveTaskResolution",
        "cropPolicy",
        "outputFormat"
      ],
      "properties": {
        "mode": {
          "enum": [
            "single_output",
            "deterministic_grid",
            "deterministic_strip",
            "ordered_sequence",
            "no_assembly"
          ]
        },
        "ordering": {
          "type": "array",
          "minItems": 1,
          "maxItems": 64,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/stableId"
          }
        },
        "preserveTaskResolution": {
          "type": "boolean"
        },
        "cropPolicy": {
          "enum": [
            "none",
            "center_safe",
            "face_safe",
            "subject_safe",
            "manual"
          ]
        },
        "labelMode": {
          "enum": [
            "none",
            "deterministic_text",
            "metadata_only"
          ]
        },
        "outputFormat": {
          "enum": [
            "png",
            "jpeg",
            "webp",
            "json_manifest",
            "otio",
            "mixed"
          ]
        }
      }
    },
    "retryPolicy": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "strategy",
        "maxRetries",
        "preserveSuccessfulTasks",
        "stopOnHardFailure"
      ],
      "properties": {
        "strategy": {
          "enum": [
            "failed_tasks_only",
            "full_recipe",
            "manual"
          ]
        },
        "maxRetries": {
          "type": "integer",
          "minimum": 0,
          "maximum": 8
        },
        "preserveSuccessfulTasks": {
          "type": "boolean"
        },
        "stopOnHardFailure": {
          "type": "boolean"
        }
      }
    },
    "evaluation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "criteria",
        "acceptanceMode"
      ],
      "properties": {
        "profileRef": {
          "$ref": "#/$defs/contractRef"
        },
        "criteria": {
          "$ref": "#/$defs/stringList"
        },
        "acceptanceMode": {
          "enum": [
            "all_tasks_pass",
            "threshold",
            "human_lock"
          ]
        },
        "passThreshold": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        }
      }
    },
    "planningBoundary": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "providerNeutral",
        "generatesMedia",
        "humanApprovalRequired"
      ],
      "properties": {
        "providerNeutral": {
          "const": true
        },
        "generatesMedia": {
          "const": false
        },
        "humanApprovalRequired": {
          "const": true
        },
        "notes": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1200
        }
      }
    }
  }
}
