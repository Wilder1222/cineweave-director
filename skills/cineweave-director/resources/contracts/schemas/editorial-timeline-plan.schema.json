{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cineweave.dev/contracts/editorial-timeline-plan.schema.json",
  "title": "CineWeave Production Editorial Timeline Plan",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "kind",
    "contractVersion",
    "editorialTimelinePlanId",
    "version",
    "storyboardRef",
    "skillReceipt",
    "timelineName",
    "frameRate",
    "timelineRange",
    "conformStatus",
    "tracks",
    "transitions",
    "otioExchange",
    "planningBoundary",
    "validation",
    "provenance"
  ],
  "properties": {
    "kind": {
      "const": "cineweave_codex_editorial_timeline_plan"
    },
    "contractVersion": {
      "const": "2.5.0"
    },
    "editorialTimelinePlanId": {
      "$ref": "common.schema.json#/$defs/identifier"
    },
    "version": {
      "type": "integer",
      "minimum": 1
    },
    "worldId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 160
    },
    "storyboardRef": {
      "$ref": "#/$defs/storyboardRef"
    },
    "skillReceipt": {
      "$ref": "common.schema.json#/$defs/skillReceipt"
    },
    "timelineName": {
      "type": "string",
      "minLength": 1,
      "maxLength": 500
    },
    "frameRate": {
      "$ref": "#/$defs/frameRate"
    },
    "timelineRange": {
      "$ref": "#/$defs/frameRange"
    },
    "conformStatus": {
      "enum": [
        "planned",
        "partial",
        "conformed"
      ]
    },
    "tracks": {
      "type": "array",
      "minItems": 1,
      "maxItems": 32,
      "items": {
        "$ref": "#/$defs/track"
      }
    },
    "transitions": {
      "type": "array",
      "maxItems": 256,
      "items": {
        "$ref": "#/$defs/transition"
      }
    },
    "markers": {
      "type": "array",
      "maxItems": 256,
      "items": {
        "$ref": "#/$defs/marker"
      }
    },
    "otioExchange": {
      "$ref": "#/$defs/otioExchange"
    },
    "planningBoundary": {
      "$ref": "#/$defs/planningBoundary"
    },
    "validation": {
      "$ref": "#/$defs/validation"
    },
    "provenance": {
      "$ref": "common.schema.json#/$defs/provenance"
    }
  },
  "$defs": {
    "storyboardRef": {
      "allOf": [
        {
          "$ref": "common.schema.json#/$defs/contractRef"
        },
        {
          "properties": {
            "kind": {
              "const": "cineweave_codex_storyboard_sequence"
            }
          }
        }
      ]
    },
    "shotSpecRef": {
      "allOf": [
        {
          "$ref": "common.schema.json#/$defs/contractRef"
        },
        {
          "properties": {
            "kind": {
              "const": "cineweave_codex_shot_spec"
            }
          }
        }
      ]
    },
    "temporalSpecRef": {
      "allOf": [
        {
          "$ref": "common.schema.json#/$defs/contractRef"
        },
        {
          "properties": {
            "kind": {
              "const": "cineweave_codex_temporal_spec"
            }
          }
        }
      ]
    },
    "frameRate": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "numerator",
        "denominator",
        "dropFrame"
      ],
      "properties": {
        "numerator": {
          "type": "integer",
          "minimum": 1,
          "maximum": 480000
        },
        "denominator": {
          "type": "integer",
          "minimum": 1,
          "maximum": 1001
        },
        "dropFrame": {
          "type": "boolean"
        }
      }
    },
    "frameRange": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "startFrame",
        "durationFrames"
      ],
      "properties": {
        "startFrame": {
          "type": "integer",
          "minimum": 0,
          "maximum": 100000000
        },
        "durationFrames": {
          "type": "integer",
          "minimum": 1,
          "maximum": 100000000
        }
      }
    },
    "track": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "trackId",
        "trackType",
        "order",
        "segments"
      ],
      "properties": {
        "trackId": {
          "$ref": "common.schema.json#/$defs/identifier"
        },
        "trackType": {
          "enum": [
            "picture",
            "overlay"
          ]
        },
        "order": {
          "type": "integer",
          "minimum": 1,
          "maximum": 32
        },
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 240
        },
        "segments": {
          "type": "array",
          "minItems": 1,
          "maxItems": 512,
          "items": {
            "$ref": "#/$defs/segment"
          }
        }
      }
    },
    "segment": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "segmentId",
        "segmentType",
        "timelineRange"
      ],
      "properties": {
        "segmentId": {
          "$ref": "common.schema.json#/$defs/identifier"
        },
        "segmentType": {
          "enum": [
            "media",
            "placeholder",
            "gap"
          ]
        },
        "timelineRange": {
          "$ref": "#/$defs/frameRange"
        },
        "shotId": {
          "$ref": "common.schema.json#/$defs/identifier"
        },
        "shotSpecRef": {
          "$ref": "#/$defs/shotSpecRef"
        },
        "temporalSpecRef": {
          "$ref": "#/$defs/temporalSpecRef"
        },
        "mediaId": {
          "$ref": "common.schema.json#/$defs/identifier"
        },
        "sourceRange": {
          "$ref": "#/$defs/frameRange"
        }
      },
      "allOf": [
        {
          "if": {
            "required": [
              "segmentType"
            ],
            "properties": {
              "segmentType": {
                "const": "media"
              }
            }
          },
          "then": {
            "required": [
              "shotId",
              "shotSpecRef",
              "mediaId",
              "sourceRange"
            ]
          }
        },
        {
          "if": {
            "required": [
              "segmentType"
            ],
            "properties": {
              "segmentType": {
                "const": "placeholder"
              }
            }
          },
          "then": {
            "required": [
              "shotId",
              "shotSpecRef"
            ],
            "not": {
              "anyOf": [
                {
                  "required": [
                    "mediaId"
                  ]
                },
                {
                  "required": [
                    "sourceRange"
                  ]
                }
              ]
            }
          }
        },
        {
          "if": {
            "required": [
              "segmentType"
            ],
            "properties": {
              "segmentType": {
                "const": "gap"
              }
            }
          },
          "then": {
            "not": {
              "anyOf": [
                {
                  "required": [
                    "shotId"
                  ]
                },
                {
                  "required": [
                    "shotSpecRef"
                  ]
                },
                {
                  "required": [
                    "temporalSpecRef"
                  ]
                },
                {
                  "required": [
                    "mediaId"
                  ]
                },
                {
                  "required": [
                    "sourceRange"
                  ]
                }
              ]
            }
          }
        }
      ]
    },
    "transition": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "transitionId",
        "trackId",
        "fromSegmentId",
        "toSegmentId",
        "type",
        "atFrame",
        "durationFrames"
      ],
      "properties": {
        "transitionId": {
          "$ref": "common.schema.json#/$defs/identifier"
        },
        "trackId": {
          "$ref": "common.schema.json#/$defs/identifier"
        },
        "fromSegmentId": {
          "$ref": "common.schema.json#/$defs/identifier"
        },
        "toSegmentId": {
          "$ref": "common.schema.json#/$defs/identifier"
        },
        "type": {
          "enum": [
            "cut",
            "dissolve",
            "wipe",
            "fade_to_black"
          ]
        },
        "atFrame": {
          "type": "integer",
          "minimum": 0,
          "maximum": 100000000
        },
        "durationFrames": {
          "type": "integer",
          "minimum": 0,
          "maximum": 100000000
        },
        "rationale": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1200
        }
      },
      "allOf": [
        {
          "if": {
            "required": [
              "type"
            ],
            "properties": {
              "type": {
                "const": "cut"
              }
            }
          },
          "then": {
            "properties": {
              "durationFrames": {
                "const": 0
              }
            }
          }
        },
        {
          "if": {
            "required": [
              "type"
            ],
            "properties": {
              "type": {
                "enum": [
                  "dissolve",
                  "wipe",
                  "fade_to_black"
                ]
              }
            }
          },
          "then": {
            "properties": {
              "durationFrames": {
                "minimum": 1
              }
            }
          }
        }
      ]
    },
    "marker": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "markerId",
        "frame",
        "role",
        "note"
      ],
      "properties": {
        "markerId": {
          "$ref": "common.schema.json#/$defs/identifier"
        },
        "frame": {
          "type": "integer",
          "minimum": 0,
          "maximum": 100000000
        },
        "role": {
          "enum": [
            "entry",
            "beat",
            "transition",
            "exit",
            "review"
          ]
        },
        "note": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1200
        },
        "shotId": {
          "$ref": "common.schema.json#/$defs/identifier"
        }
      }
    },
    "otioExchange": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "model",
        "externalMediaOnly",
        "serializationStatus"
      ],
      "properties": {
        "model": {
          "const": "otio-core"
        },
        "externalMediaOnly": {
          "const": true
        },
        "serializationStatus": {
          "const": "not_exported"
        },
        "notes": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1200
        }
      }
    },
    "planningBoundary": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "providerNeutral",
        "embedsMedia",
        "exportsTimeline",
        "humanApprovalRequired"
      ],
      "properties": {
        "providerNeutral": {
          "const": true
        },
        "embedsMedia": {
          "const": false
        },
        "exportsTimeline": {
          "const": false
        },
        "humanApprovalRequired": {
          "const": true
        },
        "notes": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1200
        }
      }
    },
    "validation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "rationalTimebase",
        "trackRangesClosed",
        "segmentsOrdered",
        "transitionsAnchored",
        "sourceRefsExact",
        "plannedMediaHonest",
        "providerNeutral"
      ],
      "properties": {
        "rationalTimebase": {
          "const": true
        },
        "trackRangesClosed": {
          "const": true
        },
        "segmentsOrdered": {
          "const": true
        },
        "transitionsAnchored": {
          "const": true
        },
        "sourceRefsExact": {
          "const": true
        },
        "plannedMediaHonest": {
          "const": true
        },
        "providerNeutral": {
          "const": true
        }
      }
    }
  }
}
