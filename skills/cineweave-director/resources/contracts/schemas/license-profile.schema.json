{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cineweave.dev/contracts/license-profile.schema.json",
  "title": "CineWeave Production License and Rights Profile",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "kind",
    "contractVersion",
    "profileId",
    "title",
    "version",
    "status",
    "subjectType",
    "subjectRef",
    "skillReceipt",
    "commercialUse",
    "redistribution",
    "derivativeUse",
    "attribution",
    "identityRights",
    "assetRights",
    "dataHandling",
    "dependencies",
    "evidence",
    "validation",
    "provenance"
  ],
  "properties": {
    "kind": {
      "const": "cineweave_codex_license_profile"
    },
    "contractVersion": {
      "const": "2.0.0"
    },
    "profileId": {
      "$ref": "#/$defs/lowerId"
    },
    "title": {
      "type": "string",
      "minLength": 1,
      "maxLength": 240
    },
    "version": {
      "type": "integer",
      "minimum": 1
    },
    "status": {
      "enum": [
        "draft",
        "verified",
        "restricted",
        "blocked",
        "expired"
      ]
    },
    "subjectType": {
      "enum": [
        "code",
        "weights",
        "base_model",
        "dependency",
        "dataset",
        "reference_asset",
        "identity",
        "service",
        "adapter"
      ]
    },
    "subjectRef": {
      "type": "string",
      "minLength": 1,
      "maxLength": 500
    },
    "skillReceipt": {
      "$ref": "#/$defs/skillReceipt"
    },
    "licenseId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 240
    },
    "licenseTextHash": {
      "$ref": "#/$defs/contentHash"
    },
    "commercialUse": {
      "enum": [
        "allowed",
        "restricted",
        "prohibited",
        "unknown",
        "not_applicable"
      ]
    },
    "redistribution": {
      "enum": [
        "allowed",
        "restricted",
        "prohibited",
        "unknown",
        "not_applicable"
      ]
    },
    "derivativeUse": {
      "enum": [
        "allowed",
        "restricted",
        "prohibited",
        "unknown",
        "not_applicable"
      ]
    },
    "attribution": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "required",
        "instructions"
      ],
      "properties": {
        "required": {
          "type": "boolean"
        },
        "instructions": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1200
        }
      }
    },
    "identityRights": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "likenessConsent",
        "identityUse",
        "publication"
      ],
      "properties": {
        "likenessConsent": {
          "enum": [
            "confirmed",
            "not_applicable",
            "unknown",
            "denied"
          ]
        },
        "identityUse": {
          "enum": [
            "allowed",
            "restricted",
            "prohibited",
            "unknown",
            "not_applicable"
          ]
        },
        "publication": {
          "enum": [
            "allowed",
            "restricted",
            "prohibited",
            "unknown",
            "not_applicable"
          ]
        },
        "notes": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1200
        }
      }
    },
    "assetRights": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "ownership",
        "generationUse",
        "publication"
      ],
      "properties": {
        "ownership": {
          "enum": [
            "creator_owned",
            "licensed",
            "public_domain",
            "unknown",
            "third_party_restricted"
          ]
        },
        "generationUse": {
          "enum": [
            "allowed",
            "restricted",
            "prohibited",
            "unknown",
            "not_applicable"
          ]
        },
        "publication": {
          "enum": [
            "allowed",
            "restricted",
            "prohibited",
            "unknown",
            "not_applicable"
          ]
        },
        "notes": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1200
        }
      }
    },
    "dataHandling": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "retention",
        "trainingUse",
        "privateAssetPolicy"
      ],
      "properties": {
        "retention": {
          "enum": [
            "none",
            "session_only",
            "project_scoped",
            "provider_defined",
            "unknown"
          ]
        },
        "trainingUse": {
          "enum": [
            "allowed",
            "restricted",
            "prohibited",
            "unknown",
            "not_applicable"
          ]
        },
        "privateAssetPolicy": {
          "enum": [
            "local_only",
            "approved_service_only",
            "public_allowed",
            "unknown"
          ]
        }
      }
    },
    "dependencies": {
      "type": "array",
      "maxItems": 32,
      "items": {
        "$ref": "#/$defs/dependency"
      }
    },
    "evidence": {
      "type": "array",
      "minItems": 1,
      "maxItems": 16,
      "items": {
        "$ref": "#/$defs/evidence"
      }
    },
    "validation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "checked",
        "noAssumedCommercialUse",
        "dependenciesReviewed",
        "identityRightsReviewed"
      ],
      "properties": {
        "checked": {
          "const": true
        },
        "noAssumedCommercialUse": {
          "const": true
        },
        "dependenciesReviewed": {
          "const": true
        },
        "identityRightsReviewed": {
          "const": true
        }
      }
    },
    "provenance": {
      "$ref": "#/$defs/provenance"
    }
  },
  "$defs": {
    "skillReceipt": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "repository",
        "ref",
        "commit",
        "installedBy",
        "usedAt"
      ],
      "properties": {
        "repository": {
          "type": "string",
          "format": "uri",
          "pattern": "^https://(www\\.)?github\\.com/[^/]+/[^/]+(?:\\.git)?/?$"
        },
        "ref": {
          "type": "string",
          "minLength": 1,
          "maxLength": 240
        },
        "commit": {
          "type": "string",
          "pattern": "^[0-9a-fA-F]{7,64}$"
        },
        "contentHash": {
          "type": "string",
          "pattern": "^sha256:[0-9a-fA-F]{64}$"
        },
        "installedBy": {
          "const": "codex-environment"
        },
        "environmentId": {
          "type": "string",
          "maxLength": 240
        },
        "usedAt": {
          "type": "string",
          "format": "date-time"
        }
      }
    },
    "stableId": {
      "type": "string",
      "pattern": "^[a-zA-Z][a-zA-Z0-9._-]{1,159}$"
    },
    "lowerId": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9._-]{2,159}$"
    },
    "observationId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 160,
      "not": {
        "pattern": "(?:https?:|file:|[\\\\/?#])"
      }
    },
    "contentHash": {
      "type": "string",
      "pattern": "^sha256:[0-9a-fA-F]{64}$"
    },
    "stringList": {
      "type": "array",
      "minItems": 1,
      "maxItems": 32,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 1600
      }
    },
    "optionalStringList": {
      "type": "array",
      "maxItems": 32,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 1600
      }
    },
    "primitive": {
      "type": [
        "string",
        "number",
        "boolean",
        "null"
      ]
    },
    "provenance": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "source",
        "createdAt",
        "updatedAt",
        "changeLog"
      ],
      "properties": {
        "source": {
          "enum": [
            "user_authored",
            "codex_authored",
            "adapted",
            "imported",
            "suite_builtin"
          ]
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        },
        "parentId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 160
        },
        "changeLog": {
          "$ref": "#/$defs/stringList"
        }
      }
    },
    "versionedRef": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "id"
      ],
      "properties": {
        "kind": {
          "type": "string",
          "minLength": 1,
          "maxLength": 160
        },
        "id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 160
        },
        "version": {
          "type": "integer",
          "minimum": 1
        },
        "contentHash": {
          "$ref": "#/$defs/contentHash"
        },
        "observationIds": {
          "type": "array",
          "maxItems": 24,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/observationId"
          }
        }
      }
    },
    "contractRef": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "contentHash"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 160
        },
        "version": {
          "type": "integer",
          "minimum": 1
        },
        "contentHash": {
          "$ref": "#/$defs/contentHash"
        }
      }
    },
    "canvas": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "aspectRatio",
        "sizeClass"
      ],
      "properties": {
        "aspectRatio": {
          "type": "string",
          "pattern": "^[1-9][0-9]*:[1-9][0-9]*$"
        },
        "sizeClass": {
          "enum": [
            "square",
            "portrait",
            "landscape",
            "wide",
            "tall",
            "custom",
            "unspecified"
          ]
        },
        "pixelDimensions": {
          "type": "string",
          "pattern": "^[1-9][0-9]*x[1-9][0-9]*$"
        },
        "background": {
          "type": "string",
          "minLength": 1,
          "maxLength": 500
        }
      }
    },
    "dependency": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "subjectType",
        "commercialUse",
        "redistribution"
      ],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 240
        },
        "subjectType": {
          "enum": [
            "code",
            "weights",
            "base_model",
            "dependency",
            "dataset",
            "reference_asset",
            "identity",
            "service"
          ]
        },
        "licenseId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 240
        },
        "commercialUse": {
          "enum": [
            "allowed",
            "restricted",
            "prohibited",
            "unknown",
            "not_applicable"
          ]
        },
        "redistribution": {
          "enum": [
            "allowed",
            "restricted",
            "prohibited",
            "unknown",
            "not_applicable"
          ]
        },
        "notes": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1200
        }
      }
    },
    "evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "sourceLabel",
        "checkedAt",
        "status"
      ],
      "properties": {
        "sourceLabel": {
          "type": "string",
          "minLength": 1,
          "maxLength": 500
        },
        "sourceUrl": {
          "type": "string",
          "format": "uri"
        },
        "checkedAt": {
          "type": "string",
          "format": "date-time"
        },
        "status": {
          "enum": [
            "verified",
            "unverified",
            "conflicting"
          ]
        },
        "notes": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1200
        }
      }
    }
  }
}
