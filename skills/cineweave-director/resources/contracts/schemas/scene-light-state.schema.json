{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cineweave.dev/contracts/scene-light-state.schema.json",
  "title": "CineWeave Physical Scene Light State",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "kind",
    "contractVersion",
    "lightStateId",
    "version",
    "sceneStateRef",
    "skillReceipt",
    "timeWeather",
    "sources",
    "ambient",
    "shadowField",
    "exposureBaseline",
    "materialResponses",
    "preserve",
    "validation"
  ],
  "properties": {
    "kind": {
      "const": "cineweave_codex_scene_light_state"
    },
    "contractVersion": {
      "const": "2.2.0"
    },
    "lightStateId": {
      "$ref": "common.schema.json#/$defs/identifier"
    },
    "version": {
      "type": "integer",
      "minimum": 1
    },
    "sceneStateRef": {
      "$ref": "common.schema.json#/$defs/contractRef"
    },
    "skillReceipt": {
      "$ref": "common.schema.json#/$defs/skillReceipt"
    },
    "timeWeather": {
      "type": "string",
      "minLength": 1,
      "maxLength": 1000
    },
    "sources": {
      "type": "array",
      "minItems": 1,
      "maxItems": 16,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "sourceId",
          "type",
          "positionAnchor",
          "direction",
          "intensity",
          "color",
          "size",
          "softness",
          "falloff",
          "castsShadow",
          "motivatedBy"
        ],
        "properties": {
          "sourceId": {
            "$ref": "common.schema.json#/$defs/identifier"
          },
          "type": {
            "enum": [
              "sun",
              "sky",
              "window",
              "doorway",
              "candle",
              "oil_lamp",
              "fire",
              "electric_practical",
              "bounce",
              "emissive_surface",
              "other"
            ]
          },
          "positionAnchor": {
            "type": "string",
            "minLength": 1,
            "maxLength": 500
          },
          "direction": {
            "type": "string",
            "minLength": 1,
            "maxLength": 500
          },
          "intensity": {
            "type": "string",
            "minLength": 1,
            "maxLength": 300
          },
          "color": {
            "type": "string",
            "minLength": 1,
            "maxLength": 300
          },
          "colorTemperatureK": {
            "type": "integer",
            "minimum": 1000,
            "maximum": 40000
          },
          "size": {
            "type": "string",
            "minLength": 1,
            "maxLength": 300
          },
          "softness": {
            "type": "string",
            "minLength": 1,
            "maxLength": 300
          },
          "falloff": {
            "type": "string",
            "minLength": 1,
            "maxLength": 500
          },
          "castsShadow": {
            "type": "boolean"
          },
          "motivatedBy": {
            "type": "string",
            "minLength": 1,
            "maxLength": 500
          }
        }
      }
    },
    "ambient": {
      "type": "string",
      "minLength": 1,
      "maxLength": 1000
    },
    "shadowField": {
      "type": "string",
      "minLength": 1,
      "maxLength": 1000
    },
    "atmosphereEffect": {
      "type": "string",
      "maxLength": 1000
    },
    "exposureBaseline": {
      "type": "string",
      "minLength": 1,
      "maxLength": 1000
    },
    "materialResponses": {
      "$ref": "common.schema.json#/$defs/stringList"
    },
    "preserve": {
      "$ref": "common.schema.json#/$defs/stringList"
    },
    "allowedVariation": {
      "type": "array",
      "maxItems": 16,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 1000
      }
    },
    "validation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "sourcesMotivated",
        "geographyBound",
        "shadowCoherent",
        "noPostprocessOwnership"
      ],
      "properties": {
        "sourcesMotivated": {
          "const": true
        },
        "geographyBound": {
          "const": true
        },
        "shadowCoherent": {
          "const": true
        },
        "noPostprocessOwnership": {
          "const": true
        }
      }
    }
  }
}
