{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cineweave.dev/contracts/reference-asset.schema.json",
  "title": "CineWeave Content-addressed Reference Asset",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "kind",
    "contractVersion",
    "assetId",
    "version",
    "status",
    "label",
    "media",
    "blob",
    "source",
    "provenance",
    "rights",
    "privacy",
    "safety"
  ],
  "properties": {
    "kind": {
      "const": "cineweave_codex_reference_asset"
    },
    "contractVersion": {
      "const": "2.4.0"
    },
    "assetId": {
      "$ref": "common.schema.json#/$defs/identifier"
    },
    "version": {
      "const": 1
    },
    "status": {
      "const": "ingested"
    },
    "label": {
      "type": "string",
      "minLength": 1,
      "maxLength": 240,
      "not": {
        "pattern": "(?:https?:|file:|[\\\\/])"
      }
    },
    "media": {
      "$ref": "#/$defs/media"
    },
    "blob": {
      "$ref": "#/$defs/blob"
    },
    "source": {
      "$ref": "#/$defs/source"
    },
    "provenance": {
      "$ref": "#/$defs/provenance"
    },
    "rights": {
      "$ref": "#/$defs/rights"
    },
    "privacy": {
      "$ref": "#/$defs/privacy"
    },
    "safety": {
      "$ref": "#/$defs/safety"
    }
  },
  "$defs": {
    "media": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "mediaKind",
        "mediaType",
        "format",
        "sourceExtension",
        "byteLength",
        "contentHash",
        "technical"
      ],
      "properties": {
        "mediaKind": {
          "enum": [
            "image",
            "video"
          ]
        },
        "mediaType": {
          "enum": [
            "image/png",
            "image/jpeg",
            "image/webp",
            "video/mp4",
            "video/quicktime",
            "video/webm"
          ]
        },
        "format": {
          "enum": [
            "png",
            "jpeg",
            "webp",
            "mp4",
            "quicktime",
            "webm"
          ]
        },
        "sourceExtension": {
          "enum": [
            ".png",
            ".jpg",
            ".webp",
            ".mp4",
            ".mov",
            ".webm"
          ]
        },
        "byteLength": {
          "type": "integer",
          "minimum": 1,
          "maximum": 536870912
        },
        "contentHash": {
          "$ref": "common.schema.json#/$defs/contentHash"
        },
        "technical": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "probeLevel"
          ],
          "properties": {
            "probeLevel": {
              "enum": [
                "signature_and_dimensions",
                "container_signature_only"
              ]
            },
            "width": {
              "type": "integer",
              "minimum": 1,
              "maximum": 65535
            },
            "height": {
              "type": "integer",
              "minimum": 1,
              "maximum": 65535
            }
          }
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "mediaKind": {
                "const": "image"
              }
            },
            "required": [
              "mediaKind"
            ]
          },
          "then": {
            "properties": {
              "byteLength": {
                "maximum": 67108864
              },
              "technical": {
                "required": [
                  "width",
                  "height"
                ],
                "properties": {
                  "probeLevel": {
                    "const": "signature_and_dimensions"
                  }
                }
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "mediaKind": {
                "const": "video"
              }
            },
            "required": [
              "mediaKind"
            ]
          },
          "then": {
            "properties": {
              "technical": {
                "properties": {
                  "probeLevel": {
                    "const": "container_signature_only"
                  }
                }
              }
            }
          }
        }
      ]
    },
    "blob": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "storageMode",
        "relativePath",
        "byteLength",
        "contentHash"
      ],
      "properties": {
        "storageMode": {
          "const": "project_content_addressed"
        },
        "relativePath": {
          "type": "string",
          "pattern": "^reference-blobs/sha256/[0-9a-f]{2}/[0-9a-f]{64}\\.blob$"
        },
        "byteLength": {
          "type": "integer",
          "minimum": 1,
          "maximum": 536870912
        },
        "contentHash": {
          "$ref": "common.schema.json#/$defs/contentHash"
        }
      }
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "sourceClass",
        "sourceLocatorStored",
        "originalFilenameStored",
        "importCreatesRights"
      ],
      "properties": {
        "sourceClass": {
          "enum": [
            "user_upload",
            "local_file",
            "generated_output",
            "external_download"
          ]
        },
        "sourceLocatorStored": {
          "const": false
        },
        "originalFilenameStored": {
          "const": false
        },
        "importCreatesRights": {
          "const": false
        }
      }
    },
    "provenance": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "byteBinding",
        "contentCredentials",
        "digitalSourceType"
      ],
      "properties": {
        "byteBinding": {
          "const": "sha256_full_asset"
        },
        "contentCredentials": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "status",
            "trust"
          ],
          "properties": {
            "status": {
              "enum": [
                "not_checked",
                "absent",
                "present_unverified",
                "valid",
                "invalid"
              ]
            },
            "trust": {
              "enum": [
                "unknown",
                "untrusted",
                "valid_untrusted_signer",
                "trusted"
              ]
            },
            "manifestHash": {
              "$ref": "common.schema.json#/$defs/contentHash"
            },
            "specVersion": {
              "type": "string",
              "minLength": 1,
              "maxLength": 40
            }
          },
          "allOf": [
            {
              "if": {
                "properties": {
                  "status": {
                    "enum": [
                      "not_checked",
                      "absent"
                    ]
                  }
                },
                "required": [
                  "status"
                ]
              },
              "then": {
                "properties": {
                  "trust": {
                    "const": "unknown"
                  }
                },
                "not": {
                  "anyOf": [
                    {
                      "required": [
                        "manifestHash"
                      ]
                    },
                    {
                      "required": [
                        "specVersion"
                      ]
                    }
                  ]
                }
              }
            },
            {
              "if": {
                "properties": {
                  "status": {
                    "const": "present_unverified"
                  }
                },
                "required": [
                  "status"
                ]
              },
              "then": {
                "properties": {
                  "trust": {
                    "enum": [
                      "unknown",
                      "untrusted"
                    ]
                  }
                }
              }
            },
            {
              "if": {
                "properties": {
                  "status": {
                    "const": "valid"
                  }
                },
                "required": [
                  "status"
                ]
              },
              "then": {
                "required": [
                  "manifestHash",
                  "specVersion"
                ],
                "properties": {
                  "trust": {
                    "enum": [
                      "valid_untrusted_signer",
                      "trusted"
                    ]
                  }
                }
              }
            },
            {
              "if": {
                "properties": {
                  "status": {
                    "const": "invalid"
                  }
                },
                "required": [
                  "status"
                ]
              },
              "then": {
                "properties": {
                  "trust": {
                    "const": "untrusted"
                  }
                }
              }
            }
          ]
        },
        "digitalSourceType": {
          "type": "string",
          "minLength": 1,
          "maxLength": 500
        }
      }
    },
    "rights": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status",
        "assetOwnership",
        "generationUse",
        "redistribution",
        "trainingUse",
        "likenessConsent",
        "requiresSeparateLicenseProfile"
      ],
      "properties": {
        "status": {
          "enum": [
            "unknown",
            "declared",
            "verified",
            "restricted",
            "blocked"
          ]
        },
        "assetOwnership": {
          "enum": [
            "unknown",
            "creator_owned",
            "licensed",
            "public_domain",
            "third_party_restricted"
          ]
        },
        "generationUse": {
          "enum": [
            "unknown",
            "allowed",
            "restricted",
            "prohibited"
          ]
        },
        "redistribution": {
          "enum": [
            "unknown",
            "allowed",
            "restricted",
            "prohibited"
          ]
        },
        "trainingUse": {
          "enum": [
            "unknown",
            "allowed",
            "restricted",
            "prohibited"
          ]
        },
        "likenessConsent": {
          "enum": [
            "unknown",
            "confirmed",
            "not_applicable",
            "denied"
          ]
        },
        "requiresSeparateLicenseProfile": {
          "const": true
        },
        "licenseProfileRef": {
          "allOf": [
            {
              "$ref": "common.schema.json#/$defs/contractRef"
            },
            {
              "properties": {
                "kind": {
                  "const": "cineweave_codex_license_profile"
                }
              }
            }
          ]
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "status": {
                "const": "verified"
              }
            },
            "required": [
              "status"
            ]
          },
          "then": {
            "required": [
              "licenseProfileRef"
            ],
            "properties": {
              "assetOwnership": {
                "enum": [
                  "creator_owned",
                  "licensed",
                  "public_domain",
                  "third_party_restricted"
                ]
              },
              "generationUse": {
                "enum": [
                  "allowed",
                  "restricted",
                  "prohibited"
                ]
              },
              "redistribution": {
                "enum": [
                  "allowed",
                  "restricted",
                  "prohibited"
                ]
              },
              "trainingUse": {
                "enum": [
                  "allowed",
                  "restricted",
                  "prohibited"
                ]
              },
              "likenessConsent": {
                "enum": [
                  "confirmed",
                  "not_applicable",
                  "denied"
                ]
              }
            }
          }
        }
      ]
    },
    "privacy": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "originalBytesRetained",
        "embeddedMetadata",
        "locationMetadata",
        "sourcePathStored",
        "reviewRequired"
      ],
      "properties": {
        "originalBytesRetained": {
          "const": true
        },
        "embeddedMetadata": {
          "enum": [
            "preserved_uninspected",
            "inspected",
            "stripped_in_derived_copy"
          ]
        },
        "locationMetadata": {
          "enum": [
            "not_inspected",
            "absent",
            "present",
            "removed_in_derived_copy"
          ]
        },
        "sourcePathStored": {
          "const": false
        },
        "reviewRequired": {
          "const": true
        }
      }
    },
    "safety": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "extensionAllowlisted",
        "signatureMatched",
        "decoderInvoked",
        "activeContentExecuted",
        "malwareScan",
        "handlingStatus"
      ],
      "properties": {
        "extensionAllowlisted": {
          "const": true
        },
        "signatureMatched": {
          "const": true
        },
        "decoderInvoked": {
          "const": false
        },
        "activeContentExecuted": {
          "const": false
        },
        "malwareScan": {
          "enum": [
            "not_run",
            "passed",
            "failed"
          ]
        },
        "handlingStatus": {
          "enum": [
            "stored_non_executable",
            "blocked"
          ]
        }
      }
    }
  }
}
