{
  "$id": "https://cineweave.dev/contracts/world-bible.schema.json",
  "title": "CineWeave World Bible",
  "description": "Versioned authority for world laws, geography, societies, history, narrative constraints and physical visual baseline.",
  "type": "object",
  "additionalProperties": false,
  "required": ["kind", "contractVersion", "worldId", "title", "version", "status", "premise", "canon", "systems", "geography", "societies", "history", "narrativeConstraints", "visualBaseline", "continuityPolicy", "unknowns", "locks", "validation", "skillReceipt", "provenance"],
  "properties": {
    "kind": { "const": "cineweave_codex_world_bible" },
    "contractVersion": { "const": "3.0.0" },
    "worldId": { "$ref": "common.schema.json#/$defs/identifier" },
    "title": { "type": "string", "minLength": 1, "maxLength": 240 },
    "version": { "type": "integer", "minimum": 1 },
    "status": { "enum": ["draft", "approved", "archived"] },
    "premise": { "type": "string", "minLength": 1, "maxLength": 3200 },
    "scope": { "type": "string", "maxLength": 1600 },
    "canon": { "type": "array", "minItems": 1, "maxItems": 256, "items": { "$ref": "#/$defs/canonClaim" } },
    "systems": { "type": "array", "minItems": 1, "maxItems": 48, "items": { "$ref": "#/$defs/worldSystem" } },
    "geography": { "type": "array", "minItems": 1, "maxItems": 96, "items": { "$ref": "#/$defs/region" } },
    "societies": { "type": "array", "minItems": 1, "maxItems": 96, "items": { "$ref": "#/$defs/society" } },
    "history": { "type": "array", "minItems": 1, "maxItems": 128, "items": { "$ref": "#/$defs/era" } },
    "narrativeConstraints": { "$ref": "#/$defs/narrativeConstraints" },
    "visualBaseline": { "$ref": "#/$defs/visualBaseline" },
    "continuityPolicy": { "$ref": "#/$defs/continuityPolicy" },
    "unknowns": { "type": "array", "maxItems": 64, "items": { "type": "string", "minLength": 1, "maxLength": 1200 } },
    "locks": { "type": "array", "maxItems": 96, "items": { "$ref": "common.schema.json#/$defs/lock" } },
    "validation": { "$ref": "#/$defs/validation" },
    "skillReceipt": { "$ref": "common.schema.json#/$defs/skillReceipt" },
    "provenance": { "$ref": "common.schema.json#/$defs/provenance" }
  },
  "$defs": {
    "canonClaim": {
      "type": "object",
      "additionalProperties": false,
      "required": ["claimId", "namespace", "statement", "status", "rationale"],
      "properties": {
        "claimId": { "$ref": "common.schema.json#/$defs/identifier" },
        "namespace": { "enum": ["physics", "metaphysics", "history", "geography", "society", "culture", "technology", "ecology", "language", "economy", "politics", "religion", "everyday_life"] },
        "statement": { "type": "string", "minLength": 1, "maxLength": 2000 },
        "status": { "enum": ["canonical", "provisional", "forbidden"] },
        "rationale": { "type": "string", "minLength": 1, "maxLength": 1200 },
        "sourceRefs": { "type": "array", "maxItems": 16, "items": { "$ref": "common.schema.json#/$defs/contractRef" } }
      }
    },
    "worldSystem": {
      "type": "object",
      "additionalProperties": false,
      "required": ["systemId", "name", "rules", "limits", "costs", "exceptions"],
      "properties": {
        "systemId": { "$ref": "common.schema.json#/$defs/identifier" },
        "name": { "type": "string", "minLength": 1, "maxLength": 240 },
        "rules": { "$ref": "common.schema.json#/$defs/stringList" },
        "limits": { "$ref": "common.schema.json#/$defs/stringList" },
        "costs": { "$ref": "common.schema.json#/$defs/stringList" },
        "exceptions": { "$ref": "common.schema.json#/$defs/stringList" }
      }
    },
    "region": {
      "type": "object",
      "additionalProperties": false,
      "required": ["regionId", "name", "scale", "orientation", "relationships", "climate", "materials"],
      "properties": {
        "regionId": { "$ref": "common.schema.json#/$defs/identifier" },
        "name": { "type": "string", "minLength": 1, "maxLength": 240 },
        "scale": { "type": "string", "minLength": 1, "maxLength": 800 },
        "orientation": { "type": "string", "minLength": 1, "maxLength": 1200 },
        "relationships": { "$ref": "common.schema.json#/$defs/stringList" },
        "climate": { "$ref": "common.schema.json#/$defs/stringList" },
        "materials": { "$ref": "common.schema.json#/$defs/stringList" }
      }
    },
    "society": {
      "type": "object",
      "additionalProperties": false,
      "required": ["societyId", "name", "values", "powerStructure", "everydayLife", "taboos", "conflicts"],
      "properties": {
        "societyId": { "$ref": "common.schema.json#/$defs/identifier" },
        "name": { "type": "string", "minLength": 1, "maxLength": 240 },
        "values": { "$ref": "common.schema.json#/$defs/stringList" },
        "powerStructure": { "$ref": "common.schema.json#/$defs/stringList" },
        "everydayLife": { "$ref": "common.schema.json#/$defs/stringList" },
        "taboos": { "$ref": "common.schema.json#/$defs/stringList" },
        "conflicts": { "$ref": "common.schema.json#/$defs/stringList" }
      }
    },
    "era": {
      "type": "object",
      "additionalProperties": false,
      "required": ["eraId", "name", "order", "events", "lastingConsequences"],
      "properties": {
        "eraId": { "$ref": "common.schema.json#/$defs/identifier" },
        "name": { "type": "string", "minLength": 1, "maxLength": 240 },
        "order": { "type": "integer", "minimum": 0 },
        "events": { "$ref": "common.schema.json#/$defs/stringList" },
        "lastingConsequences": { "$ref": "common.schema.json#/$defs/stringList" }
      }
    },
    "narrativeConstraints": {
      "type": "object",
      "additionalProperties": false,
      "required": ["possible", "impossible", "costly", "centralTensions", "storyHooks"],
      "properties": {
        "possible": { "$ref": "common.schema.json#/$defs/stringList" },
        "impossible": { "$ref": "common.schema.json#/$defs/stringList" },
        "costly": { "$ref": "common.schema.json#/$defs/stringList" },
        "centralTensions": { "$ref": "common.schema.json#/$defs/stringList" },
        "storyHooks": { "$ref": "common.schema.json#/$defs/stringList" }
      }
    },
    "visualBaseline": {
      "type": "object",
      "additionalProperties": false,
      "required": ["architecture", "materials", "technology", "wardrobeLogic", "recurringMotifs", "physicalLightLogic", "representationRemainsStyleOwned"],
      "properties": {
        "architecture": { "$ref": "common.schema.json#/$defs/stringList" },
        "materials": { "$ref": "common.schema.json#/$defs/stringList" },
        "technology": { "$ref": "common.schema.json#/$defs/stringList" },
        "wardrobeLogic": { "$ref": "common.schema.json#/$defs/stringList" },
        "recurringMotifs": { "$ref": "common.schema.json#/$defs/stringList" },
        "physicalLightLogic": { "$ref": "common.schema.json#/$defs/stringList" },
        "representationRemainsStyleOwned": { "const": true }
      }
    },
    "continuityPolicy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["immutableFacts", "allowedVariation", "changeRequiresCause", "conflictResolution"],
      "properties": {
        "immutableFacts": { "$ref": "common.schema.json#/$defs/stringList" },
        "allowedVariation": { "$ref": "common.schema.json#/$defs/stringList" },
        "changeRequiresCause": { "const": true },
        "conflictResolution": { "type": "string", "minLength": 1, "maxLength": 1600 }
      }
    },
    "validation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["canonStatusExplicit", "rulesHaveLimits", "geographyRelational", "societiesPlayable", "historyHasConsequences", "styleDoesNotRewriteWorld", "unknownsPreserved"],
      "properties": {
        "canonStatusExplicit": { "const": true },
        "rulesHaveLimits": { "const": true },
        "geographyRelational": { "const": true },
        "societiesPlayable": { "const": true },
        "historyHasConsequences": { "const": true },
        "styleDoesNotRewriteWorld": { "const": true },
        "unknownsPreserved": { "const": true }
      }
    }
  }
}
