{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cineweave.dev/contracts/cinematic-skill-manifest.schema.json",
  "title": "CineWeave Atomic Cinematic Skill Manifest",
  "description": "A provider-neutral, parameterized cinematic program catalog. It describes creator-facing controls and department handoffs without becoming Canon or executing a provider.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "kind",
    "contractVersion",
    "cinematicSkillManifestId",
    "version",
    "title",
    "status",
    "skills",
    "skillReceipt",
    "planningBoundary",
    "validation",
    "provenance"
  ],
  "properties": {
    "kind": {
      "const": "cineweave_codex_cinematic_skill_manifest"
    },
    "contractVersion": {
      "const": "2.5.0"
    },
    "cinematicSkillManifestId": {
      "$ref": "common.schema.json#/$defs/identifier"
    },
    "version": {
      "type": "integer",
      "minimum": 1
    },
    "title": {
      "type": "string",
      "minLength": 1,
      "maxLength": 240
    },
    "status": {
      "enum": [
        "draft",
        "active",
        "deprecated"
      ]
    },
    "skills": {
      "type": "array",
      "minItems": 1,
      "maxItems": 64,
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/atomicSkill"
      }
    },
    "skillReceipt": {
      "$ref": "common.schema.json#/$defs/skillReceipt"
    },
    "planningBoundary": {
      "$ref": "#/$defs/planningBoundary"
    },
    "validation": {
      "$ref": "#/$defs/validation"
    },
    "provenance": {
      "$ref": "common.schema.json#/$defs/provenance"
    }
  },
  "$defs": {
    "primitive": {
      "type": [
        "string",
        "number",
        "boolean",
        "null"
      ]
    },
    "ownerRoute": {
      "enum": [
        "shot_direction",
        "character",
        "scene",
        "style",
        "image_prompt",
        "production_plan"
      ]
    },
    "contractTarget": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "contractKind",
        "ownerRoute",
        "route",
        "fieldPath"
      ],
      "properties": {
        "contractKind": {
          "$ref": "common.schema.json#/$defs/identifier"
        },
        "ownerRoute": {
          "$ref": "#/$defs/ownerRoute"
        },
        "route": {
          "$ref": "common.schema.json#/$defs/identifier"
        },
        "fieldPath": {
          "type": "string",
          "minLength": 1,
          "maxLength": 320
        }
      }
    },
    "bindingSlot": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "slotId",
        "label",
        "role",
        "required",
        "acceptedContractKinds",
        "maxBindings"
      ],
      "properties": {
        "slotId": {
          "$ref": "common.schema.json#/$defs/identifier"
        },
        "label": {
          "type": "string",
          "minLength": 1,
          "maxLength": 240
        },
        "role": {
          "enum": [
            "character",
            "scene",
            "performance",
            "action",
            "shot",
            "style",
            "reference",
            "prop"
          ]
        },
        "required": {
          "type": "boolean"
        },
        "acceptedContractKinds": {
          "type": "array",
          "minItems": 1,
          "maxItems": 12,
          "uniqueItems": true,
          "items": {
            "$ref": "common.schema.json#/$defs/identifier"
          }
        },
        "maxBindings": {
          "type": "integer",
          "minimum": 1,
          "maximum": 12
        }
      }
    },
    "range": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "minimum",
        "maximum"
      ],
      "properties": {
        "minimum": {
          "type": "number"
        },
        "maximum": {
          "type": "number"
        },
        "step": {
          "type": "number",
          "exclusiveMinimum": 0
        }
      }
    },
    "parameter": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "parameterId",
        "label",
        "domain",
        "valueType",
        "defaultValue",
        "controlLevel",
        "targets"
      ],
      "properties": {
        "parameterId": {
          "$ref": "common.schema.json#/$defs/identifier"
        },
        "label": {
          "type": "string",
          "minLength": 1,
          "maxLength": 240
        },
        "domain": {
          "enum": [
            "blocking",
            "camera",
            "composition",
            "performance",
            "tempo",
            "lighting",
            "continuity",
            "transition"
          ]
        },
        "valueType": {
          "enum": [
            "enum",
            "number",
            "text",
            "boolean",
            "frame_count"
          ]
        },
        "defaultValue": {
          "$ref": "#/$defs/primitive"
        },
        "options": {
          "type": "array",
          "maxItems": 32,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 240
          }
        },
        "range": {
          "$ref": "#/$defs/range"
        },
        "unit": {
          "type": "string",
          "maxLength": 80
        },
        "controlLevel": {
          "enum": [
            "hard",
            "soft",
            "advisory"
          ]
        },
        "targets": {
          "type": "array",
          "minItems": 1,
          "maxItems": 8,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/contractTarget"
          }
        }
      }
    },
    "programStep": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "stepId",
        "order",
        "operation",
        "ownerRoute",
        "target",
        "source",
        "rationale"
      ],
      "properties": {
        "stepId": {
          "$ref": "common.schema.json#/$defs/identifier"
        },
        "order": {
          "type": "integer",
          "minimum": 1
        },
        "operation": {
          "enum": [
            "bind",
            "set",
            "derive",
            "preserve",
            "handoff",
            "validate"
          ]
        },
        "ownerRoute": {
          "$ref": "#/$defs/ownerRoute"
        },
        "target": {
          "$ref": "#/$defs/contractTarget"
        },
        "source": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "type",
            "id"
          ],
          "properties": {
            "type": {
              "enum": [
                "parameter",
                "binding_slot",
                "upstream_ref",
                "constant",
                "preserve"
              ]
            },
            "id": {
              "type": "string",
              "minLength": 1,
              "maxLength": 240
            }
          }
        },
        "rationale": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1200
        }
      }
    },
    "outputContract": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "contractKind",
        "ownerRoute",
        "route",
        "required",
        "purpose"
      ],
      "properties": {
        "contractKind": {
          "$ref": "common.schema.json#/$defs/identifier"
        },
        "ownerRoute": {
          "$ref": "#/$defs/ownerRoute"
        },
        "route": {
          "$ref": "common.schema.json#/$defs/identifier"
        },
        "required": {
          "type": "boolean"
        },
        "purpose": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1200
        }
      }
    },
    "controlGroup": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "groupId",
        "order",
        "domain",
        "label",
        "parameterIds"
      ],
      "properties": {
        "groupId": {
          "$ref": "common.schema.json#/$defs/identifier"
        },
        "order": {
          "type": "integer",
          "minimum": 1
        },
        "domain": {
          "enum": [
            "camera",
            "performance",
            "pacing",
            "blocking",
            "composition",
            "lighting",
            "continuity",
            "transition"
          ]
        },
        "label": {
          "type": "string",
          "minLength": 1,
          "maxLength": 240
        },
        "parameterIds": {
          "type": "array",
          "minItems": 1,
          "maxItems": 16,
          "uniqueItems": true,
          "items": {
            "$ref": "common.schema.json#/$defs/identifier"
          }
        }
      }
    },
    "qualityCheck": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "checkId",
        "label",
        "targetContractKind",
        "targetPath",
        "severity",
        "observation"
      ],
      "properties": {
        "checkId": {
          "$ref": "common.schema.json#/$defs/identifier"
        },
        "label": {
          "type": "string",
          "minLength": 1,
          "maxLength": 240
        },
        "targetContractKind": {
          "$ref": "common.schema.json#/$defs/identifier"
        },
        "targetPath": {
          "type": "string",
          "minLength": 1,
          "maxLength": 320
        },
        "severity": {
          "enum": [
            "hard",
            "soft",
            "advisory"
          ]
        },
        "observation": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1200
        }
      }
    },
    "atomicSkill": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "skillId",
        "version",
        "title",
        "summary",
        "storyFunction",
        "targetLevel",
        "bindingSlots",
        "parameters",
        "program",
        "outputContracts",
        "controlGroups",
        "qualityChecks"
      ],
      "properties": {
        "skillId": {
          "$ref": "common.schema.json#/$defs/identifier"
        },
        "version": {
          "type": "integer",
          "minimum": 1
        },
        "title": {
          "type": "string",
          "minLength": 1,
          "maxLength": 240
        },
        "summary": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1200
        },
        "storyFunction": {
          "enum": [
            "establish",
            "reveal",
            "reaction",
            "entrance",
            "dialogue",
            "intimacy",
            "follow",
            "pursuit",
            "orbit",
            "match",
            "transition",
            "impact",
            "memory"
          ]
        },
        "targetLevel": {
          "enum": [
            "shot",
            "sequence"
          ]
        },
        "bindingSlots": {
          "type": "array",
          "minItems": 1,
          "maxItems": 12,
          "items": {
            "$ref": "#/$defs/bindingSlot"
          }
        },
        "parameters": {
          "type": "array",
          "minItems": 1,
          "maxItems": 32,
          "items": {
            "$ref": "#/$defs/parameter"
          }
        },
        "program": {
          "type": "array",
          "minItems": 1,
          "maxItems": 64,
          "items": {
            "$ref": "#/$defs/programStep"
          }
        },
        "outputContracts": {
          "type": "array",
          "minItems": 1,
          "maxItems": 12,
          "items": {
            "$ref": "#/$defs/outputContract"
          }
        },
        "controlGroups": {
          "type": "array",
          "minItems": 1,
          "maxItems": 12,
          "items": {
            "$ref": "#/$defs/controlGroup"
          }
        },
        "qualityChecks": {
          "type": "array",
          "minItems": 1,
          "maxItems": 24,
          "items": {
            "$ref": "#/$defs/qualityCheck"
          }
        }
      }
    },
    "planningBoundary": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "providerNeutral",
        "generatesMedia",
        "invokesExternalTool",
        "mutatesCanon",
        "writesFiles",
        "humanApprovalRequired"
      ],
      "properties": {
        "providerNeutral": {
          "const": true
        },
        "generatesMedia": {
          "const": false
        },
        "invokesExternalTool": {
          "const": false
        },
        "mutatesCanon": {
          "const": false
        },
        "writesFiles": {
          "const": false
        },
        "humanApprovalRequired": {
          "const": true
        },
        "notes": {
          "type": "string",
          "maxLength": 1600
        }
      }
    },
    "validation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "skillIdsUnique",
        "parametersUnique",
        "programOrdered",
        "targetOwnersDeclared",
        "controlSurfaceProjectionOnly",
        "noProviderSyntax",
        "noCanonMutation",
        "noExternalExecution"
      ],
      "properties": {
        "skillIdsUnique": {
          "const": true
        },
        "parametersUnique": {
          "const": true
        },
        "programOrdered": {
          "const": true
        },
        "targetOwnersDeclared": {
          "const": true
        },
        "controlSurfaceProjectionOnly": {
          "const": true
        },
        "noProviderSyntax": {
          "const": true
        },
        "noCanonMutation": {
          "const": true
        },
        "noExternalExecution": {
          "const": true
        }
      }
    }
  }
}
