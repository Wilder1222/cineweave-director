{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cineweave.dev/contracts/beat-sheet.schema.json",
  "title": "CineWeave Beat Sheet",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "kind",
    "contractVersion",
    "beatSheetId",
    "version",
    "storyRef",
    "structure",
    "skillReceipt",
    "beats",
    "setupPayoffs",
    "validation"
  ],
  "properties": {
    "kind": {
      "const": "cineweave_codex_beat_sheet"
    },
    "contractVersion": {
      "const": "2.2.0"
    },
    "beatSheetId": {
      "$ref": "common.schema.json#/$defs/identifier"
    },
    "version": {
      "type": "integer",
      "minimum": 1
    },
    "storyRef": {
      "$ref": "common.schema.json#/$defs/contractRef"
    },
    "structure": {
      "enum": [
        "short_form",
        "three_act",
        "five_act",
        "sequence",
        "episodic",
        "custom"
      ]
    },
    "skillReceipt": {
      "$ref": "common.schema.json#/$defs/skillReceipt"
    },
    "beats": {
      "type": "array",
      "minItems": 3,
      "maxItems": 64,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "beatId",
          "order",
          "label",
          "function",
          "objective",
          "conflict",
          "choice",
          "change",
          "causesNext"
        ],
        "properties": {
          "beatId": {
            "$ref": "common.schema.json#/$defs/identifier"
          },
          "order": {
            "type": "integer",
            "minimum": 1
          },
          "label": {
            "type": "string",
            "minLength": 1,
            "maxLength": 240
          },
          "function": {
            "type": "string",
            "minLength": 1,
            "maxLength": 1000
          },
          "objective": {
            "type": "string",
            "minLength": 1,
            "maxLength": 1000
          },
          "conflict": {
            "type": "string",
            "minLength": 1,
            "maxLength": 1000
          },
          "choice": {
            "type": "string",
            "minLength": 1,
            "maxLength": 1000
          },
          "change": {
            "type": "string",
            "minLength": 1,
            "maxLength": 1000
          },
          "causesNext": {
            "type": "string",
            "minLength": 1,
            "maxLength": 1000
          },
          "estimatedShare": {
            "type": "number",
            "minimum": 0,
            "maximum": 1
          }
        }
      }
    },
    "setupPayoffs": {
      "type": "array",
      "maxItems": 32,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "setupBeatId",
          "payoffBeatId",
          "element",
          "status"
        ],
        "properties": {
          "setupBeatId": {
            "$ref": "common.schema.json#/$defs/identifier"
          },
          "payoffBeatId": {
            "$ref": "common.schema.json#/$defs/identifier"
          },
          "element": {
            "type": "string",
            "minLength": 1,
            "maxLength": 1000
          },
          "status": {
            "enum": [
              "planned",
              "resolved",
              "broken"
            ]
          }
        }
      }
    },
    "validation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "ordered",
        "causal",
        "escalating",
        "endingAnswersQuestion"
      ],
      "properties": {
        "ordered": {
          "const": true
        },
        "causal": {
          "const": true
        },
        "escalating": {
          "const": true
        },
        "endingAnswersQuestion": {
          "const": true
        }
      }
    }
  }
}
