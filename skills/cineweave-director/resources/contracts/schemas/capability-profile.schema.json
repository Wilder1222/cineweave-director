{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cineweave.dev/contracts/capability-profile.schema.json",
  "title": "CineWeave Adapter Capability Profile",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "kind",
    "contractVersion",
    "profileId",
    "title",
    "version",
    "status",
    "adapterId",
    "adapterClass",
    "skillReceipt",
    "capabilities",
    "evidenceRequirements",
    "knownLimits",
    "licenseProfileRefs",
    "matchingPolicy",
    "validation",
    "provenance"
  ],
  "properties": {
    "kind": {
      "const": "cineweave_codex_capability_profile"
    },
    "contractVersion": {
      "const": "2.0.0"
    },
    "profileId": {
      "$ref": "#/$defs/lowerId"
    },
    "title": {
      "type": "string",
      "minLength": 1,
      "maxLength": 240
    },
    "version": {
      "type": "integer",
      "minimum": 1
    },
    "status": {
      "enum": [
        "draft",
        "active",
        "deprecated",
        "retired"
      ]
    },
    "adapterId": {
      "$ref": "#/$defs/lowerId"
    },
    "adapterClass": {
      "enum": [
        "image_generation",
        "image_editing",
        "virtual_try_on",
        "relighting",
        "pose_guided",
        "layout_guided",
        "video_generation",
        "composite"
      ]
    },
    "skillReceipt": {
      "$ref": "#/$defs/skillReceipt"
    },
    "capabilities": {
      "type": "array",
      "minItems": 1,
      "maxItems": 64,
      "items": {
        "$ref": "#/$defs/capability"
      }
    },
    "evidenceRequirements": {
      "type": "array",
      "maxItems": 32,
      "items": {
        "$ref": "#/$defs/evidenceRequirement"
      }
    },
    "knownLimits": {
      "$ref": "#/$defs/stringList"
    },
    "licenseProfileRefs": {
      "type": "array",
      "minItems": 1,
      "maxItems": 24,
      "items": {
        "$ref": "#/$defs/contractRef"
      }
    },
    "matchingPolicy": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "hardRequirementPolicy",
        "partialSupportPolicy",
        "unknownCapabilityPolicy"
      ],
      "properties": {
        "hardRequirementPolicy": {
          "const": "block"
        },
        "partialSupportPolicy": {
          "enum": [
            "warn",
            "allow_with_review",
            "block"
          ]
        },
        "unknownCapabilityPolicy": {
          "enum": [
            "block",
            "warn"
          ]
        }
      }
    },
    "validation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "noEndpoint",
        "noCredentials",
        "capabilityIdsUnique",
        "licensesLinked"
      ],
      "properties": {
        "noEndpoint": {
          "const": true
        },
        "noCredentials": {
          "const": true
        },
        "capabilityIdsUnique": {
          "const": true
        },
        "licensesLinked": {
          "const": true
        }
      }
    },
    "provenance": {
      "$ref": "#/$defs/provenance"
    }
  },
  "$defs": {
    "skillReceipt": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "repository",
        "ref",
        "commit",
        "installedBy",
        "usedAt"
      ],
      "properties": {
        "repository": {
          "type": "string",
          "format": "uri",
          "pattern": "^https://(www\\.)?github\\.com/[^/]+/[^/]+(?:\\.git)?/?$"
        },
        "ref": {
          "type": "string",
          "minLength": 1,
          "maxLength": 240
        },
        "commit": {
          "type": "string",
          "pattern": "^[0-9a-fA-F]{7,64}$"
        },
        "contentHash": {
          "type": "string",
          "pattern": "^sha256:[0-9a-fA-F]{64}$"
        },
        "installedBy": {
          "const": "codex-environment"
        },
        "environmentId": {
          "type": "string",
          "maxLength": 240
        },
        "usedAt": {
          "type": "string",
          "format": "date-time"
        }
      }
    },
    "stableId": {
      "type": "string",
      "pattern": "^[a-zA-Z][a-zA-Z0-9._-]{1,159}$"
    },
    "lowerId": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9._-]{2,159}$"
    },
    "observationId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 160,
      "not": {
        "pattern": "(?:https?:|file:|[\\\\/?#])"
      }
    },
    "contentHash": {
      "type": "string",
      "pattern": "^sha256:[0-9a-fA-F]{64}$"
    },
    "stringList": {
      "type": "array",
      "minItems": 1,
      "maxItems": 32,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 1600
      }
    },
    "optionalStringList": {
      "type": "array",
      "maxItems": 32,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 1600
      }
    },
    "primitive": {
      "type": [
        "string",
        "number",
        "boolean",
        "null"
      ]
    },
    "provenance": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "source",
        "createdAt",
        "updatedAt",
        "changeLog"
      ],
      "properties": {
        "source": {
          "enum": [
            "user_authored",
            "codex_authored",
            "adapted",
            "imported",
            "suite_builtin"
          ]
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        },
        "parentId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 160
        },
        "changeLog": {
          "$ref": "#/$defs/stringList"
        }
      }
    },
    "versionedRef": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "id"
      ],
      "properties": {
        "kind": {
          "type": "string",
          "minLength": 1,
          "maxLength": 160
        },
        "id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 160
        },
        "version": {
          "type": "integer",
          "minimum": 1
        },
        "contentHash": {
          "$ref": "#/$defs/contentHash"
        },
        "observationIds": {
          "type": "array",
          "maxItems": 24,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/observationId"
          }
        }
      }
    },
    "contractRef": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "contentHash"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 160
        },
        "version": {
          "type": "integer",
          "minimum": 1
        },
        "contentHash": {
          "$ref": "#/$defs/contentHash"
        }
      }
    },
    "canvas": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "aspectRatio",
        "sizeClass"
      ],
      "properties": {
        "aspectRatio": {
          "type": "string",
          "pattern": "^[1-9][0-9]*:[1-9][0-9]*$"
        },
        "sizeClass": {
          "enum": [
            "square",
            "portrait",
            "landscape",
            "wide",
            "tall",
            "custom",
            "unspecified"
          ]
        },
        "pixelDimensions": {
          "type": "string",
          "pattern": "^[1-9][0-9]*x[1-9][0-9]*$"
        },
        "background": {
          "type": "string",
          "minLength": 1,
          "maxLength": 500
        }
      }
    },
    "capability": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "capabilityId",
        "support",
        "supportedScopes",
        "constraints"
      ],
      "properties": {
        "capabilityId": {
          "$ref": "common.schema.json#/$defs/identifier"
        },
        "support": {
          "enum": [
            "unsupported",
            "experimental",
            "partial",
            "strong"
          ]
        },
        "maxInputs": {
          "type": "integer",
          "minimum": 0,
          "maximum": 64
        },
        "maxSubjects": {
          "type": "integer",
          "minimum": 0,
          "maximum": 32
        },
        "supportedScopes": {
          "type": "array",
          "maxItems": 32,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 160
          }
        },
        "constraints": {
          "$ref": "#/$defs/optionalStringList"
        }
      }
    },
    "evidenceRequirement": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "capabilityId",
        "requiredRoles",
        "minimumConfidence"
      ],
      "properties": {
        "capabilityId": {
          "$ref": "common.schema.json#/$defs/identifier"
        },
        "requiredRoles": {
          "type": "array",
          "minItems": 1,
          "maxItems": 16,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 160
          }
        },
        "minimumConfidence": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        }
      }
    }
  }
}
