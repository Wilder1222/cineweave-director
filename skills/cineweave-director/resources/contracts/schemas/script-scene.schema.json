{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cineweave.dev/contracts/script-scene.schema.json",
  "title": "CineWeave Script Scene",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "kind",
    "contractVersion",
    "scriptSceneId",
    "version",
    "storyRef",
    "skillReceipt",
    "slugline",
    "scenePurpose",
    "participants",
    "entryState",
    "objective",
    "obstacle",
    "beats",
    "exitState",
    "continuity",
    "validation"
  ],
  "properties": {
    "kind": {
      "const": "cineweave_codex_script_scene"
    },
    "contractVersion": {
      "const": "2.2.0"
    },
    "scriptSceneId": {
      "$ref": "common.schema.json#/$defs/identifier"
    },
    "version": {
      "type": "integer",
      "minimum": 1
    },
    "storyRef": {
      "$ref": "common.schema.json#/$defs/contractRef"
    },
    "beatRefs": {
      "type": "array",
      "items": {
        "$ref": "common.schema.json#/$defs/identifier"
      },
      "maxItems": 12
    },
    "skillReceipt": {
      "$ref": "common.schema.json#/$defs/skillReceipt"
    },
    "slugline": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "interiorExterior",
        "location",
        "time"
      ],
      "properties": {
        "interiorExterior": {
          "enum": [
            "INT",
            "EXT",
            "INT_EXT"
          ]
        },
        "location": {
          "type": "string",
          "minLength": 1,
          "maxLength": 300
        },
        "time": {
          "type": "string",
          "minLength": 1,
          "maxLength": 160
        }
      }
    },
    "scenePurpose": {
      "type": "string",
      "minLength": 1,
      "maxLength": 1600
    },
    "participants": {
      "type": "array",
      "minItems": 1,
      "maxItems": 16,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "participantId",
          "role",
          "want",
          "tactic",
          "subtext"
        ],
        "properties": {
          "participantId": {
            "$ref": "common.schema.json#/$defs/identifier"
          },
          "characterRef": {
            "$ref": "common.schema.json#/$defs/contractRef"
          },
          "role": {
            "type": "string",
            "minLength": 1,
            "maxLength": 500
          },
          "want": {
            "type": "string",
            "minLength": 1,
            "maxLength": 800
          },
          "tactic": {
            "type": "string",
            "minLength": 1,
            "maxLength": 800
          },
          "subtext": {
            "type": "string",
            "minLength": 1,
            "maxLength": 1000
          }
        }
      }
    },
    "entryState": {
      "type": "string",
      "minLength": 1,
      "maxLength": 1200
    },
    "objective": {
      "type": "string",
      "minLength": 1,
      "maxLength": 1000
    },
    "obstacle": {
      "type": "string",
      "minLength": 1,
      "maxLength": 1000
    },
    "beats": {
      "type": "array",
      "minItems": 1,
      "maxItems": 40,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "order",
          "type",
          "action",
          "turn"
        ],
        "properties": {
          "order": {
            "type": "integer",
            "minimum": 1
          },
          "type": {
            "enum": [
              "action",
              "dialogue",
              "silence",
              "revelation",
              "decision"
            ]
          },
          "speakerId": {
            "$ref": "common.schema.json#/$defs/identifier"
          },
          "action": {
            "type": "string",
            "minLength": 1,
            "maxLength": 1600
          },
          "dialogue": {
            "type": "string",
            "maxLength": 2000
          },
          "subtext": {
            "type": "string",
            "maxLength": 1000
          },
          "turn": {
            "type": "string",
            "minLength": 1,
            "maxLength": 1000
          }
        }
      }
    },
    "exitState": {
      "type": "string",
      "minLength": 1,
      "maxLength": 1200
    },
    "continuity": {
      "$ref": "common.schema.json#/$defs/stringList"
    },
    "productionNotes": {
      "type": "array",
      "maxItems": 16,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 1000
      }
    },
    "validation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "sceneChangesState",
        "dialogueHasSubtext",
        "actionIsPlayable",
        "noCameraDirections"
      ],
      "properties": {
        "sceneChangesState": {
          "const": true
        },
        "dialogueHasSubtext": {
          "const": true
        },
        "actionIsPlayable": {
          "const": true
        },
        "noCameraDirections": {
          "const": true
        }
      }
    }
  }
}
