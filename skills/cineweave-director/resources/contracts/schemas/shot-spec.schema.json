{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cineweave.dev/contracts/shot-spec.schema.json",
  "title": "CineWeave 导演镜头规范",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "kind",
    "contractVersion",
    "shotSpecId",
    "version",
    "skillReceipt",
    "purpose",
    "dramaticBeat",
    "audienceAttention",
    "bindings",
    "blocking",
    "camera",
    "composition",
    "actionMoment",
    "endState",
    "continuity",
    "promptHandoff",
    "validation"
  ],
  "properties": {
    "kind": {
      "const": "cineweave_codex_shot_spec"
    },
    "contractVersion": {
      "const": "2.2.0"
    },
    "shotSpecId": {
      "$ref": "common.schema.json#/$defs/identifier"
    },
    "version": {
      "type": "integer",
      "minimum": 1
    },
    "scriptSceneRef": {
      "$ref": "common.schema.json#/$defs/contractRef"
    },
    "beatIds": {
      "type": "array",
      "maxItems": 8,
      "items": {
        "$ref": "common.schema.json#/$defs/identifier"
      }
    },
    "actionSequenceRef": {
      "$ref": "common.schema.json#/$defs/contractRef"
    },
    "actionBeatIds": {
      "type": "array",
      "minItems": 1,
      "maxItems": 16,
      "uniqueItems": true,
      "items": {
        "$ref": "common.schema.json#/$defs/identifier"
      }
    },
    "skillReceipt": {
      "$ref": "common.schema.json#/$defs/skillReceipt"
    },
    "purpose": {
      "type": "string",
      "minLength": 1,
      "maxLength": 1200
    },
    "dramaticBeat": {
      "type": "string",
      "minLength": 1,
      "maxLength": 1200
    },
    "audienceAttention": {
      "type": "array",
      "minItems": 1,
      "maxItems": 5,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 600
      }
    },
    "bindings": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "characters"
      ],
      "properties": {
        "characters": {
          "type": "array",
          "maxItems": 12,
          "items": {
            "$ref": "common.schema.json#/$defs/contractRef"
          }
        },
        "scene": {
          "$ref": "common.schema.json#/$defs/contractRef"
        },
        "interactionConstraints": {
          "$ref": "common.schema.json#/$defs/contractRef"
        }
      }
    },
    "blocking": {
      "type": "array",
      "minItems": 1,
      "maxItems": 16,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "subjectRef",
          "startZone",
          "action",
          "endZone",
          "eyeline",
          "weightAndContact"
        ],
        "properties": {
          "subjectRef": {
            "type": "string",
            "minLength": 1,
            "maxLength": 240
          },
          "startZone": {
            "type": "string",
            "minLength": 1,
            "maxLength": 500
          },
          "action": {
            "type": "string",
            "minLength": 1,
            "maxLength": 1000
          },
          "endZone": {
            "type": "string",
            "minLength": 1,
            "maxLength": 500
          },
          "eyeline": {
            "type": "string",
            "minLength": 1,
            "maxLength": 500
          },
          "weightAndContact": {
            "type": "string",
            "minLength": 1,
            "maxLength": 1000
          }
        }
      }
    },
    "camera": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "shotScale",
        "position",
        "height",
        "angle",
        "focalLengthMm",
        "perspectiveIntent",
        "focusTarget",
        "depthOfField",
        "axisSide",
        "movementIntent"
      ],
      "properties": {
        "shotScale": {
          "type": "string",
          "minLength": 1,
          "maxLength": 240
        },
        "position": {
          "type": "string",
          "minLength": 1,
          "maxLength": 600
        },
        "height": {
          "type": "string",
          "minLength": 1,
          "maxLength": 300
        },
        "angle": {
          "type": "string",
          "minLength": 1,
          "maxLength": 300
        },
        "focalLengthMm": {
          "type": "number",
          "minimum": 8,
          "maximum": 1200
        },
        "perspectiveIntent": {
          "type": "string",
          "minLength": 1,
          "maxLength": 600
        },
        "focusTarget": {
          "type": "string",
          "minLength": 1,
          "maxLength": 500
        },
        "depthOfField": {
          "type": "string",
          "minLength": 1,
          "maxLength": 500
        },
        "axisSide": {
          "type": "string",
          "minLength": 1,
          "maxLength": 300
        },
        "movementIntent": {
          "type": "string",
          "minLength": 1,
          "maxLength": 800
        }
      }
    },
    "composition": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "layout",
        "foreground",
        "midground",
        "background",
        "negativeSpace",
        "visualHierarchy"
      ],
      "properties": {
        "layout": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1000
        },
        "foreground": {
          "type": "string",
          "minLength": 1,
          "maxLength": 800
        },
        "midground": {
          "type": "string",
          "minLength": 1,
          "maxLength": 800
        },
        "background": {
          "type": "string",
          "minLength": 1,
          "maxLength": 800
        },
        "negativeSpace": {
          "type": "string",
          "minLength": 1,
          "maxLength": 600
        },
        "visualHierarchy": {
          "type": "string",
          "minLength": 1,
          "maxLength": 800
        }
      }
    },
    "lightingPlanRef": {
      "$ref": "common.schema.json#/$defs/contractRef",
      "deprecated": true,
      "description": "禁止使用旧式反向引用。ShotLightingPlan 属于下游，应由它引用此 ShotSpec。"
    },
    "temporalSpecRef": {
      "$ref": "common.schema.json#/$defs/contractRef",
      "deprecated": true,
      "description": "禁止使用旧式反向引用。TemporalSpec 属于下游，应由它引用此 ShotSpec。"
    },
    "performanceTimelineRefs": {
      "type": "array",
      "maxItems": 12,
      "items": {
        "$ref": "common.schema.json#/$defs/contractRef"
      }
    },
    "actionMoment": {
      "type": "string",
      "minLength": 1,
      "maxLength": 1200
    },
    "endState": {
      "type": "string",
      "minLength": 1,
      "maxLength": 1000
    },
    "continuity": {
      "$ref": "common.schema.json#/$defs/stringList"
    },
    "promptHandoff": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "primaryTarget",
        "mustPreserve",
        "mayVary",
        "unresolved"
      ],
      "properties": {
        "primaryTarget": {
          "type": "string",
          "minLength": 1,
          "maxLength": 800
        },
        "mustPreserve": {
          "$ref": "common.schema.json#/$defs/stringList"
        },
        "mayVary": {
          "type": "array",
          "maxItems": 16,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 800
          }
        },
        "unresolved": {
          "type": "array",
          "maxItems": 16,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 800
          }
        },
        "actionBreakdown": {
          "$ref": "#/$defs/actionBreakdown"
        }
      }
    },
    "validation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "onePurpose",
        "oneDominantCameraIdea",
        "bindingsExact",
        "axisCoherent",
        "actionPlayable",
        "endStateStable"
      ],
      "properties": {
        "onePurpose": {
          "const": true
        },
        "oneDominantCameraIdea": {
          "const": true
        },
        "bindingsExact": {
          "const": true
        },
        "axisCoherent": {
          "const": true
        },
        "actionPlayable": {
          "const": true
        },
        "endStateStable": {
          "const": true
        }
      }
    },
    "cameraLanguageDecision": {
      "$ref": "#/$defs/cameraLanguageDecision",
      "description": "影视叙事镜头的选镜理由与可见目标。v2.2 兼容增量字段；新镜头规范工作流必须填写并经逐镜检查器验收，旧版存档可不含此字段。"
    }
  },
  "$defs": {
    "actionBreakdown": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "weaponDetails",
        "technique",
        "trajectory",
        "exchange",
        "contactAndResult",
        "continuity"
      ],
      "properties": {
        "weaponDetails": {
          "type": "array",
          "minItems": 1,
          "maxItems": 8,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "weaponRef",
              "name",
              "type",
              "characteristics",
              "currentState"
            ],
            "properties": {
              "weaponRef": {
                "type": "string",
                "minLength": 1,
                "maxLength": 240
              },
              "name": {
                "type": "string",
                "minLength": 1,
                "maxLength": 240
              },
              "type": {
                "type": "string",
                "minLength": 1,
                "maxLength": 240
              },
              "characteristics": {
                "type": "array",
                "minItems": 1,
                "maxItems": 8,
                "items": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 500
                }
              },
              "currentState": {
                "type": "string",
                "minLength": 1,
                "maxLength": 800
              }
            }
          }
        },
        "technique": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1600
        },
        "trajectory": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1600
        },
        "exchange": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1600
        },
        "contactAndResult": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1200
        },
        "continuity": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1200
        }
      }
    },
    "cameraLanguageDecision": {
      "type": "object",
      "additionalProperties": false,
      "description": "技法决策不替代 camera、composition 和 TemporalSpec 的机位／运动／焦点权威。固定镜头同样可以是积极选择。",
      "required": [
        "primaryTechniqueId",
        "supportingTechniqueIds",
        "narrativeReason",
        "audiencePayoff",
        "trigger",
        "cameraMode",
        "focusMode",
        "exitMatch"
      ],
      "properties": {
        "primaryTechniqueId": {
          "type": "string",
          "pattern": "^(?:K0[1-7]|C0[1-9]|M(?:0[1-9]|1[0-2])|F0[1-3]|E0[1-4]|neutral_static)$",
          "description": "当前项目 7 个核心、28 个扩展 ID 或中性固定出口 neutral_static。"
        },
        "supportingTechniqueIds": {
          "type": "array",
          "uniqueItems": true,
          "maxItems": 8,
          "items": {
            "type": "string",
            "pattern": "^(?:K0[1-7]|C0[1-9]|M(?:0[1-9]|1[0-2])|F0[1-3]|E0[1-4])$"
          }
        },
        "narrativeReason": {
          "type": "string",
          "minLength": 1,
          "maxLength": 800
        },
        "audiencePayoff": {
          "type": "string",
          "minLength": 1,
          "maxLength": 800
        },
        "trigger": {
          "type": "string",
          "minLength": 1,
          "maxLength": 600
        },
        "cameraMode": {
          "enum": [
            "static",
            "moving",
            "compound"
          ]
        },
        "focusMode": {
          "enum": [
            "hold",
            "follow",
            "rack"
          ]
        },
        "noMotionReason": {
          "type": "string",
          "minLength": 1,
          "maxLength": 600
        },
        "focusTargetEnd": {
          "type": "string",
          "minLength": 1,
          "maxLength": 500
        },
        "exitMatch": {
          "type": "string",
          "minLength": 1,
          "maxLength": 800
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "cameraMode": {
                "const": "static"
              }
            },
            "required": [
              "cameraMode"
            ]
          },
          "then": {
            "required": [
              "noMotionReason"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "focusMode": {
                "const": "rack"
              }
            },
            "required": [
              "focusMode"
            ]
          },
          "then": {
            "required": [
              "focusTargetEnd"
            ]
          }
        }
      ]
    }
  },
  "not": {
    "anyOf": [
      {
        "required": [
          "lightingPlanRef"
        ]
      },
      {
        "required": [
          "temporalSpecRef"
        ]
      }
    ]
  },
  "dependentRequired": {
    "actionSequenceRef": [
      "actionBeatIds"
    ],
    "actionBeatIds": [
      "actionSequenceRef"
    ]
  }
}
