{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cineweave.dev/contracts/representation-binding.schema.json",
  "title": "CineWeave Representation Binding",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "kind",
    "contractVersion",
    "bindingId",
    "version",
    "status",
    "characterSpecRef",
    "stylePackageRef",
    "mapping",
    "preserveSemanticAnchorIds",
    "allowedTransformations",
    "forbiddenTransformations",
    "activationGate",
    "planningBoundary",
    "validation",
    "skillReceipt"
  ],
  "properties": {
    "kind": {
      "const": "cineweave_codex_representation_binding"
    },
    "contractVersion": {
      "const": "2.5.0"
    },
    "bindingId": {
      "$ref": "#/$defs/lowerId"
    },
    "version": {
      "type": "integer",
      "minimum": 1
    },
    "status": {
      "enum": [
        "draft",
        "active",
        "deprecated",
        "archived"
      ]
    },
    "characterSpecRef": {
      "$ref": "#/$defs/characterRef"
    },
    "morphologySpecRef": {
      "$ref": "#/$defs/morphologyRef"
    },
    "stylePackageRef": {
      "$ref": "#/$defs/styleRef"
    },
    "mapping": {
      "type": "array",
      "minItems": 4,
      "maxItems": 32,
      "items": {
        "$ref": "#/$defs/mappingRule"
      }
    },
    "preserveSemanticAnchorIds": {
      "type": "array",
      "minItems": 3,
      "maxItems": 16,
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/lowerId"
      }
    },
    "allowedTransformations": {
      "$ref": "#/$defs/stringList"
    },
    "forbiddenTransformations": {
      "$ref": "#/$defs/stringList"
    },
    "activationGate": {
      "$ref": "#/$defs/activationGate"
    },
    "planningBoundary": {
      "$ref": "#/$defs/planningBoundary"
    },
    "validation": {
      "$ref": "#/$defs/validation"
    },
    "skillReceipt": {
      "$ref": "#/$defs/skillReceipt"
    }
  },
  "$defs": {
    "lowerId": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9._-]{2,159}$"
    },
    "contentHash": {
      "type": "string",
      "pattern": "^sha256:[0-9a-fA-F]{64}$"
    },
    "stringList": {
      "type": "array",
      "minItems": 1,
      "maxItems": 48,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 1200
      }
    },
    "scaleList": {
      "type": "array",
      "minItems": 1,
      "maxItems": 5,
      "uniqueItems": true,
      "items": {
        "enum": [
          "extreme_closeup",
          "closeup",
          "medium",
          "fullbody",
          "wide"
        ]
      }
    },
    "typedRef": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "id",
        "version",
        "contentHash"
      ],
      "properties": {
        "kind": {
          "type": "string",
          "minLength": 1,
          "maxLength": 160
        },
        "id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 160
        },
        "version": {
          "type": "integer",
          "minimum": 1
        },
        "contentHash": {
          "$ref": "#/$defs/contentHash"
        }
      }
    },
    "characterRef": {
      "allOf": [
        {
          "$ref": "#/$defs/typedRef"
        },
        {
          "properties": {
            "kind": {
              "const": "cineweave_codex_character_spec"
            }
          }
        }
      ]
    },
    "morphologyRef": {
      "allOf": [
        {
          "$ref": "#/$defs/typedRef"
        },
        {
          "properties": {
            "kind": {
              "const": "cineweave_codex_character_morphology_spec"
            }
          }
        }
      ]
    },
    "styleRef": {
      "allOf": [
        {
          "$ref": "#/$defs/typedRef"
        },
        {
          "properties": {
            "kind": {
              "const": "cineweave_codex_style_package"
            }
          }
        }
      ]
    },
    "mappingRule": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "mappingId",
        "scope",
        "sourceSemantics",
        "representationRule",
        "abstractionLevel",
        "preserveAnchorIds",
        "allowedTransformations",
        "forbiddenTransformations",
        "visibleAt"
      ],
      "properties": {
        "mappingId": {
          "$ref": "#/$defs/lowerId"
        },
        "scope": {
          "enum": [
            "face_geometry",
            "eyes",
            "brows",
            "nose",
            "mouth",
            "marks",
            "body_proportion",
            "silhouette",
            "surface",
            "hair",
            "makeup",
            "costume",
            "accessory",
            "performance",
            "motion"
          ]
        },
        "sourceSemantics": {
          "$ref": "#/$defs/stringList"
        },
        "representationRule": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1600
        },
        "abstractionLevel": {
          "enum": [
            "literal",
            "restrained",
            "moderate",
            "high",
            "symbolic"
          ]
        },
        "preserveAnchorIds": {
          "type": "array",
          "minItems": 1,
          "maxItems": 16,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/lowerId"
          }
        },
        "allowedTransformations": {
          "$ref": "#/$defs/stringList"
        },
        "forbiddenTransformations": {
          "$ref": "#/$defs/stringList"
        },
        "visibleAt": {
          "$ref": "#/$defs/scaleList"
        }
      }
    },
    "activationGate": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status",
        "humanApprovalRequired",
        "crossRepresentationReviewRequired",
        "validationPassed"
      ],
      "properties": {
        "status": {
          "enum": [
            "pending",
            "approved",
            "rejected"
          ]
        },
        "humanApprovalRequired": {
          "const": true
        },
        "crossRepresentationReviewRequired": {
          "const": true
        },
        "validationPassed": {
          "type": "boolean"
        },
        "approvalRef": {
          "$ref": "#/$defs/typedRef"
        }
      }
    },
    "planningBoundary": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "providerNeutral",
        "generatesMedia",
        "containsProviderWeights",
        "humanApprovalRequired"
      ],
      "properties": {
        "providerNeutral": {
          "const": true
        },
        "generatesMedia": {
          "const": false
        },
        "containsProviderWeights": {
          "const": false
        },
        "humanApprovalRequired": {
          "const": true
        }
      }
    },
    "validation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "exactRefsRequired",
        "characterOwnsIdentity",
        "styleDoesNotMutateCanon",
        "scaleAware",
        "noProviderWeights",
        "noBiometricInference",
        "noGenerationClaim"
      ],
      "properties": {
        "exactRefsRequired": {
          "const": true
        },
        "characterOwnsIdentity": {
          "const": true
        },
        "styleDoesNotMutateCanon": {
          "const": true
        },
        "scaleAware": {
          "const": true
        },
        "noProviderWeights": {
          "const": true
        },
        "noBiometricInference": {
          "const": true
        },
        "noGenerationClaim": {
          "const": true
        }
      }
    },
    "skillReceipt": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "repository",
        "ref",
        "commit",
        "installedBy",
        "usedAt"
      ],
      "properties": {
        "repository": {
          "type": "string",
          "format": "uri",
          "pattern": "^https://(www\\.)?github\\.com/[^/]+/[^/]+(?:\\.git)?/?$"
        },
        "ref": {
          "type": "string",
          "minLength": 1,
          "maxLength": 240
        },
        "commit": {
          "type": "string",
          "pattern": "^[0-9a-fA-F]{7,64}$"
        },
        "contentHash": {
          "$ref": "#/$defs/contentHash"
        },
        "installedBy": {
          "const": "codex-environment"
        },
        "environmentId": {
          "type": "string",
          "maxLength": 240
        },
        "usedAt": {
          "type": "string",
          "format": "date-time"
        }
      }
    }
  }
}
