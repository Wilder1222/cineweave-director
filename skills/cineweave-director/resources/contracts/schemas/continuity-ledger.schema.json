{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cineweave.dev/contracts/continuity-ledger.schema.json",
  "title": "CineWeave Story Continuity Ledger",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "kind",
    "contractVersion",
    "ledgerId",
    "version",
    "storyRef",
    "skillReceipt",
    "entries",
    "conflicts",
    "validation"
  ],
  "properties": {
    "kind": {
      "const": "cineweave_codex_continuity_ledger"
    },
    "contractVersion": {
      "const": "2.2.0"
    },
    "ledgerId": {
      "$ref": "common.schema.json#/$defs/identifier"
    },
    "version": {
      "type": "integer",
      "minimum": 1
    },
    "storyRef": {
      "$ref": "common.schema.json#/$defs/contractRef"
    },
    "skillReceipt": {
      "$ref": "common.schema.json#/$defs/skillReceipt"
    },
    "entries": {
      "type": "array",
      "minItems": 1,
      "maxItems": 256,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "entryId",
          "entityType",
          "entityId",
          "factPath",
          "value",
          "sourceRefs",
          "status"
        ],
        "properties": {
          "entryId": {
            "$ref": "common.schema.json#/$defs/identifier"
          },
          "entityType": {
            "enum": [
              "story",
              "character",
              "scene",
              "prop",
              "relationship",
              "timeline",
              "world"
            ]
          },
          "entityId": {
            "$ref": "common.schema.json#/$defs/identifier"
          },
          "factPath": {
            "type": "string",
            "minLength": 1,
            "maxLength": 300
          },
          "value": {
            "type": [
              "string",
              "number",
              "boolean",
              "null"
            ]
          },
          "sourceRefs": {
            "type": "array",
            "minItems": 1,
            "maxItems": 16,
            "items": {
              "$ref": "common.schema.json#/$defs/contractRef"
            }
          },
          "validFrom": {
            "type": "string",
            "maxLength": 160
          },
          "validUntil": {
            "type": "string",
            "maxLength": 160
          },
          "status": {
            "enum": [
              "active",
              "changed",
              "resolved",
              "unknown"
            ]
          }
        }
      }
    },
    "conflicts": {
      "type": "array",
      "maxItems": 64,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "conflictId",
          "entryIds",
          "severity",
          "description",
          "resolutionStatus"
        ],
        "properties": {
          "conflictId": {
            "$ref": "common.schema.json#/$defs/identifier"
          },
          "entryIds": {
            "type": "array",
            "minItems": 2,
            "maxItems": 8,
            "items": {
              "$ref": "common.schema.json#/$defs/identifier"
            }
          },
          "severity": {
            "enum": [
              "blocking",
              "warning"
            ]
          },
          "description": {
            "type": "string",
            "minLength": 1,
            "maxLength": 1200
          },
          "resolutionStatus": {
            "enum": [
              "open",
              "resolved",
              "accepted_variation"
            ]
          }
        }
      }
    },
    "validation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "exactSources",
        "noSilentOverwrite",
        "blockingConflictsVisible"
      ],
      "properties": {
        "exactSources": {
          "const": true
        },
        "noSilentOverwrite": {
          "const": true
        },
        "blockingConflictsVisible": {
          "const": true
        }
      }
    }
  }
}
