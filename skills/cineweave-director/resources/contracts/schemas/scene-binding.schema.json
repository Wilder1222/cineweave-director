{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cineweave.dev/contracts/scene-binding.schema.json",
  "title": "CineWeave Shot Scene Binding",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "kind",
    "contractVersion",
    "bindingId",
    "sceneSpecRef",
    "roleInShot",
    "activeAnchorIds",
    "activeZoneIds",
    "cameraPlacement",
    "spatialRelations",
    "depthPlan",
    "lightingState",
    "materialResponse",
    "preserve",
    "allowedDeviations",
    "forbiddenChanges"
  ],
  "properties": {
    "kind": {
      "const": "scene_binding"
    },
    "contractVersion": {
      "const": "2.0.0"
    },
    "bindingId": {
      "$ref": "#/$defs/stableId"
    },
    "sceneSpecRef": {
      "$ref": "#/$defs/sceneSpecRef"
    },
    "sceneStateRef": {
      "$ref": "#/$defs/sceneStateRef"
    },
    "roleInShot": {
      "enum": [
        "primary_environment",
        "supporting_environment",
        "background",
        "abstracted"
      ]
    },
    "activeAnchorIds": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/stableId"
      },
      "minItems": 1,
      "maxItems": 24,
      "uniqueItems": true
    },
    "activeZoneIds": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/stableId"
      },
      "minItems": 1,
      "maxItems": 24,
      "uniqueItems": true
    },
    "cameraPlacement": {
      "$ref": "#/$defs/cameraPlacement"
    },
    "spatialRelations": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/spatialRelation"
      },
      "minItems": 1,
      "maxItems": 24
    },
    "depthPlan": {
      "$ref": "#/$defs/depthPlan"
    },
    "lightingState": {
      "$ref": "#/$defs/lightingState"
    },
    "materialResponse": {
      "$ref": "#/$defs/stringList"
    },
    "referenceObservationIds": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/observationId"
      },
      "maxItems": 24,
      "uniqueItems": true
    },
    "continuityFromBindingId": {
      "$ref": "#/$defs/stableId"
    },
    "preserve": {
      "$ref": "#/$defs/stringList"
    },
    "allowedDeviations": {
      "$ref": "#/$defs/stringList"
    },
    "forbiddenChanges": {
      "$ref": "#/$defs/stringList"
    },
    "interactionConstraints": {
      "$ref": "interaction-constraint-set.schema.json#/$defs/interactionConstraints"
    },
    "interactionConstraintSetRef": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "interactionSetId",
        "contentHash"
      ],
      "properties": {
        "interactionSetId": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9._-]{2,159}$"
        },
        "contentHash": {
          "type": "string",
          "pattern": "^sha256:[0-9a-fA-F]{64}$"
        }
      }
    }
  },
  "$defs": {
    "skillReceipt": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "repository": {
          "type": "string",
          "format": "uri",
          "pattern": "^https://(www\\.)?github\\.com/[^/]+/[^/]+(?:\\.git)?/?$"
        },
        "ref": {
          "type": "string",
          "minLength": 1,
          "maxLength": 240
        },
        "commit": {
          "type": "string",
          "pattern": "^[0-9a-fA-F]{7,64}$"
        },
        "contentHash": {
          "type": "string",
          "pattern": "^sha256:[0-9a-fA-F]{64}$"
        },
        "installedBy": {
          "const": "codex-environment"
        },
        "environmentId": {
          "type": "string",
          "maxLength": 240
        },
        "usedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": [
        "repository",
        "ref",
        "commit",
        "installedBy",
        "usedAt"
      ]
    },
    "stableId": {
      "type": "string",
      "pattern": "^[a-zA-Z][a-zA-Z0-9._-]{1,159}$"
    },
    "lowerId": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9._-]{2,159}$"
    },
    "observationId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 160,
      "not": {
        "pattern": "(?:https?:|file:|[\\\\/?#])"
      }
    },
    "contentHash": {
      "type": "string",
      "pattern": "^sha256:[0-9a-fA-F]{64}$"
    },
    "stringList": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 1200
      },
      "minItems": 1,
      "maxItems": 24
    },
    "optionalStringList": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 1200
      },
      "maxItems": 24
    },
    "characterSpecRef": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "characterId": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9._-]{2,159}$"
        },
        "version": {
          "type": "integer",
          "minimum": 1
        },
        "contentHash": {
          "type": "string",
          "pattern": "^sha256:[0-9a-fA-F]{64}$"
        }
      },
      "required": [
        "characterId",
        "version",
        "contentHash"
      ]
    },
    "appearanceStateRef": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "appearanceStateId": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9._-]{2,159}$"
        },
        "version": {
          "type": "integer",
          "minimum": 1
        },
        "contentHash": {
          "type": "string",
          "pattern": "^sha256:[0-9a-fA-F]{64}$"
        }
      },
      "required": [
        "appearanceStateId",
        "version",
        "contentHash"
      ]
    },
    "sceneSpecRef": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "sceneId": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9._-]{2,159}$"
        },
        "version": {
          "type": "integer",
          "minimum": 1
        },
        "contentHash": {
          "type": "string",
          "pattern": "^sha256:[0-9a-fA-F]{64}$"
        }
      },
      "required": [
        "sceneId",
        "version",
        "contentHash"
      ]
    },
    "sceneStateRef": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "sceneStateId": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9._-]{2,159}$"
        },
        "version": {
          "type": "integer",
          "minimum": 1
        },
        "contentHash": {
          "type": "string",
          "pattern": "^sha256:[0-9a-fA-F]{64}$"
        }
      },
      "required": [
        "sceneStateId",
        "version",
        "contentHash"
      ]
    },
    "approvalGate": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "requiresHumanApproval": {
          "const": true
        },
        "status": {
          "enum": [
            "planned",
            "approved",
            "blocked",
            "rejected"
          ]
        },
        "approvedBy": {
          "type": "string",
          "minLength": 1,
          "maxLength": 240
        },
        "approvedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": [
        "requiresHumanApproval",
        "status"
      ]
    },
    "provenance": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "source": {
          "enum": [
            "user_authored",
            "codex_authored",
            "adapted",
            "imported",
            "migrated"
          ]
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        },
        "parentId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 160
        },
        "changeLog": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 1200
          },
          "minItems": 1,
          "maxItems": 24
        }
      },
      "required": [
        "source",
        "createdAt",
        "updatedAt",
        "changeLog"
      ]
    },
    "cameraPlacement": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "cameraAnchorId": {
          "$ref": "#/$defs/stableId"
        },
        "zoneId": {
          "$ref": "#/$defs/stableId"
        },
        "axisId": {
          "$ref": "#/$defs/stableId"
        },
        "side": {
          "enum": [
            "A",
            "B",
            "on_axis",
            "not_applicable"
          ]
        },
        "height": {
          "type": "string",
          "minLength": 1,
          "maxLength": 500
        },
        "orientation": {
          "type": "string",
          "minLength": 1,
          "maxLength": 800
        }
      },
      "required": [
        "cameraAnchorId",
        "zoneId",
        "axisId",
        "side",
        "height",
        "orientation"
      ]
    },
    "spatialRelation": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "subjectRef": {
          "type": "string",
          "minLength": 1,
          "maxLength": 240
        },
        "zoneId": {
          "$ref": "#/$defs/stableId"
        },
        "relation": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1200
        },
        "screenDirection": {
          "type": "string",
          "minLength": 1,
          "maxLength": 500
        },
        "eyelineTarget": {
          "type": "string",
          "minLength": 1,
          "maxLength": 500
        }
      },
      "required": [
        "subjectRef",
        "zoneId",
        "relation",
        "screenDirection",
        "eyelineTarget"
      ]
    },
    "depthPlan": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "foreground": {
          "$ref": "#/$defs/stringList"
        },
        "midground": {
          "$ref": "#/$defs/stringList"
        },
        "background": {
          "$ref": "#/$defs/stringList"
        }
      },
      "required": [
        "foreground",
        "midground",
        "background"
      ]
    },
    "lightingState": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "key": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1200
        },
        "fill": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1200
        },
        "practicals": {
          "$ref": "#/$defs/stringList"
        },
        "shadowDirection": {
          "type": "string",
          "minLength": 1,
          "maxLength": 800
        },
        "atmosphere": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1200
        }
      },
      "required": [
        "key",
        "fill",
        "practicals",
        "shadowDirection",
        "atmosphere"
      ]
    }
  }
}
