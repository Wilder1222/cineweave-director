{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cineweave.dev/contracts/character-morphology-spec.schema.json",
  "title": "CineWeave Character Morphology Specification",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "kind",
    "contractVersion",
    "worldId",
    "morphologyId",
    "version",
    "status",
    "identitySource",
    "inputModes",
    "axes",
    "relations",
    "constraintPolicy",
    "neutralFixture",
    "identityLockGate",
    "planningBoundary",
    "validation",
    "skillReceipt",
    "provenance"
  ],
  "properties": {
    "kind": {
      "const": "cineweave_codex_character_morphology_spec"
    },
    "contractVersion": {
      "const": "2.5.0"
    },
    "worldId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 160
    },
    "morphologyId": {
      "$ref": "#/$defs/lowerId"
    },
    "version": {
      "type": "integer",
      "minimum": 1
    },
    "status": {
      "enum": [
        "draft",
        "reviewing",
        "approved",
        "superseded",
        "archived"
      ]
    },
    "characterExplorationBriefRef": {
      "$ref": "#/$defs/exactRef"
    },
    "identitySource": {
      "enum": [
        "fictional_original",
        "user_authorized_likeness",
        "licensed_character",
        "public_domain"
      ]
    },
    "inputModes": {
      "type": "array",
      "minItems": 1,
      "maxItems": 5,
      "uniqueItems": true,
      "items": {
        "enum": [
          "natural_language",
          "visual_cards",
          "semantic_sliders",
          "role_scoped_reference",
          "a_b_preference"
        ]
      }
    },
    "axes": {
      "type": "array",
      "minItems": 6,
      "maxItems": 128,
      "items": {
        "$ref": "#/$defs/axis"
      }
    },
    "relations": {
      "type": "array",
      "minItems": 2,
      "maxItems": 64,
      "items": {
        "$ref": "#/$defs/relation"
      }
    },
    "constraintPolicy": {
      "$ref": "#/$defs/constraintPolicy"
    },
    "referenceEvidence": {
      "type": "array",
      "maxItems": 24,
      "items": {
        "$ref": "#/$defs/referenceEvidence"
      }
    },
    "neutralFixture": {
      "$ref": "#/$defs/neutralFixture"
    },
    "identityLockGate": {
      "$ref": "#/$defs/identityLockGate"
    },
    "planningBoundary": {
      "$ref": "#/$defs/planningBoundary"
    },
    "validation": {
      "$ref": "#/$defs/validation"
    },
    "skillReceipt": {
      "$ref": "#/$defs/skillReceipt"
    },
    "provenance": {
      "$ref": "#/$defs/provenance"
    }
  },
  "$defs": {
    "lowerId": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9._-]{2,159}$"
    },
    "contentHash": {
      "type": "string",
      "pattern": "^sha256:[0-9a-fA-F]{64}$"
    },
    "stringList": {
      "type": "array",
      "minItems": 1,
      "maxItems": 48,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 1200
      }
    },
    "optionalStringList": {
      "type": "array",
      "maxItems": 48,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 1200
      }
    },
    "exactRef": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "id",
        "version",
        "contentHash"
      ],
      "properties": {
        "kind": {
          "type": "string",
          "minLength": 1,
          "maxLength": 160
        },
        "id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 160
        },
        "version": {
          "type": "integer",
          "minimum": 1
        },
        "contentHash": {
          "$ref": "#/$defs/contentHash"
        }
      }
    },
    "axis": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "axisId",
        "region",
        "featurePath",
        "value",
        "semanticLabel",
        "observableMeaning",
        "lock",
        "variationRadius"
      ],
      "properties": {
        "axisId": {
          "$ref": "#/$defs/lowerId"
        },
        "region": {
          "enum": [
            "face",
            "body"
          ]
        },
        "featurePath": {
          "type": "string",
          "pattern": "^(?:face|body)\\.[a-z][a-z0-9_]*(?:\\.[a-z][a-z0-9_]*)*$",
          "maxLength": 240
        },
        "value": {
          "type": "number",
          "minimum": -1,
          "maximum": 1
        },
        "semanticLabel": {
          "type": "string",
          "minLength": 1,
          "maxLength": 240
        },
        "observableMeaning": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1200
        },
        "lock": {
          "enum": [
            "hard",
            "soft",
            "free"
          ]
        },
        "variationRadius": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "evidenceObservationIds": {
          "type": "array",
          "maxItems": 8,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/lowerId"
          }
        }
      }
    },
    "relation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "relationId",
        "type",
        "memberAxisIds",
        "semanticConstraint",
        "priority"
      ],
      "properties": {
        "relationId": {
          "$ref": "#/$defs/lowerId"
        },
        "type": {
          "enum": [
            "ratio",
            "spacing",
            "alignment",
            "order",
            "transition",
            "asymmetry"
          ]
        },
        "memberAxisIds": {
          "type": "array",
          "minItems": 2,
          "maxItems": 8,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/lowerId"
          }
        },
        "semanticConstraint": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1200
        },
        "priority": {
          "enum": [
            "blocking",
            "important",
            "advisory"
          ]
        }
      }
    },
    "constraintPolicy": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "anatomical",
        "relational",
        "lockRules",
        "samplingRules"
      ],
      "properties": {
        "anatomical": {
          "$ref": "#/$defs/stringList"
        },
        "relational": {
          "$ref": "#/$defs/stringList"
        },
        "lockRules": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "hardBlocksMutation",
            "softRequiresReview",
            "freeMayExplore"
          ],
          "properties": {
            "hardBlocksMutation": {
              "const": true
            },
            "softRequiresReview": {
              "const": true
            },
            "freeMayExplore": {
              "const": true
            }
          }
        },
        "samplingRules": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "nearbyOnly",
            "onePrimaryAxisPerRound",
            "respectVariationRadius"
          ],
          "properties": {
            "nearbyOnly": {
              "const": true
            },
            "onePrimaryAxisPerRound": {
              "const": true
            },
            "respectVariationRadius": {
              "const": true
            }
          }
        }
      }
    },
    "referenceEvidence": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "observationRef",
        "scope",
        "transfer",
        "excludedUses"
      ],
      "properties": {
        "observationRef": {
          "$ref": "#/$defs/exactRef"
        },
        "scope": {
          "enum": [
            "face_morphology",
            "body_morphology",
            "surface",
            "asymmetry"
          ]
        },
        "transfer": {
          "enum": [
            "borrow_observable_semantics",
            "preserve_authorized_likeness",
            "validation_only"
          ]
        },
        "excludedUses": {
          "$ref": "#/$defs/stringList"
        }
      }
    },
    "neutralFixture": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "views",
        "expression",
        "grooming",
        "wardrobe",
        "camera",
        "lighting",
        "background",
        "fixedAcrossViews"
      ],
      "properties": {
        "views": {
          "type": "array",
          "minItems": 3,
          "maxItems": 5,
          "uniqueItems": true,
          "items": {
            "enum": [
              "front",
              "three_quarter_left",
              "three_quarter_right",
              "profile_left",
              "profile_right"
            ]
          }
        },
        "expression": {
          "type": "string",
          "minLength": 1,
          "maxLength": 800
        },
        "grooming": {
          "type": "string",
          "minLength": 1,
          "maxLength": 800
        },
        "wardrobe": {
          "type": "string",
          "minLength": 1,
          "maxLength": 800
        },
        "camera": {
          "type": "string",
          "minLength": 1,
          "maxLength": 800
        },
        "lighting": {
          "type": "string",
          "minLength": 1,
          "maxLength": 800
        },
        "background": {
          "type": "string",
          "minLength": 1,
          "maxLength": 800
        },
        "fixedAcrossViews": {
          "const": true
        }
      }
    },
    "identityLockGate": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status",
        "requiresHumanApproval",
        "requiredViews",
        "requiredChecks",
        "noAutoLock"
      ],
      "properties": {
        "status": {
          "enum": [
            "pending",
            "approved",
            "rejected"
          ]
        },
        "requiresHumanApproval": {
          "const": true
        },
        "requiredViews": {
          "type": "array",
          "minItems": 3,
          "uniqueItems": true,
          "items": {
            "enum": [
              "front",
              "three_quarter_left",
              "three_quarter_right",
              "profile_left",
              "profile_right"
            ]
          }
        },
        "requiredChecks": {
          "$ref": "#/$defs/stringList"
        },
        "approvalRef": {
          "$ref": "#/$defs/exactRef"
        },
        "noAutoLock": {
          "const": true
        }
      }
    },
    "planningBoundary": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "providerNeutral",
        "generatesMedia",
        "containsProviderWeights",
        "humanApprovalRequired"
      ],
      "properties": {
        "providerNeutral": {
          "const": true
        },
        "generatesMedia": {
          "const": false
        },
        "containsProviderWeights": {
          "const": false
        },
        "humanApprovalRequired": {
          "const": true
        },
        "notes": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1600
        }
      }
    },
    "validation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "semanticAxesProviderNeutral",
        "relationsPreferredOverRawMeasures",
        "noBiometricInference",
        "noUniversalBeautyScore",
        "noRealPersonPartMashup",
        "identityNotAutoLocked",
        "noGenerationClaim"
      ],
      "properties": {
        "semanticAxesProviderNeutral": {
          "const": true
        },
        "relationsPreferredOverRawMeasures": {
          "const": true
        },
        "noBiometricInference": {
          "const": true
        },
        "noUniversalBeautyScore": {
          "const": true
        },
        "noRealPersonPartMashup": {
          "const": true
        },
        "identityNotAutoLocked": {
          "const": true
        },
        "noGenerationClaim": {
          "const": true
        }
      }
    },
    "skillReceipt": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "repository",
        "ref",
        "commit",
        "installedBy",
        "usedAt"
      ],
      "properties": {
        "repository": {
          "type": "string",
          "format": "uri",
          "pattern": "^https://(www\\.)?github\\.com/[^/]+/[^/]+(?:\\.git)?/?$"
        },
        "ref": {
          "type": "string",
          "minLength": 1,
          "maxLength": 240
        },
        "commit": {
          "type": "string",
          "pattern": "^[0-9a-fA-F]{7,64}$"
        },
        "contentHash": {
          "$ref": "#/$defs/contentHash"
        },
        "installedBy": {
          "const": "codex-environment"
        },
        "environmentId": {
          "type": "string",
          "maxLength": 240
        },
        "usedAt": {
          "type": "string",
          "format": "date-time"
        }
      }
    },
    "provenance": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "source",
        "createdAt",
        "updatedAt",
        "changeLog"
      ],
      "properties": {
        "source": {
          "enum": [
            "user_authored",
            "codex_authored",
            "adapted",
            "imported"
          ]
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        },
        "parentMorphologyRef": {
          "$ref": "#/$defs/exactRef"
        },
        "changeLog": {
          "$ref": "#/$defs/stringList"
        }
      }
    }
  }
}
