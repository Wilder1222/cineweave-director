    "en": "Poetic Song-Inspired Period Drama"
  },
  "purpose": "为人物、场景和镜头提供可继承的宋韵文化、美术、摄影和表演表达规则；不定义角色身份或场景地理。",
  "semanticSpec": {
    "medium": "live_action",
    "representation": "naturalistic_stylized",
    "culture": "南宋江南文人生活的架空诗意影视化",
    "historicalTreatment": "poetic_adaptation",
    "visualDna": [
      "低饱和青瓷、月白、茶褐与旧木色",
      "自然皮肤和真实织物响应",
      "留白与前中后景层次",
      "社会礼仪约束下的微表演"
    ],
    "temporalDna": [
      "缓慢但有动机的摄影机运动",
      "眼神先于头部的细微反应",
      "衣袖、发丝和雨雾有低频惯性"
    ],
    "invariants": [
      "文化与服装轮廓保持宋韵语义",
      "人物身份由 CharacterSpec 保持",
      "摄影机运动必须有叙事动机"
    ],
    "forbidden": [
      "现代网红妆",
      "塑料皮肤",
      "霓虹高饱和",
      "无动机的音乐视频式运镜"
    ]
  },
  "representationModel": {
    "family": "photoreal",
    "geometryModel": "Literal adult human anatomy with restrained aesthetic idealization and preserved natural asymmetry.",
    "surfaceModel": "Observable skin, hair, textile and environmental response remain differentiated without beauty-filter smoothing.",
    "lightModel": "SceneLightState remains physically motivated while style controls tonal rolloff, contrast and color separation.",
    "depthModel": "Optical perspective and selective focus may be used, but depth cannot overwrite Scene geography.",
    "visualGrammar": [
      "Natural human anatomy",
      "Regional skin variation",
      "Real textile weight",
      "Restrained cinematic contrast"
    ],
    "temporalGrammar": [
      "Grounded body weight",
      "Low-amplitude facial acting",
      "Continuous hair and cloth inertia"
    ]
  },
