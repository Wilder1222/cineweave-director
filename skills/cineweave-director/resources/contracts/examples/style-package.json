  "displayName": {
    "zh": "宋韵诗意历史电视剧",
    "en": "诗意宋式古装剧"
  },
  "purpose": "为人物、场景和镜头提供可继承的宋韵文化、美术、摄影和表演表达规则；不定义角色身份或场景地理。",
  "semanticSpec": {
    "medium": "live_action",
    "representation": "naturalistic_stylized",
    "culture": "南宋江南文人生活的架空诗意影视化",
    "historicalTreatment": "poetic_adaptation",
    "visualDna": [
      "低饱和青瓷、月白、茶褐与旧木色",
      "自然皮肤和真实织物响应",
      "留白与前中后景层次",
      "社会礼仪约束下的微表演"
    ],
    "temporalDna": [
      "缓慢但有动机的摄影机运动",
      "眼神先于头部的细微反应",
      "衣袖、发丝和雨雾有低频惯性"
    ],
    "invariants": [
      "文化与服装轮廓保持宋韵语义",
      "人物身份由 CharacterSpec 保持",
      "摄影机运动必须有叙事动机"
    ],
    "forbidden": [
      "现代网红妆",
      "塑料皮肤",
      "霓虹高饱和",
      "无动机的音乐视频式运镜"
    ]
  },
  "representationModel": {
    "family": "photoreal",
    "geometryModel": "保留真实成人解剖，以克制的审美理想化保留自然不对称。",
    "surfaceModel": "皮肤、头发、织物及环境响应保持可观察的差异，不使用美颜磨皮。",
    "lightModel": "SceneLightState 保持物理来源，风格控制色调过渡、反差与色彩分离。",
    "depthModel": "可使用光学透视和选择性对焦，但景深不能覆盖场景地理。",
    "visualGrammar": [
      "自然人体解剖",
      "局部肤色变化",
      "真实织物重量",
      "克制的电影反差"
    ],
    "temporalGrammar": [
      "有落地感的身体重量",
      "小幅度面部表演",
      "连续的头发与衣料惯性"
    ]
  },
