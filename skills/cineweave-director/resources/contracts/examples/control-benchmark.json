          "anchorId": "anchor.camera-previs-judgment-boundary",
          "dimensionId": "dimension.cinematography",
          "criterion": "评分只判断可观察的摄影机控制与叙事可读性，不以吸引力、演员生物特征、品牌偏好或 Provider 声称代替证据。",
          "evidenceRequirement": "observed_media",
