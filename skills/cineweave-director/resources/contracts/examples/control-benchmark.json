        {
          "anchorId": "anchor.camera-previs-intrinsics",
          "dimensionId": "dimension.cinematography",
          "criterion": "固定 50mm 焦段、眼睛焦点目标与声明的 focus pull 必须同精确 CameraPrevisSpec 区分记录。",
          "evidenceRequirement": "exact_contract_and_observed_media",
          "passAnchor": "焦段保持 50mm，焦点从 3.2m 过渡到 2.85m，且注意力从背景保留转向她的眼睛。",
          "warnAnchor": "焦点转移意图可见但到达时间或景深响应不稳定，需检查适配器是否只部分支持数值 focus。",
          "failAnchor": "焦距被改变、焦点丢失主体眼睛，或无法把焦点变化与摄影机位移区分。"
        },
        {
          "anchorId": "anchor.camera-previs-timebase",
          "dimensionId": "dimension.cinematography",
          "criterion": "运动、focus pull 与稳定收势必须保持 24/1、0–132 帧的精确时间关系。",
          "evidenceRequirement": "track_and_frame_evidence",
          "passAnchor": "第 91 帧后摄影机和焦点均稳定，并在第 132 帧保留声明的终态。",
