  "branchRole": "baseline",
  "title": "基线窗口",
  "publicSummary": "枯水压力下，岑野先启动天门窗口的基线测量，并把数据不完整写入记录；她没有提交可稳定结论，也没有为工程试验授予许可。",
  "objective": "在资源期限压力下获得可复核的窗口基线。",
  "opposition": "城市要求立即承诺，但门阈值、工程逻辑与生态债模型仍未定义。",
  "choiceUnderPressure": "岑野先测量并公开标记 baseline-incomplete，不提交稳定判断。",
  "stateChange": "assessmentStatus 进入 collecting_baseline，岑野进入 verifying-window。",
  "causesNext": "基线状态满足复核请求条件，但未定义阈值使下一步必须停在人类 Gate。",
  "irreversibility": "reversible",
  "delayedConsequences": [
    {
      "id": "consequence.w02.threshold-review-request",
      "targetEventId": "event.w02.gate-window-assessment",
      "description": "基线开始收集后，下一步只能请求阈值复核，不能自动给出工程结论。",
      "when": {
        "all": [
          {
            "path": "/variables/gate/assessmentStatus",
            "op": "eq",
            "value": "collecting_baseline"
          },
          {
            "path": "/actors/character.w02.survey-cartographer/status",
            "op": "eq",
            "value": "verifying-window"
          }
        ]
      }
    }
  ],
