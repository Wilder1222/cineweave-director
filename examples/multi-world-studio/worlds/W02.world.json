  "version": 1,
  "displayName": "山海／天门",
  "canonDisposition": "proposal",
  "productionEligibility": "controlled_design_exploration_only",
  "culturalTreatment": {
    "inspiration": "东方山海想象与未来生态议题的原创组合",
    "mode": "原创生态科幻",
    "directBestiaryReuse": false,
    "worldBasis": "undefined"
  },
  "audiencePromise": "天门是受阈值约束的生态通道，山海生命是维持水系、气候、地质和迁徙的活体节点；勘界者必须在文明生存和生态完整之间选择。",
  "experiencePromise": "先被巨型生态与工程奇观吸引，再发现每一次资源获益都由另一端生命与共同体承担。",
  "themeTension": "文明是否有权把无法理解的生命定义为资源。",
  "seasonQuestion": "岑野是否稳定一座能救边城、却会永久伤害另一生态区的天门。",
  "endingDirection": "她拒绝隐藏代价，以失去家园、职业或关系换取新的勘界伦理。",
  "layers": [
    {
      "id": "layer.w02.gate-edge-life",
      "name": "门缘日常",
      "function": "边城供水、能源、市场、迁徙和警报构成普通人的生存入口。"
    },
    {
      "id": "layer.w02.survey-science",
      "name": "勘界与科学",
      "function": "观测、地图、长期数据与现场经验共同决定知识边界。"
    },
    {
      "id": "layer.w02.power-ethics",
      "name": "文明权力与伦理",
      "function": "工程机构、研究者与共同体争夺风险和收益的定义权。"
    }
  ],
  "rules": [
    {
      "id": "rule.w02.life-is-ecological-function",
      "name": "山海生命是生态功能节点",
      "capability": "巨型生命可通过迁徙、摄食、共生和地貌互动改变水系、气候与基础设施。",
      "limit": "禁止只把生命当作可替换怪兽、交通工具或资源矿。",
      "costs": [
        "捕获、驱离或死亡改变栖息地",
        "水系与迁徙路线失衡",
        "基础设施承受反馈"
      ],
      "exception": "未知生态作用可以保留，但必须登记证据与不确定性。",
      "governance": {
        "canonStatus": "proposed",
        "requestedLock": "hard",
        "effectiveLock": "undefined",
        "approvalRef": null
      }
    },
    {
      "id": "rule.w02.gate-has-ecological-debt",
      "name": "天门不能创造无代价资源",
      "capability": "天门可以交换物质、热量、生物或通路。",
      "limit": "禁止凭空创造资源、无限能源或只让一端获益。",
      "costs": [
        "远端水量、温度或营养变化",
        "栖息地与迁徙债务",
        "尚未量化的延迟影响"
      ],
      "exception": "未测得的债务只能标记为 unknown，不得当作零。",
      "governance": {
        "canonStatus": "proposed",
        "requestedLock": "hard",
        "effectiveLock": "undefined",
        "approvalRef": null
      }
    },
    {
      "id": "rule.w02.gate-has-thresholds",
      "name": "天门受地质与生态阈值约束",
      "capability": "开启窗口可以由地质、季节、磁场、天体与生态条件共同预测。",
      "limit": "禁止随意开启、永久稳定或无数据改变端点。",
      "costs": [
        "预测需要长期数据",
        "稳定干扰自然周期",
        "失败改变路线或地貌"
      ],
      "exception": "异常窗口可以发生，但必须留下可观察前兆和后果。",
      "governance": {
        "canonStatus": "proposed",
        "requestedLock": "hard",
        "effectiveLock": "undefined",
        "approvalRef": null
      }
    }
  ],
