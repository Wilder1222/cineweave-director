{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "continuity-ledger.schema.json",
  "title": "World OS Continuity ledger",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "kind", "contractVersion", "ledgerId", "version", "worldId", "stream", "sequence", "previousLedgerRef",
    "simulationCommitRef", "gateDecisionRef", "factRefs", "changes", "conflicts", "status", "writer", "createdAt"
  ],
  "properties": {
    "$schema": { "type": "string" },
    "kind": { "const": "world_os_continuity_ledger" },
    "contractVersion": { "const": "0.1.0" },
    "ledgerId": { "$ref": "common.schema.json#/$defs/identifier" },
    "version": { "type": "integer", "minimum": 1 },
    "worldId": { "$ref": "common.schema.json#/$defs/worldId" },
    "stream": { "const": "canon.main" },
    "sequence": { "type": "integer", "minimum": 1 },
    "previousLedgerRef": {
      "anyOf": [
        { "$ref": "common.schema.json#/$defs/exactRef" },
        { "type": "null" }
      ]
    },
    "simulationCommitRef": { "$ref": "common.schema.json#/$defs/exactRef" },
    "gateDecisionRef": { "$ref": "common.schema.json#/$defs/exactRef" },
    "factRefs": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "$ref": "common.schema.json#/$defs/exactRef" }
    },
    "changes": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["path", "changeType", "reason"],
        "properties": {
          "path": { "type": "string", "pattern": "^/", "minLength": 2 },
          "changeType": { "enum": ["added", "updated", "conflict"] },
          "reason": { "type": "string", "minLength": 1 }
        }
      }
    },
    "conflicts": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["conflictId", "factPath", "claimRefs", "status", "allowedInProduction"],
        "properties": {
          "conflictId": { "$ref": "common.schema.json#/$defs/identifier" },
          "factPath": { "type": "string", "pattern": "^/", "minLength": 2 },
          "claimRefs": {
            "type": "array",
            "minItems": 2,
            "uniqueItems": true,
            "items": { "$ref": "common.schema.json#/$defs/exactRef" }
          },
          "status": { "const": "unresolved" },
          "allowedInProduction": { "const": false }
        }
      }
    },
    "status": { "enum": ["active", "conflicted"] },
    "writer": { "$ref": "common.schema.json#/$defs/codexWriter" },
    "createdAt": { "type": "string", "format": "date-time" }
  }
}
