{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "publish-receipt.schema.json",
  "title": "World OS platform publish receipt",
  "type": "object",
  "required": [
    "kind",
    "contractVersion",
    "receiptId",
    "version",
    "projectionRef",
    "platformProfileRef",
    "sourceCommitRefs",
    "platformId",
    "idempotencyKey",
    "status",
    "platformRecordId",
    "receivedAt",
    "responseHash",
    "recordedBy",
    "canonMutation"
  ],
  "properties": {
    "kind": {
      "const": "world_os_publish_receipt"
    },
    "contractVersion": {
      "const": "0.1.0"
    },
    "receiptId": {
      "$ref": "common.schema.json#/$defs/identifier"
    },
    "version": {
      "type": "integer",
      "minimum": 1
    },
    "projectionRef": {
      "$ref": "common.schema.json#/$defs/exactRef"
    },
    "platformProfileRef": {
      "$ref": "common.schema.json#/$defs/exactRef"
    },
    "sourceCommitRefs": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "common.schema.json#/$defs/exactRef"
      }
    },
    "platformId": {
      "$ref": "common.schema.json#/$defs/identifier"
    },
    "idempotencyKey": {
      "type": "string",
      "minLength": 8
    },
    "status": {
      "enum": [
        "succeeded",
        "failed"
      ]
    },
    "platformRecordId": {
      "type": "string",
      "minLength": 1
    },
    "receivedAt": {
      "type": "string",
      "format": "date-time"
    },
    "responseHash": {
      "type": [
        "string",
        "null"
      ]
    },
    "recordedBy": {
      "$ref": "common.schema.json#/$defs/codexWriter"
    },
    "canonMutation": {
      "const": false
    }
  }
}
