{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "codex-brain-run-receipt.schema.json",
  "title": "World OS Codex Brain run receipt",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "kind", "contractVersion", "brainRunId", "version", "implementationVersion", "workspaceRef", "worldIds", "maxCycles",
    "simulationPolicy", "llmMode", "mcpMode", "startedAt", "endedAt", "writer", "portfolioRunRef", "shadowRunRefs",
    "shadowFailureCount", "dispatch", "preflight", "postflight", "status", "stopReason"
  ],
  "properties": {
    "kind": { "const": "world_os_codex_brain_run_receipt" },
    "contractVersion": { "const": "0.1.0" },
    "brainRunId": { "$ref": "common.schema.json#/$defs/identifier" },
    "version": { "type": "integer", "const": 1 },
    "implementationVersion": { "type": "string", "minLength": 1 },
    "workspaceRef": { "$ref": "common.schema.json#/$defs/exactRef" },
    "worldIds": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "$ref": "common.schema.json#/$defs/worldId" }
    },
    "maxCycles": { "type": "integer", "minimum": 1, "maximum": 100 },
    "simulationPolicy": { "const": "weighted_fair_deficit_round_robin" },
    "llmMode": { "enum": ["disabled", "proposal_only"] },
    "mcpMode": { "enum": ["disabled", "dry_run", "network_opt_in"] },
    "startedAt": { "type": "string", "format": "date-time" },
    "endedAt": { "type": "string", "format": "date-time" },
    "writer": { "$ref": "common.schema.json#/$defs/codexWriter" },
    "portfolioRunRef": { "$ref": "common.schema.json#/$defs/exactRef" },
    "shadowRunRefs": { "type": "array", "items": { "$ref": "common.schema.json#/$defs/exactRef" } },
    "shadowFailureCount": { "type": "integer", "minimum": 0 },
    "dispatch": { "$ref": "#/$defs/dispatch" },
    "preflight": { "$ref": "#/$defs/health" },
    "postflight": { "$ref": "#/$defs/health" },
    "status": { "enum": ["advanced", "stopped", "blocked", "stale", "failed"] },
    "stopReason": {
      "enum": [
        "budget_exhausted", "all_worlds_stopped", "world_error", "stale_after_race", "needs_human_gate",
        "awaiting_codex_template", "all_candidates_rejected", "committed_projection_pending", "llm_shadow_failed",
        "mcp_dispatch_failed", "mcp_dead_letter", "portfolio_blocked"
      ]
    }
  },
  "$defs": {
    "refList": { "type": "array", "items": { "$ref": "common.schema.json#/$defs/exactRef" } },
    "dispatch": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "profileRefs", "pendingProjectionRefs", "pendingCount", "dispatchedCount", "skippedCount", "failureCount", "attemptRefs", "publishReceiptRefs"],
      "properties": {
        "status": { "enum": ["disabled", "idle", "dry_run", "network_opt_in", "failed"] },
        "profileRefs": { "$ref": "#/$defs/refList" },
        "pendingProjectionRefs": { "$ref": "#/$defs/refList" },
        "pendingCount": { "type": "integer", "minimum": 0 },
        "dispatchedCount": { "type": "integer", "minimum": 0 },
        "skippedCount": { "type": "integer", "minimum": 0 },
        "failureCount": { "type": "integer", "minimum": 0 },
        "attemptRefs": { "$ref": "#/$defs/refList" },
        "publishReceiptRefs": { "$ref": "#/$defs/refList" }
      }
    },
    "health": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "artifactCount", "referenceCount", "missingReferenceCount", "hashMismatchReferenceCount", "cycleCount"],
      "properties": {
        "status": { "const": "pass" },
        "artifactCount": { "type": "integer", "minimum": 0 },
        "referenceCount": { "type": "integer", "minimum": 0 },
        "missingReferenceCount": { "type": "integer", "minimum": 0 },
        "hashMismatchReferenceCount": { "type": "integer", "minimum": 0 },
        "cycleCount": { "type": "integer", "minimum": 0 }
      }
    }
  }
}
