{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "seed-manifest.schema.json",
  "title": "World OS deterministic seed manifest",
  "type": "object",
  "required": [
    "kind",
    "contractVersion",
    "project",
    "entries"
  ],
  "properties": {
    "kind": {
      "const": "world_os_seed_manifest"
    },
    "contractVersion": {
      "const": "0.1.0"
    },
    "project": {
      "type": "object",
      "required": [
        "id",
        "name",
        "createdAt"
      ],
      "properties": {
        "id": {
          "$ref": "common.schema.json#/$defs/identifier"
        },
        "name": {
          "type": "string",
          "minLength": 1
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        }
      }
    },
    "entries": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "path",
          "kind",
          "id",
          "version",
          "status",
          "createdAt",
          "createdBy",
          "expectedContentHash"
        ],
        "properties": {
          "path": {
            "type": "string",
            "minLength": 1
          },
          "kind": {
            "$ref": "common.schema.json#/$defs/identifier"
          },
          "id": {
            "$ref": "common.schema.json#/$defs/identifier"
          },
          "version": {
            "type": "integer",
            "minimum": 1
          },
          "status": {
            "enum": [
              "draft",
              "candidate"
            ]
          },
          "createdAt": {
            "type": "string",
            "format": "date-time"
          },
          "createdBy": {
            "const": "codex.root"
          },
          "expectedContentHash": {
            "$ref": "common.schema.json#/$defs/contentHash"
          }
        }
      }
    }
  }
}
