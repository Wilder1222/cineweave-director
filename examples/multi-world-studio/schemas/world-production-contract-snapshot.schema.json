{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "world-production-contract-snapshot.schema.json",
  "title": "World OS external CineWeave production contract snapshot",
  "type": "object",
  "additionalProperties": false,
  "required": ["kind", "contractVersion", "snapshotId", "version", "contractKind", "sourceContractId", "sourceContractVersion", "sourceContractHash", "worldId", "documentJson", "capturedAt", "capturedBy"],
  "properties": {
    "kind": { "const": "world_os_production_contract_snapshot" },
    "contractVersion": { "const": "0.1.0" },
    "snapshotId": { "$ref": "common.schema.json#/$defs/identifier" },
    "version": { "const": 1 },
    "contractKind": { "$ref": "common.schema.json#/$defs/identifier" },
    "sourceContractId": { "$ref": "common.schema.json#/$defs/identifier" },
    "sourceContractVersion": { "type": "integer", "minimum": 1 },
    "sourceContractHash": { "$ref": "common.schema.json#/$defs/contentHash" },
    "worldId": { "anyOf": [{ "type": "string", "minLength": 1, "maxLength": 160 }, { "type": "null" }] },
    "documentJson": { "type": "string", "minLength": 2 },
    "capturedAt": { "type": "string", "format": "date-time" },
    "capturedBy": { "$ref": "common.schema.json#/$defs/codexWriter" }
  }
}
