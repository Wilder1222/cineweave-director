{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "review-report.schema.json",
  "title": "World OS portable review report",
  "type": "object",
  "required": [
    "kind",
    "contractVersion",
    "reviewId",
    "version",
    "workspaceRef",
    "reviewedAt",
    "reviewer",
    "status",
    "summary",
    "passedChecks",
    "nonExecutedBoundaries"
  ],
  "properties": {
    "$schema": {
      "type": "string"
    },
    "kind": {
      "const": "world_os_review_report"
    },
    "contractVersion": {
      "const": "0.1.0"
    },
    "reviewId": {
      "$ref": "common.schema.json#/$defs/identifier"
    },
    "version": {
      "type": "integer",
      "minimum": 1
    },
    "workspaceRef": {
      "$ref": "common.schema.json#/$defs/exactRef"
    },
    "reviewedAt": {
      "type": "string",
      "format": "date-time"
    },
    "reviewer": {
      "$ref": "common.schema.json#/$defs/codexWriter"
    },
    "status": {
      "enum": [
        "pass",
        "warn",
        "fail"
      ]
    },
    "summary": {
      "type": "object"
    },
    "passedChecks": {
      "type": "array",
      "minItems": 1
    },
    "nonExecutedBoundaries": {
      "type": "array",
      "minItems": 1
    }
  }
}
