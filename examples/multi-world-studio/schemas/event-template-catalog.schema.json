{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "event-template-catalog.schema.json",
  "title": "World OS event template catalog",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "kind",
    "contractVersion",
    "catalogId",
    "version",
    "worldId",
    "worldCardRef",
    "triggerCatalogRef",
    "actionCatalogRef",
    "platformProfileRef",
    "templates"
  ],
  "properties": {
    "$schema": {
      "type": "string"
    },
    "kind": {
      "const": "world_os_event_template_catalog"
    },
    "contractVersion": {
      "const": "0.1.0"
    },
    "catalogId": {
      "$ref": "common.schema.json#/$defs/identifier"
    },
    "version": {
      "type": "integer",
      "minimum": 1
    },
    "worldId": {
      "$ref": "common.schema.json#/$defs/worldId"
    },
    "worldCardRef": {
      "$ref": "common.schema.json#/$defs/exactRef"
    },
    "triggerCatalogRef": {
      "$ref": "common.schema.json#/$defs/exactRef"
    },
    "actionCatalogRef": {
      "$ref": "common.schema.json#/$defs/exactRef"
    },
    "platformProfileRef": {
      "$ref": "common.schema.json#/$defs/exactRef"
    },
    "templates": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/template"
      }
    }
  },
  "$defs": {
    "identifierList": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "$ref": "common.schema.json#/$defs/identifier"
      }
    },
    "condition": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "all"
          ],
          "properties": {
            "all": {
              "type": "array",
              "minItems": 1,
              "items": {
                "$ref": "#/$defs/condition"
              }
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "any"
          ],
          "properties": {
            "any": {
              "type": "array",
              "minItems": 1,
              "items": {
                "$ref": "#/$defs/condition"
              }
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "not"
          ],
          "properties": {
            "not": {
              "$ref": "#/$defs/condition"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "path",
            "op",
            "value"
          ],
          "properties": {
            "path": {
              "type": "string",
              "pattern": "^/"
            },
            "op": {
              "enum": [
                "eq",
                "ne",
                "gt",
                "gte",
                "lt",
                "lte",
                "in",
                "contains",
                "exists"
              ]
            },
            "value": {}
          }
        }
      ]
    },
    "template": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "candidateId",
        "status",
        "eventId",
        "triggerId",
        "branchRole",
        "selectionScore",
        "clockAdvanceMinutes",
        "title",
        "publicSummary",
        "participants",
        "actionIds",
        "objective",
        "opposition",
        "choiceUnderPressure",
        "stateChange",
        "delayedConsequences",
        "irreversibility",
        "causesNext",
        "canonImpact",
        "publicationIntent",
        "differingPremise",
        "projectedDeltaSummary",
        "unresolvedInputs",
        "sourceBeatRefs"
      ],
      "properties": {
        "id": {
          "$ref": "common.schema.json#/$defs/identifier"
        },
        "candidateId": {
          "$ref": "common.schema.json#/$defs/identifier"
        },
        "status": {
          "const": "proposed"
        },
        "eventId": {
          "$ref": "common.schema.json#/$defs/identifier"
        },
        "triggerId": {
          "$ref": "common.schema.json#/$defs/identifier"
        },
        "branchRole": {
          "enum": [
            "baseline",
            "deterioration",
            "opportunity"
          ]
        },
        "selectionScore": {
          "type": "integer",
          "minimum": 0,
          "maximum": 100
        },
        "clockAdvanceMinutes": {
          "type": "integer",
          "minimum": 1,
          "maximum": 1440
        },
        "title": {
          "type": "string",
          "minLength": 1
        },
        "publicSummary": {
          "type": "string",
          "minLength": 1
        },
        "participants": {
          "$ref": "#/$defs/identifierList"
        },
        "actionIds": {
          "$ref": "#/$defs/identifierList"
        },
        "objective": {
          "type": "string",
          "minLength": 1
        },
        "opposition": {
          "type": "string",
          "minLength": 1
        },
        "choiceUnderPressure": {
          "type": "string",
          "minLength": 1
        },
        "stateChange": {
          "type": "string",
          "minLength": 1
        },
        "delayedConsequences": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "id",
              "targetEventId",
              "description",
              "when"
            ],
            "properties": {
              "id": {
                "$ref": "common.schema.json#/$defs/identifier"
              },
              "targetEventId": {
                "$ref": "common.schema.json#/$defs/identifier"
              },
              "description": {
                "type": "string",
                "minLength": 1
              },
              "when": {
                "$ref": "#/$defs/condition"
              }
            }
          }
        },
        "irreversibility": {
          "enum": [
            "reversible",
            "costly_to_reverse",
            "irreversible"
          ]
        },
        "causesNext": {
          "type": "string",
          "minLength": 1
        },
        "canonImpact": {
          "enum": [
            "none",
            "candidate_fact",
            "canon_mutation"
          ]
        },
        "publicationIntent": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "platformId",
            "lane",
            "audience"
          ],
          "properties": {
            "platformId": {
              "$ref": "common.schema.json#/$defs/identifier"
            },
            "lane": {
              "const": "simulation_preview"
            },
            "audience": {
              "enum": [
                "private_workspace",
                "public_after_release_gate"
              ]
            }
          }
        },
        "differingPremise": {
          "type": "string",
          "minLength": 1
        },
        "projectedDeltaSummary": {
          "type": "string",
          "minLength": 1
        },
        "unresolvedInputs": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "$ref": "common.schema.json#/$defs/identifier"
          }
        },
        "sourceBeatRefs": {
          "$ref": "#/$defs/identifierList"
        }
      }
    }
  }
}
