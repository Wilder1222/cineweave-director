{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "simulation-run-receipt.schema.json",
  "title": "World OS simulation run receipt",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "kind",
    "contractVersion",
    "runId",
    "version",
    "implementationVersion",
    "worldId",
    "stream",
    "writer",
    "startedAt",
    "endedAt",
    "maxSteps",
    "startStateRef",
    "endStateRef",
    "startSequence",
    "endSequence",
    "committedSteps",
    "attemptedSteps",
    "stopReason",
    "status",
    "steps"
  ],
  "properties": {
    "kind": {
      "const": "world_os_simulation_run_receipt"
    },
    "contractVersion": {
      "const": "0.1.0"
    },
    "runId": {
      "$ref": "common.schema.json#/$defs/identifier"
    },
    "version": {
      "type": "integer",
      "minimum": 1
    },
    "implementationVersion": {
      "enum": [
        "0.3.0",
        "0.4.0"
      ]
    },
    "worldId": {
      "$ref": "common.schema.json#/$defs/worldId"
    },
    "stream": {
      "const": "simulation.main"
    },
    "writer": {
      "$ref": "common.schema.json#/$defs/codexWriter"
    },
    "startedAt": {
      "type": "string",
      "format": "date-time"
    },
    "endedAt": {
      "type": "string",
      "format": "date-time"
    },
    "maxSteps": {
      "type": "integer",
      "minimum": 1,
      "maximum": 100
    },
    "startStateRef": {
      "$ref": "common.schema.json#/$defs/exactRef"
    },
    "endStateRef": {
      "$ref": "common.schema.json#/$defs/exactRef"
    },
    "startSequence": {
      "type": "integer",
      "minimum": 0
    },
    "endSequence": {
      "type": "integer",
      "minimum": 0
    },
    "committedSteps": {
      "type": "integer",
      "minimum": 0
    },
    "attemptedSteps": {
      "type": "integer",
      "minimum": 0
    },
    "stopReason": {
      "enum": [
        "max_steps_reached",
        "no_due_trigger",
        "awaiting_codex_template",
        "needs_human_gate",
        "all_candidates_rejected",
        "stale_after_race",
        "committed_projection_pending"
      ]
    },
    "status": {
      "enum": [
        "advanced",
        "stopped",
        "blocked",
        "stale"
      ]
    },
    "steps": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "sequenceAttempted",
          "triggerId",
          "scanStatus",
          "branchSetRef",
          "selectedProposalRef",
          "resultStatus",
          "decisionRef",
          "commitRef",
          "outputStateRef",
          "projectionRef"
        ]
      }
    }
  }
}
