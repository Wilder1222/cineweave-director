{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "portfolio-run-receipt.schema.json",
  "title": "World OS multi-world Portfolio run receipt",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "kind",
    "contractVersion",
    "portfolioRunId",
    "version",
    "implementationVersion",
    "workspaceRef",
    "worldIds",
    "allocationPolicy",
    "maxCycles",
    "startedAt",
    "endedAt",
    "writer",
    "startHeads",
    "endHeads",
    "rounds",
    "attemptedCycles",
    "committedSteps",
    "status",
    "stopReason"
  ],
  "properties": {
    "kind": {
      "const": "world_os_portfolio_run_receipt"
    },
    "contractVersion": {
      "const": "0.1.0"
    },
    "portfolioRunId": {
      "$ref": "common.schema.json#/$defs/identifier"
    },
    "version": {
      "type": "integer",
      "const": 1
    },
    "implementationVersion": {
      "const": "0.4.0"
    },
    "workspaceRef": {
      "$ref": "common.schema.json#/$defs/exactRef"
    },
    "worldIds": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "$ref": "common.schema.json#/$defs/worldId"
      }
    },
    "allocationPolicy": {
      "const": "weighted_fair_deficit_round_robin"
    },
    "maxCycles": {
      "type": "integer",
      "minimum": 1,
      "maximum": 100
    },
    "startedAt": {
      "type": "string",
      "format": "date-time"
    },
    "endedAt": {
      "type": "string",
      "format": "date-time"
    },
    "writer": {
      "$ref": "common.schema.json#/$defs/codexWriter"
    },
    "startHeads": {
      "$ref": "#/$defs/headList"
    },
    "endHeads": {
      "$ref": "#/$defs/headList"
    },
    "rounds": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/round"
      }
    },
    "attemptedCycles": {
      "type": "integer",
      "minimum": 0
    },
    "committedSteps": {
      "type": "integer",
      "minimum": 0
    },
    "status": {
      "enum": [
        "advanced",
        "stopped",
        "blocked",
        "stale"
      ]
    },
    "stopReason": {
      "enum": [
        "budget_exhausted",
        "all_worlds_stopped",
        "world_error",
        "stale_after_race"
      ]
    }
  },
  "$defs": {
    "head": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "worldId",
        "stateRef",
        "commitRef"
      ],
      "properties": {
        "worldId": {
          "$ref": "common.schema.json#/$defs/worldId"
        },
        "stateRef": {
          "$ref": "common.schema.json#/$defs/exactRef"
        },
        "commitRef": {
          "anyOf": [
            {
              "$ref": "common.schema.json#/$defs/exactRef"
            },
            {
              "type": "null"
            }
          ]
        }
      }
    },
    "headList": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/head"
      }
    },
    "round": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "cycle",
        "worldId",
        "allocationShare",
        "receiptRef",
        "resultStatus",
        "stopReason",
        "startSequence",
        "endSequence",
        "committedSteps"
      ],
      "properties": {
        "cycle": {
          "type": "integer",
          "minimum": 1
        },
        "worldId": {
          "$ref": "common.schema.json#/$defs/worldId"
        },
        "allocationShare": {
          "type": "integer",
          "minimum": 1,
          "maximum": 100
        },
        "receiptRef": {
          "$ref": "common.schema.json#/$defs/exactRef"
        },
        "resultStatus": {
          "enum": [
            "advanced",
            "stopped",
            "blocked",
            "stale",
            "scheduler_error"
          ]
        },
        "stopReason": {
          "type": "string",
          "minLength": 1
        },
        "startSequence": {
          "type": "integer",
          "minimum": 0
        },
        "endSequence": {
          "type": "integer",
          "minimum": 0
        },
        "committedSteps": {
          "type": "integer",
          "minimum": 0
        },
        "error": {
          "type": "string",
          "minLength": 1
        }
      }
    }
  }
}
