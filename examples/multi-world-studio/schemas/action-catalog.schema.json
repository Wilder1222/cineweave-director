{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "action-catalog.schema.json",
  "title": "World OS action catalog",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "kind",
    "contractVersion",
    "catalogId",
    "version",
    "worldId",
    "worldCardRef",
    "actions"
  ],
  "properties": {
    "$schema": {
      "type": "string"
    },
    "kind": {
      "const": "world_os_action_catalog"
    },
    "contractVersion": {
      "const": "0.1.0"
    },
    "catalogId": {
      "$ref": "common.schema.json#/$defs/identifier"
    },
    "version": {
      "type": "integer",
      "minimum": 1
    },
    "worldId": {
      "$ref": "common.schema.json#/$defs/worldId"
    },
    "worldCardRef": {
      "$ref": "common.schema.json#/$defs/exactRef"
    },
    "actions": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/action"
      }
    }
  },
  "$defs": {
    "identifierList": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "$ref": "common.schema.json#/$defs/identifier"
      }
    },
    "condition": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "all"
          ],
          "properties": {
            "all": {
              "type": "array",
              "minItems": 1,
              "items": {
                "$ref": "#/$defs/condition"
              }
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "any"
          ],
          "properties": {
            "any": {
              "type": "array",
              "minItems": 1,
              "items": {
                "$ref": "#/$defs/condition"
              }
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "not"
          ],
          "properties": {
            "not": {
              "$ref": "#/$defs/condition"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "path",
            "op",
            "value"
          ],
          "properties": {
            "path": {
              "type": "string",
              "pattern": "^/"
            },
            "op": {
              "enum": [
                "eq",
                "ne",
                "gt",
                "gte",
                "lt",
                "lte",
                "in",
                "contains",
                "exists"
              ]
            },
            "value": {}
          }
        }
      ]
    },
    "action": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "status",
        "actorId",
        "applicableTriggerIds",
        "locationId",
        "preconditions",
        "goalRefs",
        "capabilityRefs",
        "knowledgeRefs",
        "preferenceRefs",
        "limitRefs",
        "ruleRefs",
        "ruleChecks",
        "choice",
        "costs",
        "effects",
        "durationMinutes",
        "canonImpactCeiling",
        "irreversibility",
        "gatePolicy",
        "sourceBeatRefs"
      ],
      "properties": {
        "id": {
          "$ref": "common.schema.json#/$defs/identifier"
        },
        "status": {
          "const": "proposed"
        },
        "actorId": {
          "$ref": "common.schema.json#/$defs/identifier"
        },
        "applicableTriggerIds": {
          "$ref": "#/$defs/identifierList"
        },
        "locationId": {
          "$ref": "common.schema.json#/$defs/identifier"
        },
        "preconditions": {
          "$ref": "#/$defs/condition"
        },
        "goalRefs": {
          "$ref": "#/$defs/identifierList"
        },
        "capabilityRefs": {
          "$ref": "#/$defs/identifierList"
        },
        "knowledgeRefs": {
          "$ref": "#/$defs/identifierList"
        },
        "preferenceRefs": {
          "$ref": "#/$defs/identifierList"
        },
        "limitRefs": {
          "$ref": "#/$defs/identifierList"
        },
        "ruleRefs": {
          "$ref": "#/$defs/identifierList"
        },
        "ruleChecks": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "ruleRef",
              "result",
              "evidence"
            ],
            "properties": {
              "ruleRef": {
                "$ref": "common.schema.json#/$defs/identifier"
              },
              "result": {
                "const": "pass"
              },
              "evidence": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        },
        "choice": {
          "type": "string",
          "minLength": 1
        },
        "costs": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "effects": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "op",
              "path",
              "value"
            ],
            "properties": {
              "op": {
                "enum": [
                  "replace",
                  "add",
                  "increment",
                  "append"
                ]
              },
              "path": {
                "type": "string",
                "pattern": "^/(variables|actors|relationships|threads|entities)/"
              },
              "value": {}
            }
          }
        },
        "durationMinutes": {
          "type": "integer",
          "minimum": 1,
          "maximum": 1440
        },
        "canonImpactCeiling": {
          "enum": [
            "none",
            "candidate_fact",
            "canon_mutation"
          ]
        },
        "irreversibility": {
          "enum": [
            "reversible",
            "costly_to_reverse",
            "irreversible"
          ]
        },
        "gatePolicy": {
          "type": "string",
          "minLength": 1
        },
        "sourceBeatRefs": {
          "$ref": "#/$defs/identifierList"
        }
      }
    }
  }
}
