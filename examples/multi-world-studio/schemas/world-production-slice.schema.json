{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "world-production-slice.schema.json",
  "title": "World OS proposal-only production vertical slice",
  "type": "object",
  "additionalProperties": false,
  "required": ["kind", "contractVersion", "sliceId", "version", "workspaceRef", "worldId", "sourceCommitRef", "sourceStateRef", "episodeId", "title", "contractRefs", "requiredGates", "gateDecisionRefs", "stage", "status", "releaseVisibility", "createdAt", "updatedAt", "createdBy"],
  "properties": {
    "kind": { "const": "world_os_production_slice" },
    "contractVersion": { "const": "0.1.0" },
    "sliceId": { "$ref": "common.schema.json#/$defs/identifier" },
    "version": { "type": "integer", "minimum": 1 },
    "workspaceRef": { "$ref": "common.schema.json#/$defs/exactRef" },
    "worldId": { "$ref": "common.schema.json#/$defs/worldId" },
    "sourceCommitRef": { "$ref": "common.schema.json#/$defs/exactRef" },
    "sourceStateRef": { "$ref": "common.schema.json#/$defs/exactRef" },
    "episodeId": { "$ref": "common.schema.json#/$defs/identifier" },
    "title": { "type": "string", "minLength": 1, "maxLength": 240 },
    "contractRefs": {
      "type": "object",
      "additionalProperties": false,
      "required": ["storyBrief", "beatSheet", "scriptScene", "characterSpecs", "sceneSpecs", "stylePackages", "shotSpecs", "promptRecords", "recipe", "rightsProfile", "qaReviews"],
      "properties": {
        "storyBrief": { "$ref": "common.schema.json#/$defs/exactRef" },
        "beatSheet": { "$ref": "common.schema.json#/$defs/exactRef" },
        "scriptScene": { "$ref": "common.schema.json#/$defs/exactRef" },
        "characterSpecs": { "type": "array", "minItems": 1, "items": { "$ref": "common.schema.json#/$defs/exactRef" } },
        "sceneSpecs": { "type": "array", "minItems": 1, "items": { "$ref": "common.schema.json#/$defs/exactRef" } },
        "stylePackages": { "type": "array", "minItems": 1, "items": { "$ref": "common.schema.json#/$defs/exactRef" } },
        "shotSpecs": { "type": "array", "minItems": 1, "items": { "$ref": "common.schema.json#/$defs/exactRef" } },
        "promptRecords": { "type": "array", "minItems": 1, "items": { "$ref": "common.schema.json#/$defs/exactRef" } },
        "recipe": { "$ref": "common.schema.json#/$defs/exactRef" },
        "rightsProfile": { "$ref": "common.schema.json#/$defs/exactRef" },
        "qaReviews": { "type": "array", "items": { "$ref": "common.schema.json#/$defs/exactRef" } }
      }
    },
    "requiredGates": { "const": ["story_ready", "character_identity", "scene_geography", "style_activation", "rights", "qa", "release"] },
    "gateDecisionRefs": { "type": "array", "items": { "$ref": "common.schema.json#/$defs/exactRef" } },
    "stage": { "enum": ["planned", "story_bound", "character_bound", "design_bound", "shot_bound", "qa_pending", "approved_asset", "released", "blocked"] },
    "status": { "enum": ["proposed", "approved", "released", "blocked"] },
    "releaseVisibility": { "const": "private_workspace" },
    "createdAt": { "type": "string", "format": "date-time" },
    "updatedAt": { "type": "string", "format": "date-time" },
    "createdBy": { "$ref": "common.schema.json#/$defs/codexWriter" }
  }
}
