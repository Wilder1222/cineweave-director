{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "template-work-item.schema.json",
  "title": "World OS Codex template work item",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "kind", "contractVersion", "workItemId", "version", "worldId", "stream", "stateRef", "simulationHeadRef",
    "triggerCatalogRef", "triggerId", "requiredAction", "status", "createdAt", "createdBy"
  ],
  "properties": {
    "$schema": { "type": "string" },
    "kind": { "const": "world_os_template_work_item" },
    "contractVersion": { "const": "0.1.0" },
    "workItemId": { "$ref": "common.schema.json#/$defs/identifier" },
    "version": { "type": "integer", "minimum": 1 },
    "worldId": { "$ref": "common.schema.json#/$defs/worldId" },
    "stream": { "const": "simulation.main" },
    "stateRef": { "$ref": "common.schema.json#/$defs/exactRef" },
    "simulationHeadRef": {
      "anyOf": [
        { "$ref": "common.schema.json#/$defs/exactRef" },
        { "type": "null" }
      ]
    },
    "triggerCatalogRef": { "$ref": "common.schema.json#/$defs/exactRef" },
    "triggerId": { "$ref": "common.schema.json#/$defs/identifier" },
    "requiredAction": { "const": "submit_event_template_catalog" },
    "status": { "enum": ["open", "resolved", "stale"] },
    "createdAt": { "type": "string", "format": "date-time" },
    "createdBy": { "$ref": "common.schema.json#/$defs/codexWriter" },
    "resolvedByCatalogRef": {
      "anyOf": [
        { "$ref": "common.schema.json#/$defs/exactRef" },
        { "type": "null" }
      ]
    }
  }
}
