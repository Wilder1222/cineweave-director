{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "world-approved-asset.schema.json",
  "title": "World OS approved private asset binding",
  "type": "object",
  "additionalProperties": false,
  "required": ["kind", "contractVersion", "approvedAssetId", "version", "worldId", "sliceRef", "sourceQaReviewRef", "mediaBindingRefs", "mediaImportRefs", "status", "visibility", "approvedAt", "approvedBy", "recordedBy"],
  "properties": {
    "kind": { "const": "world_os_approved_asset" },
    "contractVersion": { "const": "0.1.0" },
    "approvedAssetId": { "$ref": "common.schema.json#/$defs/identifier" },
    "version": { "const": 1 },
    "worldId": { "$ref": "common.schema.json#/$defs/worldId" },
    "sliceRef": { "$ref": "common.schema.json#/$defs/exactRef" },
    "sourceQaReviewRef": { "$ref": "common.schema.json#/$defs/exactRef" },
    "mediaBindingRefs": { "type": "array", "minItems": 1, "maxItems": 12, "items": { "$ref": "common.schema.json#/$defs/exactRef" } },
    "mediaImportRefs": { "type": "array", "minItems": 1, "maxItems": 12, "items": { "$ref": "common.schema.json#/$defs/exactRef" } },
    "status": { "const": "approved" },
    "visibility": { "const": "private_workspace" },
    "approvedAt": { "type": "string", "format": "date-time" },
    "approvedBy": { "type": "object", "additionalProperties": false, "required": ["kind", "id"], "properties": { "kind": { "const": "human" }, "id": { "type": "string", "minLength": 1, "maxLength": 160 } } },
    "recordedBy": { "$ref": "common.schema.json#/$defs/codexWriter" }
  }
}
