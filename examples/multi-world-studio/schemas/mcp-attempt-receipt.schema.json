{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "mcp-attempt-receipt.schema.json",
  "title": "World OS MCP attempt receipt",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "kind",
    "contractVersion",
    "attemptId",
    "version",
    "claimRef",
    "projectionRef",
    "platformProfileRef",
    "dispatchId",
    "idempotencyKey",
    "attemptNumber",
    "startedAt",
    "endedAt",
    "status",
    "platformRecordId",
    "responseHash",
    "errorCode",
    "errorHash",
    "nextRetryAt",
    "recordedBy"
  ],
  "properties": {
    "kind": {
      "const": "world_os_mcp_attempt_receipt"
    },
    "contractVersion": {
      "const": "0.1.0"
    },
    "attemptId": {
      "$ref": "common.schema.json#/$defs/identifier"
    },
    "version": {
      "type": "integer",
      "const": 1
    },
    "claimRef": {
      "$ref": "common.schema.json#/$defs/exactRef"
    },
    "projectionRef": {
      "$ref": "common.schema.json#/$defs/exactRef"
    },
    "platformProfileRef": {
      "$ref": "common.schema.json#/$defs/exactRef"
    },
    "dispatchId": {
      "$ref": "common.schema.json#/$defs/identifier"
    },
    "idempotencyKey": {
      "type": "string",
      "minLength": 1
    },
    "attemptNumber": {
      "type": "integer",
      "minimum": 1,
      "maximum": 100
    },
    "startedAt": {
      "type": "string",
      "format": "date-time"
    },
    "endedAt": {
      "type": "string",
      "format": "date-time"
    },
    "status": {
      "enum": [
        "succeeded",
        "rejected",
        "failed",
        "dead_letter"
      ]
    },
    "platformRecordId": {
      "type": [
        "string",
        "null"
      ],
      "minLength": 1
    },
    "responseHash": {
      "anyOf": [
        {
          "$ref": "common.schema.json#/$defs/contentHash"
        },
        {
          "type": "null"
        }
      ]
    },
    "errorCode": {
      "anyOf": [
        {
          "$ref": "common.schema.json#/$defs/identifier"
        },
        {
          "type": "null"
        }
      ]
    },
    "errorHash": {
      "anyOf": [
        {
          "$ref": "common.schema.json#/$defs/contentHash"
        },
        {
          "type": "null"
        }
      ]
    },
    "nextRetryAt": {
      "anyOf": [
        {
          "type": "string",
          "format": "date-time"
        },
        {
          "type": "null"
        }
      ]
    },
    "recordedBy": {
      "$ref": "common.schema.json#/$defs/codexWriter"
    }
  }
}
