{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "trigger-catalog.schema.json",
  "title": "World OS trigger catalog",
  "type": "object",
  "required": [
    "kind",
    "contractVersion",
    "catalogId",
    "version",
    "worldId",
    "worldCardRef",
    "initialStateRef",
    "triggers"
  ],
  "properties": {
    "$schema": {
      "type": "string"
    },
    "kind": {
      "const": "world_os_trigger_catalog"
    },
    "contractVersion": {
      "const": "0.1.0"
    },
    "catalogId": {
      "$ref": "common.schema.json#/$defs/identifier"
    },
    "version": {
      "type": "integer",
      "minimum": 1
    },
    "worldId": {
      "$ref": "common.schema.json#/$defs/worldId"
    },
    "worldCardRef": {
      "$ref": "common.schema.json#/$defs/exactRef"
    },
    "initialStateRef": {
      "$ref": "common.schema.json#/$defs/exactRef"
    },
    "triggers": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "id",
          "type",
          "status",
          "priority",
          "locationId",
          "when",
          "unknownPolicy",
          "once",
          "eventId",
          "requiredRuleRefs",
          "gatePolicy"
        ],
        "properties": {
          "id": {
            "$ref": "common.schema.json#/$defs/identifier"
          },
          "status": {
            "const": "proposed"
          },
          "priority": {
            "type": "integer",
            "minimum": 0,
            "maximum": 100
          },
          "dueAt": {
            "type": "string",
            "format": "date-time"
          },
          "cooldownMinutes": {
            "type": "integer",
            "minimum": 0,
            "maximum": 5256000
          },
          "maxOccurrences": {
            "type": "integer",
            "minimum": 1,
            "maximum": 1000
          },
          "when": {
            "type": "object"
          },
          "unknownPolicy": {
            "enum": [
              "block",
              "allow"
            ]
          },
          "once": {
            "type": "boolean"
          },
          "requiredRuleRefs": {
            "type": "array",
            "minItems": 1
          }
        }
      }
    }
  }
}
