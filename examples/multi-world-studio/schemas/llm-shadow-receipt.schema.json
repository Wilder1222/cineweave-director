{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "llm-shadow-receipt.schema.json",
  "title": "World OS LLM shadow proposal receipt",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "kind",
    "contractVersion",
    "shadowRunId",
    "version",
    "requestRef",
    "providerPolicyRef",
    "worldId",
    "providerId",
    "modelAlias",
    "attemptNumber",
    "requestedAt",
    "completedAt",
    "status",
    "proposalRef",
    "outputTokens",
    "costUsd",
    "responseHash",
    "errorCode",
    "errorHash",
    "rawResponseStored",
    "hiddenReasoningStored",
    "authority",
    "recordedBy"
  ],
  "properties": {
    "kind": {
      "const": "world_os_llm_shadow_receipt"
    },
    "contractVersion": {
      "const": "0.1.0"
    },
    "shadowRunId": {
      "$ref": "common.schema.json#/$defs/identifier"
    },
    "version": {
      "type": "integer",
      "const": 1
    },
    "requestRef": {
      "$ref": "common.schema.json#/$defs/exactRef"
    },
    "providerPolicyRef": {
      "$ref": "common.schema.json#/$defs/exactRef"
    },
    "worldId": {
      "$ref": "common.schema.json#/$defs/worldId"
    },
    "providerId": {
      "$ref": "common.schema.json#/$defs/identifier"
    },
    "modelAlias": {
      "type": "string",
      "minLength": 1
    },
    "attemptNumber": {
      "type": "integer",
      "minimum": 1,
      "maximum": 100
    },
    "requestedAt": {
      "type": "string",
      "format": "date-time"
    },
    "completedAt": {
      "type": "string",
      "format": "date-time"
    },
    "status": {
      "enum": [
        "proposal_generated",
        "failed"
      ]
    },
    "proposalRef": {
      "anyOf": [
        {
          "$ref": "common.schema.json#/$defs/exactRef"
        },
        {
          "type": "null"
        }
      ]
    },
    "outputTokens": {
      "type": "integer",
      "minimum": 0
    },
    "costUsd": {
      "type": "number",
      "minimum": 0
    },
    "responseHash": {
      "anyOf": [
        {
          "$ref": "common.schema.json#/$defs/contentHash"
        },
        {
          "type": "null"
        }
      ]
    },
    "errorCode": {
      "anyOf": [
        {
          "$ref": "common.schema.json#/$defs/identifier"
        },
        {
          "type": "null"
        }
      ]
    },
    "errorHash": {
      "anyOf": [
        {
          "$ref": "common.schema.json#/$defs/contentHash"
        },
        {
          "type": "null"
        }
      ]
    },
    "rawResponseStored": {
      "const": false
    },
    "hiddenReasoningStored": {
      "const": false
    },
    "authority": {
      "const": "proposal_only"
    },
    "recordedBy": {
      "$ref": "common.schema.json#/$defs/codexWriter"
    }
  }
}
