{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "world-brand-echo.schema.json",
  "title": "World OS L1 shared BrandEcho",
  "type": "object",
  "additionalProperties": false,
  "required": ["kind", "contractVersion", "echoId", "version", "workspaceRef", "worldIds", "symbolId", "surfaceForm", "semanticIntent", "usageScope", "canonImpact", "crossWorldCausality", "sharedActorRefs", "sharedItemRefs", "status", "approvalRef", "approvedAt", "createdAt", "createdBy"],
  "properties": {
    "kind": { "const": "world_os_brand_echo" },
    "contractVersion": { "const": "0.1.0" },
    "echoId": { "$ref": "common.schema.json#/$defs/identifier" },
    "version": { "type": "integer", "minimum": 1 },
    "workspaceRef": { "$ref": "common.schema.json#/$defs/exactRef" },
    "worldIds": { "type": "array", "minItems": 2, "uniqueItems": true, "items": { "$ref": "common.schema.json#/$defs/worldId" } },
    "symbolId": { "$ref": "common.schema.json#/$defs/identifier" },
    "surfaceForm": { "type": "string", "minLength": 1, "maxLength": 240 },
    "semanticIntent": { "type": "string", "minLength": 1, "maxLength": 1000 },
    "usageScope": { "const": "shared_motif_only" },
    "canonImpact": { "const": "none" },
    "crossWorldCausality": { "const": "forbidden" },
    "sharedActorRefs": { "type": "array", "maxItems": 0 },
    "sharedItemRefs": { "type": "array", "maxItems": 0 },
    "status": { "enum": ["proposed", "approved", "retired"] },
    "approvalRef": { "anyOf": [{ "$ref": "common.schema.json#/$defs/exactRef" }, { "type": "null" }] },
    "approvedAt": { "anyOf": [{ "type": "string", "format": "date-time" }, { "type": "null" }] },
    "createdAt": { "type": "string", "format": "date-time" },
    "createdBy": { "$ref": "common.schema.json#/$defs/codexWriter" }
  }
}
