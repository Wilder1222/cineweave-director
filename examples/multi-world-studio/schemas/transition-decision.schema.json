{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "transition-decision.schema.json",
  "title": "World OS transition decision",
  "type": "object",
  "required": [
    "kind",
    "contractVersion",
    "decisionId",
    "version",
    "proposalRef",
    "worldId",
    "stream",
    "decidedAt",
    "decidedBy",
    "status",
    "checks",
    "transition",
    "rationale"
  ],
  "properties": {
    "kind": {
      "const": "world_os_transition_decision"
    },
    "contractVersion": {
      "const": "0.1.0"
    },
    "decisionId": {
      "$ref": "common.schema.json#/$defs/identifier"
    },
    "version": {
      "type": "integer",
      "minimum": 1
    },
    "proposalRef": {
      "$ref": "common.schema.json#/$defs/exactRef"
    },
    "worldId": {
      "$ref": "common.schema.json#/$defs/worldId"
    },
    "stream": {
      "const": "simulation.main"
    },
    "decidedAt": {
      "type": "string",
      "format": "date-time"
    },
    "decidedBy": {
      "$ref": "common.schema.json#/$defs/codexWriter"
    },
    "status": {
      "enum": [
        "accepted_simulation",
        "needs_human_gate",
        "rejected"
      ]
    },
    "checks": {
      "type": "array",
      "minItems": 1
    },
    "transition": {
      "type": [
        "object",
        "null"
      ]
    },
    "rationale": {
      "type": "string",
      "minLength": 1
    }
  }
}
