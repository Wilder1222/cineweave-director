{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "platform-projection.schema.json",
  "title": "World OS platform projection",
  "type": "object",
  "required": [
    "kind",
    "contractVersion",
    "projectionId",
    "version",
    "platformProfileRef",
    "platformId",
    "operation",
    "audience",
    "lane",
    "authority",
    "allowMutation",
    "sourceCommitRefs",
    "stateRef",
    "worldRef",
    "generatedBy",
    "generatedAt",
    "idempotencyKey",
    "redactions",
    "payload"
  ],
  "properties": {
    "kind": {
      "const": "world_os_platform_projection"
    },
    "contractVersion": {
      "const": "0.1.0"
    },
    "projectionId": {
      "$ref": "common.schema.json#/$defs/identifier"
    },
    "version": {
      "type": "integer",
      "minimum": 1
    },
    "platformProfileRef": {
      "$ref": "common.schema.json#/$defs/exactRef"
    },
    "platformId": {
      "$ref": "common.schema.json#/$defs/identifier"
    },
    "operation": {
      "type": "string",
      "minLength": 1
    },
    "audience": {
      "const": "private_workspace"
    },
    "lane": {
      "const": "simulation_preview"
    },
    "authority": {
      "const": "non_authoritative_view"
    },
    "allowMutation": {
      "const": false
    },
    "sourceCommitRefs": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "common.schema.json#/$defs/exactRef"
      }
    },
    "stateRef": {
      "$ref": "common.schema.json#/$defs/exactRef"
    },
    "worldRef": {
      "$ref": "common.schema.json#/$defs/exactRef"
    },
    "generatedBy": {
      "$ref": "common.schema.json#/$defs/codexWriter"
    },
    "generatedAt": {
      "type": "string",
      "format": "date-time"
    },
    "idempotencyKey": {
      "type": "string",
      "minLength": 8
    },
    "redactions": {
      "type": "array",
      "minItems": 1
    },
    "payload": {
      "type": "object",
      "required": [
        "locale",
        "worldId",
        "worldName",
        "stream",
        "sequence",
        "canonLabel",
        "event",
        "state"
      ],
      "properties": {
        "canonLabel": {
          "const": "模拟分支／非正史"
        }
      }
    }
  }
}
