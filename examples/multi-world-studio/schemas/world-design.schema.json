{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "world-design.schema.json",
  "title": "World OS world design proposal",
  "type": "object",
  "required": [
    "kind",
    "contractVersion",
    "worldId",
    "version",
    "displayName",
    "canonDisposition",
    "audiencePromise",
    "themeTension",
    "seasonQuestion",
    "layers",
    "rules",
    "scarceResources",
    "factions",
    "dailySystems",
    "characters",
    "heroLocations",
    "season",
    "style",
    "day0State",
    "locks",
    "humanGates"
  ],
  "properties": {
    "$schema": {
      "type": "string"
    },
    "kind": {
      "const": "world_os_world_design_proposal"
    },
    "contractVersion": {
      "const": "0.1.0"
    },
    "worldId": {
      "$ref": "common.schema.json#/$defs/worldId"
    },
    "version": {
      "type": "integer",
      "minimum": 1
    },
    "displayName": {
      "type": "string",
      "minLength": 1
    },
    "canonDisposition": {
      "const": "proposal"
    },
    "audiencePromise": {
      "type": "string",
      "minLength": 20
    },
    "themeTension": {
      "type": "string",
      "minLength": 10
    },
    "seasonQuestion": {
      "type": "string",
      "minLength": 10
    },
    "layers": {
      "type": "array",
      "minItems": 3
    },
    "rules": {
      "type": "array",
      "minItems": 3,
      "items": {
        "type": "object",
        "required": [
          "id",
          "capability",
          "limit",
          "costs",
          "exception",
          "governance"
        ]
      }
    },
    "scarceResources": {
      "type": "array",
      "minItems": 1
    },
    "factions": {
      "type": "array",
      "minItems": 3
    },
    "dailySystems": {
      "type": "array",
      "minItems": 1
    },
    "characters": {
      "type": "array",
      "minItems": 4,
      "items": {
        "type": "object",
        "required": [
          "id",
          "displayName",
          "narrativeFunction",
          "outerGoal",
          "innerNeed",
          "fear",
          "behavioralFingerprint",
          "forbiddenReaction",
          "actorPolicy",
          "identity"
        ]
      }
    },
    "heroLocations": {
      "type": "array",
      "minItems": 5
    },
    "season": {
      "type": "object",
      "required": [
        "status",
        "beats"
      ],
      "properties": {
        "beats": {
          "type": "array",
          "minItems": 8,
          "maxItems": 8
        }
      }
    },
    "style": {
      "type": "object"
    },
    "day0State": {
      "type": "object"
    },
    "locks": {
      "type": "array",
      "items": {
        "$ref": "common.schema.json#/$defs/lock"
      }
    },
    "humanGates": {
      "type": "array",
      "minItems": 1
    }
  }
}
