{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "world-inception-decision.schema.json",
  "title": "World OS human inception decision",
  "type": "object",
  "additionalProperties": false,
  "required": ["kind", "contractVersion", "decisionId", "version", "registrationRef", "worldId", "decision", "actor", "decidedAt", "rationale", "authority", "recordedBy"],
  "properties": {
    "kind": { "const": "world_os_world_inception_decision" },
    "contractVersion": { "const": "0.1.0" },
    "decisionId": { "$ref": "common.schema.json#/$defs/identifier" },
    "version": { "const": 1 },
    "registrationRef": { "$ref": "common.schema.json#/$defs/exactRef" },
    "worldId": { "$ref": "common.schema.json#/$defs/worldId" },
    "decision": { "enum": ["approve", "reject", "revise"] },
    "actor": { "type": "object", "additionalProperties": false, "required": ["kind", "id"], "properties": { "kind": { "const": "human" }, "id": { "type": "string", "minLength": 1, "maxLength": 160 } } },
    "decidedAt": { "type": "string", "format": "date-time" },
    "rationale": { "type": "string", "minLength": 1, "maxLength": 2000 },
    "authority": { "const": "human_gate" },
    "recordedBy": { "$ref": "common.schema.json#/$defs/codexWriter" }
  }
}
