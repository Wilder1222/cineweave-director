{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "workspace.schema.json",
  "title": "World OS workspace",
  "type": "object",
  "required": [
    "kind",
    "contractVersion",
    "workspaceId",
    "version",
    "name",
    "phase",
    "repositoryRoot",
    "authority",
    "eventSourcing",
    "stores",
    "integrations",
    "allocation",
    "worlds",
    "documents",
    "locks",
    "connectionPolicy",
    "milestones"
  ],
  "properties": {
    "$schema": {
      "type": "string"
    },
    "kind": {
      "const": "world_os_workspace"
    },
    "contractVersion": {
      "const": "0.1.0"
    },
    "workspaceId": {
      "$ref": "common.schema.json#/$defs/identifier"
    },
    "version": {
      "type": "integer",
      "minimum": 1
    },
    "name": {
      "type": "string",
      "minLength": 1
    },
    "phase": {
      "const": "startup"
    },
    "repositoryRoot": {
      "type": "string",
      "minLength": 1
    },
    "authority": {
      "type": "object",
      "required": [
        "singleWriter",
        "writer",
        "writerIds",
        "humanApprovalRequiredForCanon",
        "externalStateWrites"
      ],
      "properties": {
        "singleWriter": {
          "const": true
        },
        "writer": {
          "$ref": "common.schema.json#/$defs/codexWriter"
        },
        "writerIds": {
          "type": "array",
          "minItems": 1,
          "maxItems": 1,
          "items": {
            "const": "codex.root"
          }
        },
        "humanApprovalRequiredForCanon": {
          "const": true
        },
        "externalStateWrites": {
          "const": "forbidden"
        }
      }
    },
    "eventSourcing": {
      "type": "object",
      "required": [
        "appendOnly",
        "requireExpectedVersion",
        "proposalsNeverMutateCanon",
        "commitIsTerminalMarker"
      ],
      "properties": {
        "appendOnly": {
          "const": true
        },
        "requireExpectedVersion": {
          "const": true
        },
        "proposalsNeverMutateCanon": {
          "const": true
        },
        "commitIsTerminalMarker": {
          "const": true
        }
      }
    },
    "stores": {
      "type": "object"
    },
    "integrations": {
      "type": "object"
    },
    "allocation": {
      "type": "object",
      "required": [
        "policy",
        "unit",
        "buckets"
      ],
      "properties": {
        "policy": {
          "const": "startup_70_20_10"
        },
        "unit": {
          "const": "percent"
        },
        "buckets": {
          "type": "array",
          "minItems": 3,
          "maxItems": 3
        }
      }
    },
    "worlds": {
      "type": "array",
      "minItems": 4,
      "items": {
        "type": "object",
        "required": [
          "id",
          "name",
          "portfolioRole",
          "stage",
          "canonDisposition",
          "documentRef",
          "sourcePath"
        ],
        "properties": {
          "id": {
            "$ref": "common.schema.json#/$defs/worldId"
          },
          "portfolioRole": {
            "enum": [
              "primary",
              "incubator",
              "lab"
            ]
          },
          "stage": {
            "enum": [
              "candidate_card",
              "world_bible_draft",
              "prototype",
              "active_production",
              "paused",
              "retired"
            ]
          },
          "canonDisposition": {
            "enum": [
              "proposal",
              "committed",
              "superseded",
              "rejected"
            ]
          }
        }
      }
    },
    "documents": {
      "type": "array",
      "minItems": 1
    },
    "locks": {
      "type": "array",
      "items": {
        "$ref": "common.schema.json#/$defs/lock"
      }
    },
    "connectionPolicy": {
      "type": "object"
    },
    "milestones": {
      "type": "array",
      "minItems": 4,
      "maxItems": 4
    }
  }
}
