{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "event-proposal.schema.json",
  "title": "World OS event proposal",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "kind",
    "contractVersion",
    "proposalId",
    "eventId",
    "proposalVersion",
    "worldId",
    "stream",
    "workspaceRef",
    "worldCardRef",
    "baseStateRef",
    "platformProfileRef",
    "triggerCatalogRef",
    "actionCatalogRef",
    "eventTemplateCatalogRef",
    "eventTemplateId",
    "parentCommitRef",
    "expectedSequence",
    "proposedAt",
    "source",
    "branchRole",
    "title",
    "publicSummary",
    "objective",
    "opposition",
    "choiceUnderPressure",
    "stateChange",
    "causesNext",
    "irreversibility",
    "delayedConsequences",
    "realizesConsequenceRefs",
    "trigger",
    "participants",
    "actions",
    "canonImpact",
    "publicationIntent"
  ],
  "properties": {
    "$schema": {
      "type": "string"
    },
    "kind": {
      "const": "world_os_event_proposal"
    },
    "contractVersion": {
      "const": "0.1.0"
    },
    "proposalId": {
      "$ref": "common.schema.json#/$defs/identifier"
    },
    "eventId": {
      "$ref": "common.schema.json#/$defs/identifier"
    },
    "proposalVersion": {
      "type": "integer",
      "minimum": 1
    },
    "worldId": {
      "$ref": "common.schema.json#/$defs/worldId"
    },
    "stream": {
      "const": "simulation.main"
    },
    "workspaceRef": {
      "$ref": "common.schema.json#/$defs/exactRef"
    },
    "worldCardRef": {
      "$ref": "common.schema.json#/$defs/exactRef"
    },
    "baseStateRef": {
      "$ref": "common.schema.json#/$defs/exactRef"
    },
    "platformProfileRef": {
      "$ref": "common.schema.json#/$defs/exactRef"
    },
    "triggerCatalogRef": {
      "$ref": "common.schema.json#/$defs/exactRef"
    },
    "actionCatalogRef": {
      "$ref": "common.schema.json#/$defs/exactRef"
    },
    "eventTemplateCatalogRef": {
      "$ref": "common.schema.json#/$defs/exactRef"
    },
    "eventTemplateId": {
      "$ref": "common.schema.json#/$defs/identifier"
    },
    "parentCommitRef": {
      "anyOf": [
        {
          "type": "null"
        },
        {
          "$ref": "common.schema.json#/$defs/exactRef"
        }
      ]
    },
    "expectedSequence": {
      "type": "integer",
      "minimum": 0
    },
    "proposedAt": {
      "type": "string",
      "format": "date-time"
    },
    "source": {
      "type": "object",
      "required": [
        "origin",
        "authority"
      ],
      "properties": {
        "origin": {
          "enum": [
            "codex",
            "llm_api",
            "human_request",
            "external_signal"
          ]
        },
        "authority": {
          "const": "proposal_only"
        },
        "orchestratorId": {
          "type": "string",
          "minLength": 1
        },
        "basis": {
          "type": "string",
          "minLength": 1
        },
        "providerId": {
          "type": "string",
          "minLength": 1
        },
        "requestRef": {
          "$ref": "common.schema.json#/$defs/exactRef"
        }
      }
    },
    "branchRole": {
      "enum": [
        "baseline",
        "deterioration",
        "opportunity"
      ]
    },
    "title": {
      "type": "string",
      "minLength": 1
    },
    "publicSummary": {
      "type": "string",
      "minLength": 1
    },
    "objective": {
      "type": "string",
      "minLength": 1
    },
    "opposition": {
      "type": "string",
      "minLength": 1
    },
    "choiceUnderPressure": {
      "type": "string",
      "minLength": 1
    },
    "stateChange": {
      "type": "string",
      "minLength": 1
    },
    "causesNext": {
      "type": "string",
      "minLength": 1
    },
    "irreversibility": {
      "enum": [
        "reversible",
        "costly_to_reverse",
        "irreversible"
      ]
    },
    "delayedConsequences": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/consequence"
      }
    },
    "realizesConsequenceRefs": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "$ref": "common.schema.json#/$defs/identifier"
      }
    },
    "trigger": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "triggerId",
        "type",
        "occurredAt",
        "locationId",
        "preconditions",
        "unknownPolicy"
      ],
      "properties": {
        "triggerId": {
          "$ref": "common.schema.json#/$defs/identifier"
        },
        "type": {
          "type": "string",
          "minLength": 1
        },
        "occurredAt": {
          "type": "string",
          "format": "date-time"
        },
        "locationId": {
          "$ref": "common.schema.json#/$defs/identifier"
        },
        "preconditions": {
          "$ref": "#/$defs/condition"
        },
        "unknownPolicy": {
          "enum": [
            "block",
            "allow"
          ]
        }
      }
    },
    "participants": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "$ref": "common.schema.json#/$defs/identifier"
      }
    },
    "actions": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "actionId",
          "parameters"
        ],
        "properties": {
          "actionId": {
            "$ref": "common.schema.json#/$defs/identifier"
          },
          "parameters": {
            "type": "object",
            "maxProperties": 0
          }
        }
      }
    },
    "canonImpact": {
      "enum": [
        "none",
        "candidate_fact",
        "canon_mutation"
      ]
    },
    "publicationIntent": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "platformId",
        "lane",
        "audience"
      ],
      "properties": {
        "platformId": {
          "$ref": "common.schema.json#/$defs/identifier"
        },
        "lane": {
          "const": "simulation_preview"
        },
        "audience": {
          "enum": [
            "private_workspace",
            "public_after_release_gate"
          ]
        }
      }
    }
  },
  "$defs": {
    "condition": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "all"
          ],
          "properties": {
            "all": {
              "type": "array",
              "minItems": 1,
              "items": {
                "$ref": "#/$defs/condition"
              }
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "any"
          ],
          "properties": {
            "any": {
              "type": "array",
              "minItems": 1,
              "items": {
                "$ref": "#/$defs/condition"
              }
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "not"
          ],
          "properties": {
            "not": {
              "$ref": "#/$defs/condition"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "path",
            "op",
            "value"
          ],
          "properties": {
            "path": {
              "type": "string",
              "pattern": "^/"
            },
            "op": {
              "enum": [
                "eq",
                "ne",
                "gt",
                "gte",
                "lt",
                "lte",
                "in",
                "contains",
                "exists"
              ]
            },
            "value": {}
          }
        }
      ]
    },
    "consequence": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "targetEventId",
        "description",
        "when"
      ],
      "properties": {
        "id": {
          "$ref": "common.schema.json#/$defs/identifier"
        },
        "targetEventId": {
          "$ref": "common.schema.json#/$defs/identifier"
        },
        "description": {
          "type": "string",
          "minLength": 1
        },
        "when": {
          "$ref": "#/$defs/condition"
        }
      }
    }
  }
}
