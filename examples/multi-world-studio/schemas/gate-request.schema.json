{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "gate-request.schema.json",
  "title": "World OS human Gate request",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "kind", "contractVersion", "gateRequestId", "version", "worldId", "stream", "requestType",
    "proposalRef", "decisionRef", "selectionRef", "baseStateRef", "simulationHeadRef", "canonHeadRef",
    "approvalScope", "status", "requestedAt", "requestedBy"
  ],
  "properties": {
    "$schema": { "type": "string" },
    "kind": { "const": "world_os_gate_request" },
    "contractVersion": { "const": "0.1.0" },
    "gateRequestId": { "$ref": "common.schema.json#/$defs/identifier" },
    "version": { "type": "integer", "minimum": 1 },
    "worldId": { "$ref": "common.schema.json#/$defs/worldId" },
    "stream": { "const": "simulation.main" },
    "requestType": { "const": "canon_resume_and_promote" },
    "proposalRef": { "$ref": "common.schema.json#/$defs/exactRef" },
    "decisionRef": { "$ref": "common.schema.json#/$defs/exactRef" },
    "selectionRef": { "$ref": "common.schema.json#/$defs/exactRef" },
    "baseStateRef": { "$ref": "common.schema.json#/$defs/exactRef" },
    "simulationHeadRef": {
      "anyOf": [
        { "$ref": "common.schema.json#/$defs/exactRef" },
        { "type": "null" }
      ]
    },
    "canonHeadRef": {
      "anyOf": [
        { "$ref": "common.schema.json#/$defs/exactRef" },
        { "type": "null" }
      ]
    },
    "approvalScope": { "const": "exact_proposal_resume_and_canon_promotion" },
    "status": { "const": "pending" },
    "requestedAt": { "type": "string", "format": "date-time" },
    "requestedBy": { "$ref": "common.schema.json#/$defs/codexWriter" }
  }
}
