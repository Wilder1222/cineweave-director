      "version": "draft-v0.1",
      "status": "draft"
    },
    {
      "id": "doc.world.w01",
      "path": "../../docs/examples/multi-world-studio/02-w01-linan-chunxin.md",
      "role": "world_bible",
      "worldId": "W01",
      "version": "draft-v0.1",
      "status": "draft"
    },
    {
      "id": "doc.world.w02",
      "path": "../../docs/examples/multi-world-studio/03-w02-shanhai-tianmen.md",
      "role": "world_bible",
      "worldId": "W02",
      "version": "draft-v0.1",
      "status": "draft"
    },
    {
      "id": "doc.simulation",
      "path": "../../docs/examples/multi-world-studio/05-canon-and-simulation.md",
      "role": "canon_simulation_policy",
      "version": "draft-v0.1",
      "status": "draft"
    },
    {
      "id": "doc.operations",
      "path": "../../docs/examples/multi-world-studio/07-studio-operations.md",
      "role": "operations",
      "version": "draft-v0.1",
      "status": "draft"
    },
    {
      "id": "doc.roadmap",
      "path": "../../docs/examples/multi-world-studio/08-roadmap-and-kpis.md",
      "role": "roadmap",
      "version": "draft-v0.1",
      "status": "draft"
    }
  ],
  "locks": [
    {
      "id": "lock.workspace.multi-world",
      "scope": "workspace",
      "subject": "工作室同时经营多个独立世界",
      "path": "/portfolio",
      "level": "hard",
      "status": "active",
      "sourceType": "user_intent",
      "value": true
    },
    {
      "id": "lock.workspace.codex-brain",
      "scope": "workspace",
      "subject": "Codex 是唯一编排大脑与权威写入者",
      "path": "/authority",
      "level": "hard",
      "status": "active",
      "sourceType": "user_intent",
      "value": "codex.root"
    },
    {
      "id": "lock.workspace.mcp-projection",
      "scope": "workspace",
      "subject": "MCP 只发布非权威平台投影",
      "path": "/integrations/mcp",
      "level": "hard",
      "status": "active",
      "sourceType": "user_intent",
      "value": "projection_only"
    },
    {
      "id": "lock.workspace.connection-l1",
      "scope": "workspace",
      "subject": "第一阶段仅使用 L1 软连接",
      "path": "/connectionPolicy/maxAllowedLevel",
      "level": "hard",
      "status": "proposed",
      "sourceType": "design_proposal",
      "value": "L1",
      "activationRequirement": "human_approval"
    },
    {
      "id": "lock.workspace.cross-world-canon",
      "scope": "workspace",
      "subject": "正式跨世界因果",
      "path": "/connectionPolicy/L3",
      "level": "undefined",
      "status": "unresolved",
      "sourceType": "design_unknown"
    }
  ],
  "connectionPolicy": {
    "phase": "phase_1",
    "maxAllowedLevel": "L1",
    "levels": [
      {
        "id": "L1",
        "status": "allowed",
        "canonEffect": "none",
        "description": "只共享母题、栏目语言和弱符号"
      },
      {
        "id": "L2",
        "status": "locked",
        "canonEffect": "unresolved_only",
        "minimumStableWorlds": 2
      },
      {
        "id": "L3",
        "status": "prohibited",
        "canonEffect": "cross_world_commit",
        "minimumStableWorlds": 3,
        "humanApprovalRequired": true
      }
    ]
  },
  "milestones": [
