{
  "$schema": "./schemas/workspace.schema.json",
  "kind": "world_os_workspace",
  "contractVersion": "0.1.0",
  "workspaceId": "workspace.world-matrix",
  "version": 1,
  "name": "万象织境",
  "phase": "startup",
  "repositoryRoot": "../..",
  "authority": {
    "singleWriter": true,
    "writer": {
      "kind": "codex",
      "id": "codex.root"
    },
    "writerIds": [
      "codex.root"
    ],
    "humanApprovalRequiredForCanon": true,
    "externalStateWrites": "forbidden"
  },
  "eventSourcing": {
    "appendOnly": true,
    "requireExpectedVersion": true,
    "proposalsNeverMutateCanon": true,
    "commitIsTerminalMarker": true,
    "currentHeadDerivedFromCommitChain": true
  },
  "stores": {
    "proposals": {
      "artifactKind": "world_os_event_proposal",
      "authority": "non_authoritative"
    },
    "events": {
      "artifactKind": "world_os_event_commit",
      "authority": "stream_authoritative",
      "appendOnly": true
    },
    "states": {
      "artifactKind": "world_os_state_snapshot",
      "authority": "commit_referenced_only"
    },
    "projections": {
      "artifactKind": "world_os_platform_projection",
      "derived": true,
      "rebuildable": true,
      "source": "terminal_commits"
    },
    "receipts": {
      "artifactKind": "world_os_publish_receipt",
      "authority": "delivery_evidence_only"
    }
  },
  "integrations": {
    "mcp": {
      "mode": "outbox_projection_only",
      "profilePath": "platforms/studio-platform.json",
      "profileRef": {
        "kind": "world_os_platform_profile",
        "id": "platform-profile.studio-private",
        "version": 1,
        "contentHash": "sha256:61332753dbb4e29e6e288857b607452ed8e365a5b110649cda1b2adf9a4e9037"
      },
      "canWriteCanon": false,
      "canCommitProposals": false,
      "requiresIdempotencyKey": true,
      "requiresExactSourceRefs": true,
      "feedbackRoute": "external_signal_proposal"
    },
    "llmAdapters": [
      {
        "id": "future.default",
        "enabled": false,
        "policyPath": "providers/future-llm-policy.json",
        "policyRef": {
          "kind": "world_os_llm_provider_policy",
          "id": "provider-policy.future.default",
          "version": 1,
          "contentHash": "sha256:5039f7ea2c15878bc7f2c99229e791d8938bf6ca55ab5b85109f7d7f0fedc64b"
        },
        "outputScope": "proposal_only",
        "canApprove": false,
        "canCommit": false,
        "canWriteState": false,
        "requiredOutputKind": "world_os_event_proposal",
        "budgetPolicy": {
          "maxCandidates": 3,
          "maxOutputTokens": 6000,
          "maxCostUsd": 0.5,
          "timeoutMs": 60000
        }
      }
    ]
  },
  "allocation": {
    "policy": "startup_70_20_10",
    "unit": "percent",
    "buckets": [
      {
        "id": "primary",
        "share": 70,
        "worldIds": [
          "W01"
        ]
      },
      {
        "id": "incubator",
        "share": 20,
        "worldIds": [
          "W02"
        ]
      },
      {
        "id": "lab",
        "share": 10,
        "worldIds": [
          "W03",
          "W04"
        ]
      }
    ]
  },
  "worlds": [
    {
      "id": "W01",
      "name": "临安春信",
      "portfolioRole": "primary",
      "stage": "world_bible_draft",
      "canonDisposition": "proposal",
      "documentRef": "doc.world.w01",
      "sourcePath": "worlds/W01.world.json",
      "initialStatePath": "states/W01.day0.json"
    },
    {
      "id": "W02",
      "name": "山海／天门",
      "portfolioRole": "incubator",
      "stage": "world_bible_draft",
      "canonDisposition": "proposal",
      "documentRef": "doc.world.w02",
      "sourcePath": "worlds/W02.world.json",
      "initialStatePath": "states/W02.day0.json"
    },
    {
      "id": "W03",
      "name": "雾城失物局",
      "portfolioRole": "lab",
      "stage": "candidate_card",
      "canonDisposition": "proposal",
      "documentRef": "doc.portfolio",
      "sourcePath": "worlds/W03.card.json"
    },
    {
      "id": "W04",
      "name": "潮生星港",
      "portfolioRole": "lab",
      "stage": "candidate_card",
      "canonDisposition": "proposal",
      "documentRef": "doc.portfolio",
      "sourcePath": "worlds/W04.card.json"
    }
  ],
  "documents": [
    {
      "id": "doc.meta",
      "path": "../../docs/examples/multi-world-studio/00-meta-bible.md",
      "role": "meta_bible",
      "version": "draft-v0.1",
      "status": "draft"
    },
    {
      "id": "doc.portfolio",
      "path": "../../docs/examples/multi-world-studio/01-world-portfolio.md",
