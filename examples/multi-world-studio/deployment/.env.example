# Copy into the deployment secret manager; keep values empty in source control.
# The HTTP server refuses non-loopback or network-enabled operation without this token.
WORLD_OS_HTTP_TOKEN=

# Outbound MCP HTTP connector (only when the deployment has reviewed the exact server/tool).
WORLD_OS_MCP_HTTP_TRUSTED=false
WORLD_OS_MCP_HTTP_ENDPOINT=
WORLD_OS_MCP_HTTP_API_KEY_ENV=
WORLD_OS_MCP_PROTOCOL_VERSION=2025-03-26

# Server-side proposal-only LLM shadow profile (network opt-in is a separate flag).
WORLD_OS_LLM_TRUSTED=false
WORLD_OS_LLM_ENDPOINT=
WORLD_OS_LLM_MODEL=
WORLD_OS_LLM_API_KEY_ENV=OPENAI_API_KEY
WORLD_OS_LLM_PROVIDER_ID=llm.openai-compatible.server
WORLD_OS_LLM_PROFILE_ID=server-openai-shadow
WORLD_OS_LLM_COST_PER_1K_OUTPUT_TOKENS=

# The credential named above is injected by the deployment secret manager.
OPENAI_API_KEY=
